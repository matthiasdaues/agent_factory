#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INIT_SCRIPT="$SCRIPT_DIR/packages/factory/scripts/init-factory"
UPDATE_SCRIPT="$SCRIPT_DIR/packages/factory/scripts/update-factory"

usage() {
  cat >&2 <<EOF
Usage:
  $0 <target-project-directory> [flags]   Install factory into a project
  $0 --update <target> [--check] [--force] [--source <dir>]
                                           Update an existing installation
  $0 --add [cli ...] --target <dir>        Add CLI wiring to existing install
  $0 --remove [cli ...] --target <dir>     Remove CLI wiring

Any extra flags are forwarded to the underlying script.
EOF
  exit 1
}

if [[ $# -lt 1 ]]; then
  usage
fi

if [[ "$1" == "--update" ]]; then
  shift
  TARGET="${1:-.}"
  shift 2>/dev/null || true
  exec "$UPDATE_SCRIPT" --target "$TARGET" --source "$SCRIPT_DIR" "$@"
fi

if [[ "$1" == "--add" || "$1" == "--remove" ]]; then
  exec "$INIT_SCRIPT" "$@"
fi

TARGET="$1"
shift

if [[ ! -d "$TARGET" ]]; then
  read -rp "Directory '$TARGET' does not exist. Create it? [y/N] " answer
  case "$answer" in
    [yY]|[yY][eE][sS])
      mkdir -p "$TARGET"
      ;;
    *)
      echo "Aborted." >&2
      exit 1
      ;;
  esac
fi

exec "$INIT_SCRIPT" "$@" --target "$TARGET"
