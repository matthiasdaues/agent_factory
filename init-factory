#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INIT_SCRIPT="$SCRIPT_DIR/packages/factory/scripts/init-factory"

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <target-project-directory>" >&2
  exit 1
fi

TARGET="$1"
shift

if [[ ! -d "$TARGET" ]]; then
  read -rp "Directory '$TARGET' does not exist. Create it? [y/N] " answer
  case "$answer" in
    [yY]|[yY][eE][sS])
      mkdir -p "$TARGET"
      ;;
    *)
      echo "Aborted." >&2
      exit 1
      ;;
  esac
fi

exec "$INIT_SCRIPT" "$@" --target "$TARGET"
