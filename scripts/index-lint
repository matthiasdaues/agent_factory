#!/usr/bin/env python3
"""index-lint - Generate/verify INDEX.md from agents/ and skills/ frontmatter.

INDEX.md is a generated artifact, never hand-edited: agents grouped by their
`phase`/`phase-name` frontmatter, skills grouped by their `category`
frontmatter. Same spirit as the other *-lint scripts: deterministic, stdlib
only (Python 3.8+), a minimal targeted frontmatter parser (not full YAML) —
matching spec-lint/backlog-lint's own zero-dependency approach.

Usage
  index-lint                          # regenerate INDEX.md in place
  index-lint --check                  # gate mode: exit 1 if INDEX.md is stale, write nothing
  index-lint --agents-dir agents --skills-dir skills --out INDEX.md

Exit code: 0 if INDEX.md is (now, or already) up to date; 1 in --check mode
if it was stale.
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

CANONICAL_CATEGORY_ORDER = [
    "requirements",
    "architecture",
    "planning",
    "implementation",
    "quality",
    "utility",
]

_FM_KEYS = {"name", "title", "phase", "phase-name", "category", "description"}
_KEY_LINE = re.compile(r"^([A-Za-z0-9_-]+):\s*(.*)$")


def parse_frontmatter(text: str) -> dict[str, str]:
    """Extract only the scalar/folded-block-scalar keys this script needs.

    Not a general YAML parser: list-valued keys (skills:, inputs:, outputs:,
    triggers:, handoff-to:) are deliberately skipped, not misparsed — their
    `- item` lines never match _KEY_LINE, so they're silently passed over.
    """
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end == -1:
        return {}
    lines = text[3:end].split("\n")
    result: dict[str, str] = {}
    i = 0
    while i < len(lines):
        m = _KEY_LINE.match(lines[i])
        if not m:
            i += 1
            continue
        key, rest = m.group(1), m.group(2).strip()
        if key not in _FM_KEYS:
            i += 1
            continue
        if rest in (">-", ">", "|-", "|"):
            parts = []
            i += 1
            while i < len(lines) and (lines[i].startswith("  ") or lines[i].strip() == ""):
                if lines[i].strip():
                    parts.append(lines[i].strip())
                i += 1
            result[key] = " ".join(parts)
            continue
        result[key] = rest.strip('"').strip("'")
        i += 1
    return result


def load_agents(agents_dir: Path) -> list[dict[str, str]]:
    agents = []
    for path in sorted(agents_dir.glob("*.md")):
        fm = parse_frontmatter(path.read_text())
        if not fm.get("name"):
            continue
        fm["_path"] = str(path)
        agents.append(fm)
    return agents


def load_skills(skills_dir: Path) -> list[dict[str, str]]:
    skills = []
    for path in sorted(skills_dir.glob("*/SKILL.md")):
        fm = parse_frontmatter(path.read_text())
        if not fm.get("name"):
            continue
        fm["_path"] = str(path)
        skills.append(fm)
    return skills


def render_agents_section(agents: list[dict[str, str]]) -> tuple[str, list[str]]:
    warnings = []
    phased = [a for a in agents if a.get("phase") not in (None, "")]
    unphased = [a for a in agents if a.get("phase") in (None, "")]

    def phase_key(a: dict[str, str]) -> int:
        try:
            return int(a["phase"])
        except (KeyError, ValueError):
            return 999

    phased.sort(key=lambda a: (phase_key(a), a["name"]))

    lines = ["## Agents", ""]
    seen_phase = None
    for a in phased:
        phase, phase_name = a.get("phase"), a.get("phase-name")
        if phase_name is None:
            warnings.append(f"{a['_path']}: has 'phase' but no 'phase-name'")
            phase_name = f"Phase {phase}"
        if phase != seen_phase:
            if seen_phase is not None:
                lines.append("")
            lines.append(f"### Phase {phase} — {phase_name}")
            lines.append("")
            lines.append("| Agent | Description |")
            lines.append("| --- | --- |")
            seen_phase = phase
        title = a.get("title", a["name"])
        desc = a.get("description", "")
        lines.append(f"| [`{a['name']}`]({a['_path']}) — {title} | {desc} |")

    if unphased:
        if seen_phase is not None:
            lines.append("")
        lines.append("### Unphased (dispatcher-spawned sub-agents)")
        lines.append("")
        lines.append("| Agent | Description |")
        lines.append("| --- | --- |")
        for a in sorted(unphased, key=lambda a: a["name"]):
            title = a.get("title", a["name"])
            desc = a.get("description", "")
            lines.append(f"| [`{a['name']}`]({a['_path']}) — {title} | {desc} |")

    return "\n".join(lines), warnings


def render_skills_section(skills: list[dict[str, str]]) -> tuple[str, list[str]]:
    warnings = []
    uncategorized = [s for s in skills if not s.get("category")]
    categorized = [s for s in skills if s.get("category")]

    for s in uncategorized:
        warnings.append(f"{s['_path']}: has no 'category'")

    def order_key(s: dict[str, str]) -> tuple[int, str]:
        cat = s["category"]
        try:
            idx = CANONICAL_CATEGORY_ORDER.index(cat)
        except ValueError:
            idx = len(CANONICAL_CATEGORY_ORDER)
        return (idx, s["name"])

    categorized.sort(key=order_key)

    lines = ["## Skills", ""]
    seen_cat = None
    for s in categorized:
        cat = s["category"]
        if cat != seen_cat:
            if seen_cat is not None:
                lines.append("")
            lines.append(f"### {cat.capitalize()}")
            lines.append("")
            lines.append("| Skill | Description |")
            lines.append("| --- | --- |")
            seen_cat = cat
        desc = s.get("description", "")
        lines.append(f"| [`{s['name']}`]({s['_path']}) | {desc} |")

    if uncategorized:
        if seen_cat is not None:
            lines.append("")
        lines.append("### Uncategorised")
        lines.append("")
        lines.append("| Skill | Description |")
        lines.append("| --- | --- |")
        for s in sorted(uncategorized, key=lambda s: s["name"]):
            desc = s.get("description", "")
            lines.append(f"| [`{s['name']}`]({s['_path']}) | {desc} |")

    return "\n".join(lines), warnings


def render_index(agents_dir: Path, skills_dir: Path) -> tuple[str, list[str]]:
    agents = load_agents(agents_dir)
    skills = load_skills(skills_dir)
    agents_section, aw = render_agents_section(agents)
    skills_section, sw = render_skills_section(skills)
    header = (
        "# Index\n\n"
        "Generated by `scripts/index-lint` from `agents/*.md` and "
        "`skills/*/SKILL.md` frontmatter — do not edit by hand, "
        "regenerate with `scripts/index-lint`.\n\n"
    )
    body = header + agents_section + "\n\n" + skills_section + "\n"
    return body, aw + sw


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Generate/verify INDEX.md from frontmatter.")
    ap.add_argument("--agents-dir", default="agents", type=Path)
    ap.add_argument("--skills-dir", default="skills", type=Path)
    ap.add_argument("--out", default="INDEX.md", type=Path)
    ap.add_argument(
        "--check", action="store_true", help="verify only, don't write; exit 1 if stale"
    )
    args = ap.parse_args(argv)

    content, warnings = render_index(args.agents_dir, args.skills_dir)

    for w in warnings:
        print(f"[WARNING] {w}", file=sys.stderr)

    current = args.out.read_text() if args.out.exists() else None

    if args.check:
        if current != content:
            print(f"index-lint: {args.out} is stale — run `scripts/index-lint` to regenerate")
            return 1
        print(f"index-lint: {args.out} is up to date")
        return 0

    if current == content:
        print(f"index-lint: {args.out} already up to date, no changes")
        return 0

    args.out.write_text(content)
    print(f"index-lint: wrote {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
