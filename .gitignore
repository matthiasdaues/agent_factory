# 1. Compressed code and packages

# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
*.whl

# Distribution / packaging
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# lib/ and lib64/ intentionally NOT ignored — they may contain project source code.
# Python virtualenvs are already covered by **/.venv/ and **/venv/ below.
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
env/
.env
build/
/venv/

# --- uv Configuration ---
# Ignore environments in root and all subdirectories
**/.venv/
**/venv/

# Ignore uv cache folders everywhere
**/.uv/
**/.uv_cache/

# Ignore generated version files in any package
src/**/_version.py

# --- IMPORTANT ---
# Do NOT use **/uv.lock
# You want to track the lockfile(s) to ensure builds are deterministic.

