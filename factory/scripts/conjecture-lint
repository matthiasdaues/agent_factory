#!/usr/bin/env python3
# conjecture-lint — early-warning linter for research conjectures.
#
# What: Flags the two defects that, left until adversarial review or register
#       assembly, force an expensive resolution/re-test pass:
#         1. NON-ATOMIC claim — the `claim` field bundles more than one
#            assertion (a capability AND a gap, clauses joined by whereas/but/
#            however/while/although, a semicolon splice, or multiple sentences).
#            The Claim-Admission Policy's "One Assertion" requirement already
#            forbids this; this lint moves the catch to conjecture formation
#            (playbook Step 6) instead of Step 8+.
#         2. PLANNED-TEST-COUNT MISMATCH — `planned_tests` must have as many
#            entries as the review protocol will execute (one test record per
#            planned test is required for admission). Planning more tests than
#            the protocol runs makes the claim unadmittable regardless of merit.
# When: Run at Step 6 (Validate the Conjecture), before any test/review/vote
#       session is spent on the claim.
# By:   `factory/scripts/conjecture-lint <conjecture-file> [--expect-tests N]`
#       `--expect-tests` is the plan's tests-per-claim for this claim's tier
#       (see research-planning). Omit it to check atomicity + non-empty tests
#       only.
#
# Findings are ADVISORY: a warning here is a prompt for the author/orchestrator
# to split the claim or align the test count, not an automatic rejection. The
# hard admission rules stay in policy-validate and the semantic review.
#
# Stdlib only (Python 3.8+), like schema-validate — no virtualenv needed.
#
# Exit code:
#   0  no findings
#   1  one or more lint findings (each printed to stdout)
#   2  operational error — missing file, unreadable/invalid JSON (to stderr)

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any, List, Optional, Tuple

# Strong contrastive conjunctions that, inside a single claim sentence, join two
# independent assertions (a capability and a gap, most often). Deliberately NOT
# including `while`/`although`: those are too often benign subordination
# ("A covers X, while B covers Y" is one capability claim) and generate false
# positives on genuinely atomic claims.
_CONJUNCTIONS = ("whereas", "but", "however")

# A claim whose primary disposition is a negation ("... no tool performs X ...")
# is a single gap claim even though it contains capability verbs inside the
# negated predicate. Detect that leading negation so the capability/gap
# co-occurrence check does not mis-fire on it.
_LEADING_NEGATION = re.compile(
    r'^\s*(as of [^,]+,\s*)?(there (is|are) )?(no|not|neither|none)\b',
    re.IGNORECASE,
)

# Markers that a claim asserts a positive capability.
_CAP_MARKERS = (
    "is covered", "are covered", "is performed", "are performed", "provides",
    "supports", "couples", "handles", "is adequate", "are adequate",
    "can sustain", "can parallelis", "can parallelize", "is reachable",
    "ships", "is available", "performs",
)
# Markers that a claim asserts a gap / negation.
_GAP_MARKERS = (
    "no ", "not ", "lacks", "absent", "gap", "unpackaged", "unmaintained",
    "does not", "cannot", "no admissible", "no maintained", "no turnkey",
    "infeasible", "unproven",
)


def _load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        print(f"conjecture-lint: no such file '{path}'", file=sys.stderr)
        raise SystemExit(2)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"conjecture-lint: '{path}' is not readable JSON: {exc}",
              file=sys.stderr)
        raise SystemExit(2)


def _sentence_count(text: str) -> int:
    # A claim should be exactly one sentence. Count sentence breaks: terminal
    # punctuation followed by whitespace and a capital/quote, plus one for the
    # final clause. Decimals like "1.75" are not followed by whitespace+capital.
    breaks = re.findall(r'[.!?]\s+["\'(]?[A-Z]', text)
    return len(breaks) + 1


def _find_markers(text: str, markers: Tuple[str, ...]) -> List[str]:
    low = text.lower()
    return [m.strip() for m in markers if m in low]


def lint_claim(claim: str) -> List[str]:
    findings: List[str] = []
    low = claim.lower()

    for c in _CONJUNCTIONS:
        if re.search(rf'\b{c}\b', low):
            findings.append(
                f"non-atomic: contrastive '{c}' joins two clauses — a conjecture "
                f"states exactly one assertion; split it"
            )

    if ";" in claim:
        findings.append(
            "non-atomic: ';' splices two independent clauses into one claim — "
            "split into separate conjectures"
        )

    sc = _sentence_count(claim)
    if sc > 1:
        findings.append(
            f"non-atomic: claim reads as {sc} sentences — a conjecture's claim "
            f"must be a single sentence"
        )

    # Capability-and-gap co-occurrence signals a bundled claim — but only when
    # the claim is not itself a single gap claim (a leading negation governs the
    # capability verbs, e.g. "no tool performs X").
    if not _LEADING_NEGATION.match(claim):
        caps = _find_markers(claim, _CAP_MARKERS)
        gaps = _find_markers(claim, _GAP_MARKERS)
        if caps and gaps:
            findings.append(
                f"non-atomic: claim bundles a capability assertion (near "
                f"{caps[0]!r}) and a gap/negation assertion (near {gaps[0]!r}) — "
                f"author one capability claim OR one gap claim, never both"
            )

    return findings


def lint(path: Path, expect_tests: Optional[int]) -> List[str]:
    data = _load_json(path)
    findings: List[str] = []

    if not isinstance(data, dict):
        return ["conjecture is not a JSON object"]

    claim = data.get("claim")
    if not isinstance(claim, str) or not claim.strip():
        findings.append("missing or empty 'claim' field")
    else:
        findings.extend(lint_claim(claim))

    planned = data.get("planned_tests")
    if not isinstance(planned, list) or not planned:
        findings.append(
            "'planned_tests' is missing or empty — plan the severe tests that "
            "will actually be executed"
        )
    elif expect_tests is not None and len(planned) != expect_tests:
        findings.append(
            f"planned-test-count mismatch: {len(planned)} planned but the "
            f"review protocol runs {expect_tests} — admission requires one test "
            f"record per planned test, so plan exactly {expect_tests}"
        )

    return findings


def main(argv: List[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="conjecture-lint",
        description="Early-warning linter for research conjectures "
                    "(atomicity + planned-test-count).",
    )
    parser.add_argument("conjecture", type=Path, help="conjecture JSON file")
    parser.add_argument(
        "--expect-tests", type=int, default=None,
        help="tests-per-claim the review protocol will run (from the plan)",
    )
    args = parser.parse_args(argv)

    findings = lint(args.conjecture, args.expect_tests)
    if findings:
        for f in findings:
            print(f"{args.conjecture}: {f}")
        print(f"\nconjecture-lint: {len(findings)} finding(s) in "
              f"{args.conjecture}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
