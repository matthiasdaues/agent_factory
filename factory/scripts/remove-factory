#!/usr/bin/env python3
"""remove-factory — reverse an init-factory install back to a clean tree.

What: Reads the removal manifest and undoes exactly what init-factory did,
      nothing more.
When: To uninstall Agent Factory from a project.
By:   run by hand — the companion to init-factory.

The companion to init-factory. Reads the removal manifest init-factory left at
`.agent-factory/factory-install.json` and undoes exactly what that run did,
nothing more:

  - git-ignored footprint (factory/, .claude/, .pi/, the specific .github/*
    entries, root AGENTS.md when init-factory created it, config/model.conf,
    session ephemera, .agent-factory/) — deleted outright.
    None of it was ever tracked, so `git status` is unaffected.
  - .gitignore — the single "agent_factory related" marker block is stripped
    (or the whole file removed, if init-factory created it).
  - .pre-commit-config.yaml — if init-factory created it, it's deleted; if
    init-factory only spliced into a file the project already had, just the
    `agent_factory_hook-*` `- repo: local` item is removed, leaving the
    project's own hooks untouched.
  - .claude/settings.json — if the project owned it, only Agent Factory's
    git-safety PreToolUse hook and usage-capture Stop/SubagentStop hook entries
    are removed; if init-factory created it, it went with .claude/.
  - .codex/hooks.json — if the project owned it, only Agent Factory's
    usage-capture Stop/SubagentStop entries are removed; a Factory-created file
    is deleted outright.
  - orientation files — if init-factory injected a marker-fenced orientation
    block into a project-owned CLAUDE.md or copilot-instructions.md, the block
    is stripped, restoring the file to its original content.
  - the pre-commit git hook is uninstalled only if init-factory was the one
    that `git init`-ed the repo.

NON-INTERFERENCE holds in reverse too: anything the manifest records as the
project's own (an existing orientation file, an existing pre-commit config, an
existing .gitignore, existing .github/workflows) is left exactly as it was.

Usage
  remove-factory                       # target = cwd
  remove-factory --target /path/to/project

Exit code: 0 on success (including a no-op when no manifest is present).
           1 only if the manifest exists but can't be read.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time
import uuid
from pathlib import Path

MANIFEST_PATH = ".agent-factory/factory-install.json"
HOOK_ID_PREFIX = "agent_factory_hook-"
CLAUDE_GUARDRAIL_HOOK_COMMAND = (
    '"$CLAUDE_PROJECT_DIR"/.claude/hooks/block-dangerous-git.sh'
)
CLAUDE_CAPTURE_HOOK_COMMAND = '"$CLAUDE_PROJECT_DIR"/.claude/hooks/capture-usage.sh'
CLAUDE_CAPTURE_HOOK_EVENTS = ("Stop", "SubagentStop")
CLAUDE_STEP_GUARD_HOOK_COMMANDS = {
    "Read": 'GUARD_TYPE=read "$CLAUDE_PROJECT_DIR"/.claude/hooks/step-guard.sh',
    "Edit": 'GUARD_TYPE=write "$CLAUDE_PROJECT_DIR"/.claude/hooks/step-guard.sh',
    "Write": 'GUARD_TYPE=write "$CLAUDE_PROJECT_DIR"/.claude/hooks/step-guard.sh',
    "Bash": 'GUARD_TYPE=bash "$CLAUDE_PROJECT_DIR"/.claude/hooks/step-guard.sh',
}
CODEX_AGENT_OWNED_MARKER = "# Generated by Agent Factory; do not edit.\n"

ORIENTATION_BEGIN = "<!-- >>> agent_factory orientation >>>"
ORIENTATION_END = "<!-- <<< agent_factory orientation <<< -->"
USAGE_CONTROL = Path(".agent-factory/usage-control")

REPOS_KEY = re.compile(r"^repos:\s*$")
TOP_LEVEL_KEY = re.compile(r"^\S")
REPO_ITEM_START = re.compile(r"^  - repo:\s*\S")
HOOK_ID_LINE = re.compile(r"^\s*- id:\s*(\S+)\s*$")


def log(line: str) -> None:
    print(f"remove-factory: {line}")


def strip_gitignore_block(target: Path, manifest: dict) -> None:
    path = target / ".gitignore"
    if not path.exists():
        return

    markers = manifest.get("gitignore_markers", {})
    begin = markers.get("begin", "# >>> agent_factory related >>>")
    end = markers.get("end", "# <<< agent_factory related <<<")

    text = path.read_text(encoding="utf-8")
    if begin not in text or end not in text:
        return

    pre, rest = text.split(begin, 1)
    _, post = rest.split(end, 1)
    # `pre` carries the blank-line separator init-factory inserted before the
    # block; drop it, rejoin, then restore the project's original trailing state.
    restored = (pre.removesuffix("\n")) + post
    restored = restored.rstrip("\n")
    if restored and manifest.get("gitignore_orig_final_newline", True):
        restored += "\n"

    if restored.strip():
        path.write_text(restored, encoding="utf-8")
        log(".gitignore: stripped the agent_factory related block")
    else:
        path.unlink()
        log(".gitignore: removed (held only the agent_factory block)")


def strip_orientation_block(target: Path, manifest: dict) -> None:
    orientation = manifest.get("orientation", {})
    markers = manifest.get("orientation_markers", {})
    begin = markers.get("begin", ORIENTATION_BEGIN)
    end = markers.get("end", ORIENTATION_END)
    orig_newlines = manifest.get("orientation_orig_final_newline", {})

    for rel, status in orientation.items():
        if status != "injected":
            continue
        path = target / rel
        if not path.exists():
            continue
        text = path.read_text(encoding="utf-8")
        if begin not in text or end not in text:
            continue
        pre, rest = text.split(begin, 1)
        _, post = rest.split(end, 1)
        post = post.lstrip("\n")
        restored = pre.rstrip("\n")
        if restored:
            restored += "\n"
        restored += post
        had_nl = orig_newlines.get(rel, True)
        restored = restored.rstrip("\n")
        if restored and had_nl:
            restored += "\n"
        if restored.strip():
            path.write_text(restored, encoding="utf-8")
            log(f"{rel}: stripped Agent Factory orientation block")
        else:
            path.unlink()
            log(f"{rel}: removed (held only the orientation block)")


def strip_precommit_block(target: Path, manifest: dict) -> None:
    pc = manifest.get("precommit") or {}
    if not pc.get("existed"):
        return  # init-factory created it — deleted with the footprint instead

    path = target / pc.get("path", ".pre-commit-config.yaml")
    if not path.exists():
        return

    lines = path.read_text(encoding="utf-8").splitlines()

    repos_idx = next((i for i, ln in enumerate(lines) if REPOS_KEY.match(ln)), None)
    if repos_idx is None:
        return

    list_end = len(lines)
    for i in range(repos_idx + 1, len(lines)):
        if lines[i].strip() == "":
            continue
        if TOP_LEVEL_KEY.match(lines[i]):
            list_end = i
            break

    # Item boundaries within the repos list.
    starts = [
        i for i in range(repos_idx + 1, list_end) if REPO_ITEM_START.match(lines[i])
    ]
    bounds = []
    for n, s in enumerate(starts):
        e = starts[n + 1] if n + 1 < len(starts) else list_end
        bounds.append((s, e))

    drop: list[tuple[int, int]] = []
    for s, e in bounds:
        ids = [m.group(1) for m in (HOOK_ID_LINE.match(ln) for ln in lines[s:e]) if m]
        if ids and all(i.startswith(HOOK_ID_PREFIX) for i in ids):
            drop.append((s, e))

    if not drop:
        return

    keep = [
        ln for idx, ln in enumerate(lines) if not any(s <= idx < e for s, e in drop)
    ]
    # collapse any run of blank lines left behind to a single blank
    out: list[str] = []
    for ln in keep:
        if ln.strip() == "" and out and out[-1].strip() == "":
            continue
        out.append(ln)

    restored = "\n".join(out).rstrip("\n")
    if restored and manifest.get("precommit_orig_final_newline", True):
        restored += "\n"
    path.write_text(restored, encoding="utf-8")
    log(
        f"{path.name}: removed the agent_factory_hook-* block, kept the project's own hooks"
    )


def _strip_hook_command(hooks: dict, event: str, command: str) -> bool:
    entries = hooks.get(event)
    if not isinstance(entries, list):
        return False

    kept = []
    removed = False
    for entry in entries:
        if not isinstance(entry, dict):
            kept.append(entry)
            continue
        entry_hooks = entry.get("hooks")
        if not isinstance(entry_hooks, list):
            kept.append(entry)
            continue
        filtered_hooks = [
            hook
            for hook in entry_hooks
            if not (isinstance(hook, dict) and hook.get("command") == command)
        ]
        if len(filtered_hooks) == len(entry_hooks):
            kept.append(entry)
            continue
        removed = True
        if filtered_hooks:
            kept.append({**entry, "hooks": filtered_hooks})

    if not removed:
        return False

    if kept:
        hooks[event] = kept
    else:
        hooks.pop(event, None)
    return True


def strip_settings_hook(target: Path, manifest: dict) -> None:
    if not manifest.get("claude_settings_existed"):
        return  # init-factory created it — deleted with .claude/ instead

    path = target / ".claude" / "settings.json"
    if not path.exists():
        return

    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return

    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return

    removed_events: list[str] = []
    if _strip_hook_command(hooks, "PreToolUse", CLAUDE_GUARDRAIL_HOOK_COMMAND):
        removed_events.append("git-safety PreToolUse")

    for event, command in CLAUDE_STEP_GUARD_HOOK_COMMANDS.items():
        if _strip_hook_command(hooks, event, command):
            removed_events.append(f"step-guard {event}")
        if _strip_hook_command(hooks, event, command):
            removed_events.append(f"step-guard {event} (legacy)")

    for event in CLAUDE_CAPTURE_HOOK_EVENTS:
        if _strip_hook_command(hooks, event, CLAUDE_CAPTURE_HOOK_COMMAND):
            removed_events.append(f"usage-capture {event}")

    if not removed_events:
        return

    if not hooks:
        settings.pop("hooks", None)

    path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    log(".claude/settings.json: removed " + ", ".join(removed_events) + " hook entry")


def _strip_recorded_codex_handler(hooks: dict, record: dict) -> bool:
    """Remove one handler appended by init, never every matching project hook."""
    event = record.get("event")
    command = record.get("command")
    entries = hooks.get(event)
    if not isinstance(event, str) or not isinstance(command, str):
        return False
    if not isinstance(entries, list):
        return False

    expected_matcher = record.get("matcher")
    for index in range(len(entries) - 1, -1, -1):
        entry = entries[index]
        if not isinstance(entry, dict):
            continue
        if entry.get("matcher") != expected_matcher:
            continue
        handlers = entry.get("hooks")
        if not isinstance(handlers, list):
            continue
        for handler_index in range(len(handlers) - 1, -1, -1):
            handler = handlers[handler_index]
            if not (
                isinstance(handler, dict)
                and handler.get("type") == "command"
                and handler.get("command") == command
            ):
                continue
            updated = handlers[:handler_index] + handlers[handler_index + 1 :]
            if updated:
                entries[index] = {**entry, "hooks": updated}
            else:
                entries.pop(index)
            if not entries:
                hooks.pop(event, None)
            return True
    return False


def strip_codex_hooks(target: Path, manifest: dict) -> None:
    """Restore untouched hook bytes or remove only manifest-owned additions."""
    path = target / ".codex/hooks.json"
    if path.is_symlink() or not path.exists():
        return
    try:
        info = path.lstat()
        raw = path.read_bytes()
    except OSError:
        return
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        return

    installed_hash = manifest.get("codex_hooks_installed_sha256")
    untouched = (
        isinstance(installed_hash, str)
        and hashlib.sha256(raw).hexdigest() == installed_hash
        and manifest.get("codex_hooks_restore_original") is True
    )
    if untouched:
        if manifest.get("codex_hooks_existed"):
            original = manifest.get("codex_hooks_original")
            if isinstance(original, str):
                path.write_text(original, encoding="utf-8")
                log(".codex/hooks.json: restored original bytes")
        else:
            path.unlink()
            log(".codex/hooks.json: removed Factory-created file")
        return

    try:
        config = json.loads(raw)
    except (json.JSONDecodeError, UnicodeError):
        return
    hooks = config.get("hooks") if isinstance(config, dict) else None
    if not isinstance(hooks, dict):
        return

    removed = [
        record
        for record in manifest.get("codex_hook_handlers", [])
        if isinstance(record, dict) and _strip_recorded_codex_handler(hooks, record)
    ]
    if not removed:
        return
    if not hooks:
        config.pop("hooks", None)
    if not config and not manifest.get("codex_hooks_existed"):
        path.unlink()
        log(".codex/hooks.json: removed empty Factory-created file")
        return
    path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    events = ", ".join(str(record.get("event")) for record in removed)
    log(".codex/hooks.json: removed Factory handlers for " + events)


def uninstall_pre_commit(target: Path, manifest: dict) -> None:
    if not manifest.get("git_initialized_by_us"):
        return  # the repo (and any pre-existing hook) predates us — leave it
    result = subprocess.run(
        ["uvx", "pre-commit", "uninstall"],
        cwd=target,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0:
        log("uvx pre-commit uninstall: done")


def _validated_remove_paths(target: Path, manifest: dict) -> list[str]:
    """Validate containment and reject symlinked ancestors before mutation."""
    validated: list[str] = []
    for rel in manifest.get("remove_paths", []):
        if not isinstance(rel, str):
            raise TypeError("manifest remove path is not a string")
        candidate = Path(rel)
        if candidate.is_absolute() or not candidate.parts or ".." in candidate.parts:
            raise ValueError(f"unsafe manifest remove path: {rel!r}")
        current = target
        for part in candidate.parts[:-1]:
            current = current / part
            if current.is_symlink():
                raise ValueError(f"symlinked manifest path ancestor: {rel!r}")
            if current.exists() and not current.is_dir():
                raise ValueError(f"non-directory manifest path ancestor: {rel!r}")
        validated.append(rel)
    return validated


def _symlink_points_to(path: Path, expected: Path) -> bool:
    if not path.is_symlink():
        return False
    resolved = (path.parent / os.readlink(path)).resolve()
    return resolved == expected.resolve()


def _codex_artifact_owned(path: Path, rel: str, target: Path, manifest: dict) -> bool:
    if (
        rel == "AGENTS.md"
        and manifest.get("orientation", {}).get("AGENTS.md") == "linked"
    ):
        return _symlink_points_to(path, target / "factory/config/AGENTS.md")
    if rel.startswith(".agents/skills/"):
        return _symlink_points_to(path, target / "factory/skills" / Path(rel).name)
    if rel in {
        ".codex/INDEX.yaml",
        ".codex/playbooks",
        ".codex/rulebooks",
        ".codex/scripts",
    }:
        return _symlink_points_to(path, target / "factory" / Path(rel).name)
    if rel in {
        ".codex/hooks/block-dangerous-git.sh",
        ".codex/hooks/capture-codex-usage.sh",
        ".codex/hooks/step-guard.sh",
    }:
        return _symlink_points_to(
            path, target / "factory/config/hooks" / Path(rel).name
        )
    if rel in set(manifest.get("codex_generated_agents", [])):
        if path.is_symlink():
            return False
        try:
            info = path.lstat()
            with path.open(encoding="utf-8") as stream:
                marker = stream.readline()
        except (OSError, UnicodeError):
            return False
        return (
            stat.S_ISREG(info.st_mode)
            and info.st_nlink == 1
            and marker == CODEX_AGENT_OWNED_MARKER
        )
    return rel != ".codex/hooks.json"


def delete_paths(target: Path, manifest: dict, remove_paths: list[str]) -> None:
    merged_dirs = set(manifest.get("merged_dirs", []))
    for rel in remove_paths:
        path = target / rel
        if (
            rel == "AGENTS.md" or rel.startswith((".agents/", ".codex/"))
        ) and not _codex_artifact_owned(path, rel, target, manifest):
            if path.exists() or path.is_symlink():
                log(f"preserved replaced project path: {rel}")
            continue
        if path.is_symlink():
            path.unlink()
        elif path.is_dir():
            # Directories that were merged (project owned the dir, factory
            # added individual symlinks) must NOT be removed wholesale —
            # the individual child symlinks are tracked as their own entries.
            if rel in merged_dirs:
                log(f"skip merged dir (project-owned): {rel}")
                continue
            shutil.rmtree(path)
        elif path.exists():
            path.unlink()
        else:
            continue
        log(f"removed: {rel}")


def prune_empty_dirs(target: Path) -> None:
    # Directories init-factory may have added into but not owned wholesale.
    for rel in (
        ".github/hooks",
        ".agents/skills",
        ".codex/agents",
        ".codex/hooks",
        "config",
        ".github",
        ".claude",
        ".agents",
        ".codex",
        ".pi",
    ):
        path = target / rel
        if not path.is_symlink() and path.is_dir() and not any(path.iterdir()):
            path.rmdir()
            log(f"removed empty dir: {rel}")


def _write_usage_state(control: Path, mode: str, generation: str) -> None:
    temp = control / f"state-{uuid.uuid4()}.tmp"
    temp.write_text(
        json.dumps({"mode": mode, "generation": generation}) + "\n",
        encoding="utf-8",
    )
    temp.chmod(0o600)
    os.replace(temp, control / "state.json")
    (control / "state.json").chmod(0o600)


def _pending_markers(control: Path) -> list[Path]:
    pending = control / "pending"
    return list(pending.iterdir()) if pending.is_dir() else []


def _cancel_pending(target: Path, control: Path) -> int:
    """Cancel only pending registrations; committing workers must drain."""
    scratch = target / ".agent-factory/usage/.capture"
    safe_scratch = not scratch.is_symlink() and scratch.resolve() == scratch
    cancelled = 0
    for marker in _pending_markers(control):
        if not marker.name.endswith(".pending.json") or marker.is_symlink():
            continue
        try:
            data = json.loads(marker.read_text(encoding="utf-8"))
            staged = Path(data.get("staged_source", ""))
            if (
                staged.is_absolute()
                and not staged.is_symlink()
                and safe_scratch
                and staged.parent == scratch
                and staged.is_file()
            ):
                staged.unlink()
            marker.unlink()
            cancelled += 1
        except (OSError, json.JSONDecodeError, TypeError):
            # The marker itself is Factory-owned; never follow malformed data.
            try:
                marker.unlink()
                cancelled += 1
            except OSError:
                pass
    return cancelled


def prepare_usage_removal(
    target: Path, disposition: str, timeout: float
) -> tuple[bool, Path | None]:
    """Fence persistence, then drain or explicitly cancel registrations."""
    control = target / USAGE_CONTROL
    state_path = control / "state.json"
    if not state_path.is_file():
        return True, None
    owner = control / "remove-owner"
    try:
        with owner.open("x", encoding="utf-8") as handle:
            handle.write(str(os.getpid()))
        owner.chmod(0o600)
    except FileExistsError:
        print("remove-factory: usage removal already in progress", file=sys.stderr)
        return False, None
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
        generation = state["generation"]
        _write_usage_state(control, disposition, generation)
        cancelled = _cancel_pending(target, control) if disposition == "cancel" else 0
        deadline = time.monotonic() + timeout
        while _pending_markers(control):
            if time.monotonic() >= deadline:
                _write_usage_state(control, "active", generation)
                owner.unlink(missing_ok=True)
                print(
                    "remove-factory: pending usage did not settle before timeout; "
                    "installation left active",
                    file=sys.stderr,
                )
                return False, None
            time.sleep(0.05)
        if cancelled:
            log(f"cancelled {cancelled} pending usage capture(s)")
        return True, owner
    except (OSError, KeyError, json.JSONDecodeError) as exc:
        owner.unlink(missing_ok=True)
        print(f"remove-factory: invalid usage lifecycle state: {exc}", file=sys.stderr)
        return False, None


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--target", type=Path, default=Path("."))
    ap.add_argument("--pending-usage", choices=("drain", "cancel"), default="drain")
    ap.add_argument("--pending-timeout", type=float, default=5.0)
    args = ap.parse_args(argv)

    target = args.target.resolve()
    manifest_path = target / MANIFEST_PATH

    if not manifest_path.exists():
        print(
            f"remove-factory: no manifest at {MANIFEST_PATH} — nothing to remove "
            f"(is {target} an init-factory'd project?)"
        )
        return 0

    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as e:
        print(f"remove-factory: can't read {MANIFEST_PATH}: {e}", file=sys.stderr)
        return 1

    try:
        remove_paths = _validated_remove_paths(target, manifest)
    except (TypeError, ValueError) as e:
        print(f"remove-factory: unsafe manifest — {e}", file=sys.stderr)
        return 1

    ready, _owner = prepare_usage_removal(
        target, args.pending_usage, max(0.0, args.pending_timeout)
    )
    if not ready:
        return 1

    # Undo the tracked-file edits first (while the config still exists), then
    # delete the ignored footprint, then the manifest's own directory last.
    strip_orientation_block(target, manifest)
    strip_gitignore_block(target, manifest)
    strip_precommit_block(target, manifest)
    strip_settings_hook(target, manifest)
    strip_codex_hooks(target, manifest)
    uninstall_pre_commit(target, manifest)
    delete_paths(target, manifest, remove_paths)

    agent_factory_dir = target / ".agent-factory"
    if agent_factory_dir.is_dir():
        shutil.rmtree(agent_factory_dir)
        log("removed: .agent-factory/")

    prune_empty_dirs(target)

    print(f"remove-factory: done, Agent Factory removed from {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
