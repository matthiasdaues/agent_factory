#!/usr/bin/env python3
"""remove-factory — reverse an init-factory install back to a clean tree.

What: Reads the removal manifest and undoes exactly what init-factory did,
      nothing more.
When: To uninstall Agent Factory from a project.
By:   run by hand — the companion to init-factory.

The companion to init-factory. Reads the removal manifest init-factory left at
`.agent-factory/factory-install.json` and undoes exactly what that run did,
nothing more:

  - git-ignored footprint (factory/, .claude/, .pi/, the specific .github/*
    entries, root AGENTS.md when init-factory created it, config/model.conf,
    session ephemera, .agent-factory/) — deleted outright.
    None of it was ever tracked, so `git status` is unaffected.
  - .gitignore — the single "agent_factory related" marker block is stripped
    (or the whole file removed, if init-factory created it).
  - .pre-commit-config.yaml — if init-factory created it, it's deleted; if
    init-factory only spliced into a file the project already had, just the
    `agent_factory_hook-*` `- repo: local` item is removed, leaving the
    project's own hooks untouched.
  - .claude/settings.json — if the project owned it, only Agent Factory's
    git-safety PreToolUse hook and usage-capture Stop/SubagentStop hook entries
    are removed; if init-factory created it, it went with .claude/.
  - .codex/hooks.json — if the project owned it, only Agent Factory's
    usage-capture Stop/SubagentStop entries are removed; a Factory-created file
    is deleted outright.
  - the pre-commit git hook is uninstalled only if init-factory was the one
    that `git init`-ed the repo.

NON-INTERFERENCE holds in reverse too: anything the manifest records as the
project's own (an existing orientation file, an existing pre-commit config, an
existing .gitignore, existing .github/workflows) is left exactly as it was.

Usage
  remove-factory                       # target = cwd
  remove-factory --target /path/to/project

Exit code: 0 on success (including a no-op when no manifest is present).
           1 only if the manifest exists but can't be read.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Optional

MANIFEST_PATH = ".agent-factory/factory-install.json"
HOOK_ID_PREFIX = "agent_factory_hook-"
CLAUDE_GUARDRAIL_HOOK_COMMAND = (
    '"$CLAUDE_PROJECT_DIR"/.claude/hooks/block-dangerous-git.sh'
)
CLAUDE_CAPTURE_HOOK_COMMAND = '"$CLAUDE_PROJECT_DIR"/.claude/hooks/capture-usage.sh'
CLAUDE_CAPTURE_HOOK_EVENTS = ("Stop", "SubagentStop")
CODEX_CAPTURE_HOOK_COMMAND = ".codex/hooks/capture-codex-usage.sh"
CODEX_CAPTURE_HOOK_EVENTS = ("Stop", "SubagentStop")
USAGE_CONTROL = Path(".agent-factory/usage-control")

REPOS_KEY = re.compile(r"^repos:\s*$")
TOP_LEVEL_KEY = re.compile(r"^\S")
REPO_ITEM_START = re.compile(r"^  - repo:\s*\S")
HOOK_ID_LINE = re.compile(r"^\s*- id:\s*(\S+)\s*$")


def log(line: str) -> None:
    print(f"remove-factory: {line}")


def strip_gitignore_block(target: Path, manifest: dict) -> None:
    path = target / ".gitignore"
    if not path.exists():
        return

    markers = manifest.get("gitignore_markers", {})
    begin = markers.get("begin", "# >>> agent_factory related >>>")
    end = markers.get("end", "# <<< agent_factory related <<<")

    text = path.read_text(encoding="utf-8")
    if begin not in text or end not in text:
        return

    pre, rest = text.split(begin, 1)
    _, post = rest.split(end, 1)
    # `pre` carries the blank-line separator init-factory inserted before the
    # block; drop it, rejoin, then restore the project's original trailing state.
    restored = (pre[:-1] if pre.endswith("\n") else pre) + post
    restored = restored.rstrip("\n")
    if restored and manifest.get("gitignore_orig_final_newline", True):
        restored += "\n"

    if restored.strip():
        path.write_text(restored, encoding="utf-8")
        log(".gitignore: stripped the agent_factory related block")
    else:
        path.unlink()
        log(".gitignore: removed (held only the agent_factory block)")


def strip_precommit_block(target: Path, manifest: dict) -> None:
    pc = manifest.get("precommit") or {}
    if not pc.get("existed"):
        return  # init-factory created it — deleted with the footprint instead

    path = target / pc.get("path", ".pre-commit-config.yaml")
    if not path.exists():
        return

    lines = path.read_text(encoding="utf-8").splitlines()

    repos_idx = next((i for i, ln in enumerate(lines) if REPOS_KEY.match(ln)), None)
    if repos_idx is None:
        return

    list_end = len(lines)
    for i in range(repos_idx + 1, len(lines)):
        if lines[i].strip() == "":
            continue
        if TOP_LEVEL_KEY.match(lines[i]):
            list_end = i
            break

    # Item boundaries within the repos list.
    starts = [
        i for i in range(repos_idx + 1, list_end) if REPO_ITEM_START.match(lines[i])
    ]
    bounds = []
    for n, s in enumerate(starts):
        e = starts[n + 1] if n + 1 < len(starts) else list_end
        bounds.append((s, e))

    drop: list[tuple[int, int]] = []
    for s, e in bounds:
        ids = [m.group(1) for m in (HOOK_ID_LINE.match(ln) for ln in lines[s:e]) if m]
        if ids and all(i.startswith(HOOK_ID_PREFIX) for i in ids):
            drop.append((s, e))

    if not drop:
        return

    keep = [
        ln for idx, ln in enumerate(lines) if not any(s <= idx < e for s, e in drop)
    ]
    # collapse any run of blank lines left behind to a single blank
    out: list[str] = []
    for ln in keep:
        if ln.strip() == "" and out and out[-1].strip() == "":
            continue
        out.append(ln)

    restored = "\n".join(out).rstrip("\n")
    if restored and manifest.get("precommit_orig_final_newline", True):
        restored += "\n"
    path.write_text(restored, encoding="utf-8")
    log(
        f"{path.name}: removed the agent_factory_hook-* block, kept the project's own hooks"
    )


def _strip_hook_command(hooks: dict, event: str, command: str) -> bool:
    entries = hooks.get(event)
    if not isinstance(entries, list):
        return False

    kept = []
    removed = False
    for entry in entries:
        if not isinstance(entry, dict):
            kept.append(entry)
            continue
        entry_hooks = entry.get("hooks")
        if not isinstance(entry_hooks, list):
            kept.append(entry)
            continue
        filtered_hooks = [
            hook
            for hook in entry_hooks
            if not (isinstance(hook, dict) and hook.get("command") == command)
        ]
        if len(filtered_hooks) == len(entry_hooks):
            kept.append(entry)
            continue
        removed = True
        if filtered_hooks:
            kept.append({**entry, "hooks": filtered_hooks})

    if not removed:
        return False

    if kept:
        hooks[event] = kept
    else:
        hooks.pop(event, None)
    return True


def strip_settings_hook(target: Path, manifest: dict) -> None:
    if not manifest.get("claude_settings_existed"):
        return  # init-factory created it — deleted with .claude/ instead

    path = target / ".claude" / "settings.json"
    if not path.exists():
        return

    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return

    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return

    removed_events: list[str] = []
    if _strip_hook_command(hooks, "PreToolUse", CLAUDE_GUARDRAIL_HOOK_COMMAND):
        removed_events.append("git-safety PreToolUse")

    for event in CLAUDE_CAPTURE_HOOK_EVENTS:
        if _strip_hook_command(hooks, event, CLAUDE_CAPTURE_HOOK_COMMAND):
            removed_events.append(f"usage-capture {event}")

    if not removed_events:
        return

    if not hooks:
        settings.pop("hooks", None)

    path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    log(".claude/settings.json: removed " + ", ".join(removed_events) + " hook entry")


def strip_codex_hooks(target: Path, manifest: dict) -> None:
    """Remove only Factory's entries from a project-owned Codex hook file."""
    if not manifest.get("codex_hooks_existed"):
        return

    path = target / ".codex/hooks.json"
    if not path.exists():
        return
    try:
        config = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return
    hooks = config.get("hooks") if isinstance(config, dict) else None
    if not isinstance(hooks, dict):
        return

    removed = [
        event
        for event in CODEX_CAPTURE_HOOK_EVENTS
        if _strip_hook_command(hooks, event, CODEX_CAPTURE_HOOK_COMMAND)
    ]
    if not removed:
        return
    if not hooks:
        config.pop("hooks", None)
    path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    log(".codex/hooks.json: removed usage-capture " + ", ".join(removed))


def uninstall_pre_commit(target: Path, manifest: dict) -> None:
    if not manifest.get("git_initialized_by_us"):
        return  # the repo (and any pre-existing hook) predates us — leave it
    result = subprocess.run(
        ["uvx", "pre-commit", "uninstall"], cwd=target, capture_output=True, text=True
    )
    if result.returncode == 0:
        log("uvx pre-commit uninstall: done")


def delete_paths(target: Path, manifest: dict) -> None:
    for rel in manifest.get("remove_paths", []):
        path = target / rel
        if path.is_symlink():
            path.unlink()
        elif path.is_dir():
            shutil.rmtree(path)
        elif path.exists():
            path.unlink()
        else:
            continue
        log(f"removed: {rel}")


def prune_empty_dirs(target: Path) -> None:
    # Directories init-factory may have added into but not owned wholesale.
    for rel in (
        ".github/hooks",
        ".codex/hooks",
        "config",
        ".github",
        ".claude",
        ".codex",
        ".pi",
    ):
        path = target / rel
        if path.is_dir() and not any(path.iterdir()):
            path.rmdir()
            log(f"removed empty dir: {rel}")


def _write_usage_state(control: Path, mode: str, generation: str) -> None:
    temp = control / f"state-{uuid.uuid4()}.tmp"
    temp.write_text(
        json.dumps({"mode": mode, "generation": generation}) + "\n",
        encoding="utf-8",
    )
    temp.chmod(0o600)
    os.replace(temp, control / "state.json")
    (control / "state.json").chmod(0o600)


def _pending_markers(control: Path) -> list[Path]:
    pending = control / "pending"
    return list(pending.iterdir()) if pending.is_dir() else []


def _cancel_pending(target: Path, control: Path) -> int:
    """Cancel only pending registrations; committing workers must drain."""
    scratch = target / ".agent-factory/usage/.capture"
    safe_scratch = not scratch.is_symlink() and scratch.resolve() == scratch
    cancelled = 0
    for marker in _pending_markers(control):
        if not marker.name.endswith(".pending.json") or marker.is_symlink():
            continue
        try:
            data = json.loads(marker.read_text(encoding="utf-8"))
            staged = Path(data.get("staged_source", ""))
            if (
                staged.is_absolute()
                and not staged.is_symlink()
                and safe_scratch
                and staged.parent == scratch
                and staged.is_file()
            ):
                staged.unlink()
            marker.unlink()
            cancelled += 1
        except (OSError, json.JSONDecodeError, TypeError):
            # The marker itself is Factory-owned; never follow malformed data.
            try:
                marker.unlink()
                cancelled += 1
            except OSError:
                pass
    return cancelled


def prepare_usage_removal(
    target: Path, disposition: str, timeout: float
) -> tuple[bool, Optional[Path]]:
    """Fence Pi persistence, then drain or explicitly cancel registrations."""
    control = target / USAGE_CONTROL
    state_path = control / "state.json"
    if not state_path.is_file():
        return True, None
    owner = control / "remove-owner"
    try:
        with owner.open("x", encoding="utf-8") as handle:
            handle.write(str(os.getpid()))
        owner.chmod(0o600)
    except FileExistsError:
        print("remove-factory: usage removal already in progress", file=sys.stderr)
        return False, None
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
        generation = state["generation"]
        _write_usage_state(control, disposition, generation)
        cancelled = _cancel_pending(target, control) if disposition == "cancel" else 0
        deadline = time.monotonic() + timeout
        while _pending_markers(control):
            if time.monotonic() >= deadline:
                _write_usage_state(control, "active", generation)
                owner.unlink(missing_ok=True)
                print(
                    "remove-factory: pending Pi usage did not settle before timeout; "
                    "installation left active",
                    file=sys.stderr,
                )
                return False, None
            time.sleep(0.05)
        if cancelled:
            log(f"cancelled {cancelled} pending Pi usage capture(s)")
        return True, owner
    except (OSError, KeyError, json.JSONDecodeError) as exc:
        owner.unlink(missing_ok=True)
        print(f"remove-factory: invalid usage lifecycle state: {exc}", file=sys.stderr)
        return False, None


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--target", type=Path, default=Path("."))
    ap.add_argument("--pending-usage", choices=("drain", "cancel"), default="drain")
    ap.add_argument("--pending-timeout", type=float, default=5.0)
    args = ap.parse_args(argv)

    target = args.target.resolve()
    manifest_path = target / MANIFEST_PATH

    if not manifest_path.exists():
        print(
            f"remove-factory: no manifest at {MANIFEST_PATH} — nothing to remove "
            f"(is {target} an init-factory'd project?)"
        )
        return 0

    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as e:
        print(f"remove-factory: can't read {MANIFEST_PATH}: {e}", file=sys.stderr)
        return 1

    ready, _owner = prepare_usage_removal(
        target, args.pending_usage, max(0.0, args.pending_timeout)
    )
    if not ready:
        return 1

    # Undo the tracked-file edits first (while the config still exists), then
    # delete the ignored footprint, then the manifest's own directory last.
    strip_gitignore_block(target, manifest)
    strip_precommit_block(target, manifest)
    strip_settings_hook(target, manifest)
    strip_codex_hooks(target, manifest)
    uninstall_pre_commit(target, manifest)
    delete_paths(target, manifest)

    agent_factory_dir = target / ".agent-factory"
    if agent_factory_dir.is_dir():
        shutil.rmtree(agent_factory_dir)
        log("removed: .agent-factory/")

    prune_empty_dirs(target)

    print(f"remove-factory: done, Agent Factory removed from {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
