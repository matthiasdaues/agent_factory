#!/usr/bin/env python3
"""remove-factory — reverse an init-factory install back to a clean tree.

The companion to init-factory. Reads the removal manifest init-factory left at
`.agent-factory/factory-install.json` and undoes exactly what that run did,
nothing more:

  - git-ignored footprint (factory/, .claude/, the specific .github/* entries,
    config/model.conf, session ephemera, .agent-factory/) — deleted outright.
    None of it was ever tracked, so `git status` is unaffected.
  - .gitignore — the single "agent_factory related" marker block is stripped
    (or the whole file removed, if init-factory created it).
  - .pre-commit-config.yaml — if init-factory created it, it's deleted; if
    init-factory only spliced into a file the project already had, just the
    `agent_factory_hook-*` `- repo: local` item is removed, leaving the
    project's own hooks untouched.
  - .claude/settings.json — if the project owned it, only the git-safety
    PreToolUse hook entry is removed; if init-factory created it, it went with
    .claude/.
  - the pre-commit git hook is uninstalled only if init-factory was the one
    that `git init`-ed the repo.

NON-INTERFERENCE holds in reverse too: anything the manifest records as the
project's own (an existing orientation file, an existing pre-commit config, an
existing .gitignore, existing .github/workflows) is left exactly as it was.

Usage
  remove-factory                       # target = cwd
  remove-factory --target /path/to/project

Exit code: 0 on success (including a no-op when no manifest is present).
           1 only if the manifest exists but can't be read.
"""

from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

MANIFEST_PATH = ".agent-factory/factory-install.json"
HOOK_ID_PREFIX = "agent_factory_hook-"

REPOS_KEY = re.compile(r"^repos:\s*$")
TOP_LEVEL_KEY = re.compile(r"^\S")
REPO_ITEM_START = re.compile(r"^  - repo:\s*\S")
HOOK_ID_LINE = re.compile(r"^\s*- id:\s*(\S+)\s*$")


def log(line: str) -> None:
    print(f"remove-factory: {line}")


def strip_gitignore_block(target: Path, manifest: dict) -> None:
    path = target / ".gitignore"
    if not path.exists():
        return

    markers = manifest.get("gitignore_markers", {})
    begin = markers.get("begin", "# >>> agent_factory related >>>")
    end = markers.get("end", "# <<< agent_factory related <<<")

    text = path.read_text(encoding="utf-8")
    if begin not in text or end not in text:
        return

    pre, rest = text.split(begin, 1)
    _, post = rest.split(end, 1)
    # `pre` carries the blank-line separator init-factory inserted before the
    # block; drop it, rejoin, then restore the project's original trailing state.
    restored = (pre[:-1] if pre.endswith("\n") else pre) + post
    restored = restored.rstrip("\n")
    if restored and manifest.get("gitignore_orig_final_newline", True):
        restored += "\n"

    if restored.strip():
        path.write_text(restored, encoding="utf-8")
        log(".gitignore: stripped the agent_factory related block")
    else:
        path.unlink()
        log(".gitignore: removed (held only the agent_factory block)")


def strip_precommit_block(target: Path, manifest: dict) -> None:
    pc = manifest.get("precommit") or {}
    if not pc.get("existed"):
        return  # init-factory created it — deleted with the footprint instead

    path = target / pc.get("path", ".pre-commit-config.yaml")
    if not path.exists():
        return

    lines = path.read_text(encoding="utf-8").splitlines()

    repos_idx = next((i for i, ln in enumerate(lines) if REPOS_KEY.match(ln)), None)
    if repos_idx is None:
        return

    list_end = len(lines)
    for i in range(repos_idx + 1, len(lines)):
        if lines[i].strip() == "":
            continue
        if TOP_LEVEL_KEY.match(lines[i]):
            list_end = i
            break

    # Item boundaries within the repos list.
    starts = [
        i for i in range(repos_idx + 1, list_end) if REPO_ITEM_START.match(lines[i])
    ]
    bounds = []
    for n, s in enumerate(starts):
        e = starts[n + 1] if n + 1 < len(starts) else list_end
        bounds.append((s, e))

    drop: list[tuple[int, int]] = []
    for s, e in bounds:
        ids = [m.group(1) for m in (HOOK_ID_LINE.match(ln) for ln in lines[s:e]) if m]
        if ids and all(i.startswith(HOOK_ID_PREFIX) for i in ids):
            drop.append((s, e))

    if not drop:
        return

    keep = [
        ln for idx, ln in enumerate(lines) if not any(s <= idx < e for s, e in drop)
    ]
    # collapse any run of blank lines left behind to a single blank
    out: list[str] = []
    for ln in keep:
        if ln.strip() == "" and out and out[-1].strip() == "":
            continue
        out.append(ln)

    restored = "\n".join(out).rstrip("\n")
    if restored and manifest.get("precommit_orig_final_newline", True):
        restored += "\n"
    path.write_text(restored, encoding="utf-8")
    log(
        f"{path.name}: removed the agent_factory_hook-* block, kept the project's own hooks"
    )


def strip_settings_hook(target: Path, manifest: dict) -> None:
    if not manifest.get("claude_settings_existed"):
        return  # init-factory created it — deleted with .claude/ instead

    path = target / ".claude" / "settings.json"
    if not path.exists():
        return

    guardrail = '"$CLAUDE_PROJECT_DIR"/.claude/hooks/block-dangerous-git.sh'
    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return

    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return
    pre = hooks.get("PreToolUse")
    if not isinstance(pre, list):
        return

    kept = []
    for entry in pre:
        entry_hooks = entry.get("hooks", []) if isinstance(entry, dict) else []
        if any(
            isinstance(h, dict) and h.get("command") == guardrail for h in entry_hooks
        ):
            continue
        kept.append(entry)

    if len(kept) == len(pre):
        return

    if kept:
        hooks["PreToolUse"] = kept
    else:
        hooks.pop("PreToolUse", None)
        if not hooks:
            settings.pop("hooks", None)

    path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    log(".claude/settings.json: removed the git-safety guardrail hook entry")


def uninstall_pre_commit(target: Path, manifest: dict) -> None:
    if not manifest.get("git_initialized_by_us"):
        return  # the repo (and any pre-existing hook) predates us — leave it
    result = subprocess.run(
        ["uvx", "pre-commit", "uninstall"], cwd=target, capture_output=True, text=True
    )
    if result.returncode == 0:
        log("uvx pre-commit uninstall: done")


def delete_paths(target: Path, manifest: dict) -> None:
    for rel in manifest.get("remove_paths", []):
        path = target / rel
        if path.is_symlink():
            path.unlink()
        elif path.is_dir():
            shutil.rmtree(path)
        elif path.exists():
            path.unlink()
        else:
            continue
        log(f"removed: {rel}")


def prune_empty_dirs(target: Path) -> None:
    # Directories init-factory may have added into but not owned wholesale.
    for rel in (".github/hooks", "config", ".github", ".claude"):
        path = target / rel
        if path.is_dir() and not any(path.iterdir()):
            path.rmdir()
            log(f"removed empty dir: {rel}")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--target", type=Path, default=Path("."))
    args = ap.parse_args(argv)

    target = args.target.resolve()
    manifest_path = target / MANIFEST_PATH

    if not manifest_path.exists():
        print(
            f"remove-factory: no manifest at {MANIFEST_PATH} — nothing to remove "
            f"(is {target} an init-factory'd project?)"
        )
        return 0

    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as e:
        print(f"remove-factory: can't read {MANIFEST_PATH}: {e}", file=sys.stderr)
        return 1

    # Undo the tracked-file edits first (while the config still exists), then
    # delete the ignored footprint, then the manifest's own directory last.
    strip_gitignore_block(target, manifest)
    strip_precommit_block(target, manifest)
    strip_settings_hook(target, manifest)
    uninstall_pre_commit(target, manifest)
    delete_paths(target, manifest)

    agent_factory_dir = target / ".agent-factory"
    if agent_factory_dir.is_dir():
        shutil.rmtree(agent_factory_dir)
        log("removed: .agent-factory/")

    prune_empty_dirs(target)

    print(f"remove-factory: done, Agent Factory removed from {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
