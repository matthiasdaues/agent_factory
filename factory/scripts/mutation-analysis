#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["mutmut"]
# ///
"""mutation-analysis — deterministic mutation gate backed by mutmut.

What: Runs mutation testing for Python production files, writes a JSON report,
      and blocks unresolved surviving mutants.
When: On demand or as a pre-merge gate after a story commit.
By:   the implementation-agent dispatcher and quality gate workflows.

Usage:
  mutation-analysis [--project-dir DIR] [--story-id ST-NNNN]
                    [--diff-base REF] [--resolutions PATH] [PATH ...]

Exit codes:
  0: all mutants killed or explicitly resolved
  1: one or more mutants survived without a resolution action
  2: configuration, git, or mutation-run failure
"""

from __future__ import annotations

import argparse
import ast
import json
import os
import re
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from dataclasses import asdict, dataclass
from difflib import SequenceMatcher
from fnmatch import fnmatch
from pathlib import Path
from typing import Iterator


TEST_FILE_PATTERNS = (
    "test_*.py",
    "*_test.py",
    "*_test.go",
    "*.test.ts",
    "*.test.js",
    "*.spec.ts",
    "*.spec.js",
)
SURVIVOR_ACTIONS = {"remove-dead-code", "add-missing-test", "file-qa-finding"}
TOKEN_RE = re.compile(
    r"==|!=|<=|>=|//=|\*\*=|\+=|-=|\*=|/=|%=|//=|\*\*|//|:=|<<|>>|"
    r"[-+*/%<>&^|~]=?|[A-Za-z_][A-Za-z0-9_]*|\d+|\S"
)
HUNK_RE = re.compile(r"^@@ -(?P<old>\d+)(?:,\d+)? \+(?P<new>\d+)(?:,\d+)? @@")
STORY_RE = re.compile(r"(ST-\d{4,})")


@dataclass
class MutationReportEntry:
    """Canonical JSON report entry for one mutant."""

    mutant: str
    operator: str
    location: str
    status: str
    resolution_action: str
    raw_status: str


class MutationAnalysisError(RuntimeError):
    """Raised when the wrapper cannot produce a trustworthy gate result."""


def main(argv: list[str] | None = None) -> int:
    """Run the mutation-analysis gate from the current repository."""
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "paths", nargs="*", help="Production file paths relative to --project-dir"
    )
    parser.add_argument(
        "--project-dir",
        default=".",
        help="Project directory containing the source and tests to mutate",
    )
    parser.add_argument("--story-id", help="Explicit story id for the report filename")
    parser.add_argument(
        "--diff-base", help="Git ref used to scope production files from the story diff"
    )
    parser.add_argument(
        "--resolutions",
        help="JSON object mapping mutant ids or path:line locations to survivor actions",
    )
    args = parser.parse_args(argv)

    try:
        repo_root = git_repo_root()
        project_dir = resolve_project_dir(repo_root, args.project_dir)
        story_id = args.story_id or infer_story_id(repo_root)
        changed_paths = select_production_paths(
            repo_root, project_dir, args.paths, args.diff_base
        )
        python_paths = [path for path in changed_paths if path.suffix == ".py"]
        resolutions = load_resolutions(repo_root, args.resolutions)
        report = run_mutation_analysis(repo_root, project_dir, python_paths, resolutions)
        report_path = write_report(repo_root, story_id, report)
        unresolved = count_unresolved_survivors(report)
        print(f"mutation-analysis: wrote {len(report)} mutant result(s) to {report_path}")
        print(f"mutation-analysis: {unresolved} unresolved survivor(s)")
        return 1 if unresolved else 0
    except MutationAnalysisError as error:
        print(f"mutation-analysis: {error}", file=sys.stderr)
        return 2


def git_repo_root() -> Path:
    """Return the repository root for the current working directory."""
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise MutationAnalysisError(result.stderr.strip() or "not inside a git repository")
    return Path(result.stdout.strip()).resolve()


def resolve_project_dir(repo_root: Path, raw_project_dir: str) -> Path:
    """Resolve and validate the selected project directory."""
    project_dir = (repo_root / raw_project_dir).resolve()
    try:
        project_dir.relative_to(repo_root)
    except ValueError as exc:
        raise MutationAnalysisError("--project-dir must stay inside the repository") from exc
    if not project_dir.exists() or not project_dir.is_dir():
        raise MutationAnalysisError(f"project directory does not exist: {raw_project_dir}")
    return project_dir


def infer_story_id(repo_root: Path) -> str:
    """Infer the story id from the current Git branch name."""
    result = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=repo_root,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise MutationAnalysisError(result.stderr.strip() or "failed to read current branch")
    match = STORY_RE.search(result.stdout.strip())
    if not match:
        raise MutationAnalysisError(
            "could not infer story id from the current branch; pass --story-id"
        )
    return match.group(1)


def select_production_paths(
    repo_root: Path,
    project_dir: Path,
    explicit_paths: list[str],
    diff_base: str | None,
) -> list[Path]:
    """Choose mutation targets from diff scope, explicit inputs, or full-module fallback."""
    if diff_base:
        repo_paths = diff_scoped_paths(repo_root, diff_base)
        project_paths = [
            Path(path.relative_to(project_dir))
            for path in repo_paths
            if is_relative_to(path, project_dir)
            and not is_test_file(path.relative_to(project_dir))
        ]
        return dedupe_paths(project_paths)
    if explicit_paths:
        return dedupe_paths(
            [Path(path) for path in explicit_paths if not is_test_file(Path(path))]
        )
    if (project_dir / "src").exists():
        return [Path("src")]
    return dedupe_paths(
        [
            path.relative_to(project_dir)
            for path in project_dir.rglob("*.py")
            if not is_test_file(path.relative_to(project_dir))
        ]
    )


def diff_scoped_paths(repo_root: Path, diff_base: str) -> list[Path]:
    """Return changed paths from the requested git diff scope."""
    result = subprocess.run(
        ["git", "diff", "--name-only", "--diff-filter=ACMR", diff_base, "HEAD"],
        cwd=repo_root,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise MutationAnalysisError(result.stderr.strip() or f"git diff failed for {diff_base}")
    paths: list[Path] = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        rel_path = (repo_root / line.strip()).resolve()
        if rel_path.exists():
            paths.append(rel_path)
    return paths


def dedupe_paths(paths: list[Path]) -> list[Path]:
    """Keep path order stable while removing duplicates."""
    seen: set[str] = set()
    ordered: list[Path] = []
    for path in paths:
        key = path.as_posix()
        if key in seen:
            continue
        seen.add(key)
        ordered.append(path)
    return ordered


def is_test_file(path: Path) -> bool:
    """Return True when *path* matches the gate's test-file exclusions."""
    if "tests" in path.parts or "__tests__" in path.parts:
        return True
    return any(fnmatch(path.name, pattern) for pattern in TEST_FILE_PATTERNS)


def is_relative_to(path: Path, parent: Path) -> bool:
    """Compatibility wrapper for Path.is_relative_to on Python 3.10."""
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def load_resolutions(repo_root: Path, raw_path: str | None) -> dict[str, str]:
    """Load and validate an optional survivor-resolution mapping."""
    if not raw_path:
        return {}
    path = (
        Path(raw_path).resolve()
        if os.path.isabs(raw_path)
        else (repo_root / raw_path).resolve()
    )
    if not path.exists():
        raise MutationAnalysisError(f"resolutions file does not exist: {raw_path}")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise MutationAnalysisError(f"invalid resolutions JSON: {raw_path}") from exc
    if not isinstance(payload, dict):
        raise MutationAnalysisError("resolutions JSON must be an object of key -> action")
    cleaned: dict[str, str] = {}
    for key, value in payload.items():
        if not isinstance(key, str) or not isinstance(value, str):
            raise MutationAnalysisError("resolution keys and values must be strings")
        if value not in SURVIVOR_ACTIONS:
            allowed = ", ".join(sorted(SURVIVOR_ACTIONS))
            raise MutationAnalysisError(
                f"unsupported resolution action {value!r}; expected one of {allowed}"
            )
        cleaned[key] = value
    return cleaned


def run_mutation_analysis(
    repo_root: Path,
    project_dir: Path,
    python_paths: list[Path],
    resolutions: dict[str, str],
) -> list[MutationReportEntry]:
    """Execute mutmut in an isolated workspace and translate the results."""
    if not python_paths:
        return []
    workspace_root = repo_root / ".current-work" / "mutation-analysis" / "workspaces"
    workspace_root.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=workspace_root, prefix="run-") as temp_dir:
        workspace = Path(temp_dir)
        prepare_workspace(project_dir, workspace)
        write_mutmut_config(workspace, python_paths)
        execute_mutmut(workspace)
        return collect_report_entries(workspace, resolutions)


def prepare_workspace(project_dir: Path, workspace: Path) -> None:
    """Create a lightweight workspace that mirrors the selected project."""
    for entry in project_dir.iterdir():
        if entry.name in {".git", ".venv", ".pytest_cache", ".ruff_cache", "mutants"}:
            continue
        os.symlink(entry, workspace / entry.name, target_is_directory=entry.is_dir())


def write_mutmut_config(workspace: Path, python_paths: list[Path]) -> None:
    """Write a minimal mutmut setup.cfg for the isolated workspace."""
    test_selection = [
        candidate + "/" for candidate in ("tests", "test") if (workspace / candidate).exists()
    ]
    lines = ["[mutmut]", "source_paths ="]
    lines.extend(f"    {path.as_posix()}" for path in python_paths)
    if test_selection:
        lines.append("pytest_add_cli_args_test_selection =")
        lines.extend(f"    {path}" for path in test_selection)
    lines.append("use_setproctitle = false")
    lines.append("")
    (workspace / "setup.cfg").write_text("\n".join(lines), encoding="utf-8")


def execute_mutmut(workspace: Path) -> None:
    """Run mutmut and raise if the mutation engine itself fails."""
    mutmut_executable = Path(sys.executable).with_name("mutmut")
    command = (
        [str(mutmut_executable), "run"]
        if mutmut_executable.exists()
        else [sys.executable, "-m", "mutmut", "run"]
    )
    result = subprocess.run(
        command,
        cwd=workspace,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise MutationAnalysisError(
            "mutmut run failed\n"
            f"STDOUT:\n{result.stdout.strip()}\n\n"
            f"STDERR:\n{result.stderr.strip()}".rstrip()
        )


def collect_report_entries(
    workspace: Path, resolutions: dict[str, str]
) -> list[MutationReportEntry]:
    """Translate mutmut results into the Factory report format."""
    with temporary_cwd(workspace):
        from mutmut.__main__ import collect_source_file_mutation_data
        from mutmut.configuration import Config
        from mutmut.state import reset_state

        Config.reset()
        reset_state()
        mutants, _ = collect_source_file_mutation_data(mutant_names=[])
        entries = [
            entry_from_mutant(mutant_name, result, resolutions)
            for _, mutant_name, result in mutants
        ]
        Config.reset()
        reset_state()
    return entries


@contextmanager
def temporary_cwd(path: Path) -> Iterator[None]:
    """Temporarily switch the process working directory."""
    current = Path.cwd()
    os.chdir(path)
    try:
        yield
    finally:
        os.chdir(current)


def entry_from_mutant(
    mutant_name: str, exit_code: int | None, resolutions: dict[str, str]
) -> MutationReportEntry:
    """Build one report entry from a mutmut result."""
    from mutmut.__main__ import find_mutant, get_diff_for_mutant
    from mutmut.__main__ import status_by_exit_code as mutmut_status_by_exit_code

    raw_status = mutmut_status_by_exit_code[exit_code]
    source_path = Path(find_mutant(mutant_name).path)
    diff = get_diff_for_mutant(mutant_name)
    relative_line, before, after = parse_mutation_change(diff)
    location = f"{source_path.as_posix()}:{resolve_source_line(source_path, mutant_name, relative_line)}"
    operator = classify_operator(before, after)
    status = "killed" if raw_status == "killed" else "survived"
    resolution_action = resolve_action(mutant_name, location, status, resolutions)
    return MutationReportEntry(
        mutant=mutant_name,
        operator=operator,
        location=location,
        status=status,
        resolution_action=resolution_action,
        raw_status=raw_status,
    )


def parse_mutation_change(diff: str) -> tuple[int, str, str]:
    """Extract the first changed line number within the mutated function diff."""
    old_line = 0
    new_line = 0
    pending_before: tuple[int, str] | None = None
    for line in diff.splitlines():
        hunk = HUNK_RE.match(line)
        if hunk:
            old_line = int(hunk.group("old"))
            new_line = int(hunk.group("new"))
            pending_before = None
            continue
        if line.startswith(" "):
            old_line += 1
            new_line += 1
            pending_before = None
            continue
        if line.startswith("-"):
            pending_before = (old_line, line[1:].rstrip())
            old_line += 1
            continue
        if line.startswith("+"):
            if pending_before is not None:
                return pending_before[0], pending_before[1], line[1:].rstrip()
            new_line += 1
    raise MutationAnalysisError("failed to parse mutant diff into operator and location")


def parse_mutant_target(mutant_name: str) -> tuple[str | None, str]:
    """Return (class_name, function_name) for a mutmut identifier."""
    symbol = mutant_name.rsplit(".", 1)[-1]
    base = symbol.split("__mutmut_", 1)[0]
    if base.startswith("x_"):
        return None, base[2:]
    if base.startswith("xǁ"):
        _, class_name, function_name = base.split("ǁ", 2)
        return class_name, function_name
    raise MutationAnalysisError(f"unsupported mutant identifier format: {mutant_name}")


def resolve_source_line(source_path: Path, mutant_name: str, relative_line: int) -> int:
    """Map a function-local diff line back to the original source file line."""
    class_name, function_name = parse_mutant_target(mutant_name)
    tree = ast.parse(source_path.read_text(encoding="utf-8"))
    function_line = function_definition_line(tree, class_name, function_name)
    if function_line is None:
        raise MutationAnalysisError(
            f"could not map mutant to a source definition line: {mutant_name}"
        )
    return function_line + relative_line - 1


def function_definition_line(
    tree: ast.AST, class_name: str | None, function_name: str
) -> int | None:
    """Find the source line where the mutated function or method is defined."""
    if class_name is None:
        for node in tree.body:  # type: ignore[attr-defined]
            if isinstance(node, ast.FunctionDef) and node.name == function_name:
                return node.lineno
        return None

    for node in tree.body:  # type: ignore[attr-defined]
        if not isinstance(node, ast.ClassDef) or node.name != class_name:
            continue
        for child in node.body:
            if isinstance(child, ast.FunctionDef) and child.name == function_name:
                return child.lineno
    return None


def classify_operator(before: str, after: str) -> str:
    """Summarise the changed token sequence for reporting."""
    before_tokens = TOKEN_RE.findall(before)
    after_tokens = TOKEN_RE.findall(after)
    matcher = SequenceMatcher(a=before_tokens, b=after_tokens)
    removed: list[str] = []
    added: list[str] = []
    for tag, a_start, a_end, b_start, b_end in matcher.get_opcodes():
        if tag == "equal":
            continue
        removed.extend(before_tokens[a_start:a_end])
        added.extend(after_tokens[b_start:b_end])
    left = " ".join(removed) or "∅"
    right = " ".join(added) or "∅"
    return f"{left} -> {right}"


def resolve_action(
    mutant_name: str,
    location: str,
    status: str,
    resolutions: dict[str, str],
) -> str:
    """Map a mutant result to the required survivor resolution action."""
    if status == "killed":
        return "none-required"
    if mutant_name in resolutions:
        return resolutions[mutant_name]
    if location in resolutions:
        return resolutions[location]
    return "unresolved"


def write_report(repo_root: Path, story_id: str, report: list[MutationReportEntry]) -> Path:
    """Persist the canonical mutation-analysis JSON report."""
    report_dir = repo_root / ".current-work" / "mutation-analysis"
    report_dir.mkdir(parents=True, exist_ok=True)
    report_path = report_dir / f"{story_id}.json"
    payload = [asdict(entry) for entry in report]
    report_path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    return report_path


def count_unresolved_survivors(report: list[MutationReportEntry]) -> int:
    """Count survivors that still block merge."""
    return sum(
        1
        for entry in report
        if entry.status == "survived" and entry.resolution_action == "unresolved"
    )


if __name__ == "__main__":
    raise SystemExit(main())
