#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
"""matrix-lint — deterministic consistency gate for model.conf.

What: Validates config/model.conf — every [facts] row a well-formed
      <cli>.<tier> = <model-id>, and on_missing (if set) halt|auto.
When: On commit when model.conf changes; on demand via /validate.
By:   pre-commit hook `matrix-lint`; its parse_matrix() is reused by
      resolve-model and openrouter-discover.

Validates the per-CLI tier router (ADR-0020, ADR-0021, VR-024): every
`[facts]` entry is a well-formed `<cli>.<tier> = <model-id>` mapping, and
`on_missing` (if set) is `halt` or `auto`. No policy layer to cross-check —
a tier is either configured for a CLI or it isn't.

No third-party dependencies (Python 3.8+ stdlib only, ADR-0006).

Usage
  matrix-lint --matrix config/model.conf
  matrix-lint --matrix config/model.conf --format json --report-only

Exit code: number of ERROR-severity findings (0 = clean), unless --report-only.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SEVERITY_ORDER = {"error": 3, "warning": 2, "info": 1}

VALID_TIERS = {"economy", "standard", "strong"}
VALID_ON_MISSING = {"halt", "auto"}


@dataclass
class Finding:
    code: str
    severity: str
    artifact: str
    message: str

    def line(self) -> str:
        return (
            f"[{self.severity.upper():7}] {self.code}  {self.artifact}: {self.message}"
        )


# --- Parser -------------------------------------------------------------------


def parse_matrix(text: str) -> Tuple[Optional[str], Dict[str, str]]:
    """Parse the INI-like model.conf.

    Returns (error_message | None, facts_dict). Keys: ``cli.tier`` ->
    model-id, plus the bare ``on_missing`` key.
    """
    facts: Dict[str, str] = {}
    current: Optional[Dict[str, str]] = None

    for lineno, raw in enumerate(text.splitlines(), start=1):
        ln = raw.strip()
        if not ln or ln.startswith("#"):
            continue

        # Section header
        m = re.match(r"^\[(\w+)]$", ln)
        if m:
            section_name = m.group(1).lower()
            if section_name == "facts":
                current = facts
            else:
                return f"line {lineno}: unknown section [{m.group(1)}]", facts
            continue

        if current is None:
            return f"line {lineno}: content outside a section", facts

        # Key = value
        kv = re.match(r"^([\w._-]+)\s*=\s*(.+)$", ln)
        if not kv:
            return f"line {lineno}: malformed entry: {ln!r}", facts
        current[kv.group(1).strip()] = kv.group(2).strip()

    if not facts:
        return "file contains no [facts] section", facts

    return None, facts


# --- Checks -------------------------------------------------------------------


def check_matrix(matrix_path: Path) -> List[Finding]:
    rel = matrix_path.name
    findings: List[Finding] = []

    if not matrix_path.exists():
        findings.append(
            Finding(
                "MX-MISSING",
                "error",
                str(matrix_path),
                "model.conf does not exist",
            )
        )
        return findings

    text = matrix_path.read_text(encoding="utf-8")
    err, facts = parse_matrix(text)

    if err:
        findings.append(Finding("MX-PARSE", "error", rel, f"parse error: {err}"))
        return findings

    on_missing = facts.get("on_missing")
    if on_missing is not None and on_missing not in VALID_ON_MISSING:
        findings.append(
            Finding(
                "MX-ENUM",
                "error",
                rel,
                f"on_missing '{on_missing}' not in {{halt, auto}}",
            )
        )
    elif on_missing is None:
        findings.append(
            Finding(
                "MX-DEFAULT",
                "info",
                rel,
                "on_missing not set; defaults to 'halt' (FR-K4)",
            )
        )

    # --- Extract CLIs and their tier mappings from facts ---
    cli_tiers: Dict[str, Dict[str, str]] = {}  # cli -> {tier -> model}
    for key, val in facts.items():
        if key == "on_missing":
            continue
        parts = key.split(".", 1)
        if len(parts) != 2:
            findings.append(
                Finding(
                    "MX-KEY",
                    "error",
                    rel,
                    f"facts key '{key}' not in <cli>.<tier> format",
                )
            )
            continue
        cli, tier = parts
        if tier not in VALID_TIERS:
            findings.append(
                Finding(
                    "MX-TIER",
                    "error",
                    rel,
                    f"facts key '{key}': tier '{tier}' not in {{economy, standard, strong}}",
                )
            )
            continue
        cli_tiers.setdefault(cli, {})[tier] = val

    if not cli_tiers:
        findings.append(
            Finding("MX-EMPTY", "error", rel, "no CLIs configured in [facts]")
        )

    # --- Coverage: a CLI missing a tier halts any resolution needing it ---
    for cli in sorted(cli_tiers):
        missing = VALID_TIERS - set(cli_tiers[cli])
        for tier in sorted(missing):
            findings.append(
                Finding(
                    "MX-COVERAGE",
                    "warning",
                    rel,
                    f"CLI '{cli}' has no model for tier '{tier}' — "
                    f"resolving it will use on_missing",
                )
            )

    findings.sort(key=lambda f: (-SEVERITY_ORDER[f.severity], f.code, f.artifact))
    return findings


# --- Driver -------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        description="Deterministic consistency gate for model.conf."
    )
    p.add_argument(
        "--matrix",
        default="model.conf",
        type=Path,
        help="path to model.conf",
    )
    p.add_argument("--format", choices=["text", "json"], default="text", dest="fmt")
    p.add_argument(
        "--report-only",
        action="store_true",
        help="always exit 0 (report without gating)",
    )
    args = p.parse_args(argv)

    findings = check_matrix(args.matrix)
    counts = {s: sum(1 for f in findings if f.severity == s) for s in SEVERITY_ORDER}

    if args.fmt == "json":
        print(
            json.dumps(
                {
                    "findings": [asdict(f) for f in findings],
                    "summary": counts,
                },
                indent=2,
            )
        )
    else:
        for f in findings:
            print(f.line())
        print(
            f"\nmatrix-lint: {counts['error']} error(s), "
            f"{counts['warning']} warning(s), {counts['info']} info."
        )

    return 0 if args.report_only else counts["error"]


if __name__ == "__main__":
    sys.exit(main())
