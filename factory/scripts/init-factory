def _install_codex_step_guard(target: Path, install: dict, report: list[str]) -> None:
    """Merge Factory's Codex step-guard hooks into project hook config."""
    hooks_dir = _ensure_codex_hooks_dir(target, install, report)
    install["codex_ignored_entries"].add(".codex/hooks/step-guard.sh")

    ensure_symlink(
        hooks_dir / "step-guard.sh",
        target / "factory" / "config" / "hooks" / "step-guard.sh",
        report,
        install=install,
    )

    path, config, hooks, existed = _load_codex_hooks(target, install)
    entries = hooks.setdefault("PreToolUse", [])
    if not isinstance(entries, list):
        raise Collision(f"{path}: 'hooks.PreToolUse' exists but isn't a list")

    changed = False
    for event, command in CODEX_STEP_GUARD_HOOK_COMMANDS.items():
        already_wired = any(
            isinstance(entry, dict)
            and entry.get("matcher") == event
            and any(
                isinstance(hook, dict) and hook.get("command") == command
                for hook in (entry.get("hooks", []) if isinstance(entry, dict) else [])
            )
            for entry in entries
        )
        if already_wired:
            continue
        entries.append(
            {
                "matcher": event,
                "hooks": [{"type": "command", "command": command}],
            }
        )
        _record_codex_handler(
            install,
            {"event": "PreToolUse", "matcher": event, "command": command},
        )
        changed = True

    if changed or not existed:
        path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        log(report, ".codex/hooks.json: wired step-guard PreToolUse entries")


