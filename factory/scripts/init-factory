#!/usr/bin/env python3
"""init-factory — idempotent, *tracelessly removable* setup: wire Agent Factory
into a target project without interfering with what's already there.

Works identically whether `--target` is a brand-new empty directory or an
existing repo with its own history, docs, CI workflows, and hooks. Two
promises govern every step:

  1. NON-INTERFERENCE. init-factory never overwrites, reformats, or shadows a
     file the project already owns. An existing orientation file, an existing
     pre-commit config, existing .github/workflows — all are left exactly as
     they were. Where Agent Factory needs to add something, it adds it beside
     the project's own content, never on top of it.

  2. TRACELESS REMOVAL. Everything Agent Factory drops into the target is
     either (a) git-ignored under a single, marker-delimited "agent_factory
     related" block, so it never enters the project's tracked history at all,
     or (b) — for the one file that must be tracked, the pre-commit config —
     added as hooks whose ids are prefixed `agent_factory_hook-`, extricable
     by that prefix. A companion script, `factory/scripts/remove-factory`,
     reverses the whole install back to a clean `git status`. init-factory
     records exactly what it did in `.agent-factory/factory-install.json` so
     the remover can be exact.

Why .github can't just be git-ignored wholesale: the target's own GitHub
Actions live in `.github/workflows/`. Ignoring all of `.github` would hide
that CI infrastructure from git. So init-factory ignores only the specific
entries it adds under `.github/` (the CLI symlinks, the hooks dir, and — only
when init-factory itself created it — copilot-instructions.md), never the
directory as a whole.

Deliberately NOT bundled into a skill by default — this can be run directly,
standalone, with no AI in the loop at all (`init-factory` is a normal
executable). A thin skill wrapper exists for CLIs that want to invoke it
conversationally, but nothing about using Agent Factory requires it.

Does not scaffold docs/spec/, docs/adr/, docs/CONTEXT.md, or any other docs/
subtree — those are created lazily by the skill that first needs them
(domain-modeling, todo-format), not eagerly by init.

Steps
  1. Create --target if missing.
  2. `git init` if --target isn't already a repo.
  3. Copy factory/ from --source into --target, UNLESS --target/factory
     already exists — in that case this step is skipped (not diffed, not
     refreshed; that's the still-unbuilt update script's job).
  4. Create --target/.claude and --target/.github (if missing).
  5. Symlink factory/{agents,skills,playbooks,rulebooks,scripts,INDEX.yaml}
     and the orientation file into both dot-dirs. NON-INTERFERENCE: if an
     orientation file (.claude/CLAUDE.md, .github/copilot-instructions.md)
     already exists as a real file, it is left untouched and skipped — the
     project keeps its own; Agent Factory's is not forced on top.
  6. Symlink the shared git-safety hook into both dot-dirs and wire it into
     .claude/settings.json (created if absent, merged if present, never
     duplicated).
  7. Copy factory/config/model.conf to --target/config/model.conf, only if
     absent (meant to diverge per project).
  8. Pre-commit: the ONLY tracked change. If --target/.pre-commit-config.yaml
     exists, splice Agent Factory's `agent_factory_hook-*` block in beside the
     project's own hooks (merge-precommit-config). If it doesn't exist, create
     it carrying just that block. A project's inert `.pre-commit-config.yml`
     is never touched — pre-commit only auto-reads `.yaml`.
  9. Emit the single "agent_factory related" .gitignore block (created or
     appended; rewritten in place on re-run).
  10. Write .agent-factory/factory-install.json (the removal manifest).
  11. `uvx pre-commit install`.

Usage
  init-factory                                    # target = cwd, source = this checkout
  init-factory --target /path/to/project
  init-factory --target /path/to/project --source /path/to/agent_factory

Exit code: 0 on success (including a clean no-op re-run). 1 on any collision
or unsupported existing state — the first step that can't proceed stops the
whole run before touching anything later.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# name -> path relative to factory/, symlinked into each dot-dir under the same name
FACTORY_CONTENT = [
    "agents",
    "skills",
    "playbooks",
    "rulebooks",
    "scripts",
    "INDEX.yaml",
]

DOT_DIRS = [".claude", ".github"]

# dot-dir -> this CLI's root orientation-file path, relative to --target
ORIENTATION_FILE = {
    ".claude": ".claude/CLAUDE.md",
    ".github": ".github/copilot-instructions.md",
}

# The exact PreToolUse/Bash hook command string that wires the git-safety
# guardrail into a project's .claude/settings.json.
CLAUDE_GUARDRAIL_HOOK_COMMAND = (
    '"$CLAUDE_PROJECT_DIR"/.claude/hooks/block-dangerous-git.sh'
)

# Marker lines that fence the single .gitignore block. remove-factory strips
# everything between them (inclusive). Keep these strings in sync there.
GITIGNORE_BEGIN = "# >>> agent_factory related >>>"
GITIGNORE_END = "# <<< agent_factory related <<<"

MANIFEST_PATH = ".agent-factory/factory-install.json"


class Collision(Exception):
    """Raised when a step finds something at a destination path that isn't
    ours to skip past — stops the whole run, names the exact path."""


def log(report: list[str], line: str) -> None:
    report.append(line)
    print(f"init-factory: {line}")


# --------------------------------------------------------------------------- #
# Steps
# --------------------------------------------------------------------------- #


def ensure_target_dir(target: Path, install: dict, report: list[str]) -> None:
    if target.exists():
        log(report, f"target directory exists: {target}")
        return

    target.mkdir(parents=True)
    log(report, f"created target directory: {target}")


def ensure_git(target: Path, install: dict, report: list[str]) -> None:
    if (target / ".git").exists():
        # setdefault: a prior run may have recorded that WE created this repo.
        install.setdefault("git_initialized_by_us", False)
        log(report, "git: already a repo, left untouched")
        return

    subprocess.run(["git", "init", str(target)], check=True, capture_output=True)
    install["git_initialized_by_us"] = True
    log(report, "git: initialized new repo")


def copy_factory(
    source_factory: Path, target: Path, install: dict, report: list[str]
) -> None:
    dest = target / "factory"

    # factory/ is unconditionally Agent Factory's own toolset — always record
    # it for removal, whether we copy it now or it was copied on a prior run.
    install["remove_paths"].append("factory")

    if dest.exists():
        log(
            report,
            "factory/: already present, skipped — refreshing an existing "
            "factory/ is the (not yet built) update script's job, not init's",
        )
        return

    shutil.copytree(source_factory, dest, symlinks=False)
    log(report, f"factory/: copied in from {source_factory}")


def ensure_dot_dirs(target: Path, install: dict, report: list[str]) -> None:
    for name in DOT_DIRS:
        path = target / name

        if path.exists():
            install["dir_existed"][name] = True
            log(report, f"{name}/: already present, continuing")
            continue

        path.mkdir()
        install["dir_existed"][name] = False
        install["remove_paths"].append(name)
        log(report, f"{name}/: created")


def ensure_symlink(
    link: Path, dest: Path, report: list[str], install: dict | None = None
) -> bool:
    """Create a relative symlink at `link` pointing to `dest`. Returns True if
    a new link was created, False if it was already correct. Records created
    links in install["remove_paths"] when `install` is passed."""
    rel = os.path.relpath(dest, start=link.parent)

    if link.is_symlink():
        current = (link.parent / os.readlink(link)).resolve()

        if current == dest.resolve():
            if install is not None:
                install["remove_paths"].append(_relpath(link, install))
            log(report, f"skip (already linked): {link}")
            return False

        raise Collision(f"{link} is already a symlink to {current}, not to {dest}")

    if link.exists():
        raise Collision(f"{link} already exists and is not a symlink to {dest}")

    link.symlink_to(rel)
    if install is not None:
        install["remove_paths"].append(_relpath(link, install))
    log(report, f"linked: {link} -> {rel}")
    return True


def _relpath(path: Path, install: dict) -> str:
    return os.path.relpath(path, start=install["_target"])


def symlink_factory_content(target: Path, install: dict, report: list[str]) -> None:
    factory = target / "factory"

    for dot_dir in DOT_DIRS:
        base = target / dot_dir

        for name in FACTORY_CONTENT:
            ensure_symlink(base / name, factory / name, report, install=install)
            # .github entries are ignored individually (never the whole dir, which
            # would hide the project's own workflows); .claude is ignored wholesale.
            if dot_dir == ".github":
                install["github_ignored_entries"].add(f".github/{name}")

        _link_orientation(target, dot_dir, factory, install, report)


def _link_orientation(
    target: Path, dot_dir: str, factory: Path, install: dict, report: list[str]
) -> None:
    rel = ORIENTATION_FILE[dot_dir]
    link = target / rel
    dest = factory / "config" / "AGENTS.md"

    # NON-INTERFERENCE: a real, project-owned orientation file is left as is.
    if link.exists() and not link.is_symlink():
        install["orientation"][rel] = "skipped-existing"
        log(
            report,
            f"{rel}: already exists as a project file — left untouched "
            "(Agent Factory orientation not forced on top)",
        )
        return

    ensure_symlink(link, dest, report, install=install)
    install["orientation"][rel] = "linked"
    if dot_dir == ".github":
        install["github_ignored_entries"].add(rel)


def install_git_guardrail(target: Path, install: dict, report: list[str]) -> None:
    _install_claude_guardrail(target, install, report)
    _install_copilot_guardrail(target, install, report)


def _install_claude_guardrail(target: Path, install: dict, report: list[str]) -> None:
    hooks_dir = target / ".claude" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)

    link = hooks_dir / "block-dangerous-git.sh"
    dest = target / "factory" / "config" / "hooks" / "block-dangerous-git.sh"
    ensure_symlink(link, dest, report, install=install)

    _ensure_claude_guardrail_settings(target, install, report)


def _install_copilot_guardrail(target: Path, install: dict, report: list[str]) -> None:
    hooks_dir = target / ".github" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    install["github_ignored_entries"].add(".github/hooks")

    script_link = hooks_dir / "block-dangerous-git.sh"
    script_dest = target / "factory" / "config" / "hooks" / "block-dangerous-git.sh"
    ensure_symlink(script_link, script_dest, report, install=install)

    config_link = hooks_dir / "block-dangerous-git.json"
    config_dest = target / "factory" / "config" / "hooks" / "block-dangerous-git.json"
    ensure_symlink(config_link, config_dest, report, install=install)


def _ensure_claude_guardrail_settings(
    target: Path, install: dict, report: list[str]
) -> None:
    path = target / ".claude" / "settings.json"

    if not path.exists():
        settings = {
            "hooks": {
                "PreToolUse": [
                    {
                        "matcher": "Bash",
                        "hooks": [
                            {
                                "type": "command",
                                "command": CLAUDE_GUARDRAIL_HOOK_COMMAND,
                            }
                        ],
                    }
                ]
            }
        }
        path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
        install["claude_settings_existed"] = False
        # Recorded for removal in case .claude/ itself pre-existed and so isn't
        # deleted wholesale; harmless when .claude/ is removed as a unit.
        install["remove_paths"].append(".claude/settings.json")
        log(report, ".claude/settings.json: created with git-safety guardrail hook")
        return

    # setdefault: if a prior run created it, keep existed=False (it's ours).
    install.setdefault("claude_settings_existed", True)

    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        raise Collision(
            f"{path} exists but isn't valid JSON ({e}) — wire the git-safety "
            "guardrail hook in by hand: a PreToolUse/Bash hook running "
            f"{CLAUDE_GUARDRAIL_HOOK_COMMAND}"
        )

    if not isinstance(settings, dict):
        raise Collision(
            f"{path} exists but its top-level JSON isn't an object — wire the "
            f"git-safety guardrail hook in by hand: a PreToolUse/Bash hook running "
            f"{CLAUDE_GUARDRAIL_HOOK_COMMAND}"
        )

    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise Collision(
            f"{path}: 'hooks' key exists but isn't an object — wire it in by hand"
        )

    pre_tool_use = hooks.setdefault("PreToolUse", [])
    if not isinstance(pre_tool_use, list):
        raise Collision(
            f"{path}: 'hooks.PreToolUse' exists but isn't a list — wire the "
            "git-safety guardrail hook in by hand"
        )

    for entry in pre_tool_use:
        entry_hooks = entry.get("hooks", []) if isinstance(entry, dict) else []
        for hook in entry_hooks:
            if (
                isinstance(hook, dict)
                and hook.get("command") == CLAUDE_GUARDRAIL_HOOK_COMMAND
            ):
                log(
                    report,
                    ".claude/settings.json: git-safety guardrail hook already wired in",
                )
                return

    pre_tool_use.append(
        {
            "matcher": "Bash",
            "hooks": [{"type": "command", "command": CLAUDE_GUARDRAIL_HOOK_COMMAND}],
        }
    )
    path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    log(report, ".claude/settings.json: added git-safety guardrail hook")


def copy_model_matrix(target: Path, install: dict, report: list[str]) -> None:
    config_dir = target / "config"
    dest = config_dir / "model.conf"

    if dest.exists():
        # If a prior run created it, the loaded manifest already carries the
        # ignore + removal records; if it's the project's own, we leave it out.
        log(
            report,
            "config/model.conf: already present, left untouched (meant to diverge per project)",
        )
        return

    if not config_dir.exists():
        config_dir.mkdir(parents=True)
        install["remove_paths"].append("config")

    shutil.copyfile(target / "factory" / "config" / "model.conf", dest)
    install["remove_paths"].append("config/model.conf")
    install["ignore_model_conf"] = True
    log(report, "config/model.conf: copied in as a starter")


def handle_precommit(target: Path, install: dict, report: list[str]) -> None:
    dest = target / ".pre-commit-config.yaml"
    template = target / "factory" / "config" / "pre-commit-config.yaml"

    if dest.is_symlink():
        # A legacy install may have symlinked this to the template. That no
        # longer works: factory/ is now git-ignored, so a tracked symlink into
        # it would dangle after removal. Convert it to a real file carrying the
        # same block, so it survives factory/ removal and stays extricable.
        current = (dest.parent / os.readlink(dest)).resolve()
        if current != template.resolve():
            raise Collision(
                f"{dest} is already a symlink to {current}, not to {template}"
            )
        dest.unlink()
        dest.write_text(_fresh_precommit_text(template), encoding="utf-8")
        install["precommit"] = {"path": ".pre-commit-config.yaml", "existed": False}
        log(report, ".pre-commit-config.yaml: replaced legacy symlink with real file")
        return

    if not dest.exists():
        dest.write_text(_fresh_precommit_text(template), encoding="utf-8")
        install["precommit"] = {"path": ".pre-commit-config.yaml", "existed": False}
        install["remove_paths"].append(".pre-commit-config.yaml")
        log(report, ".pre-commit-config.yaml: created with Agent Factory's hook block")
        return

    # Record the original's trailing-newline state so removal restores it exactly.
    install.setdefault(
        "precommit_orig_final_newline",
        dest.read_text(encoding="utf-8").endswith("\n"),
    )
    merge_script = target / "factory" / "scripts" / "merge-precommit-config"
    result = subprocess.run(
        [
            sys.executable,
            str(merge_script),
            "--target",
            str(dest),
            "--template",
            str(template),
        ],
    )

    if result.returncode != 0:
        raise Collision(
            f"{dest} exists with a structure merge-precommit-config couldn't "
            "handle automatically — see its error above, merge by hand"
        )

    # setdefault: if a prior run created this file, keep existed=False so the
    # remover deletes it wholesale rather than only stripping our block.
    install.setdefault(
        "precommit", {"path": ".pre-commit-config.yaml", "existed": True}
    )
    log(report, ".pre-commit-config.yaml: spliced Agent Factory's hook block in")


def _fresh_precommit_text(template: Path) -> str:
    """A standalone .pre-commit-config.yaml carrying only Agent Factory's
    `- repo: local` block (extracted verbatim from the template)."""
    lines = template.read_text(encoding="utf-8").splitlines()
    for i, line in enumerate(lines):
        if line.rstrip() == "  - repo: local":
            block = "\n".join(lines[i:])
            break
    else:
        raise Collision(
            f"{template} has no `- repo: local` block to build a config from"
        )

    header = (
        "# Created by Agent Factory init-factory. The agent_factory_hook-* hooks\n"
        "# below are added here and removed by factory/scripts/remove-factory\n"
        "# (extricable by their id prefix). Safe to delete if it holds nothing else.\n"
        "repos:\n"
    )
    return header + block + "\n"


def write_gitignore_block(target: Path, install: dict, report: list[str]) -> None:
    path = target / ".gitignore"

    entries = ["/factory/", "/.claude/", "/.agent-factory/", "/session-scratchpad.md"]
    if install.get("ignore_model_conf"):
        entries.append("/config/model.conf")
    for entry in sorted(install["github_ignored_entries"]):
        entries.append("/" + entry)

    install["ignored_paths"] = entries

    body = [
        GITIGNORE_BEGIN,
        "# Added by init-factory; remove with factory/scripts/remove-factory.",
        *entries,
        GITIGNORE_END,
    ]
    block = "\n".join(body) + "\n"

    if not path.exists():
        path.write_text(block, encoding="utf-8")
        install["gitignore_existed"] = False
        install.setdefault("gitignore_orig_final_newline", True)
        install["remove_paths"].append(".gitignore")
        log(report, ".gitignore: created with the agent_factory related block")
        return

    # setdefault: if a prior run created .gitignore, keep existed=False.
    install.setdefault("gitignore_existed", True)
    existing = path.read_text(encoding="utf-8")

    if GITIGNORE_BEGIN in existing and GITIGNORE_END in existing:
        pre, rest = existing.split(GITIGNORE_BEGIN, 1)
        _, post = rest.split(GITIGNORE_END, 1)
        rebuilt = pre.rstrip("\n") + "\n\n" + block + post.lstrip("\n")
        if rebuilt != existing:
            path.write_text(rebuilt, encoding="utf-8")
            log(report, ".gitignore: refreshed the agent_factory related block")
        else:
            log(report, ".gitignore: agent_factory related block already current")
        return

    # First append: preserve the project's exact bytes. Record whether the
    # original ended with a newline so remove-factory can restore it precisely,
    # rather than leaving a stray trailing newline behind.
    had_nl = existing.endswith("\n")
    install.setdefault("gitignore_orig_final_newline", had_nl)
    base = existing if had_nl else existing + "\n"
    path.write_text(base + "\n" + block, encoding="utf-8")
    log(report, ".gitignore: appended the agent_factory related block")


def load_prior_manifest(target: Path, install: dict, report: list[str]) -> None:
    """Seed `install` from a previous run's manifest so an idempotent re-run
    preserves what init already knows is Agent Factory's — steps that skip
    because a path already exists would otherwise lose that knowledge, leaving
    the remover unable to clean it up."""
    path = target / MANIFEST_PATH

    if not path.exists():
        return

    try:
        prior = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return

    install["remove_paths"] = list(prior.get("remove_paths", []))
    install["orientation"] = dict(prior.get("orientation", {}))
    if prior.get("precommit"):
        install["precommit"] = prior["precommit"]
    for key in (
        "git_initialized_by_us",
        "gitignore_existed",
        "gitignore_orig_final_newline",
        "precommit_orig_final_newline",
        "claude_settings_existed",
    ):
        if key in prior:
            install[key] = prior[key]
    for p in prior.get("ignored_paths", []):
        if p == "/config/model.conf":
            install["ignore_model_conf"] = True
        elif p.startswith("/.github/"):
            install["github_ignored_entries"].add(p.lstrip("/"))

    log(report, f"{MANIFEST_PATH}: prior install found, preserving its records")


def write_manifest(target: Path, install: dict, report: list[str]) -> None:
    manifest_path = target / MANIFEST_PATH
    manifest_path.parent.mkdir(parents=True, exist_ok=True)

    payload = {
        "version": 1,
        "git_initialized_by_us": install.get("git_initialized_by_us", False),
        "gitignore_existed": install.get("gitignore_existed", True),
        "gitignore_markers": {"begin": GITIGNORE_BEGIN, "end": GITIGNORE_END},
        "gitignore_orig_final_newline": install.get(
            "gitignore_orig_final_newline", True
        ),
        "precommit": install.get("precommit", {}),
        "precommit_orig_final_newline": install.get(
            "precommit_orig_final_newline", True
        ),
        "precommit_hook_id_prefix": "agent_factory_hook-",
        "claude_settings_existed": install.get("claude_settings_existed", True),
        "orientation": install.get("orientation", {}),
        "ignored_paths": install.get("ignored_paths", []),
        "remove_paths": _dedup(install["remove_paths"]),
    }
    manifest_path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    log(report, f"{MANIFEST_PATH}: wrote removal manifest")


def _dedup(paths: list[str]) -> list[str]:
    seen: set[str] = set()
    out: list[str] = []
    for p in paths:
        if p not in seen:
            seen.add(p)
            out.append(p)
    return out


def pre_commit_install(target: Path, report: list[str]) -> None:
    result = subprocess.run(
        ["uvx", "pre-commit", "install"], cwd=target, capture_output=True, text=True
    )

    if result.returncode != 0:
        log(report, f"uvx pre-commit install: FAILED — {result.stderr.strip()}")
        return

    log(report, "uvx pre-commit install: done")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument(
        "--source",
        type=Path,
        default=None,
        help="agent_factory checkout to copy factory/ from (default: the checkout this script itself lives in)",
    )
    ap.add_argument(
        "--target",
        type=Path,
        default=Path("."),
        help="project directory to initialize (default: cwd)",
    )
    args = ap.parse_args(argv)

    source_root = (args.source or Path(__file__).resolve().parents[2]).resolve()
    source_factory = source_root / "factory"

    if not source_factory.is_dir():
        print(
            f"init-factory: no factory/ found at {source_factory} — pass --source explicitly",
            file=sys.stderr,
        )
        return 1

    target = args.target.resolve()
    report: list[str] = []
    install: dict = {
        "_target": target,
        "remove_paths": [],
        "dir_existed": {},
        "orientation": {},
        "github_ignored_entries": set(),
    }

    try:
        ensure_target_dir(target, install, report)
        load_prior_manifest(target, install, report)
        ensure_git(target, install, report)
        copy_factory(source_factory, target, install, report)
        ensure_dot_dirs(target, install, report)
        symlink_factory_content(target, install, report)
        install_git_guardrail(target, install, report)
        copy_model_matrix(target, install, report)
        handle_precommit(target, install, report)
        write_gitignore_block(target, install, report)
        write_manifest(target, install, report)
        pre_commit_install(target, report)
    except Collision as e:
        print(f"init-factory: STOPPED — {e}", file=sys.stderr)
        return 1

    print(f"init-factory: done, {target} is set up")

    return 0


if __name__ == "__main__":
    sys.exit(main())
