        ensure_symlink(
            extensions_dir / name,
            target / "factory" / "config" / "extensions" / name,
            report,
            install=install,
        )


def _install_codex_usage_capture(
    target: Path, install: dict, report: list[str]
) -> None:
    """Merge Factory's Codex lifecycle hooks into project hook config."""
    hooks_dir = _ensure_codex_hooks_dir(target, install, report)
    install["codex_ignored_entries"].add(".codex/hooks/capture-codex-usage.sh")

    ensure_symlink(
        hooks_dir / "capture-codex-usage.sh",
        target / "factory/config/hooks/capture-codex-usage.sh",
        report,
        install=install,
    )

    path, config, hooks, existed = _load_codex_hooks(target, install)

    changed = False
    for event in CODEX_CAPTURE_HOOK_EVENTS:
        entries = hooks.setdefault(event, [])
        if not isinstance(entries, list):
            raise Collision(f"{path}: 'hooks.{event}' exists but isn't a list")
        already_wired = any(
            isinstance(hook, dict) and hook.get("command") == CODEX_CAPTURE_HOOK_COMMAND
            for entry in entries
            for hook in (entry.get("hooks", []) if isinstance(entry, dict) else [])
        )
        if not already_wired:
            entries.append(
                {"hooks": [{"type": "command", "command": CODEX_CAPTURE_HOOK_COMMAND}]}
            )
            _record_codex_handler(
                install,
                {"event": event, "command": CODEX_CAPTURE_HOOK_COMMAND},
            )
            changed = True

    if changed or not existed:
        path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        log(report, ".codex/hooks.json: wired Stop/SubagentStop usage capture")

    log(
        report,
        "Codex usage capture: installed but not active until trusted; "
        "start Codex, open /hooks, then review and trust the project hooks",
    )


def _ensure_codex_hooks_dir(target: Path, install: dict, report: list[str]) -> Path:
    hooks_dir = target / ".codex" / "hooks"
    _ensure_project_directory(hooks_dir, install, report)
    return hooks_dir


def _record_codex_handler(install: dict, handler: dict) -> None:
    if handler not in install["codex_hook_handlers"]:
        install["codex_hook_handlers"].append(handler)


def _load_codex_hooks(target: Path, install: dict) -> tuple[Path, dict, dict, bool]:
    """Load the shared Codex hook document while preserving ownership facts."""
    path = target / ".codex" / "hooks.json"
    existed = path.exists()
    if existed:
        install.setdefault("codex_hooks_existed", True)
        raw = path.read_text(encoding="utf-8")
        if install.get("codex_hooks_existed", True):
            install.setdefault("codex_hooks_original", raw)
        try:
            config = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise Collision(f"{path} exists but isn't valid JSON ({exc})")
        if not isinstance(config, dict):
            raise Collision(f"{path} exists but its top-level JSON isn't an object")
    else:
        config = {}
        install["codex_hooks_existed"] = False
        install["remove_paths"].append(".codex/hooks.json")
        install["codex_ignored_entries"].add(".codex/hooks.json")

    hooks = config.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise Collision(f"{path}: 'hooks' key exists but isn't an object")
    return path, config, hooks, existed


def _install_codex_guardrail(target: Path, install: dict, report: list[str]) -> None:
    """Install Codex's Bash matcher without disturbing project hook entries."""
    hooks_dir = _ensure_codex_hooks_dir(target, install, report)
    link = hooks_dir / "block-dangerous-git.sh"
    ensure_symlink(
        link,
        target / "factory/config/hooks/block-dangerous-git.sh",
        report,
        install=install,
    )
    install["codex_ignored_entries"].add(_relpath(link, install))

    path, config, hooks, existed = _load_codex_hooks(target, install)
    entries = hooks.setdefault("PreToolUse", [])
    if not isinstance(entries, list):
        raise Collision(f"{path}: 'hooks.PreToolUse' exists but isn't a list")
    already_wired = any(
        isinstance(hook, dict) and hook.get("command") == CODEX_GUARDRAIL_HOOK_COMMAND
        for entry in entries
        for hook in (entry.get("hooks", []) if isinstance(entry, dict) else [])
    )
    if already_wired:
        log(report, ".codex/hooks.json: git-safety guardrail already wired")
        return
    entries.append(
        {
            "matcher": "^Bash$",
            "hooks": [{"type": "command", "command": CODEX_GUARDRAIL_HOOK_COMMAND}],
        }
    )
    _record_codex_handler(
        install,
        {
            "event": "PreToolUse",
            "matcher": "^Bash$",
            "command": CODEX_GUARDRAIL_HOOK_COMMAND,
        },
    )
    path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    action = "created" if not existed else "added"
    log(report, f".codex/hooks.json: {action} Codex git-safety guardrail")


def _install_copilot_usage_capture(
    target: Path, install: dict, report: list[str]
) -> None:
    """Install an isolated Copilot version-1 hook file.

    Copilot combines `.github/hooks/*.json`, so a dedicated Factory-owned file
    is merge-safe without parsing or rewriting project-owned hook files.
    """
    hooks_dir = target / ".github" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    install["github_ignored_entries"].add(".github/hooks")

    for name in ("capture-copilot-usage.sh", "capture-usage.json"):
        ensure_symlink(
            hooks_dir / name,
            target / "factory" / "config" / "hooks" / name,
            report,
            install=install,
        )

    log(
        report,
        "Copilot usage capture: agentStop totals include child activity; "
        "subagentStop is attribution-only (general-purpose emits no child hook)",
    )


