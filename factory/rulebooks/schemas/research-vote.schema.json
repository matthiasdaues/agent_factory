{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vote",
  "type": "object",
  "required": ["review_ref", "claim_hash", "reviewer", "value"],
  "properties": {
    "review_ref": {
      "type": "string"
    },
    "claim_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "enum": ["SURVIVE", "REFUTE", "UNRESOLVED", "ABSTAIN"]
    }
  }
}
