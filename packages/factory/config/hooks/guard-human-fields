#!/usr/bin/env python3
"""guard-human-fields: refuse an agent's call that sets a human field (BR-092).

A human field is a non-null `override_by`, `override_reason`,
`stop_confirmed_by`, or `stop_confirmed_reason`, the status `waived` in a
finding file or a register file, or `waived` in the Status cell of a
proposal review row. Only the stakeholder writes these values, in an editor
or with a `!` command, which runs outside the tool hooks.

Guarded paths, relative to the git top level of the target file:

  docs/findings/<name>.md                finding files
  docs/findings/register/**/<name>.json  register files
  docs/proposals/<name>.md               the tables under `# Appendix`

Input: the PreToolUse payload of Claude Code on standard input, for the
tools Edit, MultiEdit, Write, NotebookEdit, and Bash.

"Sets" means a value appears that was not there before. Edit and MultiEdit
apply each edit to the current file and compare the values before and after;
when the file is missing or an old_string is not in it, the guard compares
old_string with new_string. Write and NotebookEdit compare the new content
with the current file. Bash is checked only when it writes into a guarded
path: a redirect, tee, sed -i, perl -i, or an interpreter that names the
path. Then any human value in the command text refuses it.

Exit 0 lets the call through. Exit 2 refuses it, with a message on standard
error that names the file and the field. The guard writes no file.

Blind spot (DEC-42): the guard checks the text of each call. An agent that
hides the field name passes it, such as with a field name built from pieces
in a script, a `cp` of a prepared file, or `git checkout <ref> -- <file>`.
"""

from __future__ import annotations

import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

HUMAN_FIELDS = ("override_by", "override_reason", "stop_confirmed_by", "stop_confirmed_reason")
NULL_VALUES = {"", "null", "~", "''", '""'}
BLOCK_SCALARS = {"|", ">", "|-", ">-", "|+", ">+"}

_FIELD_NAMES = "|".join(HUMAN_FIELDS + ("status",))
# A YAML line of a finding file, such as `stop_confirmed_by: human  # note`.
YAML_LINE = re.compile(rf"^[ \t]*({_FIELD_NAMES})[ \t]*:(.*)$", re.MULTILINE)
# A JSON key of a register file, such as `"status": "waived"`.
JSON_KEY = re.compile(
    rf'"({_FIELD_NAMES})"\s*:\s*("(?:[^"\\]|\\.)*"|[^,}}\s]+)'
)
# A field anywhere in a shell command, such as `s/status: open/status: waived/`.
SHELL_FIELD = re.compile(
    rf"""\b({_FIELD_NAMES})["']?\s*:\s*["']?([^\s"',/}}]*)"""
)
WAIVED_WORD = re.compile(r"\bwaived\b")
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1")
INTERPRETERS = {"python", "python3", "perl", "ruby", "node", "awk", "gawk"}
SHELLS = {"sh", "bash", "zsh", "dash"}
SEPARATORS = {";", "&&", "||", "|", "&", "(", ")"}
REDIRECTS = {">", ">>", ">|", "&>", "&>>", "1>", "1>>", "2>", "2>>"}


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        return 0
    if not isinstance(payload, dict):
        return 0
    refusal = check_call(payload)
    if refusal is None:
        return 0
    print(refusal, file=sys.stderr)
    return 2


def check_call(payload: dict) -> str | None:
    """Return the refusal message for a call that sets a human field, else None."""
    tool = payload.get("tool_name")
    args = payload.get("tool_input")
    if not isinstance(args, dict):
        return None
    cwd = Path(payload.get("cwd") or os.getcwd())

    if tool == "Bash":
        return check_shell(str(args.get("command") or ""), cwd)

    raw_path = args.get("notebook_path") if tool == "NotebookEdit" else args.get("file_path")
    if not isinstance(raw_path, str) or not raw_path:
        return None
    path = _absolute(raw_path, cwd)
    rel, kind = guarded(path)
    if kind is None:
        return None
    current = _read(path)

    if tool == "Write":
        return _compare(rel, kind, current or "", str(args.get("content") or ""))
    if tool == "NotebookEdit":
        return _compare(rel, kind, current or "", str(args.get("new_source") or ""))
    if tool == "Edit":
        return check_edits(rel, kind, current, [args])
    if tool == "MultiEdit":
        edits = args.get("edits")
        return check_edits(rel, kind, current, edits if isinstance(edits, list) else [])
    return None


def check_edits(rel: str, kind: str, current: str | None, edits: list) -> str | None:
    """Apply the edits in order to the current file and compare before with after.

    An edit that cannot be applied is checked on its own old_string and
    new_string."""
    text = current
    for edit in edits:
        if not isinstance(edit, dict):
            continue
        old = str(edit.get("old_string") or "")
        new = str(edit.get("new_string") or "")
        if text is not None and old and old in text:
            after = text.replace(old, new) if edit.get("replace_all") else text.replace(old, new, 1)
            refusal = _compare(rel, kind, text, after)
            text = after
        else:
            refusal = _compare(rel, kind, old, new)
        if refusal:
            return refusal
    return None


def check_shell(command: str, cwd: Path) -> str | None:
    """Refuse a shell command that writes into a guarded path and assigns a human value."""
    for path in shell_write_targets(command, cwd):
        rel, kind = guarded(path)
        if kind is None:
            continue
        if kind == "proposal":
            if WAIVED_WORD.search(command):
                return _message(rel, "Status")
            continue
        for field, value in SHELL_FIELD.findall(command):
            if _is_human(field, value):
                return _message(rel, field)
    return None


def shell_write_targets(command: str, cwd: Path) -> list[Path]:
    """Name the paths a shell command writes into, as far as its text shows."""
    targets: list[Path] = []
    try:
        # Each line is a command of its own, except after a line continuation.
        text = _strip_heredoc_bodies(command).replace("\\\n", " ").replace("\n", " ; ")
        lexer = shlex.shlex(text, posix=True, punctuation_chars=";&|()<>")
        lexer.whitespace_split = True
        lexer.commenters = ""
        words = list(lexer)
    except ValueError:
        # Unbalanced quotes: treat every path-like word of the text as a target.
        return [_absolute(word, cwd) for word in re.findall(r"[\w./*-]+", command)]

    for simple in _split_commands(words):
        targets.extend(_absolute(word, cwd) for word in _simple_targets(simple, cwd))
    return targets


def _split_commands(words: list[str]) -> list[list[str]]:
    commands: list[list[str]] = [[]]
    for word in words:
        if word in SEPARATORS:
            commands.append([])
        else:
            commands[-1].append(word)
    return [c for c in commands if c]


def _simple_targets(words: list[str], cwd: Path) -> list[str]:
    targets = [words[i + 1] for i, w in enumerate(words[:-1]) if w in REDIRECTS]
    args = [w for w in words if w not in REDIRECTS]
    while args and re.match(r"^\w+=", args[0]):
        args = args[1:]
    if not args:
        return targets
    name = os.path.basename(args[0])
    rest = args[1:]
    in_place = name in ("sed", "perl") and any(
        w.startswith("-i") or w == "--in-place" for w in rest
    )
    if name == "tee" or in_place:
        targets.extend(w for w in rest if not w.startswith("-"))
    elif name in INTERPRETERS:
        # A script can write any path that its text names.
        targets.extend(re.findall(r"[\w./*-]+", " ".join(rest)))
    elif name in SHELLS and "-c" in rest:
        script = rest[rest.index("-c") + 1] if rest.index("-c") + 1 < len(rest) else ""
        targets.extend(str(p) for p in shell_write_targets(script, cwd))
    return targets


def _strip_heredoc_bodies(command: str) -> str:
    """Drop the body lines of each heredoc, so the lexer sees only the commands."""
    lines = command.split("\n")
    kept: list[str] = []
    terminator: str | None = None
    for line in lines:
        if terminator is not None:
            if line.strip() == terminator:
                terminator = None
            continue
        kept.append(line)
        match = HEREDOC.search(line)
        if match:
            terminator = match.group(2)
    return "\n".join(kept)


def guarded(path: Path) -> tuple[str, str | None]:
    """Return the path relative to its project root and its kind, or None when unguarded."""
    root = _project_root(path)
    try:
        rel = path.relative_to(root).as_posix()
    except ValueError:
        return str(path), None
    parts = rel.split("/")
    if parts[:2] == ["docs", "findings"]:
        if len(parts) == 3 and _matches(parts[2], ".md"):
            return rel, "finding"
        if len(parts) >= 4 and parts[2] == "register" and _matches(parts[-1], ".json"):
            return rel, "register"
    if parts[:2] == ["docs", "proposals"] and len(parts) == 3 and _matches(parts[2], ".md"):
        return rel, "proposal"
    return rel, None


def _matches(name: str, suffix: str) -> bool:
    """A file name with the suffix, or a glob that can match one."""
    return name.endswith((suffix, "*"))


def _project_root(path: Path) -> Path:
    directory = path.parent
    while not directory.exists() and directory != directory.parent:
        directory = directory.parent
    try:
        out = subprocess.run(
            ["git", "-C", str(directory), "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=False,
        )
    except OSError:
        out = None
    if out is not None and out.returncode == 0 and out.stdout.strip():
        return Path(out.stdout.strip()).resolve()
    return Path(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()).resolve()


def _absolute(raw: str, cwd: Path) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        path = cwd / path
    return path.resolve()


def _read(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None


def _compare(rel: str, kind: str, before: str, after: str) -> str | None:
    added = human_values(kind, after) - human_values(kind, before)
    if not added:
        return None
    field = min(added)[0]
    return _message(rel, field)


def human_values(kind: str, text: str) -> set[tuple[str, str]]:
    """The human values a text holds, as (field, value) pairs."""
    if kind == "finding":
        return _yaml_values(text)
    if kind == "register":
        return {
            (field, value)
            for field, raw in JSON_KEY.findall(text)
            if _is_human(field, value := _unquote(raw))
        }
    if kind == "proposal":
        return _appendix_waived_rows(text)
    return set()


def _yaml_values(text: str) -> set[tuple[str, str]]:
    values: set[tuple[str, str]] = set()
    lines = text.split("\n")
    for match in YAML_LINE.finditer(text):
        field, raw = match.group(1), _strip_comment(match.group(2)).strip()
        if raw in BLOCK_SCALARS:
            line_no = text.count("\n", 0, match.start())
            indent = len(lines[line_no]) - len(lines[line_no].lstrip())
            body = []
            for line in lines[line_no + 1:]:
                if line.strip() and len(line) - len(line.lstrip()) <= indent:
                    break
                body.append(line.strip())
            raw = " ".join(b for b in body if b) or ""
        value = _unquote(raw)
        if _is_human(field, value):
            values.add((field, value))
    return values


def _appendix_waived_rows(text: str) -> set[tuple[str, str]]:
    """The rows of the Appendix tables whose Status cell holds `waived`, keyed by their first cell."""
    rows: set[tuple[str, str]] = set()
    in_appendix = False
    status_index: int | None = None
    for line in text.split("\n"):
        if re.match(r"^#\s", line):
            in_appendix = line.strip() == "# Appendix"
            status_index = None
            continue
        if not in_appendix or not line.lstrip().startswith("|"):
            status_index = None
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if status_index is None:
            status_index = cells.index("Status") if "Status" in cells else -1
            continue
        if 0 <= status_index < len(cells) and cells[status_index] == "waived":
            rows.add(("Status", cells[0]))
    return rows


def _strip_comment(raw: str) -> str:
    stripped = raw.strip()
    if stripped[:1] in ("'", '"'):
        return stripped
    return re.split(r"\s#", raw, maxsplit=1)[0]


def _unquote(raw: str) -> str:
    raw = raw.strip()
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in ("'", '"'):
        return raw[1:-1]
    return raw


def _is_human(field: str, value: str) -> bool:
    if field == "status":
        return value == "waived"
    return value not in NULL_VALUES


def _message(rel: str, field: str) -> str:
    return (
        f"guard-human-fields: refused. The call sets the human field `{field}` in {rel}. "
        "Only the stakeholder writes this field, in an editor or with a `!` command "
        "(BR-092). Leave the field as it is and tell the stakeholder."
    )


if __name__ == "__main__":
    sys.exit(main())
