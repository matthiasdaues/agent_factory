{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "./.github/hooks/capture-copilot-usage.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "./.github/hooks/capture-copilot-usage.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
