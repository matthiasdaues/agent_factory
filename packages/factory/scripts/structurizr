#!/bin/bash
# structurizr - Docker-only wrapper for the Structurizr DSL export pipeline
#
# What: Docker-only wrapper for the Structurizr DSL export/validate/inspect
#       pipeline (no local install).
# When: When architecture diagrams are exported or the DSL is validated.
# By:   the maintain-architecture and scaffold-arc42 skills / architecture-agent.
#
# This script provides a unified interface to Structurizr export, validation,
# and inspection operations without requiring local installation of Structurizr,
# Playwright, or any other tool. All operations run inside a Docker container.
#
# Usage:
#   ./structurizr <subcommand> [args...]
#
# Subcommands:
#   export-svg   - Export all views as SVG files to docs/assets/images/
#   export-all   - Export all views as SVG (alias for export-svg)
#   validate     - Validate the DSL model for syntax and semantic errors
#   list-views   - List all view keys defined in the DSL workspace

set -euo pipefail

# Configuration
IMAGE="${STRUCTURIZR_IMAGE:-structurizr/structurizr:2026.05.22-playwright}"
DOCS_DIR="${STRUCTURIZR_DOCS:-$(pwd)/docs}"
ARC42_DIR="${DOCS_DIR}/arc42"
IMAGES_DIR="${DOCS_DIR}/assets/images"

# Validate that docs directory exists
if [ ! -d "${DOCS_DIR}" ]; then
    echo "Error: docs directory does not exist at ${DOCS_DIR}" >&2
    exit 1
fi

if [ ! -d "${ARC42_DIR}" ]; then
    echo "Error: arc42 directory does not exist at ${ARC42_DIR}" >&2
    exit 1
fi

# Create output directory for exports (required by US-RP-002 and US-RP-003)
mkdir -p "${IMAGES_DIR}"

# Ensure docker is available
if ! command -v docker &> /dev/null; then
    echo "Error: Docker is not installed or not in PATH" >&2
    exit 1
fi

# Strip the "structurizr-" prefix from exported filenames.
# Structurizr exports as structurizr-<ViewKey>.<ext>; we want <ViewKey>.<ext>.
strip_prefix() {
    for f in "${IMAGES_DIR}"/structurizr-*; do
        [ -e "$f" ] || continue
        local base
        base="$(basename "$f")"
        local stripped="${base#structurizr-}"
        mv "$f" "${IMAGES_DIR}/${stripped}"
    done
}

# Subcommand dispatcher
case "${1:-}" in
    export-svg|export-all)
        docker run --rm \
            -v "${DOCS_DIR}:/workspace" \
            "${IMAGE}" export -format svg -workspace /workspace/arc42/architecture.dsl -output /workspace/assets/images
        strip_prefix
        ;;
    validate)
        exec docker run --rm \
            -v "${DOCS_DIR}:/workspace" \
            "${IMAGE}" validate -workspace /workspace/arc42/architecture.dsl
        ;;
    list-views)
        exec docker run --rm \
            -v "${DOCS_DIR}:/workspace" \
            "${IMAGE}" list-views -workspace /workspace/arc42/architecture.dsl
        ;;
    *)
        # Unknown subcommand
        cat >&2 <<EOF
Usage: $(basename "$0") <subcommand> [args...]

Subcommands:
  export-svg   - Export all views as SVG files to docs/assets/images/
  export-all   - Alias for export-svg
  validate     - Validate the DSL model
  list-views   - List all view keys in the workspace

Default image: ${IMAGE}
Override with:  STRUCTURIZR_IMAGE=<image> ./structurizr <subcommand>
EOF
        exit 1
        ;;
esac
