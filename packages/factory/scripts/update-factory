#!/usr/bin/env python3
"""update-factory — refresh an installed factory/ to the current checkout.

What: Brings a project's installed `factory/` up to date with the current state
      of the referenced agent_factory checkout, then re-applies every *derived*
      install step through the sourced init-factory — regenerated Codex
      adapters and Copilot agent copies (with tools: frontmatter), re-verified
      runtime symlinks, re-merged guardrail/usage hook wiring, and a re-run
      pre-commit install.
When: To update an existing install to a newer checkout.
By:   run by hand (a shell, no AI needed); companion to init-factory and
      remove-factory. Run it from the checkout (`--target <project>`) or from
      inside the installed project (`--source <checkout>`); either works.

Safety: Before replacing factory/, the script compares per-file checksums
recorded at install time against the currently installed files. Files that
the user added (custom skills, agents, scripts) or modified (tweaked prompts,
adjusted rules) are detected and reported. When user changes are found, the
update stops unless --force is passed. With --force, user-changed and
user-added files are preserved in .agent-factory/factory-user-changes/ so
nothing is lost.

Installations created before checksum recording was introduced have no
baseline to compare against. In that case the update proceeds as before
(full replacement) and records checksums for future updates.

Paths a pre-commit hook regenerates after install (see HOOK_REGENERATED_PATHS,
currently INDEX.yaml) are excluded from checksum comparison entirely: a hook
doing its job is never a user modification, so it never triggers --force.
These paths are still overwritten on every update, same as everything else in
factory/ — they are just never diffed against the baseline.

What is *not* touched: only `factory/` is replaced. The project's own files,
the `.gitignore`/`.pre-commit-config.yaml` edits, and the `.agent-factory/`
directory — including the usage-tracking transcripts under
`.agent-factory/usage/` and the lifecycle state under `.agent-factory/usage-
control/` — are all preserved. init-factory only rewrites the removal manifest
(`.agent-factory/factory-install.json`) and initializes the lifecycle
if-absent; it never deletes usage data.

On failure, the install is rolled back: the old `factory/` is moved aside
(not deleted) before the refresh, and if the sourced init-factory returns
non-zero — a `Collision`, the only non-graceful failure — the previous
`factory/` is restored in place. The project is never left without a
`factory/` and dangling runtime symlinks; resolve the reported collision and
re-run `update-factory` to finish.

The one decision update-factory cannot infer is WHICH checkout to pull from.
init-factory records the source it copied from in the install manifest
(`factory_source`); update-factory reads that as its default and `--source`
overrides it. Installations created before that field existed must pass
`--source`.

Usage
  update-factory --target /path/to/project                 # source from manifest
  update-factory --target /path/to/project --source /path/to/agent_factory
  update-factory --source /path/to/agent_factory           # target = cwd
  update-factory --check                                   # report changes, don't update
  update-factory --force                                   # update despite user changes

Exit code: 0 on success. 1 if the target isn't an init-factory'd project, if no
source can be resolved, or if the sourced init-factory stops on a collision.
2 if user modifications were detected and --force was not passed.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import uuid
from pathlib import Path

MANIFEST_PATH = ".agent-factory/factory-install.json"
CHECKSUMS_PATH = ".agent-factory/factory-checksums.json"
USER_CHANGES_DIR = ".agent-factory/factory-user-changes"
CHECKSUM_SKIP_PREFIXES = ("__pycache__/",)
CHECKSUM_SKIP_SUFFIXES = (".pyc",)

# Paths (relative to factory/) that a pre-commit hook regenerates after
# install — e.g. index-lint rewriting INDEX.yaml. These are never a user
# choice, so they are excluded from checksum comparison here: a hook-
# modified file must never be reported as a "user modification" that
# requires --force. Kept in sync with the identical constant in
# init-factory; the full factory/ replace below still overwrites these
# paths unconditionally, since update-factory never copies file-by-file.
HOOK_REGENERATED_PATHS = ("INDEX.yaml",)


class ManifestUnreadable(Exception):
    """The install manifest exists but cannot be read as valid JSON."""


def log(line: str) -> None:
    print(f"update-factory: {line}")


def load_manifest(target: Path) -> dict | None:
    """Return the install manifest, None if it is absent, or raise
    `ManifestUnreadable` if it exists but is malformed — so callers can
    distinguish "not an install" from "an install whose manifest is corrupt"."""
    path = target / MANIFEST_PATH
    if not path.exists():
        return None
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as exc:
        raise ManifestUnreadable(str(exc)) from exc
    return manifest if isinstance(manifest, dict) else None


# ── Checksum detection ─────────────────────────────────────────────────


def _should_checksum(rel: str) -> bool:
    return (
        not any(rel.startswith(p) or f"/{p}" in rel for p in CHECKSUM_SKIP_PREFIXES)
        and not any(rel.endswith(s) for s in CHECKSUM_SKIP_SUFFIXES)
        and not any(
            rel == p or rel.endswith(f"/{p}") for p in HOOK_REGENERATED_PATHS
        )
    )


def _compute_checksums(factory_dir: Path) -> dict[str, str]:
    checksums: dict[str, str] = {}
    for path in sorted(factory_dir.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(factory_dir).as_posix()
        if not _should_checksum(rel):
            continue
        checksums[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
    return checksums


def _read_checksums(target: Path) -> dict[str, str] | None:
    path = target / CHECKSUMS_PATH
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        files = data.get("files")
        return files if isinstance(files, dict) else None
    except (json.JSONDecodeError, OSError):
        return None


def _write_checksums(target: Path, factory_dir: Path) -> None:
    checksums = _compute_checksums(factory_dir)
    out = target / CHECKSUMS_PATH
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(
        json.dumps({"version": 1, "files": checksums}, indent=2) + "\n",
        encoding="utf-8",
    )


def _detect_modifications(
    target: Path,
) -> tuple[list[str], list[str], list[str]] | None:
    """Compare installed factory/ against stored checksums.

    Returns (modified, added, removed) lists of relative paths, or None
    when no baseline checksums exist (pre-checksum install).
    """
    stored = _read_checksums(target)
    if stored is None:
        return None

    factory_dir = target / "factory"
    if not factory_dir.is_dir():
        return None

    current = _compute_checksums(factory_dir)

    modified = [r for r in current if r in stored and current[r] != stored[r]]
    added = [r for r in current if r not in stored]
    removed = [r for r in stored if r not in current]

    return modified, added, removed


def _report_modifications(
    modified: list[str], added: list[str], removed: list[str],
) -> None:
    """Print a human-readable report of user changes."""
    total = len(modified) + len(added) + len(removed)
    print(f"\n  Found {total} user change(s) in factory/:\n")
    if modified:
        print("  Modified (content differs from install baseline):")
        for f in modified:
            print(f"    M  {f}")
    if added:
        print("  Added (not in original install):")
        for f in added:
            print(f"    A  {f}")
    if removed:
        print("  Removed (present at install, now absent):")
        for f in removed:
            print(f"    D  {f}")
    print()


def _preserve_user_changes(
    target: Path, modified: list[str], added: list[str],
) -> Path | None:
    """Copy user-modified and user-added files to a dated directory.

    Returns the directory path, or None if there was nothing to preserve.
    """
    to_save = modified + added
    if not to_save:
        return None

    from datetime import datetime

    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = target / USER_CHANGES_DIR / stamp
    factory_dir = target / "factory"

    for rel in to_save:
        src = factory_dir / rel
        if not src.exists():
            continue
        out = dest / rel
        out.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, out)

    return dest if dest.exists() else None


# ── Init delegation ────────────────────────────────────────────────────


def _run_init(source: Path, target: Path) -> int:
    """Invoke the *sourced* init-factory to re-apply the install after the
    factory/ refresh. Subprocess so the replace-and-reinstall boundary and the
    sourced script's own idempotency/collision handling stay exactly the
    script's — update-factory adds no re-implementation of init's wiring."""
    pkg_init = source / "packages" / "factory" / "scripts" / "init-factory"
    init = pkg_init if pkg_init.exists() else source / "factory" / "scripts" / "init-factory"
    result = subprocess.run(
        [
            sys.executable,
            str(init),
            "--source",
            str(source),
            "--target",
            str(target),
        ],
        check=False,
    )
    return result.returncode


# ── Main ───────────────────────────────────────────────────────────────


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--target", type=Path, default=Path("."))
    ap.add_argument(
        "--source",
        type=Path,
        default=None,
        help="agent_factory checkout whose factory/ is the new state "
        "(default: the source recorded in the install manifest)",
    )
    ap.add_argument(
        "--force",
        action="store_true",
        help="proceed even when user modifications are detected; "
        "changed files are preserved under .agent-factory/factory-user-changes/",
    )
    ap.add_argument(
        "--check",
        action="store_true",
        help="report user modifications and exit without updating",
    )
    args = ap.parse_args(argv)

    target = args.target.resolve()
    try:
        manifest = load_manifest(target)
    except ManifestUnreadable as exc:
        print(
            f"update-factory: {CHECKSUMS_PATH} exists but is not valid JSON ({exc})",
            file=sys.stderr,
        )
        return 1
    if manifest is None:
        print(
            f"update-factory: {target} is not an init-factory'd project — "
            f"no {MANIFEST_PATH} found",
            file=sys.stderr,
        )
        return 1

    # ── Modification detection ─────────────────────────────────────────

    result = _detect_modifications(target)
    if result is not None:
        modified, added, removed = result
        has_changes = bool(modified or added or removed)

        if has_changes:
            _report_modifications(modified, added, removed)

            if args.check:
                return 2

            if not args.force:
                print(
                    "  User modifications detected. The update would replace these.\n"
                    "  Options:\n"
                    "    --force   proceed and preserve changed files in\n"
                    f"              {USER_CHANGES_DIR}/<timestamp>/\n"
                    "    --check   re-run with --check to see the full report\n",
                    file=sys.stderr,
                )
                return 2

            saved = _preserve_user_changes(target, modified, added)
            if saved:
                log(f"preserved {len(modified) + len(added)} user-changed files in {saved}")
        elif args.check:
            log("no user modifications detected in factory/")
            return 0
    else:
        if args.check:
            log("no checksum baseline found (pre-checksum install) — "
                "cannot detect modifications; run update once to establish baseline")
            return 0
        log("no checksum baseline — proceeding (first update will record baseline)")

    if args.check:
        return 0

    # ── Resolve source ─────────────────────────────────────────────────

    if args.source is not None:
        source = args.source.resolve()
    else:
        recorded = manifest.get("factory_source")
        if not isinstance(recorded, str) or not recorded:
            print(
                "update-factory: no --source given and the install manifest "
                "records no factory_source (a pre-existing install?) — pass "
                "--source <agent_factory checkout>",
                file=sys.stderr,
            )
            return 1
        source = Path(recorded).resolve()

    pkg_factory = source / "packages" / "factory"
    source_factory = pkg_factory if pkg_factory.is_dir() else source / "factory"
    if not source_factory.is_dir():
        print(
            f"update-factory: no factory/ found at {source} — pass "
            "--source explicitly",
            file=sys.stderr,
        )
        return 1

    target_factory = target / "factory"
    if target_factory.exists() and not target_factory.is_dir():
        print(
            f"update-factory: {target_factory} exists and is not a directory — "
            "refusing to touch it",
            file=sys.stderr,
        )
        return 1

    # ── Replace factory/ ───────────────────────────────────────────────

    backup: Path | None = None
    if target_factory.is_dir():
        backup_dir = target / ".agent-factory"
        backup_dir.mkdir(parents=True, exist_ok=True)
        backup = backup_dir / f"factory-backup-{uuid.uuid4()}"
        os.rename(target_factory, backup)
        log(f"moved existing factory/ aside ({target_factory})")
    else:
        log("no existing factory/ to remove — installing fresh")

    log(f"refreshing factory/ from {source_factory}")
    code = _run_init(source, target)
    if code != 0:
        if backup is not None and backup.is_dir() and not target_factory.exists():
            os.rename(backup, target_factory)
            log("restored the previous factory/ after the failed reinstall")
        print(
            "update-factory: the sourced init-factory did not complete — "
            "see its output above; resolve the reported collision and re-run "
            "update-factory to finish the refresh",
            file=sys.stderr,
        )
        return code

    if backup is not None and backup.is_dir():
        shutil.rmtree(backup)
        log("removed the update backup")

    _stamp_tree_hash(source, target)
    _write_checksums(target, target_factory)
    log("done, factory/ is now current")
    return 0


def _stamp_tree_hash(source: Path, target: Path) -> None:
    """Record the git tree hash of packages/factory/ in the install manifest
    so check-factory-freshness can detect staleness without a full diff."""
    pkg_factory = source / "packages" / "factory"
    if not pkg_factory.is_dir():
        return
    try:
        tree_hash = subprocess.run(
            ["git", "-C", str(source), "rev-parse", "HEAD:packages/factory"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return
    manifest_path = target / MANIFEST_PATH
    if not manifest_path.is_file():
        return
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return
    manifest["factory_tree_hash"] = tree_hash
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    log(f"stamped factory_tree_hash: {tree_hash[:12]}")


if __name__ == "__main__":
    sys.exit(main())
