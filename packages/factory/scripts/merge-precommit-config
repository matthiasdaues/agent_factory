#!/usr/bin/env python3
"""merge-precommit-config — idempotently splice Agent Factory's hooks into an
existing project's .pre-commit-config.yaml, without disturbing any hooks the
project already had.

What: Appends Agent Factory's `- repo: local` hook block to a project's own
      pre-commit config, idempotently.
When: During init-factory, only when the target already has its own
      pre-commit config; with --update, after every update-factory run.
By:   init-factory and update-factory (which loads merge() and asks before
      writing) — never run standalone in normal use.

Only handles the one case that actually needs merge logic: a *real*,
pre-existing `--target` file. If `--target` doesn't exist yet, the caller
(init-factory) just symlinks the template in directly — this script is never
invoked for that case.

Deliberately not a general YAML merger (no third-party dependency, matching
the zero-dependency approach of the other *-lint scripts, ADR-0006). It
understands exactly one shape: a top-level `repos:` key holding a block-style
list. Anything else about `--target`'s structure is left untouched — this
script only ever inserts one new list item at the top of that one list.

Algorithm
  1. Derive the no-op markers from `--template` itself: the hook ids inside
     its `- repo: local` block. If `--target` already declares any of them,
     or any id with the `agent_factory_hook-` prefix when the template
     carries that prefix, treat it as already merged: no-op. One id is not
     enough, because the merge can drop a hook the project runs itself
     (mdformat), and a later run would splice the block in a second time.
     Deriving the markers from the template (rather than a hardcoded id) is
     what makes the splice direction-agnostic — the same script works
     factory-into-project and subproject-into-root, each with its own
     template and its own markers.
  2. Otherwise find the line that is exactly `repos:` at column 0. Missing,
     or `repos:` written with inline content (flow style, e.g. `repos: []`)
     → abort; this shape isn't understood, merge by hand.
  3. Confirm the indent of the list's own existing items (if any) matches our
     template's 2-space convention — a mismatch would produce invalid YAML by
     mixing sibling indents, so abort rather than guess.
  4. Splice `--template`'s own `- repo: local` block (verbatim, unchanged) in
     at the TOP of the list, right after the `repos:` line, so Agent Factory's
     gates run first and its block sits at a predictable, extricable position.

Usage
  merge-precommit-config --target .pre-commit-config.yaml --template .agent-factory/factory/config/pre-commit-config.yaml

Exit code: 0 on success (including the already-merged no-op).
           1 if --target's structure isn't understood — manual merge required.
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

TEMPLATE_BLOCK_START = re.compile(r"^  - repo: local\s*$")
TOP_LEVEL_KEY = re.compile(r"^\S")
REPOS_KEY = re.compile(r"^repos:\s*$")
LIST_ITEM_INDENT = re.compile(r"^( *)- ")
HOOK_ID_LINE = re.compile(r"^\s*- id:\s*(\S+)\s*$")
HOOK_ENTRY_LINE = re.compile(r"^(\s*)entry:\s*(.+)$")
REPO_ITEM_START = re.compile(r"^  - repo:\s*\S")
HOOK_KEY_LINE = re.compile(r"^( *)([A-Za-z_]+):")
BLOCK_SCALAR = re.compile(r"^[>|][+-]?$")

# Tools that projects commonly provide their own hooks for.  When the target
# already has a hook whose entry invokes one of these, the corresponding
# factory hook is dropped from the splice to avoid running the tool twice.
DEDUP_TOOLS = {"mdformat"}


def find_template_block(template_text: str) -> list[str]:
    lines = template_text.splitlines()

    for i, line in enumerate(lines):
        if TEMPLATE_BLOCK_START.match(line):
            return lines[i:]

    raise ValueError(
        "--template has no top-level `- repo: local` entry — can't extract a block to splice"
    )


FACTORY_HOOK_PREFIX = "agent_factory_hook-"


def template_hook_ids(template_lines: list[str]) -> set[str]:
    """Return every hook id inside `--template`'s own `- repo: local` block
    (the same block `find_template_block()` extracts).

    These ids are the already-merged markers. Deriving them from whichever
    template is passed, rather than hardcoding one, lets the same script
    serve factory-into-project and subproject-into-root without either
    direction stepping on the other's markers.
    """
    ids: set[str] = set()
    in_block = False

    for line in template_lines:
        if TEMPLATE_BLOCK_START.match(line):
            in_block = True
            continue

        if in_block:
            if REPO_ITEM_START.match(line):
                break

            m = HOOK_ID_LINE.match(line)

            if m:
                ids.add(m.group(1))

    if not ids:
        raise ValueError(
            "--template has no `- id: <name>` hook inside its `- repo: local` "
            "block — can't derive an already-merged marker from it"
        )

    return ids


def already_merged(target_lines: list[str], template_ids: set[str]) -> bool:
    """True when `--target` declares a hook from an earlier merge.

    Any template hook id counts. When the template carries the
    `agent_factory_hook-` prefix, any id with that prefix counts too, so a
    template that gained or lost hooks since the last merge still matches."""
    prefixed = any(i.startswith(FACTORY_HOOK_PREFIX) for i in template_ids)

    for line in target_lines:
        m = HOOK_ID_LINE.match(line)

        if not m:
            continue

        hook_id = m.group(1)

        if hook_id in template_ids or (prefixed and hook_id.startswith(FACTORY_HOOK_PREFIX)):
            return True

    return False


def find_repos_list_bounds(target_lines: list[str]) -> tuple[int, int] | None:
    """Return (start, end) line indices of the repos: list's own items,
    end exclusive. None if the shape isn't understood."""
    repos_idx = None

    for i, line in enumerate(target_lines):
        if REPOS_KEY.match(line):
            repos_idx = i
            break

    if repos_idx is None:
        return None

    end = len(target_lines)

    for i in range(repos_idx + 1, len(target_lines)):
        if target_lines[i].strip() == "":
            continue

        if TOP_LEVEL_KEY.match(target_lines[i]):
            end = i
            break

    return repos_idx, end


def existing_item_indent(target_lines: list[str], start: int, end: int) -> int | None:
    """Indent (in spaces) of the first `- ` list item in [start, end).
    None if the list is currently empty (nothing to compare against)."""
    for i in range(start + 1, end):
        m = LIST_ITEM_INDENT.match(target_lines[i])

        if m:
            return len(m.group(1))

    return None


def _tools_in_target(target_lines: list[str]) -> set[str]:
    """Return the set of DEDUP_TOOLS names that already appear in any hook
    entry line in the target (outside of agent_factory_hook-* blocks and
    excluding entries that invoke .agent-factory/factory/scripts/ — those are factory
    tools, not independent project tools)."""
    found: set[str] = set()
    in_factory_block = False
    for i, line in enumerate(target_lines):
        m = HOOK_ID_LINE.match(line)
        if m:
            in_factory_block = m.group(1).startswith("agent_factory_hook-")
        if in_factory_block:
            continue
        entry = _entry_at(target_lines, i)
        if entry is not None:
            if ".agent-factory/factory/scripts/" in entry or "factory/scripts/" in entry:
                continue
            for tool in DEDUP_TOOLS:
                if tool in entry:
                    found.add(tool)
    return found


def _filter_template_block(block: list[str], skip_tools: set[str]) -> list[str]:
    """Remove individual hook stanzas from the template block whose entry
    invokes a tool in skip_tools.  Leading comments travel with the stanza
    they precede, so dropping a stanza also drops its comments."""
    if not skip_tools:
        return block
    filtered: list[str] = []
    stanza: list[str] = []
    for line in block:
        if HOOK_ID_LINE.match(line) and stanza:
            # Peel trailing comment/blank lines off the current stanza —
            # they belong to the upcoming hook, not the one that just ended.
            leading: list[str] = []
            while stanza and re.match(r"^\s*(#|$)", stanza[-1]):
                leading.append(stanza.pop())
            leading.reverse()
            if not _stanza_uses_tool(stanza, skip_tools):
                filtered.extend(stanza)
            stanza = leading + [line]
        else:
            stanza.append(line)
    if stanza and not _stanza_uses_tool(stanza, skip_tools):
        filtered.extend(stanza)
    return filtered


def _stanza_uses_tool(stanza: list[str], tools: set[str]) -> bool:
    for i in range(len(stanza)):
        entry = _entry_at(stanza, i)
        if entry is not None:
            return any(tool in entry for tool in tools)
    return False


def _entry_at(lines: list[str], i: int) -> str | None:
    """The value of the `entry:` key on line i, or None. A block scalar
    (`entry: >-`, BUG-0113) yields its more-indented lines joined by
    spaces, as a folded scalar reads."""
    m = HOOK_ENTRY_LINE.match(lines[i])
    if not m:
        return None
    indent, value = len(m.group(1)), m.group(2).strip()
    if not BLOCK_SCALAR.match(value):
        return value
    parts: list[str] = []
    for line in lines[i + 1:]:
        if line.strip() and len(line) - len(line.lstrip()) <= indent:
            break
        parts.append(line.strip())
    return " ".join(p for p in parts if p)


def _hook_stanzas(lines: list[str]) -> list[tuple[str, int, int]]:
    """(hook id, start, end) of each `- id:` stanza in `lines`. A stanza
    ends before the comment and blank lines that head the next one."""
    starts = [(i, m.group(1)) for i, m in ((i, HOOK_ID_LINE.match(ln)) for i, ln in enumerate(lines)) if m]
    stanzas: list[tuple[str, int, int]] = []
    for n, (s, hook_id) in enumerate(starts):
        e = starts[n + 1][0] if n + 1 < len(starts) else len(lines)
        while e > s + 1 and re.match(r"^\s*(#|$)", lines[e - 1]):
            e -= 1
        stanzas.append((hook_id, s, e))
    return stanzas


def _stanza_keys(stanza: list[str]) -> list[tuple[str, list[str]]]:
    """Split a hook stanza into (key, lines) pairs. The first line, `- id:`,
    is the key `id`; a key's more-indented lines travel with it."""
    key_indent = len(stanza[0]) - len(stanza[0].lstrip()) + 2
    keys: list[tuple[str, list[str]]] = [("id", [stanza[0]])]
    for line in stanza[1:]:
        m = HOOK_KEY_LINE.match(line)
        if m and len(m.group(1)) == key_indent:
            keys.append((m.group(2), [line]))
        else:
            keys[-1][1].append(line)
    return keys


def _project_keys(old_items: list[list[str]], template_block: list[str]) -> dict[str, list[str]]:
    """The lines of each key a project set on a factory hook that the
    factory's template does not use on any hook (BUG-0112), by hook id.
    The factory owns every key its template uses; the project owns the
    rest, such as `args:` or `exclude:`."""
    owned = {"id"}
    for _, s, e in _hook_stanzas(template_block):
        owned.update(key for key, _ in _stanza_keys(template_block[s:e]))
    kept: dict[str, list[str]] = {}
    for item in old_items:
        for hook_id, s, e in _hook_stanzas(item):
            for key, key_lines in _stanza_keys(item[s:e]):
                if key not in owned:
                    kept.setdefault(hook_id, []).extend(key_lines)
    return kept


def _add_project_keys(block: list[str], kept: dict[str, list[str]]) -> list[str]:
    """Append each hook's kept project keys to the end of its stanza."""
    out = list(block)
    for hook_id, _, e in reversed(_hook_stanzas(block)):
        if hook_id in kept:
            out[e:e] = kept[hook_id]
    return out


def _replace_factory_block(lines: list[str], template_text: str) -> list[str] | None:
    """Replace the existing agent_factory_hook-* repo block with the
    template's, in place (BUG-0110). Comment and blank lines that end the
    old block head the next item, so they stay. Keys a project set on a
    factory hook carry over (BUG-0112). Returns None when no repo item
    consists of factory hooks alone."""
    bounds = find_repos_list_bounds(lines)
    if bounds is None:
        return None
    start, end = bounds
    item_starts = [i for i in range(start + 1, end) if REPO_ITEM_START.match(lines[i])]
    drop: list[tuple[int, int]] = []
    for n, s in enumerate(item_starts):
        e = item_starts[n + 1] if n + 1 < len(item_starts) else end
        ids = [m.group(1) for m in (HOOK_ID_LINE.match(ln) for ln in lines[s:e]) if m]
        if not ids or not all(i.startswith(FACTORY_HOOK_PREFIX) for i in ids):
            continue
        while e > s + 1 and re.match(r"^\s*(#|$)", lines[e - 1]):
            e -= 1
        drop.append((s, e))
    if not drop:
        return None

    block = find_template_block(template_text)
    while block and not block[-1].strip():
        block.pop()
    kept = _project_keys([lines[s:e] for s, e in drop], block)
    block = _filter_template_block(block, _tools_in_target(lines))
    block = _add_project_keys(block, kept)

    out: list[str] = []
    prev = 0
    for n, (s, e) in enumerate(drop):
        out.extend(lines[prev:s])
        if n == 0:
            out.extend(block)
        prev = e
    out.extend(lines[prev:])
    return out


def merge(target_text: str, template_text: str, *, update: bool = False) -> str | None:
    """Return the merged text, or None if already merged and not updating.

    When update=True and the factory block already exists, replace it in
    place with the current template's block — this is how update-factory
    refreshes guarded entries."""
    template_ids = template_hook_ids(template_text.splitlines())

    if already_merged(target_text.splitlines(), template_ids):
        if not update:
            return None
        replaced = _replace_factory_block(target_text.splitlines(), template_text)
        if replaced is None:
            raise ValueError(
                "the existing agent_factory_hook-* block could not be stripped "
                "cleanly — merge by hand to avoid duplication"
            )
        return "\n".join(replaced) + "\n"

    target_lines = target_text.splitlines()
    bounds = find_repos_list_bounds(target_lines)

    if bounds is None:
        raise ValueError(
            "no top-level `repos:` block-style list found in --target — "
            "either missing, or written in flow style (e.g. `repos: []`); "
            "merge Agent Factory's hooks in by hand"
        )

    start, end = bounds
    indent = existing_item_indent(target_lines, start, end)

    if indent is not None and indent != 2:
        raise ValueError(
            f"--target's repos: list items are indented {indent} spaces, "
            "not the 2 this template uses — splicing would mix sibling "
            "indents and produce invalid YAML; merge by hand"
        )

    # Insert at the TOP of the repos: list (right after the `repos:` line), so
    # Agent Factory's gates run first and the agent_factory_hook-* block sits at
    # a predictable place. `start` is the index of the `repos:` line itself.
    block = find_template_block(template_text)
    skip_tools = _tools_in_target(target_lines)
    if skip_tools:
        block = _filter_template_block(block, skip_tools)
    insert_at = start + 1
    spliced = target_lines[:insert_at] + block + [""] + target_lines[insert_at:]

    return "\n".join(spliced) + "\n"


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--target", required=True, type=Path)
    ap.add_argument("--template", required=True, type=Path)
    ap.add_argument(
        "--update",
        action="store_true",
        help="strip the existing factory block and re-splice from the current "
        "template (used by update-factory to refresh hook entries)",
    )
    args = ap.parse_args(argv)

    target_text = args.target.read_text(encoding="utf-8")
    template_text = args.template.read_text(encoding="utf-8")

    try:
        merged = merge(target_text, template_text, update=args.update)
    except ValueError as e:
        print(f"merge-precommit-config: {e}", file=sys.stderr)
        return 1

    if merged is None:
        print(
            f"merge-precommit-config: {args.target} already has Agent Factory's hooks, no change"
        )
        return 0

    args.target.write_text(merged, encoding="utf-8")
    print(f"merge-precommit-config: merged Agent Factory's hooks into {args.target}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
