#!/usr/bin/env python3
"""move-docs — move files and rewrite every reference to them.

What: Moves each OLD file to NEW. A tracked file moves with `git mv`, so git
      records a rename. An untracked file moves with a plain move. When NEW
      ends with `/` or names an existing folder, the file keeps its name in
      that folder. In every text file of the project, the script then
      rewrites two kinds of reference:

      - A Markdown link to a moved file points at its new path. A relative
        link inside a moved file resolves from its new folder. Anchors and
        queries stay. It prints `link: <file>: <old target> -> <new target>`.
      - A full path from the project root, such as `docs/proposals/a.md` in
        front matter, a code span, YAML, or prose, becomes the new path. It
        prints `path: <file>:<line>: <old> -> <new>`.

      The scan set is every file that git tracks, or that is untracked and
      not ignored, outside .git/ and .agent-factory/. Binary files stay as
      they are. Every content edit comes before the first move, so a failed
      move undoes them all. The script stages the moves and leaves the
      content edits unstaged for review.
When: A developer reorganises documents, for example moves a finished
      proposal into docs/proposals/implemented/.
By:   The project maintainer or an agent on the maintainer's request.

Usage:
    packages/factory/scripts/move-docs [--dry-run] [--root DIR] OLD NEW [OLD NEW ...]

--root defaults to the current directory. OLD and NEW are paths relative to
it. --dry-run prints the moves and rewrites and changes no file.

Exit codes:
    0  success or --dry-run
    1  a step failed partway; every change of the run is undone
    2  refused before the first change: bad arguments, a missing OLD, a NEW
       that exists already, or two moves with the same NEW
"""

from __future__ import annotations

import argparse
import posixpath
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path, PurePosixPath

# The link rewrite lives beside this script.
_HERE = str(Path(__file__).resolve().parent)
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)
from _link_rewrite import rewrite_links, rewrite_paths

SKIPPED_DIRS = {".git", ".agent-factory"}


class Refused(Exception):
    """A reason to stop before the first change."""


@dataclass
class FileEdit:
    """The new text of one file, at its path before the run."""

    path: str
    old_text: str
    new_text: str


def _git(root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *args], capture_output=True, text=True, check=False
    )


def is_git_repo(root: Path) -> bool:
    return _git(root, "rev-parse", "--is-inside-work-tree").stdout.strip() == "true"


def scan_set(root: Path, git: bool) -> list[str]:
    """List the files to scan: tracked, or untracked and not ignored."""
    if git:
        out = _git(root, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
        files = {p for p in out.stdout.split("\0") if p}
    else:
        files = {p.relative_to(root).as_posix() for p in root.rglob("*")}
    return sorted(
        rel
        for rel in files
        if not SKIPPED_DIRS & set(PurePosixPath(rel).parts) and (root / rel).is_file()
    )


def tracked(root: Path, rel: str) -> bool:
    return _git(root, "ls-files", "--error-unmatch", "--", rel).returncode == 0


def read_text(path: Path) -> str | None:
    """Return the text of ``path``, or None for a binary or non-UTF-8 file."""
    data = path.read_bytes()
    if b"\0" in data:
        return None
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return None


def plan_moves(root: Path, pairs: list[tuple[str, str]]) -> dict[str, str]:
    """Map each OLD path to its NEW path, both normalised; refuse a bad pair."""
    moved: dict[str, str] = {}
    for old, new in pairs:
        old_rel = posixpath.normpath(old)
        if old_rel.startswith("../") or posixpath.isabs(old_rel):
            raise Refused(f"outside the project: {old}")
        if not (root / old_rel).is_file():
            raise Refused(f"no such file: {old}")
        if new.endswith("/") or (root / new).is_dir():
            new = posixpath.join(new, posixpath.basename(old_rel))
        new_rel = posixpath.normpath(new)
        if new_rel.startswith("../") or posixpath.isabs(new_rel):
            raise Refused(f"outside the project: {new}")
        if (root / new_rel).exists():
            raise Refused(f"exists already: {new_rel}")
        if old_rel in moved:
            raise Refused(f"moved twice: {old_rel}")
        if new_rel in moved.values():
            raise Refused(f"two moves share the new path: {new_rel}")
        moved[old_rel] = new_rel
    return moved


def plan_edits(
    root: Path, git: bool, moved: dict[str, str]
) -> tuple[list[FileEdit], list[str]]:
    """Return the content edits and the report lines, in path order."""
    edits: list[FileEdit] = []
    report: list[str] = []
    for rel in scan_set(root, git):
        text = read_text(root / rel)
        if text is None:
            continue
        new_rel = moved.get(rel, rel)
        rewritten = text
        if rel.endswith(".md"):
            rewritten, links = rewrite_links(text, rel, new_rel, moved, set())
            report += [f"link: {new_rel}: {old} -> {new}" for old, new in links]
        rewritten, paths = rewrite_paths(rewritten, moved)
        report += [f"path: {new_rel}:{line}: {old} -> {new}" for line, old, new in paths]
        if rewritten != text:
            edits.append(FileEdit(rel, text, rewritten))
    return edits, report


def _move(root: Path, git: bool, old: str, new: str) -> None:
    (root / new).parent.mkdir(parents=True, exist_ok=True)
    if git and tracked(root, old):
        result = _git(root, "mv", "--", old, new)
        if result.returncode != 0:
            raise OSError(result.stderr.strip() or f"git mv failed: {old}")
    else:
        shutil.move(str(root / old), str(root / new))


def apply(root: Path, git: bool, moved: dict[str, str], edits: list[FileEdit]) -> None:
    """Write the edits, then move the files; undo everything on a failure."""
    written: list[FileEdit] = []
    done: list[tuple[str, str]] = []
    try:
        for edit in edits:
            (root / edit.path).write_text(edit.new_text, encoding="utf-8")
            written.append(edit)
        for old, new in moved.items():
            _move(root, git, old, new)
            done.append((old, new))
    except OSError:
        for old, new in reversed(done):
            _move(root, git, new, old)
        for edit in written:
            (root / edit.path).write_text(edit.old_text, encoding="utf-8")
        raise


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="move-docs", description="Move files and rewrite every reference to them."
    )
    parser.add_argument("--dry-run", action="store_true", help="change no file")
    parser.add_argument("--root", default=".", help="project root (default: .)")
    parser.add_argument("paths", nargs="+", metavar="OLD NEW", help="pairs of paths")
    args = parser.parse_args(argv)

    if len(args.paths) % 2:
        print("move-docs: give the paths as OLD NEW pairs", file=sys.stderr)
        return 2
    root = Path(args.root).resolve()
    pairs = list(zip(args.paths[::2], args.paths[1::2], strict=True))
    try:
        moved = plan_moves(root, pairs)
    except Refused as error:
        print(f"move-docs: refused: {error}", file=sys.stderr)
        return 2

    git = is_git_repo(root)
    edits, report = plan_edits(root, git, moved)
    for old, new in moved.items():
        print(f"move: {old} -> {new}")
    for line in report:
        print(line)
    if args.dry_run:
        print(f"dry run: {len(moved)} moves, {len(edits)} files to edit, nothing changed")
        return 0
    try:
        apply(root, git, moved, edits)
    except OSError as error:
        print(f"move-docs: failed, every change undone: {error}", file=sys.stderr)
        return 1
    print(f"done: {len(moved)} moves, {len(edits)} files edited")
    return 0


if __name__ == "__main__":
    sys.exit(main())
