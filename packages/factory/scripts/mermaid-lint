#!/usr/bin/env python3
"""Reject raw semicolons in fenced Mermaid diagrams.

Mermaid treats semicolons as statement separators in some diagram grammars.
That makes a semicolon in prose capable of terminating the statement and
breaking the render. Entity escapes such as ``#59;`` remain allowed.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

FENCE_OPEN = re.compile(r"^(`{3,})\s*mermaid\s*$", re.IGNORECASE)
FENCE_CLOSE = re.compile(r"^(`{3,})\s*$")
ENTITY = re.compile(r"#(?:[A-Za-z][A-Za-z0-9]*|[0-9]+);")


def raw_semicolon_columns(line: str) -> list[int]:
    """Return one-based columns of semicolons not ending Mermaid entities."""
    allowed = {match.end() - 1 for match in ENTITY.finditer(line)}
    return [i + 1 for i, char in enumerate(line) if char == ";" and i not in allowed]


def check(path: Path) -> list[str]:
    errors: list[str] = []
    inside = False
    fence_len = 0

    for line_number, line in enumerate(
        path.read_text(encoding="utf-8").splitlines(), start=1
    ):
        if inside:
            close = FENCE_CLOSE.match(line)
            if close and len(close.group(1)) >= fence_len:
                inside = False
                continue
            for column in raw_semicolon_columns(line):
                errors.append(
                    f"{path}:{line_number}:{column}: MERMAID-SEMICOLON "
                    "raw semicolon in Mermaid block; use punctuation or #59;"
                )
            continue

        opening = FENCE_OPEN.match(line)
        if opening:
            inside = True
            fence_len = len(opening.group(1))

    return errors


def markdown_files(names: list[str]) -> list[Path]:
    if names:
        return [
            path
            for name in names
            if (path := Path(name)).is_file() and path.suffix.lower() == ".md"
        ]
    tracked = subprocess.run(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard", "*.md"],
        check=False,
        stdout=subprocess.PIPE,
    )
    if tracked.returncode == 0:
        return [Path(name.decode()) for name in tracked.stdout.split(b"\0") if name]

    root = Path.cwd()
    return [
        path
        for path in root.rglob("*.md")
        if not any(part.startswith(".") for part in path.relative_to(root).parts)
    ]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Reject raw semicolons in fenced Mermaid diagrams"
    )
    parser.add_argument("files", nargs="*")
    args = parser.parse_args(argv)

    errors = [error for path in markdown_files(args.files) for error in check(path)]
    if errors:
        print("\n".join(errors), file=sys.stderr)
        print(f"mermaid-lint: {len(errors)} error(s)", file=sys.stderr)
        return 1
    print("mermaid-lint: no raw semicolons found")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
