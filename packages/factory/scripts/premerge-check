#!/usr/bin/env python3
"""premerge-check — required, scripted gate on a finished branch before it
merges into its target. Replaces "the orchestrating session remembers to
diff the branch against its target" with a deterministic check
(docs/reviews/retro-2026-07-12.md action item #3, proposal §4).

What: Runs the stale-base, contaminated-diff, and semantic gate checks on
      a finished branch and writes the premerge-check-ok marker on success.
When: Before every branch merge into its target.
By:   run by the merging session; enforced by block-dangerous-git, which
      denies `git merge` without the marker.

Catches the two contaminated diffs the 2026-07-12 session hit by hand
(`git diff --stat` run manually, after the fact) and turns that habit into
a required step run before every merge, not after a full agent run is
already finished. Also enforces semantic quality gates (CRAP score, mutation
testing, dependency rules) before merge (proposal: Agentic Quality Gates
§ Design 5 — Gate Execution Lifecycle).

Checks
  1. Stale-base signature: `<branch>` must contain every commit reachable
     from `<target>` (`git merge-base --is-ancestor <target> <branch>`). If
     not, the diff `<target>...<branch>` necessarily reverts lines
     `<target>` already has — the same underlying condition verify-base
     checks pre-dispatch, checked here again post-dispatch as a second,
     independent gate.
  2. File-count blowout: `git diff --name-only <target>...<branch>` must
     not exceed `--max-files` (default 20) — a large, unscoped diff is the
     signature of a stale-base run that touched far more than intended.
     On a story branch, the story's own files in `docs/reviews/` and
     `docs/findings/` do not count. A file there belongs to the story when
     its name holds the story ID or its `story` field names the story.
  3. Out-of-scope paths (only if `--scope` given): every changed file must
     fall under at least one declared `--scope` prefix.
  4. Code review ran (story branches only): a report
     `docs/reviews/code-review-*.md` at the branch head sets `story` to the
     story ID and `branch_head` to an ancestor of the branch head (BR-122).
  5. Findings are closed (story branches only): no finding file
     `docs/findings/<ID>.md` at the branch head with `story` set to the
     story ID is open and blocking (BR-085). Register files never block.
     Checks 4 and 5 read the branch head through git, never the folder
     premerge-check runs in.
  6. Semantic gates (story branches only): if `<branch>` matches the pattern
     `story/ST-NNNN`, premerge-check adds a detached worktree at the branch
     head under `.current-work/<target>/premerge/<story-id>` of the primary
     checkout and removes it afterwards (BR-123, ADR-0038). Before the add,
     it removes a worktree that a crashed run left at that path. The gate
     list comes from the story file at the branch head (BR-066). Each gate
     is a hard gate — failure of any one blocks the merge.
       - `dependency-check`: when `docs/spec/dependency-rules.dsl` exists at
         the branch head; otherwise premerge-check prints the skip. Reruns
         in the worktree.
       - `test-design-verify`: when the story has a Test Design or Prior
         Tests heading. Reruns in the worktree.
       - Every entry under `gates` in `docs/testing.yaml` with
         `enabled: true`, plus each gate of the story's `quality-gates`
         field. The field only adds gates. premerge-check builds the calls
         of `crap-score` and `mutation-testing`; every other gate runs its
         `command` through the shell. A gate without an entry or without a
         command fails and is named. The old keys `crap_score`,
         `mutation_testing`, and `test_design_verify` count as the entries
         of their gates; with both forms, the key with hyphens wins with a
         warning (BR-055). Without the field and without a `gates` section,
         `crap-score` runs alone. No default picks `mutation-testing`.
       - The test suite: `test_command` of `docs/testing.yaml`. A non-zero
         exit fails and names the test suite. Without `test_command`,
         premerge-check prints the skip.
     A built-in gate runs from `.agent-factory/factory/scripts/` of the
     primary checkout, or from the folder of premerge-check when that copy
     lacks the script. The worktree is its source root, and `uv` builds the
     worktree's own environment (OI-10). No file of a checkout changes, and
     no stash is made.
     `default_quality_gates` in `docs/charter/house-rules.md` is no gate
     source; when found, premerge-check prints a warning that names the file.

Usage
  premerge-check <target> <branch> [--scope PATH ...] [--max-files N]

Exit codes
  0: PASS — no blocking finding
  1: BLOCK — at least one blocking finding; do not merge without an
     explicit override
  2: usage or git-invocation error

On PASS, writes `.current-work/premerge-check-ok` at the invoking repo's
top level, keyed to `<branch>`'s current head SHA.
`.agent-factory/factory/config/hooks/block-dangerous-git.sh` denies `git merge <branch>`
unless that marker matches — mechanical enforcement, not just a prompt
instruction.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from dispatch_lib import _load_yaml, glob_match, stop_notice

try:
    import yaml
except ImportError:
    yaml = None  # type: ignore[assignment]

YAML_ERRORS: tuple[type[Exception], ...] = (ValueError, KeyError) + (
    (yaml.YAMLError,) if yaml else ()
)


def run_git(args: list[str]) -> tuple[int, str, str]:
    result = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
    return result.returncode, result.stdout.strip(), result.stderr.strip()


def write_marker(branch: str) -> None:
    code, top, _ = run_git(["rev-parse", "--show-toplevel"])

    if code != 0:
        return

    _, head, _ = run_git(["rev-parse", branch])
    marker_dir = Path(top) / ".current-work"
    marker_dir.mkdir(exist_ok=True)
    (marker_dir / "premerge-check-ok").write_text(f"branch={branch}\nhead={head}\n")


def check_stale_base(target: str, branch: str) -> tuple[bool, str]:
    code, _, err = run_git(["merge-base", "--is-ancestor", target, branch])

    if code == 128:
        return False, f"ERROR: {err or 'unknown ref while checking ancestry'}"

    if code != 0:
        _, out, _ = run_git(
            ["rev-list", "--left-right", "--count", f"{target}...{branch}"]
        )
        left, _, _ = out.partition("\t")
        return False, (
            f"BLOCK stale-base-signature: {branch!r} is missing "
            f"{left.strip() or '?'} commit(s) present on {target!r} — the diff "
            f"necessarily reverts already-merged work"
        )

    return True, f"PASS stale-base-signature: {branch!r} contains all of {target!r}"


def changed_files(target: str, branch: str) -> tuple[int, list[str], str]:
    code, out, err = run_git(["diff", "--name-only", f"{target}...{branch}"])

    if code != 0:
        return 2, [], err

    files = [line for line in out.splitlines() if line]
    return 0, files, ""


def check_blowout(
    files: list[str], max_files: int, uncounted: list[str] | None = None
) -> tuple[bool, str]:
    """Count the changed files without *uncounted*, the story's own files."""
    skipped = set(uncounted or [])
    count = len([f for f in files if f not in skipped])
    note = (
        f", not counting {len(skipped)} review or finding file(s) of the story"
        if skipped
        else ""
    )
    if count > max_files:
        return False, (
            f"BLOCK file-count-blowout: {count} files changed{note}, "
            f"exceeds --max-files {max_files}"
        )

    return (
        True,
        f"PASS file-count-blowout: {count} files changed{note} (limit {max_files})",
    )


def check_out_of_scope(
    files: list[str],
    scopes: list[str],
    scope_globs: list[str] | None = None,
) -> tuple[bool, str]:
    if not scopes and not scope_globs:
        return True, "SKIP out-of-scope-paths: no --scope declared"

    def _in_scope(f: str) -> bool:
        if any(f == s or f.startswith(s.rstrip("/") + "/") for s in scopes):
            return True
        return bool(scope_globs and any(glob_match(g, f) for g in scope_globs))

    out_of_scope = [f for f in files if not _in_scope(f)]

    if out_of_scope:
        listed = ", ".join(out_of_scope[:10])
        more = f" (+{len(out_of_scope) - 10} more)" if len(out_of_scope) > 10 else ""
        return False, f"BLOCK out-of-scope-paths: {listed}{more}"

    return (
        True,
        f"PASS out-of-scope-paths: all {len(files)} file(s) under declared scope",
    )


def extract_story_id(branch: str) -> str | None:
    """Extract story ID from branch name (e.g., 'story/ST-0105' -> 'ST-0105')."""
    match = re.match(r"^story/(ST-\d+)$", branch)
    return match.group(1) if match else None


def _parse_yaml_frontmatter(frontmatter: str) -> dict:
    """Minimal YAML parser for story frontmatter. Handles lists and simple scalars."""
    result = {}
    lines = frontmatter.strip().split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip() or line.strip().startswith("#"):
            i += 1
            continue

        # Parse key: value or key: [list items]
        if ":" in line:
            key, _, value = line.partition(":")
            key = key.strip()
            value = value.strip()

            # Handle list syntax: key: [item1, item2]
            if value.startswith("[") and value.endswith("]"):
                inner = value[1:-1].strip()
                result[key] = (
                    [item.strip() for item in inner.split(",") if item.strip()]
                    if inner
                    else []
                )
            # Handle list items on next lines
            elif value == "" or value.startswith("-"):
                items = []
                if value.startswith("-"):
                    items.append(value[1:].strip())
                i += 1
                while i < len(lines):
                    line = lines[i]
                    stripped = line.strip()
                    if stripped.startswith("-"):
                        items.append(stripped[1:].strip())
                        i += 1
                    elif stripped and not ":" in line:
                        i += 1
                    else:
                        break
                if items:
                    result[key] = items
                continue
            else:
                result[key] = value

        i += 1

    return result


def read_story_file(story_id: str, top: Path) -> dict | None:
    """Read story YAML frontmatter. Returns dict with parsed YAML or None."""
    story_file = top / "backlog" / f"{story_id}.md"
    if not story_file.exists():
        return None

    try:
        return parse_frontmatter(story_file.read_text())
    except OSError:
        return None


def parse_frontmatter(content: str) -> dict | None:
    """Return the YAML frontmatter between the `---` lines, or None without one."""
    if not content.startswith("---"):
        return None
    end_of_front = content.find("\n---\n", 3)
    if end_of_front == -1:
        return None
    frontmatter = content[3:end_of_front]
    try:
        # Try to use yaml library if available, fall back to simple parser
        data = yaml.safe_load(frontmatter) if yaml else _parse_yaml_frontmatter(frontmatter)
    except YAML_ERRORS:
        return None
    return data if isinstance(data, dict) else None


# --- Review and finding checks at the branch head (BR-085, BR-121, BR-122) ---

REVIEWS_DIR = "docs/reviews/"
FINDINGS_DIR = "docs/findings/"
REGISTER_DIR = "docs/findings/register/"
BLOCKING_CATEGORIES = ("defect", "risk")
BLOCKING_SEVERITIES = ("critical", "major")


class GitReadError(Exception):
    """git cannot read a file at the branch head."""


def files_at_head(branch: str, folder: str) -> list[str]:
    """The tracked files under *folder* at the head of *branch*."""
    code, out, err = run_git(["ls-tree", "-r", "--name-only", branch, "--", folder])
    if code != 0:
        raise GitReadError(f"git ls-tree {branch} {folder}: {err}")
    return [line for line in out.splitlines() if line]


def read_at_head(branch: str, paths: list[str]) -> dict[str, str]:
    """Read each of *paths* at the head of *branch* in one `git cat-file` call."""
    if not paths:
        return {}
    request = "".join(f"{branch}:{path}\n" for path in paths).encode()
    result = subprocess.run(
        ["git", "cat-file", "--batch"], input=request, capture_output=True, check=False
    )
    if result.returncode != 0:
        raise GitReadError(f"git cat-file --batch: {result.stderr.decode().strip()}")
    texts: dict[str, str] = {}
    out, pos = result.stdout, 0
    for path in paths:
        end = out.index(b"\n", pos)
        header = out[pos:end].decode()
        if header.endswith((" missing", " ambiguous")):
            raise GitReadError(f"git cat-file: {branch}:{path} {header.rsplit(' ', 1)[1]}")
        size = int(header.rsplit(" ", 1)[1])
        texts[path] = out[end + 1 : end + 1 + size].decode(errors="replace")
        pos = end + 1 + size + 1
    return texts


def parse_record(path: str, text: str) -> dict:
    """The fields of a review report, finding file, or register file."""
    if path.endswith(".json"):
        try:
            data = json.loads(text)
        except ValueError:
            return {}
        return data if isinstance(data, dict) else {}
    return parse_frontmatter(text) or {}


def _field(record: dict, key: str) -> str:
    value = record.get(key)
    return "" if value is None else str(value).strip()


def is_blocking(record: dict) -> bool:
    """The blocking rule of finding-classification.md (BR-085)."""
    return (
        _field(record, "category") in BLOCKING_CATEGORIES
        and _field(record, "severity") in BLOCKING_SEVERITIES
    )


def _is_finding_file(path: str) -> bool:
    """A finding file is `docs/findings/<ID>.md`, not a register file."""
    name = path[len(FINDINGS_DIR):] if path.startswith(FINDINGS_DIR) else ""
    return name.endswith(".md") and "/" not in name


def _records_of_story(branch: str, story_id: str, paths: list[str]) -> dict[str, dict]:
    """The records among *paths* whose `story` field names *story_id*."""
    records = {}
    for path, text in read_at_head(branch, paths).items():
        if story_id not in text:
            continue
        record = parse_record(path, text)
        if _field(record, "story") == story_id:
            records[path] = record
    return records


def story_owned_files(branch: str, story_id: str, files: list[str]) -> list[str]:
    """The files of *files* in docs/reviews/ and docs/findings/ that belong to
    the story: the name holds the story ID, or the `story` field at the head
    of *branch* names the story. A file the branch deleted is not the story's.
    """
    candidates = [f for f in files if f.startswith((REVIEWS_DIR, FINDINGS_DIR))]
    if not candidates:
        return []
    present = set(files_at_head(branch, REVIEWS_DIR) + files_at_head(branch, FINDINGS_DIR))
    by_name = [f for f in candidates if story_id in Path(f).name]
    to_read = [f for f in candidates if f not in by_name and f in present]
    by_field = _records_of_story(branch, story_id, to_read)
    return [f for f in candidates if f in by_name or f in by_field]


def _is_ancestor(commit: str, branch: str) -> bool:
    if not commit:
        return False
    code, _, _ = run_git(["merge-base", "--is-ancestor", commit, branch])
    return code == 0


def check_code_review(branch: str, story_id: str) -> tuple[bool, str]:
    """Pass when a code-review report of the story reviewed an ancestor of the head."""
    reports = [
        f for f in files_at_head(branch, REVIEWS_DIR)
        if Path(f).name.startswith("code-review-") and f.endswith(".md")
    ]
    for path, record in sorted(_records_of_story(branch, story_id, reports).items()):
        if _is_ancestor(_field(record, "branch_head"), branch):
            return True, (
                f"PASS code-review: {path} reviewed an ancestor of the head of {branch}"
            )
    return False, (
        f"BLOCK code-review: no report {REVIEWS_DIR}code-review-{story_id}-YYYY-MM-DD.md "
        f"at the head of {branch} has story {story_id} and a branch_head that is "
        f"an ancestor of the head (BR-122)"
    )


def check_open_findings(branch: str, story_id: str) -> tuple[bool, str]:
    """Refuse while a blocking finding file of the story is open at the head."""
    finding_files = [f for f in files_at_head(branch, FINDINGS_DIR) if _is_finding_file(f)]
    open_ids = [
        _field(record, "id") or Path(path).stem
        for path, record in sorted(_records_of_story(branch, story_id, finding_files).items())
        if _field(record, "status") == "open" and is_blocking(record)
    ]
    if open_ids:
        return False, (
            f"BLOCK open-findings: {', '.join(open_ids)} of {story_id} "
            f"{'is' if len(open_ids) == 1 else 'are'} open and blocking at the head of {branch}"
        )
    return True, f"PASS open-findings: no open blocking finding of {story_id} at the head of {branch}"


# Gates whose call premerge-check builds; every other gate needs a command.
BUILT_IN_GATES = ("crap-score", "mutation-testing")
# Gates that run by their own condition and have no entry to pick (BR-066).
CONDITIONAL_GATES = ("dependency-check", "test-design-verify")
# Old keys with underscores and the gate each one names (BR-055).
OLD_GATE_KEYS = {
    "crap_score": "crap-score",
    "mutation_testing": "mutation-testing",
    "test_design_verify": "test-design-verify",
}
DEFAULT_GATES = ["crap-score"]
HOUSE_RULES = "docs/charter/house-rules.md"
TEST_DESIGN_HEADING = re.compile(r"^#{1,6}\s+(Test Design|Prior Tests)\s*$", re.MULTILINE)
DEPENDENCY_RULES = "docs/spec/dependency-rules.dsl"
TESTING_YAML = "docs/testing.yaml"
INSTALLED_SCRIPTS = Path(".agent-factory") / "factory" / "scripts"
# Variables that point uv at the caller's environment instead of the worktree's.
FOREIGN_ENVIRONMENT = ("VIRTUAL_ENV", "UV_PROJECT_ENVIRONMENT")


def _read_testing_yaml(top: Path) -> dict:
    """Return docs/testing.yaml as a mapping, or an empty mapping without one."""
    path = top / TESTING_YAML
    if not path.is_file():
        return {}
    try:
        data = _load_yaml(path.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def gate_entries(top: Path) -> tuple[dict[str, dict] | None, list[str]]:
    """Return the entries of the `gates` section by gate name, and the warnings.

    An old key with underscores counts as the entry of its gate. With both
    forms, the key with hyphens wins and a warning names the old key (BR-055).
    A scalar such as `attempts` is no gate. Without a `gates` section, the
    entries are None.
    """
    gates = _read_testing_yaml(top).get("gates")
    if not isinstance(gates, dict):
        return None, []
    entries: dict[str, dict] = {}
    warnings: list[str] = []
    for key, value in gates.items():
        if not isinstance(value, dict) or key in OLD_GATE_KEYS:
            continue
        entries[str(key)] = value
    for old, name in OLD_GATE_KEYS.items():
        value = gates.get(old)
        if not isinstance(value, dict):
            continue
        if name in entries:
            warnings.append(
                f"WARN semantic-gates: {TESTING_YAML} has gates.{old} and gates.{name}; "
                f"premerge-check uses gates.{name}, so delete gates.{old}"
            )
            continue
        entries[name] = value
    return entries, warnings


def _quality_gates(story_data: dict | None) -> list[str] | None:
    """Return the story's `quality-gates` field as a list, or None without one."""
    if not story_data or story_data.get("quality-gates") is None:
        return None
    field = story_data["quality-gates"]
    return [str(g) for g in (field if isinstance(field, list) else [field])]


def _picked_gates(story_data: dict | None, entries: dict[str, dict] | None) -> list[str]:
    """Every enabled entry, then the gates the story's field adds (BR-066)."""
    field = _quality_gates(story_data)
    if field is None and entries is None:
        return list(DEFAULT_GATES)
    picked = [
        name
        for name, entry in (entries or {}).items()
        if entry.get("enabled") is True and name not in CONDITIONAL_GATES
    ]
    for name in field or []:
        if name not in picked and name not in CONDITIONAL_GATES:
            picked.append(name)
    return picked


def _house_rules_warning(top: Path) -> list[str]:
    path = top / HOUSE_RULES
    try:
        if path.is_file() and "default_quality_gates:" in path.read_text():
            return [
                f"WARN semantic-gates: {HOUSE_RULES} still has default_quality_gates; "
                "premerge-check ignores it and takes the gates from docs/testing.yaml"
            ]
    except OSError:
        pass
    return []


def resolve_gates(top: Path, story_id: str) -> tuple[list[str], list[str]]:
    """Return the gates the merge requires, and any warnings."""
    entries, warnings = gate_entries(top)
    gates = _picked_gates(read_story_file(story_id, top), entries)
    story_path = top / "backlog" / f"{story_id}.md"
    try:
        story_text = story_path.read_text() if story_path.is_file() else ""
    except OSError:
        story_text = ""
    if TEST_DESIGN_HEADING.search(story_text):
        gates.append("test-design-verify")
    if (top / DEPENDENCY_RULES).is_file():
        gates.append("dependency-check")
    return gates, warnings + _house_rules_warning(top)


def gate_refusal(gate: str, entries: dict[str, dict] | None) -> str | None:
    """Name why docs/testing.yaml cannot run *gate*, or None when it can.

    A built-in or conditional gate needs no command. Every other gate needs
    an entry with a command (BR-066, RL-G09, OI-15).
    """
    if gate in BUILT_IN_GATES or gate in CONDITIONAL_GATES:
        return None
    entry = (entries or {}).get(gate)
    if entry is None:
        return f"no entry gates.{gate} in {TESTING_YAML}"
    command = entry.get("command")
    if not isinstance(command, str) or not command.strip():
        return f"gates.{gate} in {TESTING_YAML} has no command"
    return None


def dependency_skip_notice(top: Path) -> list[str]:
    """Name the skip of dependency-check when *top* has no rules file (BR-066)."""
    if (top / DEPENDENCY_RULES).is_file():
        return []
    return [f"SKIP dependency-check: {DEPENDENCY_RULES} does not exist"]


def changed_python_files(top: Path, files: list[str]) -> list[str]:
    """The `.py` files of the story's diff that still exist in *top* (BR-066)."""
    return [f for f in files if f.endswith(".py") and (top / f).is_file()]


def crap_score_skip_notice(gates: list[str], py_files: list[str], story_id: str) -> list[str]:
    """Name the empty run of crap-score when the story changed no `.py` file."""
    if "crap-score" not in gates or py_files:
        return []
    return [f"PASS crap-score: {story_id} changed no .py file, so it scored nothing"]


def _describe_row(row: dict) -> str:
    name = row.get("function") or row.get("rule_name") or row.get("file") or "?"
    if "crap_score" in row:
        return f"{name} {row['crap_score']}"
    return str(name)


def read_gate_result(path: Path) -> tuple[bool, str]:
    """Read one gate result file.

    crap-score and dependency-check write a list of rows with `pass_fail`;
    test-design-verify writes an object with `passed`.
    """
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return False, "invalid result"
    if isinstance(data, list):
        failing = [r for r in data if not isinstance(r, dict) or r.get("pass_fail") != "pass"]
        if not failing:
            return True, "passed"
        return False, "failed: " + ", ".join(
            _describe_row(r) if isinstance(r, dict) else "invalid row" for r in failing
        )
    if isinstance(data, dict):
        return (True, "passed") if data.get("passed") is True else (False, "failed")
    return False, "invalid result"


def primary_checkout() -> Path | None:
    """Return the top folder of the primary checkout, also from a linked worktree."""
    code, common, _ = run_git(["rev-parse", "--path-format=absolute", "--git-common-dir"])
    if code != 0:
        return None
    common_dir = Path(common)
    if common_dir.name == ".git":
        return common_dir.parent
    code, top, _ = run_git(["rev-parse", "--show-toplevel"])
    return Path(top) if code == 0 else None


def premerge_path(primary: Path, feature_branch: str, unit_id: str) -> Path:
    """Path of the temporary worktree of one unit of work (BR-123)."""
    return primary / ".current-work" / feature_branch / "premerge" / unit_id


def remove_worktree(path: Path) -> None:
    """Remove the worktree at *path*, if any, and prune its record (BR-123)."""
    run_git(["worktree", "remove", "--force", str(path)])
    run_git(["worktree", "prune"])


def add_worktree(path: Path, branch: str) -> tuple[bool, str]:
    """Remove a leftover at *path*, then add a detached worktree at *branch*'s head."""
    remove_worktree(path)
    code, _, err = run_git(["worktree", "add", "--detach", str(path), branch])
    return code == 0, err


def gate_script(primary: Path, gate: str) -> Path:
    """The installed copy of the primary checkout, else the folder of this script."""
    installed = primary / INSTALLED_SCRIPTS / gate
    return installed if installed.is_file() else SCRIPT_DIR / gate


def _threshold(entries: dict[str, dict] | None) -> object:
    return (entries or {}).get("crap-score", {}).get("threshold")


def gate_command(
    script: Path,
    gate: str,
    worktree: Path,
    story_id: str,
    entries: dict[str, dict] | None = None,
    py_files: list[str] | None = None,
) -> list[str]:
    """Build the call of a gate that premerge-check names (BR-066, RL-G17).

    crap-score scores only *py_files*, the `.py` files of the story's diff.
    """
    report_dir = worktree / ".current-work" / gate
    if gate == "dependency-check":
        return [
            str(script),
            "--dsl-path", str(worktree / DEPENDENCY_RULES),
            "--source-root", str(worktree),
            "--story-id", story_id,
            "--report-dir", str(report_dir),
        ]
    if gate == "crap-score":
        threshold = _threshold(entries)
        extra = ["--threshold", str(threshold)] if threshold is not None else []
        return [
            str(script),
            "--source-root", str(worktree),
            "--story-id", story_id,
            "--report-dir", str(report_dir),
            *extra,
            "--",
            *(str(worktree / f) for f in py_files or []),
        ]
    if gate == "mutation-testing":
        return [
            str(script),
            "--story-id", story_id,
            "--testing-yaml", str(worktree / TESTING_YAML),
            "--report-dir", str(report_dir),
        ]
    return [
        str(script),
        "--story", str(worktree / "backlog" / f"{story_id}.md"),
        "--story-id", story_id,
        "--scope-map", str(worktree / "docs" / "spec" / "scope-map.md"),
        "--spec-dir", str(worktree / "docs" / "spec" / "features"),
        "--repo-root", str(worktree),
        "--epics", str(worktree / "backlog" / "epics.md"),
        "--report-dir", str(report_dir),
    ]


def _worktree_environment() -> dict[str, str]:
    """The caller's environment without the variables that point uv elsewhere."""
    return {k: v for k, v in os.environ.items() if k not in FOREIGN_ENVIRONMENT}


def _failure_detail(result: subprocess.CompletedProcess, report: Path | None) -> str:
    if report is not None and report.is_file():
        ok, detail = read_gate_result(report)
        if not ok and detail != "failed":
            return detail
    lines = (result.stderr or result.stdout).strip().splitlines()
    return f"exit {result.returncode}" + (f": {lines[-1]}" if lines else "")


def rerun_gate(
    primary: Path,
    gate: str,
    worktree: Path,
    story_id: str,
    entries: dict[str, dict] | None = None,
    py_files: list[str] | None = None,
) -> tuple[bool, str]:
    """Run *gate* in *worktree* and judge it by its exit code.

    premerge-check builds the call of a gate it names. Every other gate runs
    the `command` of its entry through the shell.
    """
    refusal = gate_refusal(gate, entries)
    if refusal is not None:
        return False, refusal
    if gate == "crap-score" and not py_files:
        return True, "scored nothing"
    env = _worktree_environment()
    if gate in BUILT_IN_GATES or gate in CONDITIONAL_GATES:
        script = gate_script(primary, gate)
        call: list[str] | str = gate_command(
            script, gate, worktree, story_id, entries, py_files
        )
        shell = False
        report: Path | None = worktree / ".current-work" / gate / f"{story_id}.json"
    else:
        call = str((entries or {})[gate]["command"])
        shell = True
        report = None
    try:
        result = subprocess.run(
            call, shell=shell, cwd=worktree, env=env,
            capture_output=True, text=True, check=False,
        )
    except OSError as exc:
        return False, f"cannot run {call}: {exc}"
    if result.returncode == 0:
        return True, "passed"
    return False, _failure_detail(result, report)


def check_semantic_gates(
    gates: list[str],
    story_id: str,
    worktree: Path,
    primary: Path,
    py_files: list[str] | None = None,
) -> list[str]:
    """Run each gate in *worktree* and return one entry per gate that fails."""
    entries, _ = gate_entries(worktree)
    failed_gates = []
    for gate in gates:
        ok, detail = rerun_gate(primary, gate, worktree, story_id, entries, py_files)
        if not ok:
            failed_gates.append(f"{gate} ({detail})")
    return failed_gates


def read_test_command(top: Path) -> str | None:
    """Return `test_command` of docs/testing.yaml, or None without one."""
    command = _read_testing_yaml(top).get("test_command")
    return command.strip() if isinstance(command, str) and command.strip() else None


def check_test_suite(worktree: Path, story_id: str) -> tuple[bool, str]:
    """Run the test suite in *worktree* with its own uv environment (OI-10)."""
    command = read_test_command(worktree)
    if command is None:
        return True, f"SKIP test-suite: {TESTING_YAML} has no test_command"
    try:
        result = subprocess.run(
            command, shell=True, cwd=worktree, env=_worktree_environment(),
            capture_output=True, text=True, check=False,
        )
    except OSError as exc:
        return False, f"BLOCK test-suite: cannot run {command!r}: {exc}"
    if result.returncode != 0:
        lines = (result.stdout + result.stderr).strip().splitlines()
        tail = f": {lines[-1]}" if lines else ""
        return False, (
            f"BLOCK test-suite: the test suite {command!r} exited "
            f"{result.returncode} for {story_id}{tail}"
        )
    return True, f"PASS test-suite: the test suite {command!r} passed for {story_id}"


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("target", help="merge target branch, e.g. dev")
    ap.add_argument("branch", help="finished branch being considered for merge")
    ap.add_argument(
        "--scope",
        action="append",
        default=[],
        metavar="PATH",
        help="declared path prefix the dispatch said it would touch; repeatable",
    )
    ap.add_argument(
        "--scope-glob",
        action="append",
        default=[],
        metavar="PATTERN",
        help="gitignore-style glob pattern for scope matching; repeatable",
    )
    ap.add_argument(
        "--max-files",
        type=int,
        default=20,
        metavar="N",
        help="file-count blowout threshold (default 20)",
    )
    args = ap.parse_args(argv)

    code, _, err = run_git(["rev-parse", "--is-inside-work-tree"])

    if code != 0:
        print(f"premerge-check: not a git repository: {err}", file=sys.stderr)
        return 2

    # The stop on a critical finding comes before every other check. During
    # a stop, no other check runs and no marker is written (BR-091).
    notice = stop_notice()
    if notice is not None:
        sys.stdout.write(notice)
        return 1

    findings: list[bool] = []

    ok, line = check_stale_base(args.target, args.branch)
    print(line)
    findings.append(ok)

    status, files, err = changed_files(args.target, args.branch)

    if status == 2:
        print(f"premerge-check: {err}", file=sys.stderr)
        return 2

    story_id = extract_story_id(args.branch)
    try:
        owned = story_owned_files(args.branch, story_id, files) if story_id else []
    except GitReadError as exc:
        print(f"premerge-check: {exc}", file=sys.stderr)
        return 2

    ok, line = check_blowout(files, args.max_files, owned)
    print(line)
    findings.append(ok)

    ok, line = check_out_of_scope(files, args.scope, args.scope_glob)
    print(line)
    findings.append(ok)

    if story_id:
        try:
            for check in (check_code_review, check_open_findings):
                ok, line = check(args.branch, story_id)
                print(line)
                findings.append(ok)
        except GitReadError as exc:
            print(f"premerge-check: {exc}", file=sys.stderr)
            return 2

    # Check semantic gates if branch is a story branch
    if story_id:
        code, top, err = run_git(["rev-parse", "--show-toplevel"])
        if code != 0:
            print(f"premerge-check: {err}", file=sys.stderr)
            return 2
        primary = primary_checkout() or Path(top)
        worktree = premerge_path(primary, args.target, story_id)
        added, err = add_worktree(worktree, args.branch)
        if not added:
            remove_worktree(worktree)
            print(f"premerge-check: cannot add worktree {worktree}: {err}", file=sys.stderr)
            return 2
        try:
            gates, warnings = resolve_gates(worktree, story_id)
            py_files = changed_python_files(worktree, files)
            notices = dependency_skip_notice(worktree)
            notices += crap_score_skip_notice(gates, py_files, story_id)
            for warning in warnings + notices:
                print(warning)
            failed_gates = check_semantic_gates(
                gates, story_id, worktree, primary, py_files
            )
            suite_ok, suite_line = check_test_suite(worktree, story_id)
        finally:
            remove_worktree(worktree)
        if failed_gates:
            print(f"BLOCK semantic-gates: {', '.join(failed_gates)} for {story_id}")
        elif gates:
            print(f"PASS semantic-gates: {', '.join(gates)} passed for {story_id}")
        else:
            print(f"PASS semantic-gates: no gate applies to {story_id}")
        findings.append(not failed_gates)
        print(suite_line)
        findings.append(suite_ok)
    else:
        # Non-story branches skip semantic gates
        print("SKIP semantic-gates: branch does not match story/ST-NNNN pattern")

    if all(findings):
        print(
            f"premerge-check: PASS — {args.branch!r} clean to merge into {args.target!r}"
        )
        write_marker(args.branch)
        return 0

    print(
        f"premerge-check: BLOCK — do not merge {args.branch!r} without an explicit override"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
