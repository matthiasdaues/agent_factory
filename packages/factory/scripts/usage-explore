#!/usr/bin/env python3
"""usage-explore — project-root wrapper for the usage DuckDB explorer UI.

Discovers the installed usage-analysis component or the development source
and launches the web-based SQL explorer. Stdlib-only.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _find_usage_package() -> Path | None:
    """Return the directory containing the usage package's pyproject.toml."""
    cwd = Path(os.getcwd()).resolve()
    for parent in [cwd, *cwd.parents]:
        installed = parent / ".agent-factory" / "usage-analysis"
        if (installed / "pyproject.toml").is_file():
            return installed
        source = parent / "packages" / "usage"
        if (source / "pyproject.toml").is_file():
            return source
    return None


def _find_evidence_dir() -> str | None:
    """Return the evidence spool directory if it exists."""
    cwd = Path(os.getcwd()).resolve()
    for parent in [cwd, *cwd.parents]:
        candidate = parent / ".agent-factory" / "usage"
        if candidate.is_dir():
            return str(candidate)
    return None


def main() -> None:
    if len(sys.argv) < 2:
        print(
            "usage: usage-explore <path.duckdb> [port] [--no-watch]",
            file=sys.stderr,
        )
        sys.exit(2)

    pkg = _find_usage_package()
    if pkg is None:
        print(
            "usage-explore: usage package not found "
            "(no .agent-factory/usage-analysis/ or packages/usage/)",
            file=sys.stderr,
        )
        sys.exit(2)

    no_watch = "--no-watch" in sys.argv
    argv = [a for a in sys.argv[1:] if a != "--no-watch"]

    db_path = Path(argv[0]).resolve()
    rest = argv[1:]

    watch_args: list[str] = []
    if not no_watch:
        evidence = _find_evidence_dir()
        if evidence:
            watch_args = ["--watch", evidence]

    os.execvp("uv", [
        "uv", "run", "--directory", str(pkg),
        "python", "-m", "usage.explorer", str(db_path), *rest, *watch_args
    ])


if __name__ == "__main__":
    main()
