#!/usr/bin/env python3
"""usage-explore — project-root wrapper for the usage DuckDB explorer UI.

Discovers the installed usage-analysis component or the development source
and launches the web-based SQL explorer. Stdlib-only.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _find_usage_package() -> Path | None:
    """Return the directory containing the usage package's pyproject.toml."""
    cwd = Path(os.getcwd()).resolve()
    for parent in [cwd, *cwd.parents]:
        installed = parent / ".agent-factory" / "usage-analysis"
        if (installed / "pyproject.toml").is_file():
            return installed
        source = parent / "packages" / "usage"
        if (source / "pyproject.toml").is_file():
            return source
    return None


def main() -> None:
    if len(sys.argv) < 2:
        print(
            "usage: usage-explore <path.duckdb> [port]",
            file=sys.stderr,
        )
        sys.exit(2)

    pkg = _find_usage_package()
    if pkg is None:
        print(
            "usage-explore: usage package not found "
            "(no .agent-factory/usage-analysis/ or packages/usage/)",
            file=sys.stderr,
        )
        sys.exit(2)
    os.execvp("uv", [
        "uv", "run", "--directory", str(pkg),
        "python", "-m", "usage.explorer", *sys.argv[1:]
    ])


if __name__ == "__main__":
    main()
