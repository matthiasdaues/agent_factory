def _install_copilot_guardrail(target: Path, install: dict, report: list[str]) -> None:
    hooks_dir = target / ".github" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    install["github_ignored_entries"].add(".github/hooks")

    script_link = hooks_dir / "block-dangerous-git.sh"
    script_dest = target / "factory" / "config" / "hooks" / "block-dangerous-git.sh"
    ensure_symlink(script_link, script_dest, report, install=install)

    config_link = hooks_dir / "block-dangerous-git.json"
    config_dest = target / "factory" / "config" / "hooks" / "block-dangerous-git.json"
    ensure_symlink(config_link, config_dest, report, install=install)


def _install_copilot_step_guard(target: Path, install: dict, report: list[str]) -> None:
    hooks_dir = target / ".github" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    install["github_ignored_entries"].add(".github/hooks")

    for name in ("step-guard.sh", "step-guard.json"):
        ensure_symlink(
            hooks_dir / name,
            target / "factory" / "config" / "hooks" / name,
            report,
            install=install,
        )


def _install_codex_step_guard(target: Path, install: dict, report: list[str]) -> None:
    """Merge Factory's Codex step-guard hooks into project hook config."""
    hooks_dir = _ensure_codex_hooks_dir(target, install, report)
    install["codex_ignored_entries"].add(".codex/hooks/step-guard.sh")

    ensure_symlink(
        hooks_dir / "step-guard.sh",
        target / "factory" / "config" / "hooks" / "step-guard.sh",
        report,
        install=install,
    )

    path, config, hooks, existed = _load_codex_hooks(target, install)
    entries = hooks.setdefault("PreToolUse", [])
    if not isinstance(entries, list):
        raise Collision(f"{path}: 'hooks.PreToolUse' exists but isn't a list")

    changed = False
    for event, command in CODEX_STEP_GUARD_HOOK_COMMANDS.items():
        already_wired = any(
            isinstance(entry, dict)
            and entry.get("matcher") == event
            and any(
                isinstance(hook, dict) and hook.get("command") == command
                for hook in (entry.get("hooks", []) if isinstance(entry, dict) else [])
            )
            for entry in entries
        )
        if already_wired:
            continue
        entries.append(
            {
                "matcher": event,
                "hooks": [{"type": "command", "command": command}],
            }
        )
        _record_codex_handler(
            install,
            {"event": "PreToolUse", "matcher": event, "command": command},
        )
        changed = True

    if changed or not existed:
        path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        log(report, ".codex/hooks.json: wired step-guard PreToolUse entries")


def _ensure_pi_extensions_dir(target: Path, install: dict, report: list[str]) -> Path:
    extensions_dir = target / ".pi" / "extensions"
    if not extensions_dir.exists():
        extensions_dir.mkdir(parents=True)
        install["remove_paths"].append(".pi/extensions")
        log(report, ".pi/extensions: created")
    return extensions_dir


def _install_pi_guardrail(target: Path, install: dict, report: list[str]) -> None:
    extensions_dir = _ensure_pi_extensions_dir(target, install, report)

    link = extensions_dir / "block-dangerous-git.ts"
    dest = target / "factory" / "config" / "extensions" / "block-dangerous-git.ts"
    ensure_symlink(link, dest, report, install=install)


def _install_pi_step_guard(target: Path, install: dict, report: list[str]) -> None:
    extensions_dir = _ensure_pi_extensions_dir(target, install, report)

    link = extensions_dir / "step-guard.ts"
    dest = target / "factory" / "config" / "extensions" / "step-guard.ts"
    ensure_symlink(link, dest, report, install=install)


def install_pi_invocation_layer(target: Path, install: dict, report: list[str]) -> None:
    """Symlink the Pi invocation-layer extensions into .pi/extensions/. Pi has
    no native subagent concept; run_agent runs one factory agent in a separate
    Pi session, and dispatch_wave runs a parallel, worktree-isolated wave of
    them (ADR-0004, UC-10, FR-J4)."""
    extensions_dir = _ensure_pi_extensions_dir(target, install, report)

    for name in ("run-agent.ts", "dispatch-wave.ts", "pi-usage.ts"):
        link = extensions_dir / name
        dest = target / "factory" / "config" / "extensions" / name
        ensure_symlink(link, dest, report, install=install)


def _ensure_claude_guardrail_settings(
    target: Path, install: dict, report: list[str]
) -> None:
    path = target / ".claude" / "settings.json"

    if not path.exists():
        settings = {
            "hooks": {
                "PreToolUse": [
                    {
                        "matcher": "Bash",
                        "hooks": [
                            {
                                "type": "command",
                                "command": CLAUDE_GUARDRAIL_HOOK_COMMAND,
                            }
                        ],
                    }
                ]
            }
        }
        path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
        install["claude_settings_existed"] = False
        # Recorded for removal in case .claude/ itself pre-existed and so isn't
        # deleted wholesale; harmless when .claude/ is removed as a unit.
        install["remove_paths"].append(".claude/settings.json")
        log(report, ".claude/settings.json: created with git-safety guardrail hook")
        return

    # setdefault: if a prior run created it, keep existed=False (it's ours).
    install.setdefault("claude_settings_existed", True)

    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        raise Collision(
            f"{path} exists but isn't valid JSON ({e}) — wire the git-safety "
            "guardrail hook in by hand: a PreToolUse/Bash hook running "
            f"{CLAUDE_GUARDRAIL_HOOK_COMMAND}"
        )

    if not isinstance(settings, dict):
        raise Collision(
            f"{path} exists but its top-level JSON isn't an object — wire the "
            f"git-safety guardrail hook in by hand: a PreToolUse/Bash hook running "
            f"{CLAUDE_GUARDRAIL_HOOK_COMMAND}"
        )

    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise Collision(
            f"{path}: 'hooks' key exists but isn't an object — wire it in by hand"
        )

    pre_tool_use = hooks.setdefault("PreToolUse", [])
    if not isinstance(pre_tool_use, list):
        raise Collision(
            f"{path}: 'hooks.PreToolUse' exists but isn't a list — wire the "
            "git-safety guardrail hook in by hand"
        )

    for entry in pre_tool_use:
        entry_hooks = entry.get("hooks", []) if isinstance(entry, dict) else []
        for hook in entry_hooks:
            if (
                isinstance(hook, dict)
                and hook.get("command") == CLAUDE_GUARDRAIL_HOOK_COMMAND
            ):
                log(
                    report,
                    ".claude/settings.json: git-safety guardrail hook already wired in",
                )
                return

    pre_tool_use.append(
        {
            "matcher": "Bash",
            "hooks": [{"type": "command", "command": CLAUDE_GUARDRAIL_HOOK_COMMAND}],
        }
    )
    path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    log(report, ".claude/settings.json: added git-safety guardrail hook")


def _ensure_claude_step_guard_settings(
    target: Path, install: dict, report: list[str]
) -> None:
    """Wire the step-guard Read/Edit/Write/Bash entries into
    .claude/settings.json, preserving unrelated hooks."""
    path = target / ".claude" / "settings.json"

    if not path.exists():
        settings = {
            "hooks": {
                "PreToolUse": [
                    {
                        "matcher": tool_name,
                        "hooks": [
                            {
                                "type": "command",
                                "command": command,
                            }
                        ],
                    }
                    for tool_name, command in CLAUDE_STEP_GUARD_HOOK_COMMANDS.items()
                ]
            }
        }
        path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
        install["claude_settings_existed"] = False
        install["remove_paths"].append(".claude/settings.json")
        log(report, ".claude/settings.json: created with step-guard hook entries")
        return

    install.setdefault("claude_settings_existed", True)

    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        raise Collision(
            f"{path} exists but isn't valid JSON ({e}) — wire the step-guard "
            "hooks in by hand"
        )

    if not isinstance(settings, dict):
        raise Collision(
            f"{path} exists but its top-level JSON isn't an object — wire the "
            "step-guard hooks in by hand"
        )

    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise Collision(
            f"{path}: 'hooks' key exists but isn't an object — wire it in by hand"
        )

    changed = False
    for tool_name, command in CLAUDE_STEP_GUARD_HOOK_COMMANDS.items():
        changed = (
            _wire_claude_step_guard_event(path, hooks, tool_name, command, report)
            or changed
        )
        changed = (
            _migrate_legacy_step_guard_event(hooks, tool_name, command, report)
            or changed
        )

    if changed:
        path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")


def _wire_claude_step_guard_event(
    path: Path, hooks: dict, tool_name: str, command: str, report: list[str]
) -> bool:
    pre_tool_use = hooks.setdefault("PreToolUse", [])
    if not isinstance(pre_tool_use, list):
        raise Collision(
            f"{path}: 'hooks.PreToolUse' exists but isn't a list — wire the "
            "step-guard hook in by hand"
        )

    for entry in pre_tool_use:
        if not isinstance(entry, dict) or entry.get("matcher") != tool_name:
            continue
        entry_hooks = entry.get("hooks", [])
        for hook in entry_hooks:
            if isinstance(hook, dict) and hook.get("command") == command:
                log(
                    report,
                    f".claude/settings.json: {tool_name} step-guard hook already wired in",
                )
                return False

    pre_tool_use.append(
        {
            "matcher": tool_name,
            "hooks": [{"type": "command", "command": command}],
        }
    )
    log(report, f".claude/settings.json: added {tool_name} step-guard hook")
    return True


def _migrate_legacy_step_guard_event(
    hooks: dict, tool_name: str, command: str, report: list[str]
) -> bool:
    """Remove old-format top-level tool-name event keys left by pre-fix installs."""
    entries = hooks.get(tool_name)
    if not isinstance(entries, list):
        return False
    kept = []
    removed = False
    for entry in entries:
        entry_hooks = entry.get("hooks", []) if isinstance(entry, dict) else []
        if any(
            isinstance(h, dict) and h.get("command") == command for h in entry_hooks
        ):
            removed = True
        else:
            kept.append(entry)
    if not removed:
        return False
    if kept:
        hooks[tool_name] = kept
    else:
        del hooks[tool_name]
    log(
        report,
        f".claude/settings.json: migrated legacy {tool_name} step-guard event to PreToolUse",
    )
    return True


def _ensure_claude_capture_settings(
    target: Path, install: dict, report: list[str]
) -> None:
    """Wire the usage-capture Stop/SubagentStop entries into
    .claude/settings.json, mirroring `_ensure_claude_guardrail_settings`
    above: created if absent, merged if present, one entry per event, never
    duplicated, never touching hooks the project already owns (including the
    guardrail's own PreToolUse entry, which this function never looks at)."""
    path = target / ".claude" / "settings.json"

    if not path.exists():
        settings = {
            "hooks": {
                event: [
                    {
                        "hooks": [
                            {
                                "type": "command",
                                "command": CLAUDE_CAPTURE_HOOK_COMMAND,
                            }
                        ]
                    }
                ]
                for event in CLAUDE_CAPTURE_HOOK_EVENTS
            }
        }
        path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
        install["claude_settings_existed"] = False
        install["remove_paths"].append(".claude/settings.json")
        log(
            report,
            ".claude/settings.json: created with usage-capture Stop/SubagentStop hooks",
        )
        return

    # setdefault: if a prior run (or the guardrail install just above) created
    # it, keep existed=False (it's ours).
    install.setdefault("claude_settings_existed", True)

    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        raise Collision(
            f"{path} exists but isn't valid JSON ({e}) — wire the usage-capture "
            "hooks in by hand: Stop and SubagentStop hooks running "
            f"{CLAUDE_CAPTURE_HOOK_COMMAND}"
        )

    if not isinstance(settings, dict):
        raise Collision(
            f"{path} exists but its top-level JSON isn't an object — wire the "
            f"usage-capture hooks in by hand: Stop and SubagentStop hooks "
            f"running {CLAUDE_CAPTURE_HOOK_COMMAND}"
        )

    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise Collision(
            f"{path}: 'hooks' key exists but isn't an object — wire it in by hand"
        )

    changed = False
    for event in CLAUDE_CAPTURE_HOOK_EVENTS:
        changed = _wire_capture_event(path, hooks, event, report) or changed

    if changed:
        path.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")


def _wire_capture_event(path: Path, hooks: dict, event: str, report: list[str]) -> bool:
    """Append the usage-capture command entry under hooks[event] unless
    already present. Returns True iff it added a new entry (so the caller
    only rewrites the file when something actually changed)."""
    entries = hooks.setdefault(event, [])
    if not isinstance(entries, list):
        raise Collision(
            f"{path}: 'hooks.{event}' exists but isn't a list — wire the "
            "usage-capture hook in by hand"
        )

    for entry in entries:
        entry_hooks = entry.get("hooks", []) if isinstance(entry, dict) else []
        for hook in entry_hooks:
            if (
                isinstance(hook, dict)
                and hook.get("command") == CLAUDE_CAPTURE_HOOK_COMMAND
            ):
                log(
                    report,
                    f".claude/settings.json: {event} usage-capture hook already wired in",
                )
                return False

    entries.append(
        {"hooks": [{"type": "command", "command": CLAUDE_CAPTURE_HOOK_COMMAND}]}
    )
    log(report, f".claude/settings.json: added {event} usage-capture hook")
    return True


def copy_model_matrix(target: Path, install: dict, report: list[str]) -> None:
    config_dir = target / "config"
    dest = config_dir / "model.conf"

    if dest.exists():
        # If a prior run created it, the loaded manifest already carries the
        # ignore + removal records; if it's the project's own, we leave it out.
        log(
            report,
            "config/model.conf: already present, left untouched (meant to diverge per project)",
        )
        return

    if not config_dir.exists():
        config_dir.mkdir(parents=True)
        install["remove_paths"].append("config")

    shutil.copyfile(target / "factory" / "config" / "model.conf", dest)
    install["remove_paths"].append("config/model.conf")
    install["ignore_model_conf"] = True
    log(report, "config/model.conf: copied in as a starter")


def ensure_project_identity(
    target: Path, project_name: str | None, install: dict, report: list[str]
) -> None:
    """Create the stable, project-local identity consumed by usage capture."""
    path = target / PROJECT_IDENTITY
    if path.exists():
        try:
            identity = json.loads(path.read_text(encoding="utf-8"))
            uuid.UUID(identity["project_id"])
            if (
                not isinstance(identity["project_name"], str)
                or not identity["project_name"].strip()
            ):
                raise ValueError("project_name must be a non-empty string")
        except (OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as exc:
            raise Collision(f"{PROJECT_IDENTITY}: invalid project identity: {exc}")
        log(report, f"{PROJECT_IDENTITY}: already present, identity preserved")
        return

    if project_name is None:
        try:
            project_name = input("Project name: ").strip()
        except (EOFError, OSError) as exc:
            raise Collision(
                "project name is required; pass --project-name for non-interactive init"
            ) from exc
    else:
        project_name = project_name.strip()
    if not project_name:
        raise Collision("project name must not be empty")

    path.parent.mkdir(parents=True, exist_ok=True)
    identity = {
        "project_id": str(uuid.uuid4()),
        "project_name": project_name,
    }
    path.write_text(json.dumps(identity, indent=2) + "\n", encoding="utf-8")
    install["remove_paths"].append(str(PROJECT_IDENTITY))
    install["ignore_project_identity"] = True
    log(report, f"{PROJECT_IDENTITY}: created project identity")


def handle_precommit(target: Path, install: dict, report: list[str]) -> None:
    dest = target / ".pre-commit-config.yaml"
    template = target / "factory" / "config" / "pre-commit-config.yaml"

    if dest.is_symlink():
        current = (dest.parent / os.readlink(dest)).resolve()
        if current != template.resolve():
            raise Collision(
                f"{dest} is already a symlink to {current}, not to {template}"
            )
        dest.unlink()
        dest.write_text(_fresh_precommit_text(template), encoding="utf-8")
        install["precommit"] = {"path": ".pre-commit-config.yaml", "existed": False}
        log(report, ".pre-commit-config.yaml: replaced legacy symlink with real file")
        return

    if not dest.exists():
        dest.write_text(_fresh_precommit_text(template), encoding="utf-8")
        install["precommit"] = {"path": ".pre-commit-config.yaml", "existed": False}
        install["remove_paths"].append(".pre-commit-config.yaml")
        log(report, "created .pre-commit-config.yaml with factory hooks")
        log(report, "hooks: mdformat, link-check, mermaid-lint, spec-lint,")
        log(report, "       arch-lint, backlog-lint, context-lint, matrix-lint,")
        log(report, "       statemachine-lint, index-lint, run-tests")
        pre_commit_install(target, report)
        return

    install.setdefault(
        "precommit", {"path": ".pre-commit-config.yaml", "existed": True}
    )
    log(
        report,
        ".pre-commit-config.yaml already exists — factory hooks not merged.",
    )
    log(
        report,
        "The fitting process will offer to splice factory hooks into your",
    )
    log(
        report,
        "existing config (run the fitting skill, or merge by hand with",
    )
    log(
        report,
        "factory/scripts/merge-precommit-config).",
    )


def _fresh_precommit_text(template: Path) -> str:
    """A standalone .pre-commit-config.yaml carrying only Agent Factory's
    `- repo: local` block (extracted verbatim from the template)."""
    lines = template.read_text(encoding="utf-8").splitlines()
    for i, line in enumerate(lines):
        if line.rstrip() == "  - repo: local":
            block = "\n".join(lines[i:])
            break
    else:
        raise Collision(
            f"{template} has no `- repo: local` block to build a config from"
        )

    header = (
        "# Created by Agent Factory init-factory. The agent_factory_hook-* hooks\n"
        "# below are added here and removed by factory/scripts/remove-factory\n"
        "# (extricable by their id prefix). Safe to delete if it holds nothing else.\n"
        "repos:\n"
    )
    return header + block + "\n"


def _scan_test_entrypoints(target: Path) -> list[tuple[str, str]]:
    """Deterministic subset of the detect-test-regime skill's step-1 scan
    (factory/skills/detect-test-regime/SKILL.md): check each conventional
    test entrypoint for concrete evidence — never mere file presence — and
    return one (label, command) pair per entrypoint found. init-factory has
    no AI in the loop, so this mirrors the skill's table mechanically rather
    than delegating to it; keep the two in sync as the table grows."""
    candidates: list[tuple[str, str]] = []

    def read(path: Path) -> str:
        try:
            return path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            return ""

    makefile = target / "Makefile"
    if makefile.is_file() and re.search(r"(?m)^test:", read(makefile)):
        candidates.append(("Makefile `test` target", "make test"))

    package_json = target / "package.json"
    if package_json.is_file():
        try:
            data = json.loads(read(package_json) or "{}")
        except json.JSONDecodeError:
            data = {}
        if isinstance(data, dict) and "test" in (data.get("scripts") or {}):
            candidates.append(("package.json `test` script", "npm test"))

    pyproject_text = (
        read(target / "pyproject.toml") if (target / "pyproject.toml").is_file() else ""
    )

    if (target / "tox.ini").is_file() or "[tool.tox]" in pyproject_text:
        candidates.append(("tox", "tox"))

    if (target / "noxfile.py").is_file():
        candidates.append(("noxfile.py", "nox"))

    justfile = target / "Justfile"
    if justfile.is_file() and re.search(r"(?m)^test:", read(justfile)):
        candidates.append(("Justfile `test` recipe", "just test"))

    taskfile = target / "Taskfile.yml"
    if taskfile.is_file():
        text = read(taskfile)
        if re.search(r"(?m)^tasks:", text) and re.search(r"(?m)^\s+test:", text):
            candidates.append(("Taskfile.yml `test` task", "task test"))

    # Both pytest evidence sources imply the same command; only record once.
    if "[tool.pytest.ini_options]" in pyproject_text:
        candidates.append(("pyproject.toml `[tool.pytest.ini_options]`", "pytest"))
    elif (target / "pytest.ini").is_file():
        candidates.append(("pytest.ini", "pytest"))
    elif "[tool:pytest]" in read(target / "setup.cfg"):
        candidates.append(("setup.cfg `[tool:pytest]`", "pytest"))

    return candidates


def _resolve_testing_yaml(target: Path) -> Path:
    """Return the testing.yaml path via format detection."""
    ac_path = target / "docs" / "agent-context" / "testing.yaml"
    if ac_path.is_file():
        return ac_path
    charter_path = target / "docs" / "charter" / "testing.yaml"
    if charter_path.is_file():
        return charter_path
    ac_dir = target / "docs" / "agent-context"
    if ac_dir.is_dir():
        return ac_path
    return ac_path


def _write_testing_yaml(target: Path, command: str) -> None:
    path = _resolve_testing_yaml(target)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "# docs/agent-context/testing.yaml — project test command declaration\n"
        "# Detected by Agent Factory's detect-test-regime scan during init-factory.\n"
        "# Code is the source of truth; this file is a derived record — re-run\n"
        "# the detect-test-regime skill by hand once the project's test setup\n"
        "# changes. Schema: factory/rulebooks/templates/charter-testing.yaml\n"
        "\n"
        f'test_command: "{command}"\n',
        encoding="utf-8",
    )


def detect_test_regime(target: Path, report: list[str]) -> None:
    """Scan for an existing test regime and record it in
    testing.yaml (docs/agent-context/ or docs/charter/ via format detection)
    — the deterministic core of the detect-test-regime skill (step 2: one
    entrypoint records, several ask rather than guess, none surfaces the
    gap). Never writes to .pre-commit-config.yaml: test hooks stay
    project-owned (BR-029)."""
    path = _resolve_testing_yaml(target)
    if path.exists():
        log(report, f"{path.relative_to(target)}: already present, left untouched")
        return

    by_command: dict[str, list[str]] = {}
    for label, command in _scan_test_entrypoints(target):
        by_command.setdefault(command, []).append(label)

    rel_path = path.relative_to(target)
    if not by_command:
        log(
            report,
            f"{rel_path}: no test entrypoint detected — gap "
            "surfaced. Build project-owned test infrastructure, or run the "
            "detect-test-regime skill once one exists.",
        )
        return

    if len(by_command) == 1:
        command = next(iter(by_command))
        _write_testing_yaml(target, command)
        log(
            report,
            f"{rel_path}: created, test_command={command!r} "
            f"(detected via {', '.join(by_command[command])})",
        )
        return

    # Several distinct commands found: do not guess (skill step 2). Ask
    # interactively; a non-interactive run (no TTY, or a blank answer)
    # surfaces the gap instead of picking one.
    options = sorted(by_command)
    print("init-factory: multiple possible test commands detected:")
    for i, command in enumerate(options, start=1):
        print(f"  {i}. {command}  ({', '.join(by_command[command])})")
    try:
        choice = input(
            f"Which is the project's canonical test_command? [1-{len(options)}, blank to skip]: "
        ).strip()
    except (EOFError, OSError):
        choice = ""

    if choice.isdigit() and 1 <= int(choice) <= len(options):
        command = options[int(choice) - 1]
        _write_testing_yaml(target, command)
        log(
            report,
            f"{rel_path}: created, test_command={command!r} (user-selected)",
        )
        return

    log(
        report,
        f"{rel_path}: multiple test entrypoints found "
        f"({', '.join(options)}) — gap surfaced, none recorded. Run the "
        "detect-test-regime skill, or edit testing.yaml by hand, to disambiguate.",
    )


def write_gitignore_block(target: Path, install: dict, report: list[str]) -> None:
    path = target / ".gitignore"

    entries = [
        "/factory/",
        "/.claude/",
        "/.pi/",
        "/.agent-factory/",
        "/.current-work/",
        "/session-scratchpad.md",
    ]
    if install.get("ignore_model_conf"):
        entries.append("/config/model.conf")
    if install.get("ignore_project_identity"):
        entries.append(f"/{PROJECT_IDENTITY}")
    if install.get("ignore_root_agents"):
        entries.append("/AGENTS.md")
    for entry in sorted(install["github_ignored_entries"]):
        entries.append("/" + entry)
    for entry in sorted(install["codex_ignored_entries"]):
        entries.append("/" + entry)
    for entry in sorted(install["agents_ignored_entries"]):
        entries.append("/" + entry)

    install["ignored_paths"] = entries

    body = [
        GITIGNORE_BEGIN,
        "# Added by init-factory; remove with factory/scripts/remove-factory.",
        *entries,
        GITIGNORE_END,
    ]
    block = "\n".join(body) + "\n"

    if not path.exists():
        path.write_text(block, encoding="utf-8")
        install["gitignore_existed"] = False
        install.setdefault("gitignore_orig_final_newline", True)
        install["remove_paths"].append(".gitignore")
        log(report, ".gitignore: created with the agent_factory related block")
        return

    # setdefault: if a prior run created .gitignore, keep existed=False.
    install.setdefault("gitignore_existed", True)
    existing = path.read_text(encoding="utf-8")

    if GITIGNORE_BEGIN in existing and GITIGNORE_END in existing:
        pre, rest = existing.split(GITIGNORE_BEGIN, 1)
        _, post = rest.split(GITIGNORE_END, 1)
        rebuilt = pre.rstrip("\n") + "\n\n" + block + post.lstrip("\n")
        if rebuilt != existing:
            path.write_text(rebuilt, encoding="utf-8")
            log(report, ".gitignore: refreshed the agent_factory related block")
        else:
            log(report, ".gitignore: agent_factory related block already current")
        return

    # First append: preserve the project's exact bytes. Record whether the
    # original ended with a newline so remove-factory can restore it precisely,
    # rather than leaving a stray trailing newline behind.
    had_nl = existing.endswith("\n")
    install.setdefault("gitignore_orig_final_newline", had_nl)
    base = existing if had_nl else existing + "\n"
    path.write_text(base + "\n" + block, encoding="utf-8")
    log(report, ".gitignore: appended the agent_factory related block")


def load_prior_manifest(target: Path, install: dict, report: list[str]) -> None:
    """Seed `install` from a previous run's manifest so an idempotent re-run
    preserves what init already knows is Agent Factory's — steps that skip
    because a path already exists would otherwise lose that knowledge, leaving
    the remover unable to clean it up."""
    path = target / MANIFEST_PATH

    if not path.exists():
        return

    try:
        prior = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return

    install["remove_paths"] = list(prior.get("remove_paths", []))
    install["merged_dirs"] = list(prior.get("merged_dirs", []))
    install["orientation"] = dict(prior.get("orientation", {}))
    if prior.get("precommit"):
        install["precommit"] = prior["precommit"]
    for key in (
        "git_initialized_by_us",
        "gitignore_existed",
        "gitignore_orig_final_newline",
        "precommit_orig_final_newline",
        "claude_settings_existed",
    ):
        if key in prior:
            install[key] = prior[key]
    for p in prior.get("ignored_paths", []):
        if p == "/config/model.conf":
            install["ignore_model_conf"] = True
        elif p == f"/{PROJECT_IDENTITY}":
            install["ignore_project_identity"] = True
        elif p == "/AGENTS.md":
            install["ignore_root_agents"] = True
        elif p.startswith("/.github/"):
            install["github_ignored_entries"].add(p.lstrip("/"))
        elif p.startswith("/.codex/"):
            install["codex_ignored_entries"].add(p.lstrip("/"))
        elif p.startswith("/.agents/"):
            install["agents_ignored_entries"].add(p.lstrip("/"))

    if "orientation_orig_final_newline" in prior:
        install["orientation_orig_final_newline"] = prior[
            "orientation_orig_final_newline"
        ]

    if "codex_hooks_existed" in prior:
        install["codex_hooks_existed"] = prior["codex_hooks_existed"]
    if "codex_hooks_original" in prior:
        install["codex_hooks_original"] = prior["codex_hooks_original"]
    install["copilot_generated_agents"] = set(prior.get("copilot_generated_agents", []))
    install["codex_generated_agents"] = set(prior.get("codex_generated_agents", []))
    install["codex_hook_handlers"] = list(prior.get("codex_hook_handlers", []))
    prior_hooks_hash = prior.get("codex_hooks_installed_sha256")
    hooks_path = target / ".codex/hooks.json"
    hooks_unchanged = (
        isinstance(prior_hooks_hash, str)
        and hooks_path.is_file()
        and not hooks_path.is_symlink()
        and hashlib.sha256(hooks_path.read_bytes()).hexdigest() == prior_hooks_hash
    )
    install["codex_hooks_restore_original"] = bool(
        prior.get("codex_hooks_restore_original", True) and hooks_unchanged
    )

    log(report, f"{MANIFEST_PATH}: prior install found, preserving its records")


def write_manifest(target: Path, install: dict, report: list[str]) -> None:
    manifest_path = target / MANIFEST_PATH
    manifest_path.parent.mkdir(parents=True, exist_ok=True)

    hooks_path = target / ".codex/hooks.json"
    hooks_sha256 = (
        hashlib.sha256(hooks_path.read_bytes()).hexdigest()
        if hooks_path.is_file() and not hooks_path.is_symlink()
        else None
    )
    payload = {
        "version": 1,
        "git_initialized_by_us": install.get("git_initialized_by_us", False),
        "gitignore_existed": install.get("gitignore_existed", True),
        "gitignore_markers": {"begin": GITIGNORE_BEGIN, "end": GITIGNORE_END},
        "gitignore_orig_final_newline": install.get(
            "gitignore_orig_final_newline", True
        ),
        "precommit": install.get("precommit", {}),
        "precommit_orig_final_newline": install.get(
            "precommit_orig_final_newline", True
        ),
        "precommit_hook_id_prefix": "agent_factory_hook-",
        "claude_settings_existed": install.get("claude_settings_existed", True),
        "codex_hooks_existed": install.get("codex_hooks_existed", True),
        "codex_hooks_original": install.get("codex_hooks_original"),
        "codex_hooks_installed_sha256": hooks_sha256,
        "codex_hooks_restore_original": install.get(
            "codex_hooks_restore_original", True
        ),
        "copilot_generated_agents": sorted(install["copilot_generated_agents"]),
        "codex_generated_agents": sorted(install["codex_generated_agents"]),
        "codex_hook_handlers": install["codex_hook_handlers"],
        "orientation": install.get("orientation", {}),
        "orientation_markers": {
            "begin": ORIENTATION_BEGIN,
            "end": ORIENTATION_END,
        },
        "orientation_orig_final_newline": install.get(
            "orientation_orig_final_newline", {}
        ),
        "ignored_paths": install.get("ignored_paths", []),
        "remove_paths": _dedup(install["remove_paths"]),
        "merged_dirs": sorted(set(install.get("merged_dirs", []))),
        "factory_source": install.get("factory_source"),
    }
    manifest_path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    log(report, f"{MANIFEST_PATH}: wrote removal manifest")


def _private_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        raise Collision(f"unsafe Factory usage directory: {path}")
    os.chmod(path, 0o700, follow_symlinks=False)


def _private_file(path: Path, content: str) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        info = None
    if info is not None and (
        not stat.S_ISREG(info.st_mode)
        or info.st_nlink != 1
        or (hasattr(os, "geteuid") and info.st_uid != os.geteuid())
    ):
        raise Collision(f"unsafe Factory usage file: {path}")
    fd = os.open(
        path,
        os.O_CREAT | os.O_TRUNC | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        opened = os.fstat(fd)
        if not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1:
            raise Collision(f"unsafe Factory usage file: {path}")
        os.fchmod(fd, 0o600)
        os.write(fd, content.encode("utf-8"))
    finally:
        os.close(fd)


def _repair_private_tree(root: Path) -> None:
    """Repair only safe, owner-owned Factory usage descendants."""
    if not root.exists() or root.is_symlink():
        return
    for entry in os.scandir(root):
        info = entry.stat(follow_symlinks=False)
        if stat.S_ISLNK(info.st_mode):
            continue
        if hasattr(os, "geteuid") and info.st_uid != os.geteuid():
            continue
        path = Path(entry.path)
        if stat.S_ISDIR(info.st_mode):
            os.chmod(path, 0o700, follow_symlinks=False)
            _repair_private_tree(path)
        elif stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
            fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
            try:
                opened = os.fstat(fd)
                if not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1:
                    continue
                os.fchmod(fd, 0o600)
            finally:
                os.close(fd)


def initialize_usage_lifecycle(
    target: Path, report: list[str], transcript_retention: str | None = None
) -> None:
    """Pre-create and probe the atomic Pi registration fence and registry."""
    control = target / ".agent-factory" / "usage-control"
    usage = target / ".agent-factory" / "usage"
    _private_directory(control)
    _private_directory(control / "pending")
    _private_directory(usage)
    _private_directory(usage / ".capture")
    state = control / "state.json"
    if not state.exists():
        _private_file(
            state,
            json.dumps({"mode": "active", "generation": str(uuid.uuid4())}) + "\n",
        )
        log(report, ".agent-factory/usage-control: initialized")
    else:
        state_info = state.lstat()
        if (
            stat.S_ISLNK(state_info.st_mode)
            or not stat.S_ISREG(state_info.st_mode)
            or (hasattr(os, "geteuid") and state_info.st_uid != os.geteuid())
        ):
            raise Collision(f"unsafe Factory usage state: {state}")
        os.chmod(state, 0o600, follow_symlinks=False)
    config = control / "config.json"
    if transcript_retention is not None or not config.exists():
        mode = transcript_retention or "full"
        _private_file(config, json.dumps({"transcript_retention": mode}) + "\n")
    else:
        config_info = config.lstat()
        if (
            stat.S_ISLNK(config_info.st_mode)
            or not stat.S_ISREG(config_info.st_mode)
            or config_info.st_nlink != 1
            or (hasattr(os, "geteuid") and config_info.st_uid != os.geteuid())
        ):
            raise Collision(f"unsafe Factory usage config: {config}")
        os.chmod(config, 0o600, follow_symlinks=False)
    _repair_private_tree(usage)
    _repair_private_tree(control)
    probe = control / "pending" / f"hardlink-probe-{uuid.uuid4()}"
    try:
        os.link(state, probe)
    except OSError as exc:
        log(
            report,
            "Pi usage capture unavailable: the project filesystem does not "
            f"support the required same-volume hard-link registration fence ({exc})",
        )
    finally:
        probe.unlink(missing_ok=True)


def _dedup(paths: list[str]) -> list[str]:
    seen: set[str] = set()
    out: list[str] = []
    for p in paths:
        if p not in seen:
            seen.add(p)
            out.append(p)
    return out


def pre_commit_install(target: Path, report: list[str]) -> None:
    result = subprocess.run(
        [
            "uvx",
            "pre-commit",
            "install",
            "--hook-type",
            "pre-commit",
            "--hook-type",
            "pre-push",
        ],
        cwd=target,
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        log(report, f"uvx pre-commit install: FAILED — {result.stderr.strip()}")
        return

    log(report, "uvx pre-commit install (pre-commit, pre-push): done")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument(
        "--source",
        type=Path,
        default=None,
        help="agent_factory checkout to copy factory/ from (default: the checkout this script itself lives in)",
    )
    ap.add_argument(
        "--target",
        type=Path,
        default=Path("."),
        help="project directory to initialize (default: cwd)",
    )
    ap.add_argument(
        "--usage-transcript-retention",
        choices=("full", "omit"),
        default=None,
    )
    ap.add_argument(
        "--project-name",
        default=None,
        help="non-empty project name (prompted for on a fresh interactive install)",
    )
    ap.add_argument(
        "--cli",
        choices=KNOWN_CLIS,
        nargs="+",
        default=None,
        help="which CLI(s) to wire (default: auto-detect or ask interactively)",
    )
    args = ap.parse_args(argv)

    source_root = (args.source or Path(__file__).resolve().parents[2]).resolve()
    pkg_factory = source_root / "packages" / "factory"
    source_factory = pkg_factory if pkg_factory.is_dir() else source_root / "factory"

    if not source_factory.is_dir():
        print(
            f"init-factory: no factory/ found at {source_root} — pass --source explicitly",
            file=sys.stderr,
        )
        return 1

    target = args.target.resolve()

    print("\ninit-factory")
    print("═" * 54)

    report: list[str] = []
    install: dict = {
        "_target": target,
        "remove_paths": [],
        "dir_existed": {},
        "orientation": {},
        "github_ignored_entries": set(),
        "codex_ignored_entries": set(),
        "agents_ignored_entries": set(),
        "copilot_generated_agents": set(),
        "codex_generated_agents": set(),
        "codex_hook_handlers": [],
        "codex_hooks_restore_original": True,
        "ignore_root_agents": False,
        "factory_source": str(source_root),
    }

    # ── Section 1: Scaffolding ──────────────────────────────────────────
    section("Scaffolding")

    try:
        ensure_target_dir(target, install, report)
        load_prior_manifest(target, install, report)
        ensure_git(target, install, report)
        fix_origin_head(target, report)
        copy_factory(source_factory, target, install, report)
    except Collision as e:
        print(f"\n  STOPPED — {e}", file=sys.stderr)
        return 1

    # ── Section 2: CLI selection ────────────────────────────────────────
    clis: list[str] | None = args.cli
    if clis is None:
        detected = detect_cli(target)
        if detected:
            clis = detected
        else:
            section("CLI selection")
            clis = ask_clis()
            if clis:
                log(report, f"selected: {', '.join(clis)}")
            else:
                log(report, "wiring all CLIs")

    dot_dirs = _active_dot_dirs(clis)
    cli_label = ", ".join(clis) if clis else "all"
    install["cli"] = clis
    auto = " (auto-detected)" if args.cli is None and clis else ""

    # ── Section 3: Wiring ───────────────────────────────────────────────
    section(f"Wiring: {cli_label}{auto}")

    try:
        ensure_dot_dirs(target, install, report, dot_dirs)

        if _wants(clis, "codex"):
            preflight_codex_adapter(target, install)
        if _wants(clis, "copilot"):
            preflight_copilot_agents(target, install)

        _out.quiet = True
        pre_wire = len(report)
        symlink_factory_content(target, install, report, dot_dirs)
        wire_count = len(report) - pre_wire
        _out.quiet = False
        log(report, f"{wire_count} factory symlinks")

        if _wants(clis, "codex"):
            install_codex_adapter(target, install, report)
        if _wants(clis, "copilot"):
            install_copilot_agents(target, install, report)

        _out.quiet = True
        pre_guard = len(report)
        install_git_guardrail(target, install, report, clis)
        install_step_guard(target, install, report, clis)
        guard_count = len(report) - pre_guard
        _out.quiet = False
        if guard_count:
            log(report, f"guardrails and step guards installed ({guard_count} hooks)")

        _out.quiet = True
        pre_usage = len(report)
        usage_runtime_ready = provision_usage_runtime(target, report)
        if usage_runtime_ready:
            install_usage_capture(target, install, report, clis)
        usage_count = len(report) - pre_usage
        _out.quiet = False
        if usage_runtime_ready:
            log(report, "usage capture: runtime ready, hooks installed")
        else:
            log(report, "usage capture: runtime unavailable, hooks inactive")

        if _wants(clis, "pi"):
            install_pi_invocation_layer(target, install, report)

    except Collision as e:
        _out.quiet = False
        print(f"\n  STOPPED — {e}", file=sys.stderr)
        return 1

    # ── Section 4: Project identity ─────────────────────────────────────
    section("Project identity")
    try:
        copy_model_matrix(target, install, report)
        ensure_project_identity(target, args.project_name, install, report)
    except Collision as e:
        print(f"\n  STOPPED — {e}", file=sys.stderr)
        return 1

    # ── Section 5: Gitignore ────────────────────────────────────────────
    section("Gitignore")
    write_gitignore_block(target, install, report)

    # ── Section 6: Pre-commit hooks ─────────────────────────────────────
    section("Pre-commit hooks")
    try:
        handle_precommit(target, install, report)
    except Collision as e:
        print(f"\n  STOPPED — {e}", file=sys.stderr)
        return 1

    # ── Finalize (silent) ──────────────────────────────────────────────
    _out.quiet = True
    write_manifest(target, install, report)
    initialize_usage_lifecycle(target, report, args.usage_transcript_retention)
    _out.quiet = False

    # Receipt.
    print(f"\n{'═' * 54}")
    print(f"  target: {target}")
    print(f"  cli:    {cli_label}")
    print(f"  undo:   factory/scripts/remove-factory")
    print()

    return 0


if __name__ == "__main__":
    sys.exit(main())
