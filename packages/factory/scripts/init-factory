def install_usage_capture(target: Path, install: dict, report: list[str],
                          clis: list[str] | None = None) -> None:
    """Install native usage-capture triggers for the selected CLIs."""
    if _wants(clis, "claude"):
        hooks_dir = target / ".claude" / "hooks"
        hooks_dir.mkdir(parents=True, exist_ok=True)
        link = hooks_dir / "capture-usage.sh"
        dest = target / "factory" / "config" / "hooks" / "capture-usage.sh"
        ensure_symlink(link, dest, report, install=install)
        _ensure_claude_capture_settings(target, install, report)
    if _wants(clis, "copilot"):
        _install_copilot_usage_capture(target, install, report)
    if _wants(clis, "codex"):
        _install_codex_usage_capture(target, install, report)
    if _wants(clis, "pi"):
        _install_pi_usage_capture(target, install, report)


def _secure_runtime_tree(root: Path) -> None:
    """Make the project-owned runtime private without following symlinks."""
    os.chmod(root, 0o700, follow_symlinks=False)
    for entry in os.scandir(root):
        info = entry.stat(follow_symlinks=False)
        path = Path(entry.path)
        if stat.S_ISLNK(info.st_mode):
            continue
        if stat.S_ISDIR(info.st_mode):
            _secure_runtime_tree(path)
        elif stat.S_ISREG(info.st_mode):
            os.chmod(path, 0o700 if info.st_mode & 0o111 else 0o600)


def provision_usage_runtime(target: Path, report: list[str]) -> bool:
    """Install hash-verified tokenizer dependencies before hooks activate.

    Network access, when needed, is confined to this user-invoked init step.
    ``UV_OFFLINE`` is passed explicitly so an offline init either uses already
    cached verified artifacts or leaves capture inactive with a clear report.
    """
    requirements = target / USAGE_REQUIREMENTS
    runtime = target / USAGE_RUNTIME
    ready = runtime / ".requirements-sha256"
    if runtime.is_symlink() or (runtime.exists() and not runtime.is_dir()):
        log(report, f"usage capture unavailable: unsafe runtime path {runtime}")
        return False
    if runtime.exists() and ready.exists():
        ready.unlink()

    runtime.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(runtime.parent, 0o700)
    stage = runtime.parent / f"usage-runtime-stage-{uuid.uuid4()}"
    backup = runtime.parent / f"usage-runtime-old-{uuid.uuid4()}"
    offline = os.environ.get("UV_OFFLINE", "").lower() not in ("", "0", "false", "no")
    common = ["--offline"] if offline else []
    try:
        digest = hashlib.sha256(requirements.read_bytes()).hexdigest()
        create = subprocess.run(
            ["uv", "venv", *common, "--no-python-downloads", str(stage)],
            cwd=target,
            capture_output=True,
            text=True,
            check=False,
        )
        if create.returncode != 0:
            raise RuntimeError(create.stderr.strip() or "uv venv failed")
        python = stage / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
        sync = subprocess.run(
            [
                "uv",
                "pip",
                "sync",
                *common,
                "--require-hashes",
                "--no-build",
                "--no-python-downloads",
                "--python",
                str(python),
                str(requirements),
            ],
            cwd=target,
            capture_output=True,
            text=True,
            check=False,
        )
        if sync.returncode != 0:
            raise RuntimeError(sync.stderr.strip() or "uv pip sync failed")
        marker = stage / ".requirements-sha256"
        marker.write_text(digest + "\n", encoding="ascii")
        _secure_runtime_tree(stage)
        if runtime.exists():
            runtime.rename(backup)
        stage.rename(runtime)
        if backup.exists():
            shutil.rmtree(backup, ignore_errors=True)
        log(report, "usage capture runtime: exact hash-verified environment ready")
        return True
    except (OSError, RuntimeError) as exc:
        if stage.exists():
            shutil.rmtree(stage)
        if backup.exists() and not runtime.exists():
            backup.rename(runtime)
        log(report, f"usage capture unavailable; lifecycle hooks left inactive — {exc}")
        return False


def _install_pi_usage_capture(target: Path, install: dict, report: list[str]) -> None:
    """Install Pi's native human-session shutdown trigger and shared bridge."""
    extensions_dir = _ensure_pi_extensions_dir(target, install, report)
    for name in ("capture-usage.ts", "pi-usage.ts"):
        ensure_symlink(
            extensions_dir / name,
            target / "factory" / "config" / "extensions" / name,
            report,
            install=install,
        )


def _install_codex_usage_capture(
    target: Path, install: dict, report: list[str]
) -> None:
    """Merge Factory's Codex lifecycle hooks into project hook config."""
    hooks_dir = _ensure_codex_hooks_dir(target, install, report)
    install["codex_ignored_entries"].add(".codex/hooks/capture-codex-usage.sh")

    ensure_symlink(
        hooks_dir / "capture-codex-usage.sh",
        target / "factory/config/hooks/capture-codex-usage.sh",
        report,
        install=install,
    )

    path, config, hooks, existed = _load_codex_hooks(target, install)

    changed = False
    for event in CODEX_CAPTURE_HOOK_EVENTS:
        entries = hooks.setdefault(event, [])
        if not isinstance(entries, list):
            raise Collision(f"{path}: 'hooks.{event}' exists but isn't a list")
        already_wired = any(
            isinstance(hook, dict) and hook.get("command") == CODEX_CAPTURE_HOOK_COMMAND
            for entry in entries
            for hook in (entry.get("hooks", []) if isinstance(entry, dict) else [])
        )
        if not already_wired:
            entries.append(
                {"hooks": [{"type": "command", "command": CODEX_CAPTURE_HOOK_COMMAND}]}
            )
            _record_codex_handler(
                install,
                {"event": event, "command": CODEX_CAPTURE_HOOK_COMMAND},
            )
            changed = True

    if changed or not existed:
        path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        log(report, ".codex/hooks.json: wired Stop/SubagentStop usage capture")

    log(
        report,
        "Codex usage capture: installed but not active until trusted; "
        "start Codex, open /hooks, then review and trust the project hooks",
    )


def _ensure_codex_hooks_dir(target: Path, install: dict, report: list[str]) -> Path:
    hooks_dir = target / ".codex" / "hooks"
    _ensure_project_directory(hooks_dir, install, report)
    return hooks_dir


def _record_codex_handler(install: dict, handler: dict) -> None:
    if handler not in install["codex_hook_handlers"]:
        install["codex_hook_handlers"].append(handler)


def _load_codex_hooks(target: Path, install: dict) -> tuple[Path, dict, dict, bool]:
    """Load the shared Codex hook document while preserving ownership facts."""
    path = target / ".codex" / "hooks.json"
    existed = path.exists()
    if existed:
        install.setdefault("codex_hooks_existed", True)
        raw = path.read_text(encoding="utf-8")
        if install.get("codex_hooks_existed", True):
            install.setdefault("codex_hooks_original", raw)
        try:
            config = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise Collision(f"{path} exists but isn't valid JSON ({exc})")
        if not isinstance(config, dict):
            raise Collision(f"{path} exists but its top-level JSON isn't an object")
    else:
        config = {}
        install["codex_hooks_existed"] = False
        install["remove_paths"].append(".codex/hooks.json")
        install["codex_ignored_entries"].add(".codex/hooks.json")

    hooks = config.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise Collision(f"{path}: 'hooks' key exists but isn't an object")
    return path, config, hooks, existed


def _install_codex_guardrail(target: Path, install: dict, report: list[str]) -> None:
    """Install Codex's Bash matcher without disturbing project hook entries."""
    hooks_dir = _ensure_codex_hooks_dir(target, install, report)
    link = hooks_dir / "block-dangerous-git.sh"
    ensure_symlink(
        link,
        target / "factory/config/hooks/block-dangerous-git.sh",
        report,
        install=install,
    )
    install["codex_ignored_entries"].add(_relpath(link, install))

    path, config, hooks, existed = _load_codex_hooks(target, install)
    entries = hooks.setdefault("PreToolUse", [])
    if not isinstance(entries, list):
        raise Collision(f"{path}: 'hooks.PreToolUse' exists but isn't a list")
    already_wired = any(
        isinstance(hook, dict) and hook.get("command") == CODEX_GUARDRAIL_HOOK_COMMAND
        for entry in entries
        for hook in (entry.get("hooks", []) if isinstance(entry, dict) else [])
    )
    if already_wired:
        log(report, ".codex/hooks.json: git-safety guardrail already wired")
        return
    entries.append(
        {
            "matcher": "^Bash$",
            "hooks": [{"type": "command", "command": CODEX_GUARDRAIL_HOOK_COMMAND}],
        }
    )
    _record_codex_handler(
        install,
        {
            "event": "PreToolUse",
            "matcher": "^Bash$",
            "command": CODEX_GUARDRAIL_HOOK_COMMAND,
        },
    )
    path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    action = "created" if not existed else "added"
    log(report, f".codex/hooks.json: {action} Codex git-safety guardrail")


def _install_copilot_usage_capture(
    target: Path, install: dict, report: list[str]
) -> None:
    """Install an isolated Copilot version-1 hook file.

    Copilot combines `.github/hooks/*.json`, so a dedicated Factory-owned file
    is merge-safe without parsing or rewriting project-owned hook files.
    """
    hooks_dir = target / ".github" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    install["github_ignored_entries"].add(".github/hooks")

    for name in ("capture-copilot-usage.sh", "capture-usage.json"):
        ensure_symlink(
            hooks_dir / name,
            target / "factory" / "config" / "hooks" / name,
            report,
            install=install,
        )

    log(
        report,
        "Copilot usage capture: agentStop totals include child activity; "
        "subagentStop is attribution-only (general-purpose emits no child hook)",
    )


def _install_claude_guardrail(target: Path, install: dict, report: list[str]) -> None:
    hooks_dir = target / ".claude" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)

    link = hooks_dir / "block-dangerous-git.sh"
    dest = target / "factory" / "config" / "hooks" / "block-dangerous-git.sh"
    ensure_symlink(link, dest, report, install=install)

    _ensure_claude_guardrail_settings(target, install, report)


def _install_claude_step_guard(target: Path, install: dict, report: list[str]) -> None:
