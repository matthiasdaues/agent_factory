#!/usr/bin/env python3
"""init-factory — idempotent, *tracelessly removable* setup: wire Agent Factory
into a target project without interfering with what's already there.

What: Copies factory/ in and symlinks the per-CLI resources, guardrails, and
      config, recording everything for clean removal.
When: Once per project to install the toolset (re-run to update).
By:   run by hand (a shell, no AI needed); the init-factory skill relays it.

Works identically whether `--target` is a brand-new empty directory or an
existing repo with its own history, docs, CI workflows, and hooks. Two
promises govern every step:

  1. NON-INTERFERENCE. init-factory never overwrites, reformats, or shadows a
     file the project already owns. An existing orientation file, an existing
     pre-commit config, existing .github/workflows — all are left exactly as
     they were. Where Agent Factory needs to add something, it adds it beside
     the project's own content, never on top of it.

  2. TRACELESS REMOVAL. Everything Agent Factory drops into the target is
     either (a) git-ignored under a single, marker-delimited "agent_factory
     related" block, so it never enters the project's tracked history at all,
     or (b) — for the one file that must be tracked, the pre-commit config —
     added as hooks whose ids are prefixed `agent_factory_hook-`, extricable
     by that prefix. A companion script, `factory/scripts/remove-factory`,
     reverses the whole install back to a clean `git status`. init-factory
     records exactly what it did in `.agent-factory/factory-install.json` so
     the remover can be exact.

Why .github can't just be git-ignored wholesale: the target's own GitHub
Actions live in `.github/workflows/`. Ignoring all of `.github` would hide
that CI infrastructure from git. So init-factory ignores only the specific
entries it adds under `.github/` (the CLI symlinks, the hooks dir, and — only
when init-factory itself created it — copilot-instructions.md), never the
directory as a whole.

Pi has no native PreToolUse hook file like Claude Code or Copilot CLI. For pi,
init-factory instead scaffolds a project-local extension under `.pi/extensions/`
that blocks the same dangerous bash/git patterns when the project is trusted
and project-local extensions are loaded.

Deliberately NOT bundled into a skill by default — this can be run directly,
standalone, with no AI in the loop at all (`init-factory` is a normal
executable). A thin skill wrapper exists for CLIs that want to invoke it
conversationally, but nothing about using Agent Factory requires it.

Does not scaffold docs/spec/, docs/adr/, docs/CONTEXT.md, or any other docs/
subtree — those are created lazily by the skill that first needs them
(domain-modeling, todo-format), not eagerly by init.

Steps
Sections (printed as the run progresses)

  Scaffolding     Create --target, git init, copy factory/.
  CLI selection    Auto-detect from existing dot-dirs, accept --cli, or ask
                   interactively. --cli accepts multiple values.
  Wiring           Create dot-dirs, symlink factory content, install
                   guardrails, step guards, and usage capture for the
                   selected CLI(s).
  Project identity Copy config/model.conf (if absent), create or preserve
                   config/project.json.
  Gitignore        Emit the single "agent_factory related" .gitignore block.
  Pre-commit       If no .pre-commit-config.yaml exists, create one with
                   factory hooks and run `uvx pre-commit install`.
                   If one exists, leave it alone — merging factory hooks
                   into an existing config is the fitting's job.

Test-regime detection and project fingerprinting are NOT part of init.
They belong to the fitting — the conversational process where VIRGIL
learns the project and the project gains its attachment points. See
the context-aware-init-factory proposal for the lifecycle model.

Usage
  init-factory --cli claude                       # target = cwd, one CLI
  init-factory --cli claude copilot               # wire two CLIs
  init-factory --target /path/to/project          # auto-detect or ask
  init-factory --target /path/to/project --source /path/to/agent_factory

Exit code: 0 on success (including a clean no-op re-run). 1 on any collision
or unsupported existing state — the first step that can't proceed stops the
whole run before touching anything later.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import uuid
from pathlib import Path

# name -> path relative to factory/, symlinked into each dot-dir under the same name
FACTORY_CONTENT = [
    "agents",
    "skills",
    "playbooks",
    "rulebooks",
    "scripts",
    "INDEX.yaml",
]

DOT_DIRS = [".claude", ".github", ".pi", ".codex"]

# --cli name -> which dot-dirs and adapters that CLI needs.
CLI_DOT_DIRS: dict[str, list[str]] = {
    "claude": [".claude"],
    "copilot": [".github"],
    "pi": [".pi"],
    "codex": [".codex"],
}
KNOWN_CLIS = list(CLI_DOT_DIRS.keys())

# dot-dir -> this CLI's root orientation-file path, relative to --target
ORIENTATION_FILE = {
    ".claude": ".claude/CLAUDE.md",
    ".github": ".github/copilot-instructions.md",
    ".pi": "AGENTS.md",
    ".codex": "AGENTS.md",
}

# The exact PreToolUse/Bash hook command string that wires the git-safety
# guardrail into a project's .claude/settings.json.
CLAUDE_GUARDRAIL_HOOK_COMMAND = (
    '"$CLAUDE_PROJECT_DIR"/.claude/hooks/block-dangerous-git.sh'
)

CLAUDE_STEP_GUARD_HOOK_COMMANDS = {
    "Read": 'GUARD_TYPE=read "$CLAUDE_PROJECT_DIR"/.claude/hooks/step-guard.sh',
    "Edit": 'GUARD_TYPE=write "$CLAUDE_PROJECT_DIR"/.claude/hooks/step-guard.sh',
    "Write": 'GUARD_TYPE=write "$CLAUDE_PROJECT_DIR"/.claude/hooks/step-guard.sh',
    "Bash": 'GUARD_TYPE=bash "$CLAUDE_PROJECT_DIR"/.claude/hooks/step-guard.sh',
}

# The exact Stop/SubagentStop hook command string that wires the usage-capture
# trigger into a project's .claude/settings.json. One hook-pair covers both
# the human main session (Stop) and every dispatched sub-agent (SubagentStop)
# within the CLI; the shared script tells them apart via the hook payload's
# own `hook_event_name`, not via a different command string.
CLAUDE_CAPTURE_HOOK_COMMAND = '"$CLAUDE_PROJECT_DIR"/.claude/hooks/capture-usage.sh'
CLAUDE_CAPTURE_HOOK_EVENTS = ("Stop", "SubagentStop")

# Codex exposes the same lifecycle event names through its project-level
# `.codex/hooks.json`. Keep the command exact so remove-factory can identify
# only Factory's entries without disturbing project hooks.
CODEX_CAPTURE_HOOK_EVENTS = ("Stop", "SubagentStop")
CODEX_GUARDRAIL_HOOK_COMMAND = (
    '"$(git rev-parse --show-toplevel)/.codex/hooks/block-dangerous-git.sh"'
)
CODEX_CAPTURE_HOOK_COMMAND = (
    '"$(git rev-parse --show-toplevel)/.codex/hooks/capture-codex-usage.sh"'
)
CODEX_STEP_GUARD_HOOK_COMMANDS = {
    "Read": 'GUARD_TYPE=read "$(git rev-parse --show-toplevel)"/.codex/hooks/step-guard.sh',
    "Edit": 'GUARD_TYPE=write "$(git rev-parse --show-toplevel)"/.codex/hooks/step-guard.sh',
    "Write": 'GUARD_TYPE=write "$(git rev-parse --show-toplevel)"/.codex/hooks/step-guard.sh',
    "apply_patch": 'GUARD_TYPE=write "$(git rev-parse --show-toplevel)"/.codex/hooks/step-guard.sh',
    "Bash": 'GUARD_TYPE=bash "$(git rev-parse --show-toplevel)"/.codex/hooks/step-guard.sh',
}

COPILOT_STEP_GUARD_MATCHERS = {
    "Read": ("read_file", "view"),
    "Edit": ("edit", "apply_patch"),
    "Write": ("write_file", "create"),
    "Bash": ("bash",),
}
COPILOT_OWNED_MARKER = "# Generated by Agent Factory; do not edit."

CODEX_AGENT_OWNED_MARKER = "# Generated by Agent Factory; do not edit.\n"

# Marker lines that fence the single .gitignore block. remove-factory strips
# everything between them (inclusive). Keep these strings in sync there.
GITIGNORE_BEGIN = "# >>> agent_factory related >>>"
GITIGNORE_END = "# <<< agent_factory related <<<"

# Marker lines that fence the orientation-include block injected into a
# project's existing orientation file. remove-factory strips the block
# (inclusive) on uninstall.
ORIENTATION_BEGIN = "<!-- >>> agent_factory orientation >>>"
ORIENTATION_END = "<!-- <<< agent_factory orientation <<< -->"

# Per-CLI include directives.  Claude Code supports @-includes (path relative
# to the file's directory); Copilot CLI and Pi have no native include so the
# full AGENTS.md content is inlined between the markers.
ORIENTATION_INCLUDE = {
    ".claude": "@../factory/config/AGENTS.md\n",
}

RULEBOOK_LINK_TARGETS = {
    ".github": "../factory/rulebooks/rules.md",
    ".pi": "factory/rulebooks/rules.md",
    ".codex": "factory/rulebooks/rules.md",
}

MANIFEST_PATH = ".agent-factory/factory-install.json"
USAGE_RUNTIME = Path(".agent-factory/usage-runtime")
USAGE_REQUIREMENTS = Path("factory/config/usage-runtime-requirements.txt")
PROJECT_IDENTITY = Path("config/project.json")


CLI_LABELS = {
    "claude": "Claude Code",
    "copilot": "GitHub Copilot CLI",
    "pi": "Stackblitz Pi",
    "codex": "OpenAI Codex CLI",
}


def detect_cli(target: Path) -> list[str]:
    """Auto-detect CLIs from existing dot-directories in the target.
    Returns a list of detected CLI names (may be empty)."""
    found = []
    if (target / ".claude").is_dir():
        found.append("claude")
    if (target / ".github").is_dir():
        found.append("copilot")
    if (target / ".pi").is_dir():
        found.append("pi")
    if (target / ".codex").is_dir() or (target / ".agents").is_dir():
        found.append("codex")
    return found


def _wants(clis: list[str] | None, name: str) -> bool:
    """True when the named CLI is in the active set (None = all)."""
    return clis is None or name in clis


def _active_dot_dirs(clis: list[str] | None) -> list[str]:
    """Compute the union of dot-dirs for the selected CLIs."""
    if clis is None:
        return list(DOT_DIRS)
    result: list[str] = []
    for c in clis:
        for d in CLI_DOT_DIRS[c]:
            if d not in result:
                result.append(d)
    return result


def ask_clis() -> list[str] | None:
    """Interactively ask which CLIs to wire. Returns list or None (all).
    Falls back to None on non-TTY or empty input."""
    if not sys.stdin.isatty():
        return None
    print("  Which CLIs should be wired?")
    for i, name in enumerate(KNOWN_CLIS, 1):
        print(f"    {i}  {name:<10} {CLI_LABELS[name]}")
    print()
    print("  Enter one or more (e.g. 1,3 or claude copilot), 'a' for all:")
    try:
        answer = input("  > ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if answer in ("a", "all", ""):
        return None
    selected: list[str] = []
    for token in answer.replace(",", " ").split():
        token = token.strip()
        if token.isdigit():
            idx = int(token) - 1
            if 0 <= idx < len(KNOWN_CLIS) and KNOWN_CLIS[idx] not in selected:
                selected.append(KNOWN_CLIS[idx])
        elif token in KNOWN_CLIS and token not in selected:
            selected.append(token)
    return selected if selected else None


class Collision(Exception):
    """Raised when a step finds something at a destination path that isn't
    ours to skip past — stops the whole run, names the exact path."""


class _Output:
    quiet = False

_out = _Output()


def section(title: str) -> None:
    padding = max(1, 54 - len(title))
    print(f"\n── {title} {'─' * padding}")


def log(report: list[str], line: str) -> None:
    report.append(line)
    if not _out.quiet:
        print(f"  {line}")


# --------------------------------------------------------------------------- #
# Steps
# --------------------------------------------------------------------------- #


def ensure_target_dir(target: Path, install: dict, report: list[str]) -> None:
    if target.exists():
        log(report, f"target directory exists: {target}")
        return

    target.mkdir(parents=True)
    log(report, f"created target directory: {target}")


def ensure_git(target: Path, install: dict, report: list[str]) -> None:
    if (target / ".git").exists():
        # setdefault: a prior run may have recorded that WE created this repo.
        install.setdefault("git_initialized_by_us", False)
        log(report, "git: already a repo, left untouched")
        return

    subprocess.run(["git", "init", str(target)], check=True, capture_output=True)
    install["git_initialized_by_us"] = True
    log(report, "git: initialized new repo")


def fix_origin_head(target: Path, report: list[str]) -> None:
    """Detect and repair a dangling `origin/HEAD` symref.

    `origin/HEAD` is a local symref that should point at the remote's default
    branch (e.g. `refs/remotes/origin/main`). It goes dangling — pointing at a
    branch that no longer exists locally, most often `origin/master` after the
    remote's default moved to `main` — whenever a clone predates that rename.
    Tools that resolve `origin/HEAD` (merge-base lookups, default-branch
    detection) then fail silently. This is a best-effort repair: it never
    raises and never aborts init, regardless of git or network state.

    Repair order:
      1. No-op if `origin/HEAD` already resolves to an existing ref.
      2. Try `git remote set-head origin --auto`, which asks the remote which
         branch is its default (requires network).
      3. If that fails (no network, no `origin` remote, ...), fall back to
         scanning locally-known `refs/remotes/origin/*` for `main` or
         `master` (preferring `main`) and point the symref there directly.
    """
    try:
        valid = subprocess.run(
            ["git", "rev-parse", "--verify", "-q", "refs/remotes/origin/HEAD"],
            cwd=target,
            capture_output=True,
            text=True,
            check=False,
        )
        if valid.returncode == 0:
            log(report, "origin/HEAD: valid, no repair needed")
            return

        auto = subprocess.run(
            ["git", "remote", "set-head", "origin", "--auto"],
            cwd=target,
            capture_output=True,
            text=True,
            check=False,
        )
        if auto.returncode == 0:
            log(
                report, "origin/HEAD: dangling, repaired via git remote set-head --auto"
            )
            return

        # `--auto` needs network (or no `origin` remote exists at all) —
        # fall back to what's already known locally.
        branches = subprocess.run(
            [
                "git",
                "for-each-ref",
                "--format=%(refname:short)",
                "refs/remotes/origin/",
            ],
            cwd=target,
            capture_output=True,
            text=True,
            check=False,
        )
        if branches.returncode != 0:
            log(
                report,
                "origin/HEAD: dangling, repair skipped — "
                f"could not list local remote-tracking refs ({branches.stderr.strip()})",
            )
            return

        names = {
            line.split("/", 1)[1]
            for line in branches.stdout.splitlines()
            if "/" in line
        }
        for candidate in ("main", "master"):
            if candidate not in names:
                continue

            fallback = subprocess.run(
                [
                    "git",
                    "symbolic-ref",
                    "refs/remotes/origin/HEAD",
                    f"refs/remotes/origin/{candidate}",
                ],
                cwd=target,
                capture_output=True,
                text=True,
                check=False,
            )
            if fallback.returncode == 0:
                log(
                    report,
                    f"origin/HEAD: dangling, repaired locally to "
                    f"refs/remotes/origin/{candidate} (offline fallback)",
                )
            else:
                log(
                    report,
                    "origin/HEAD: dangling, offline fallback failed — "
                    f"{fallback.stderr.strip()}",
                )
            return

        log(
            report,
            "origin/HEAD: dangling, repair skipped — "
            "no local origin/main or origin/master to fall back to",
        )
    except OSError as exc:
        # git itself unavailable, or some other OS-level failure — this repair
        # is best-effort and must never abort init.
        log(report, f"origin/HEAD: repair skipped — {exc}")


def copy_factory(
    source_factory: Path, target: Path, install: dict, report: list[str]
) -> None:
    dest = target / "factory"

    # factory/ is unconditionally Agent Factory's own toolset — always record
    # it for removal, whether we copy it now or it was copied on a prior run.
    install["remove_paths"].append("factory")

    if dest.exists():
        log(
            report,
            "factory/: already present, skipped — refreshing an existing "
            "factory/ is the update script's job (factory/scripts/update-factory), "
            "not init's",
        )
        return

    shutil.copytree(source_factory, dest, symlinks=False)
    log(report, f"factory/: copied in from {source_factory}")


def ensure_dot_dirs(target: Path, install: dict, report: list[str],
                    dot_dirs: list[str] | None = None) -> None:
    for name in (dot_dirs if dot_dirs is not None else DOT_DIRS):
        path = target / name

        if path.exists():
            install["dir_existed"][name] = True
            log(report, f"{name}/: already present, continuing")
            continue

        path.mkdir()
        install["dir_existed"][name] = False
        install["remove_paths"].append(name)
        log(report, f"{name}/: created")


def ensure_symlink(
    link: Path, dest: Path, report: list[str], install: dict | None = None
) -> bool:
    """Create a relative symlink at `link` pointing to `dest`. Returns True if
    a new link was created, False if it was already correct. Records created
    links in install["remove_paths"] when `install` is passed."""
    rel = os.path.relpath(dest, start=link.parent)

    if link.is_symlink():
        current = (link.parent / os.readlink(link)).resolve()

        if current == dest.resolve():
            if install is not None:
                install["remove_paths"].append(_relpath(link, install))
            log(report, f"skip (already linked): {link}")
            return False

        raise Collision(f"{link} is already a symlink to {current}, not to {dest}")

    if link.exists():
        # When both sides are directories, merge factory entries individually
        # instead of requiring a wholesale symlink.
        if link.is_dir() and dest.is_dir() and install is not None:
            return _merge_into_existing_dir(link, dest, report, install)
        raise Collision(f"{link} already exists and is not a symlink to {dest}")

    link.symlink_to(rel)
    if install is not None:
        install["remove_paths"].append(_relpath(link, install))
    log(report, f"linked: {link} -> {rel}")
    return True


def _merge_into_existing_dir(
    link: Path, dest: Path, report: list[str], install: dict
) -> bool:
    """Symlink each entry from *dest* into the existing *link* directory.

    Used when the project already owns a directory at a path the factory would
    normally replace with a single directory symlink (e.g. `.github/scripts`
    already contains project scripts).  Individual entries are tracked in
    ``install["remove_paths"]`` for removal, and the parent is recorded in
    ``install["merged_dirs"]`` so remove-factory knows NOT to ``rmtree`` it.
    """
    created_any = False
    merged_key = _relpath(link, install)
    install.setdefault("merged_dirs", []).append(merged_key)

    for child in sorted(dest.iterdir()):
        child_link = link / child.name
        child_rel = os.path.relpath(child, start=child_link.parent)

        if child_link.is_symlink():
            current = (child_link.parent / os.readlink(child_link)).resolve()
            if current == child.resolve():
                install["remove_paths"].append(_relpath(child_link, install))
                log(report, f"skip (already merged): {child_link}")
                continue
            raise Collision(
                f"{child_link} is already a symlink to {current}, not to {child}"
            )

        if child_link.exists():
            log(report, f"skip (project owns): {child_link}")
            continue

        child_link.symlink_to(child_rel)
        install["remove_paths"].append(_relpath(child_link, install))
        log(report, f"merged: {child_link} -> {child_rel}")
        created_any = True

    log(report, f"merged factory entries into existing dir: {link}")
    return created_any


def _relpath(path: Path, install: dict) -> str:
    return os.path.relpath(path, start=install["_target"])


def symlink_factory_content(target: Path, install: dict, report: list[str],
                            dot_dirs: list[str] | None = None) -> None:
    factory = target / "factory"

    for dot_dir in (dot_dirs if dot_dirs is not None else DOT_DIRS):
        base = target / dot_dir

        for name in FACTORY_CONTENT:
            if dot_dir == ".github" and name == "agents":
                continue  # Copilot agents are generated, not symlinked
            if dot_dir == ".codex" and name in ("agents", "skills"):
                continue  # agents generated into .codex/agents/; skills go to .agents/skills/
            ensure_symlink(base / name, factory / name, report, install=install)
            # .github and .codex entries are ignored individually (never the
            # whole dir); .claude and .pi are ignored wholesale.
            if dot_dir == ".github":
                merged_key = _relpath(base / name, install)
                if merged_key in install.get("merged_dirs", []):
                    for child_rel in install["remove_paths"]:
                        if child_rel.startswith(merged_key + "/"):
                            install["github_ignored_entries"].add(child_rel)
                else:
                    install["github_ignored_entries"].add(f".github/{name}")
            elif dot_dir == ".codex":
                install["codex_ignored_entries"].add(f".codex/{name}")

        _link_orientation(target, dot_dir, factory, install, report)


def _ensure_project_directory(path: Path, install: dict, report: list[str]) -> None:
    """Create a shared project directory without following foreign symlinks."""
    if path.is_symlink() or (path.exists() and not path.is_dir()):
        raise Collision(f"{path} exists and is not a project directory")
    if path.exists():
        return
    path.mkdir()
    log(report, f"{_relpath(path, install)}/: created")


def _preflight_codex_link(link: Path, dest: Path) -> None:
    """Accept an absent or exact Factory link, rejecting every foreign path."""
    if link.is_symlink():
        current = (link.parent / os.readlink(link)).resolve()
        if current != dest.resolve():
            raise Collision(f"{link} is already a symlink to {current}, not to {dest}")
        return
    if link.exists():
        raise Collision(f"{link} already exists and is not a symlink to {dest}")


def _has_codex_agent_marker(path: Path) -> bool:
    if path.is_symlink() or not path.is_file():
        return False
    try:
        with path.open(encoding="utf-8") as stream:
            return stream.readline() == CODEX_AGENT_OWNED_MARKER
    except (OSError, UnicodeError):
        return False


def preflight_codex_adapter(target: Path, install: dict) -> None:
    """Validate the Codex-specific footprint (.agents/, generated agents, hooks).

    The .codex/ dot-dir itself is created by ensure_dot_dirs and validated there.
    This function covers what's unique to codex: .agents/ tree, agent generation
    targets, and hook script destinations."""
    factory = target / "factory"
    directory_paths = (
        target / ".agents",
        target / ".agents/skills",
        target / ".codex/agents",
        target / ".codex/hooks",
    )
    for path in directory_paths:
        if path.is_symlink() or (path.exists() and not path.is_dir()):
            raise Collision(f"unsafe Codex directory path: {path}")

    # Orientation (AGENTS.md) is validated and linked by _link_orientation
    # via symlink_factory_content — no preflight needed here.

    for source in sorted((factory / "skills").iterdir()):
        if source.is_dir() and (source / "SKILL.md").is_file():
            _preflight_codex_link(target / ".agents/skills" / source.name, source)
    # Standard factory symlinks (playbooks, rulebooks, scripts, INDEX.yaml)
    # are validated and created by symlink_factory_content.
    for name in ("block-dangerous-git.sh", "capture-codex-usage.sh", "step-guard.sh"):
        _preflight_codex_link(
            target / ".codex/hooks" / name,
            target / "factory/config/hooks" / name,
        )

    prior_agents = install["codex_generated_agents"]
    desired_agents = {
        f".codex/agents/{source.stem}.toml"
        for source in sorted((factory / "agents").glob("*.md"))
    }
    for relative in desired_agents:
        destination = target / relative
        if not (destination.exists() or destination.is_symlink()):
            continue
        if relative not in prior_agents or not _has_codex_agent_marker(destination):
            raise Collision(f"foreign Codex agent collision: {destination}")

    agents_dir = target / ".codex/agents"
    if agents_dir.is_dir():
        for path in agents_dir.glob("*.toml"):
            relative = _relpath(path, install)
            if _has_codex_agent_marker(path) and relative not in prior_agents:
                raise Collision(f"unmanifested Codex agent ownership marker: {path}")

    hooks_path = target / ".codex/hooks.json"
    if hooks_path.is_symlink():
        raise Collision(f"unsafe Codex hooks file: {hooks_path}")
    if hooks_path.exists():
        info = hooks_path.stat()
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_nlink != 1
            or (hasattr(os, "geteuid") and info.st_uid != os.geteuid())
        ):
            raise Collision(f"unsafe Codex hooks file: {hooks_path}")
        try:
            config = json.loads(hooks_path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError, UnicodeError) as exc:
            raise Collision(f"{hooks_path} exists but isn't valid JSON ({exc})")
        if not isinstance(config, dict):
            raise Collision(
                f"{hooks_path} exists but its top-level JSON isn't an object"
            )
        hooks = config.get("hooks", {})
        if not isinstance(hooks, dict):
            raise Collision(f"{hooks_path}: 'hooks' key exists but isn't an object")
        for event in ("PreToolUse", *CODEX_CAPTURE_HOOK_EVENTS):
            if event in hooks and not isinstance(hooks[event], list):
                raise Collision(
                    f"{hooks_path}: 'hooks.{event}' exists but isn't a list"
                )


def install_codex_adapter(target: Path, install: dict, report: list[str]) -> None:
    """Install Codex's .agents/ tree and generated agent adapters.

    The .codex/ dot-dir and its standard factory symlinks (playbooks, rulebooks,
    scripts, INDEX.yaml) are already handled by ensure_dot_dirs and
    symlink_factory_content. This function covers the codex-specific layout:
    .agents/skills/ symlinks, .codex/agents/*.toml generation, and sub-dirs."""
    factory = target / "factory"
    agents_root = target / ".agents"
    skills_dir = agents_root / "skills"
    generated_dir = target / ".codex" / "agents"

    for directory in (agents_root, skills_dir, generated_dir):
        _ensure_project_directory(directory, install, report)

    for source in sorted((factory / "skills").iterdir()):
        if not source.is_dir() or not (source / "SKILL.md").is_file():
            continue
        link = skills_dir / source.name
        ensure_symlink(link, source, report, install=install)
        install["agents_ignored_entries"].add(_relpath(link, install))

    generator = factory / "scripts" / "generate-codex-agents"
    result = subprocess.run(
        [
            sys.executable,
            str(generator),
            "--agents-dir",
            str(factory / "agents"),
            "--output-dir",
            str(generated_dir),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        reason = result.stderr.strip() or result.stdout.strip() or "generation failed"
        raise Collision(f"Codex agent generation failed: {reason}")
    log(report, result.stdout.strip())
    install["codex_generated_agents"] = set()
    for source in sorted((factory / "agents").glob("*.md")):
        generated = generated_dir / f"{source.stem}.toml"
        relative = _relpath(generated, install)
        install["remove_paths"].append(relative)
        install["codex_ignored_entries"].add(relative)
        install["codex_generated_agents"].add(relative)


def _has_copilot_agent_marker(path: Path) -> bool:
    if path.is_symlink() or not path.is_file():
        return False
    try:
        text = path.read_text(encoding="utf-8")
        if not text.startswith("---"):
            return False
        close = text.find("\n---", 3)
        if close == -1:
            return False
        return COPILOT_OWNED_MARKER in text[:close]
    except (OSError, UnicodeError):
        return False


def preflight_copilot_agents(target: Path, install: dict) -> None:
    """Validate the Copilot agents directory before generating into it."""
    factory = target / "factory"
    agents_dir = target / ".github" / "agents"

    if agents_dir.is_symlink():
        current = (agents_dir.parent / os.readlink(agents_dir)).resolve()
        canonical = (factory / "agents").resolve()
        if current != canonical:
            raise Collision(
                f".github/agents is a symlink to {current}, not to {canonical}"
            )
        return  # Will be replaced during install

    if not agents_dir.is_dir():
        return  # Will be created

    prior = install["copilot_generated_agents"]
    desired = {
        f".github/agents/{src.name}"
        for src in sorted((factory / "agents").glob("*.md"))
    }
    for relative in desired:
        destination = target / relative
        if not destination.exists():
            continue
        if relative in prior or _has_copilot_agent_marker(destination):
            continue
        if destination.is_symlink():
            current = (destination.parent / os.readlink(destination)).resolve()
            canonical = (factory / "agents" / destination.name).resolve()
            if current == canonical:
                continue  # Old symlink from prior init; will be replaced
        try:
            if (
                destination.read_bytes()
                == (factory / "agents" / destination.name).read_bytes()
            ):
                continue  # Byte-identical copy from prior init
        except OSError:
            pass
        raise Collision(f"foreign Copilot agent collision: {destination}")

    for path in agents_dir.glob("*.md"):
        relative = _relpath(path, install)
        if _has_copilot_agent_marker(path) and relative not in prior:
            raise Collision(f"unmanifested Copilot agent ownership marker: {path}")


def install_copilot_agents(target: Path, install: dict, report: list[str]) -> None:
    """Generate Copilot agent definitions with tools: frontmatter."""
    factory = target / "factory"
    agents_dir = target / ".github" / "agents"

    if agents_dir.is_symlink():
        agents_dir.unlink()
        log(
            report,
            ".github/agents: removed directory symlink (replaced by generated copies)",
        )

    agents_dir.mkdir(parents=True, exist_ok=True)

    generator = factory / "scripts" / "generate-copilot-agents"
    result = subprocess.run(
        [
            sys.executable,
            str(generator),
            "--agents-dir",
            str(factory / "agents"),
            "--output-dir",
            str(agents_dir),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        reason = result.stderr.strip() or result.stdout.strip() or "generation failed"
        raise Collision(f"Copilot agent generation failed: {reason}")
    log(report, result.stdout.strip())

    install["copilot_generated_agents"] = set()
    for source in sorted((factory / "agents").glob("*.md")):
        generated = agents_dir / source.name
        relative = _relpath(generated, install)
        install["remove_paths"].append(relative)
        install["copilot_generated_agents"].add(relative)
    install["github_ignored_entries"].add(".github/agents")


def _orientation_block(dot_dir: str, factory: Path) -> str:
    """Build the marker-fenced orientation block for a given CLI."""
    include = ORIENTATION_INCLUDE.get(dot_dir)
    if include is not None:
        body = include
    else:
        body = (factory / "config" / "AGENTS.md").read_text(encoding="utf-8")
        if not body.endswith("\n"):
            body += "\n"
        target = RULEBOOK_LINK_TARGETS.get(dot_dir)
        if target is not None:
            body = body.replace("](../rulebooks/rules.md)", f"]({target})")
    return (
        ORIENTATION_BEGIN
        + "\n"
        + "Added by init-factory; remove with factory/scripts/remove-factory.\n"
        + body
        + ORIENTATION_END
        + "\n"
    )


def _inject_orientation(
    path: Path,
    dot_dir: str,
    factory: Path,
    install: dict,
    report: list[str],
) -> None:
    """Prepend a marker-fenced orientation block to an existing orientation
    file.  Idempotent: refreshes the block on re-run, skips if current."""
    rel = _relpath(path, install)
    block = _orientation_block(dot_dir, factory)
    existing = path.read_text(encoding="utf-8")

    if ORIENTATION_BEGIN in existing and ORIENTATION_END in existing:
        pre, rest = existing.split(ORIENTATION_BEGIN, 1)
        _, post = rest.split(ORIENTATION_END, 1)
        rebuilt = pre + block + post.lstrip("\n")
        if rebuilt != existing:
            path.write_text(rebuilt, encoding="utf-8")
            log(report, f"{rel}: refreshed Agent Factory orientation block")
        else:
            log(report, f"{rel}: orientation block already current")
        install["orientation"][rel] = "injected"
        return

    install.setdefault("orientation_orig_final_newline", {}).setdefault(
        rel, existing.endswith("\n")
    )
    header = block + "\n"
    path.write_text(header + existing, encoding="utf-8")
    install["orientation"][rel] = "injected"
    log(report, f"{rel}: prepended Agent Factory orientation block")


def _link_orientation(
    target: Path, dot_dir: str, factory: Path, install: dict, report: list[str]
) -> None:
    rel = ORIENTATION_FILE[dot_dir]
    link = target / rel
    dest = factory / "config" / "AGENTS.md"

    if link.exists() and not link.is_symlink():
        _inject_orientation(link, dot_dir, factory, install, report)
        return

    ensure_symlink(link, dest, report, install=install)
    install["orientation"][rel] = "linked"
    if dot_dir == ".github":
        install["github_ignored_entries"].add(rel)
    elif dot_dir in (".pi", ".codex"):
        install["ignore_root_agents"] = True


def install_git_guardrail(target: Path, install: dict, report: list[str],
                          clis: list[str] | None = None) -> None:
    if _wants(clis, "claude"):
        _install_claude_guardrail(target, install, report)
    if _wants(clis, "copilot"):
        _install_copilot_guardrail(target, install, report)
    if _wants(clis, "pi"):
        _install_pi_guardrail(target, install, report)
    if _wants(clis, "codex"):
        _install_codex_guardrail(target, install, report)


def install_step_guard(target: Path, install: dict, report: list[str],
                       clis: list[str] | None = None) -> None:
