#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
# spec-lint - Deterministic consistency linter for docs/spec/.
#
# What: Parses docs/spec/ Markdown, checks required artifacts, validates
#       ID cross-references, and reports deterministic defects — Pass 1 of the
#       spec review.
# When: On commit when docs/spec/ changes; on demand via /validate; ahead of
#       the inspect-spec LLM pass.
# By:   pre-commit hook `spec-lint` (and its orchestrator variant); the
#       inspect-spec skill / spec-review-agent.
#
# This is the Pass-1 (deterministic) half of the spec review mechanism. It parses
# the specification core (Markdown files and features/*.feature), checks
# cross-references between declared IDs (BR-###, entities, glossary terms), and
# reports the defect classes a parser can catch exactly and cheaply — leaving
# semantic judgement to the inspect-spec LLM pass.
#
# It has NO third-party dependencies (Python 3.8+ stdlib only), so it runs anywhere
# without a virtualenv, mirroring the zero-install intent of scripts/structurizr.
#
# Usage:
#   ./spec-lint [--spec-dir docs/spec] [--glossary docs/spec/glossary.md]
#               [--format text|json] [--gate-todos] [--report-only]
#
# Exit code: 1 when there is at least one ERROR-severity finding, 0 when
# clean or with --report-only, 2 on a usage error.
# Findings are grouped by code so the LLM reviewer and CI can both consume them.
#
# Every check is intentionally conservative: it flags only what is deterministically
# provable from the declared structure, to keep false positives near zero. Heuristic
# checks are marked (heuristic) in their message and emitted at warning/info severity.

import argparse
import json
import os
import re
import sys
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Dict, List, Set

# Session-log helper lives beside this script; ensure it is importable whether
# spec-lint is run directly or loaded from elsewhere. See
# docs/proposals/session-log-addendum.md.
_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)
import _session_log  # noqa: E402

SEVERITY_ORDER = {"error": 3, "warning": 2, "info": 1}

# --- Regexes for declared anchors -------------------------------------------------
RE_BR = re.compile(r"\bBR-(\d{1,3})\b")
RE_BR_DEF = re.compile(r"^\s*(?:[-*]\s*)?\*{0,2}BR-(\d{1,3})\*{0,2}\s*[:.—-]")
RE_BR_DEF_TABLE = re.compile(r"^\s*\|\s*BR-(\d{1,3})\s*\|")
RE_HEADING = re.compile(r"^#{1,6}\s+")
RE_FENCE = re.compile(r"^```+\s*([A-Za-z0-9_-]*)\s*$")
RE_MERMAID_TRANSITION = re.compile(r"^\s*(.+?)\s*-->\s*(.+?)\s*(?::.*)?$")
# Mermaid ER relationship: ENTITY1 <cardinality-glyphs> ENTITY2 : label
# Cardinality tokens contain |, o, {, }, --, .. — matched loosely as a no-space run.
RE_ERD_REL = re.compile(r"^\s*([A-Za-z_]\w*)\s+\S+\s+([A-Za-z_]\w*)\s*:")
RE_ERD_ENTITY_BLOCK = re.compile(r"^\s*([A-Za-z_][\w-]*)\s*\{")

REQUIRED_ARTIFACTS = [
    "scope-map.md",
    "entity-model.md",
]

# Working output (gaps reports, QA strategies, todo lists) lives here; it is
# not part of the specification core.
WORK_DIR = "work"


@dataclass
class Finding:
    code: str
    severity: str  # error | warning | info
    artifact: str
    message: str

    def line(self) -> str:
        return (
            f"[{self.severity.upper():7}] {self.code}  {self.artifact}: {self.message}"
        )


@dataclass
class Graph:
    business_rules_defined: Set[str] = field(default_factory=set)
    business_rules_referenced: Set[str] = field(default_factory=set)
    entities: Set[str] = field(default_factory=set)
    entities_with_attrs: Set[str] = field(default_factory=set)


def read(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return ""


def fenced_blocks(text: str, lang: str) -> List[str]:
    """Return the bodies of ```<lang> ... ``` fenced code blocks."""
    blocks, buf, inside, cur_lang = [], [], False, ""
    for ln in text.splitlines():
        m = RE_FENCE.match(ln)
        if m:
            if inside:
                if cur_lang.lower() == lang.lower():
                    blocks.append("\n".join(buf))
                buf, inside = [], False
            else:
                inside, cur_lang = True, m.group(1)
            continue
        if inside:
            buf.append(ln)
    return blocks


# --- Individual checks ------------------------------------------------------------


def check_required_artifacts(spec: Path) -> List[Finding]:
    out = []
    for rel in REQUIRED_ARTIFACTS:
        if not (spec / rel).exists():
            out.append(
                Finding("STRUCT005", "error", rel, "required spec artifact is missing")
            )
    return out


# Unattended reverse-map writes `status: draft` into the scope map's
# frontmatter. A stakeholder confirms the map by removing the field or setting
# it to `confirmed`; until then the brownfield Stage 1 exit must fail (BUG-0096).
RE_FRONTMATTER = re.compile(r"\A---\n(.*?)\n---\s*$", re.S | re.M)
RE_DRAFT_STATUS = re.compile(r"^status:\s*['\"]?draft['\"]?\s*$", re.M)


def check_scope_map_draft(spec: Path) -> List[Finding]:
    m = RE_FRONTMATTER.match(read(spec / "scope-map.md"))
    if not m or not RE_DRAFT_STATUS.search(m.group(1)):
        return []
    return [
        Finding(
            "SCOPE001",
            "error",
            "scope-map.md",
            "scope map is a draft (frontmatter status: draft); a stakeholder "
            "must confirm it before the brownfield Stage 1 exit",
        )
    ]


def feature_files(spec: Path) -> List[Path]:
    """Return the feature files of the core, in docs/spec/features/."""
    return sorted((spec / "features").glob("*.feature"))


def collect_graph(spec: Path, graph: Graph) -> None:
    for f in spec.rglob("*.md"):
        for ln in read(f).splitlines():
            defm = RE_BR_DEF.match(ln) or RE_BR_DEF_TABLE.match(ln)
            is_heading = bool(RE_HEADING.match(ln))
            if defm:
                graph.business_rules_defined.add(f"BR-{int(defm.group(1)):03d}")
            if is_heading:
                for hbr in RE_BR.finditer(ln):
                    graph.business_rules_defined.add(f"BR-{int(hbr.group(1)):03d}")
            if RE_BR_DEF.match(ln) or is_heading:
                continue
            for br in RE_BR.finditer(ln):
                graph.business_rules_referenced.add(f"BR-{int(br.group(1)):03d}")

    # A feature file defines no business rule: every BR-### in it, comment
    # lines included, is a reference.
    for f in feature_files(spec):
        for br in RE_BR.finditer(read(f)):
            graph.business_rules_referenced.add(f"BR-{int(br.group(1)):03d}")

    erd = spec / "entity-model.md"
    for block in fenced_blocks(read(erd), "mermaid"):
        if "erdiagram" not in block.lower():
            continue
        for ln in block.splitlines():
            bm = RE_ERD_ENTITY_BLOCK.match(ln)
            if bm:
                graph.entities.add(bm.group(1).upper())
                graph.entities_with_attrs.add(bm.group(1).upper())
            rm = RE_ERD_REL.match(ln)
            if rm:
                graph.entities.add(rm.group(1).upper())
                graph.entities.add(rm.group(2).upper())


def check_traceability(spec: Path, graph: Graph) -> List[Finding]:
    out = []

    # BR referenced but never defined blocks; defined but never used informs.
    for bid in sorted(graph.business_rules_referenced - graph.business_rules_defined):
        out.append(
            Finding(
                "TRACE002",
                "error",
                "docs/spec",
                f"{bid} is referenced but never defined in a Business Rules section",
            )
        )
    for bid in sorted(graph.business_rules_defined - graph.business_rules_referenced):
        out.append(
            Finding(
                "TRACE003",
                "info",
                "docs/spec",
                f"{bid} is defined but never referenced elsewhere",
            )
        )

    # Entities that appear only in relationships, with no attribute block, are
    # underspecified — a genuine completeness gap the ERD can prove on its own.
    for ent in sorted(graph.entities - graph.entities_with_attrs):
        out.append(
            Finding(
                "TRACE004",
                "info",
                "docs/spec/entity-model.md",
                f"entity '{ent}' is used in a relationship but has no attribute block defined",
            )
        )
    return out


def check_state_machines(spec: Path) -> List[Finding]:
    out = []
    sm = spec / "state-machines.md"
    if not sm.exists():
        return out
    rel = "docs/spec/state-machines.md"
    for block in fenced_blocks(read(sm), "mermaid"):
        if "statediagram" not in block.lower():
            continue
        succ: Dict[str, Set[str]] = {}
        initial: Set[str] = set()
        nodes: Set[str] = set()
        terminal: Set[str] = set()
        for ln in block.splitlines():
            m = RE_MERMAID_TRANSITION.match(ln.strip())
            if not m:
                continue
            a, b = m.group(1).strip(), m.group(2).strip()
            if a == "[*]":
                initial.add(b)
                nodes.add(b)
            elif b == "[*]":
                terminal.add(a)
                nodes.add(a)
            else:
                succ.setdefault(a, set()).add(b)
                nodes.update({a, b})
        if not initial:
            out.append(
                Finding(
                    "SM003",
                    "warning",
                    rel,
                    "state diagram has no initial transition ([*] --> State)",
                )
            )
            continue
        reached, stack = set(initial), list(initial)
        while stack:
            n = stack.pop()
            for nxt in succ.get(n, ()):
                if nxt not in reached:
                    reached.add(nxt)
                    stack.append(nxt)
        for n in sorted(nodes - reached):
            out.append(
                Finding(
                    "SM001",
                    "warning",
                    rel,
                    f"state '{n}' is unreachable from the initial state",
                )
            )
        for n in sorted(nodes):
            if n not in succ and n not in terminal:
                out.append(
                    Finding(
                        "SM002",
                        "warning",
                        rel,
                        f"state '{n}' is a non-terminal dead end (no outgoing transition, no [*])",
                    )
                )
    return out


# The todo lists are working output in docs/spec/work/. todo.md marks an open
# entry with `- status: open` (templates/todo-entry.md); todos.md also counts
# `- [ ]` items, which several agents and playbooks still write (BUG-0091).
OPEN_ENTRY = r"^\s*-\s*status:\s*open\s*$"
OPEN_CHECKBOX = r"^\s*-\s*\[\s\]"
TODO_FILES = (
    ("todo.md", re.compile(OPEN_ENTRY, re.M)),
    ("todos.md", re.compile(f"{OPEN_ENTRY}|{OPEN_CHECKBOX}", re.M)),
)


def check_todos(spec: Path, gate: bool) -> List[Finding]:
    findings: List[Finding] = []
    for name, open_item in TODO_FILES:
        todos = spec / WORK_DIR / name
        if not todos.exists():
            continue
        open_items = len(open_item.findall(read(todos)))
        if open_items:
            sev = "error" if gate else "info"
            findings.append(
                Finding(
                    "TODO001",
                    sev,
                    f"docs/spec/{WORK_DIR}/{name}",
                    f"{open_items} unresolved todo item(s) remain",
                )
            )
    return findings


RE_TABLE_SEPARATOR = re.compile(r"^\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?\s*$")


def table_cells(line: str) -> List[str]:
    """Split one Markdown table row into its stripped cells."""
    return [c.strip() for c in line.strip().strip("|").split("|")]


def glossary_terms(text: str) -> Set[str]:
    """Return the terms of every glossary table with a Term column.

    Emphasis around a term is not part of it: `**Agent**` reads as "Agent".
    """
    terms: Set[str] = set()
    column = None  # index of the Term column in the current table
    previous = ""
    for ln in text.splitlines():
        if not ln.lstrip().startswith("|"):
            column, previous = None, ""
            continue
        if RE_TABLE_SEPARATOR.match(ln.strip()):
            header = [c.lower() for c in table_cells(previous)]
            column = header.index("term") if "term" in header else None
        elif column is not None:
            cells = table_cells(ln)
            if column < len(cells):
                term = cells[column].strip("*_ ").strip()
                if term:
                    terms.add(term)
        previous = ln
    return terms


def check_glossary(spec: Path, glossary: Path) -> List[Finding]:
    """GLOSS001: a glossary term that no core file outside the glossary uses.

    The core is every Markdown and feature file under the spec folder. The
    glossary itself and the working output in work/ never count as a use.
    """
    if not glossary or not glossary.is_file():
        return []
    terms = glossary_terms(read(glossary))
    if not terms:
        return []
    skip = glossary.resolve()
    work = (spec / WORK_DIR).resolve()
    core = [
        f
        for f in [*spec.rglob("*.md"), *spec.rglob("*.feature")]
        if f.resolve() != skip and work not in f.resolve().parents
    ]
    corpus = "\n".join(read(f) for f in core).lower()
    return [
        Finding(
            "GLOSS001",
            "info",
            str(glossary),
            f"glossary term '{t}' is never used in the spec (heuristic)",
        )
        for t in sorted(terms)
        if t.lower() not in corpus
    ]


# --- Driver -----------------------------------------------------------------------


def run(spec: Path, glossary: Path, gate_todos: bool) -> (List[Finding], Graph):
    graph = Graph()
    findings: List[Finding] = []
    findings += check_required_artifacts(spec)
    findings += check_scope_map_draft(spec)
    collect_graph(spec, graph)
    findings += check_traceability(spec, graph)
    findings += check_state_machines(spec)
    findings += check_todos(spec, gate_todos)
    findings += check_glossary(spec, glossary)
    findings.sort(key=lambda f: (-SEVERITY_ORDER[f.severity], f.code, f.artifact))
    return findings, graph


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        description="Deterministic spec consistency & traceability linter."
    )
    p.add_argument("--spec-dir", default="docs/spec")
    p.add_argument(
        "--glossary",
        default="docs/spec/glossary.md",
        help="the glossary whose table terms GLOSS001 checks",
    )
    p.add_argument("--format", choices=["text", "json"], default="text")
    p.add_argument(
        "--gate-todos", action="store_true", help="treat unresolved todos as an error"
    )
    p.add_argument(
        "--report-only",
        action="store_true",
        help="always exit 0 (report without gating)",
    )
    args = p.parse_args(argv)

    spec = Path(args.spec_dir)
    if not spec.is_dir():
        print(f"Error: spec directory not found at {spec}", file=sys.stderr)
        return 2

    findings, graph = run(spec, Path(args.glossary), args.gate_todos)
    counts = {s: sum(1 for f in findings if f.severity == s) for s in SEVERITY_ORDER}
    _session_log.set_summary(counts)  # folded into the session-log record when active

    if args.format == "json":
        print(
            json.dumps(
                {
                    "findings": [asdict(f) for f in findings],
                    "summary": counts,
                },
                indent=2,
            )
        )
    else:
        for f in findings:
            print(f.line())
        print(
            f"\nspec-lint: {counts['error']} error(s), "
            f"{counts['warning']} warning(s), {counts['info']} info "
            f"across {len(list(spec.rglob('*.md')))} spec file(s)."
        )
    return 1 if counts["error"] and not args.report_only else 0


if __name__ == "__main__":
    with _session_log.record("spec-lint", sys.argv[1:]) as _rec:
        _rec.exit_code = main()
    sys.exit(_rec.exit_code if _rec.exit_code is not None else 0)
