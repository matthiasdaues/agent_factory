#!/usr/bin/env python3
"""migrate-spec-layout — move a project's files into the core artifact layout.

What: Moves the files of the path table in
      docs/proposals/core-artifact-layout.md into the core artifact layout.
      A tracked file moves with `git mv`, so git records a rename. An
      untracked or ignored file moves with a plain move. When
      docs/spec/<name>-qa-strategy.md and the same name in
      supplementary_specs/ share a new path, the second one moves to
      docs/spec/work/<name>-area-qa-strategy.md, and the script prints the
      pair as `same new path: <old> -> <new>, because <old> -> <new>`. A
      move never replaces a file. The script also
      rewrites the `theme` line of docs/spec/architecture.dsl. It removes
      actor-goal-list.md and every file in a use_cases/ folder under docs/,
      docs/~archive/ included, with `git rm`. A file in that removal set
      that git cannot remove safely stays and is listed as
      `delete by hand: <path>`. It moves each two-column table of
      docs/arc42/12_glossary.md into docs/spec/glossary.md, with the columns
      Term, Definition, and Avoid, rewrites chapter 12 at its old path with
      one link line, and stages both files. An existing glossary keeps its
      sections, and the chapter 12 sections follow them. It moves the
      `## Language` terms of docs/CONTEXT.md, docs/arc42/CONTEXT.md, and
      each CONTEXT.md that docs/arc42/CONTEXT-MAP.md names into a glossary
      section named after the file's title, and removes that section from
      the file. A `###` subheading under `## Language` becomes a section of
      its own, and a bullet `- **Term**:` is a term as well. These terms
      also join an existing glossary (DEC-18). It
      lists each term in more than one section as `duplicate term: <term> in <section>, <section>`
      and names the two follow-up steps as `next step:` lines at the end.
      At the end of its output it
      lists every old path outside a Markdown link, which it never rewrites,
      as `old path: <file>:<line>: <old path>`. In every Markdown file it
      scans, it rewrites each local link to a moved file, rebases each
      relative link of a moved file, and turns each link to a removed file
      into its link text in a code span. It prints each rewrite as
      `link: <file>: <old target> -> <new target>`. It gives each
      `files:` value of the project's agent_factory_hook-* entries in
      .pre-commit-config.yaml the value of the hook template
      config/pre-commit-config.yaml of the same factory tree and prints
      `hook: .pre-commit-config.yaml: <hook id>: <old> -> <new>`. Every
      content edit comes before the first move, so a failed move undoes
      them all.
When: init-factory runs it as its last step on an update; a developer can
      run it by hand.
By:   init-factory, or the project maintainer.

Usage:
    packages/factory/scripts/migrate-spec-layout [--dry-run] [TARGET]

TARGET defaults to the current directory. --dry-run prints the planned moves,
the removals, the link and hook rewrites, and the old-path listing, and
changes no file.

Exit codes:
    0  success, no work, or --dry-run
    1  a step failed partway; every change of the run is undone
    2  refused before the first change: busy repository, a destination that
       already exists, two planned moves that still share a destination, or
       bad arguments

The script never commits, never forces `git rm`, and never deletes a file
outside git.
"""

from __future__ import annotations

import argparse
import posixpath
import re
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass, field
from pathlib import Path, PurePosixPath
from urllib.parse import quote, unquote

SPEC = "docs/spec"
SUPPLEMENTARY = "docs/spec/supplementary_specs"
ARC42 = "docs/arc42"
OLD_THEMES = "docs/arc42/themes"
NEW_THEMES = "docs/assets/themes"
DSL = "docs/spec/architecture.dsl"

CORE_SUPPLEMENTARY = {
    "entity-model.md",
    "state-machines.md",
    "validation-rules.md",
    "interface-contracts.md",
}
WORK_FILES = {"prd.md", "SPEC-UPDATE-SUMMARY.md", "todo.md", "todos.md"}
ARC42_DSL_FILES = {"architecture.dsl", "dependency-rules.dsl"}

# A `theme` line whose path is relative to docs/arc42/themes/.
THEME_LINE = re.compile(r"^(\s*theme\s+)([\"']?)themes/", re.MULTILINE)

CHAPTER12 = "docs/arc42/12_glossary.md"
GLOSSARY = "docs/spec/glossary.md"
GLOSSARY_LINK = "The terms are in [the glossary](../spec/glossary.md)."
GLOSSARY_COLUMNS = ("Term", "Definition", "Avoid")
TITLE_SECTION = "Terms"
TABLE_SEPARATOR = re.compile(r"^\|?(\s*:?-+:?\s*\|)*\s*:?-+:?\s*\|?$")
CELL_BORDER = re.compile(r"(?<!\\)\|")

DOCS = "docs"
GOAL_LIST = "actor-goal-list.md"
USE_CASES = "use_cases"

LISTING_HEADING = "Old paths the script did not rewrite:"
PRE_COMMIT_CONFIG = ".pre-commit-config.yaml"
FACTORY_HOOK = "agent_factory_hook-"
SKIPPED_DIRS = {".git", ".agent-factory"}
# A path token that starts at a `docs/` folder, also inside a longer path.
PATH_TOKEN = re.compile(r"(?<![\w.-])docs/[\w./~*-]*")
INLINE_LINK = re.compile(r"!?\[[^\]]*\]\([^)]*\)")
REFERENCE_LINK = re.compile(r"^\s{0,3}\[[^\]]+\]:\s*\S+")
HOOK_ID = re.compile(r"^\s*-\s+id:\s*(\S+)")
LIST_ITEM = re.compile(r"^\s*-\s")


def new_path(rel: str) -> str:
    """Return the new path of ``rel`` under the path table, or ``rel`` itself.

    ``rel`` is a POSIX path relative to the project root. A path the table
    does not move, such as docs/spec/scope-map.md or a path that is already
    in the new layout, maps to itself.
    """
    path = PurePosixPath(rel)
    parent, name = str(path.parent), path.name
    if rel.startswith(OLD_THEMES + "/"):
        return NEW_THEMES + rel[len(OLD_THEMES) :]
    if parent == ARC42 and name in ARC42_DSL_FILES:
        return f"{SPEC}/{name}"
    if parent == SPEC:
        if name.endswith(".feature"):
            return f"{SPEC}/features/{name}"
        if name in WORK_FILES or name.endswith(("-gaps.md", "-qa-strategy.md")):
            return f"{SPEC}/work/{name}"
    if parent == SUPPLEMENTARY and name.endswith(".md"):
        if name in CORE_SUPPLEMENTARY:
            return f"{SPEC}/{name}"
        if name.endswith("-qa-strategy.md"):
            return f"{SPEC}/work/{name}"
        return f"{SPEC}/areas/{name}"
    return rel


# Order of the moves: the order of the path table.
def _move_rank(new: str) -> int:
    if new.startswith(f"{SPEC}/features/"):
        return 0
    if new.startswith(f"{SPEC}/work/"):
        return 3
    if new.startswith(f"{SPEC}/areas/"):
        return 4
    if new.startswith(NEW_THEMES + "/"):
        return 2
    return 1


QA_SUFFIX = "-qa-strategy.md"
SAME_NEW_PATH = "same new path"
AREA_QA_SUFFIX = "-area-qa-strategy.md"


def separate_shared_paths(
    moves: list[tuple[str, str]],
) -> tuple[list[tuple[str, str]], list[tuple[str, str, str, str]]]:
    """Give a QA strategy of supplementary_specs/ its own new path on a clash.

    docs/spec/<name>-qa-strategy.md and
    docs/spec/supplementary_specs/<name>-qa-strategy.md share the new path
    docs/spec/work/<name>-qa-strategy.md. The second one then moves to
    docs/spec/work/<name>-area-qa-strategy.md, so no file is lost (IMPL-0001).
    The result is the moves and each pair as (old, new, other old, other new).
    """
    claimed = {new: old for old, new in moves if not old.startswith(SUPPLEMENTARY)}
    result, pairs = [], []
    for old, new in moves:
        if old.startswith(SUPPLEMENTARY) and new in claimed:
            area = new.removesuffix(QA_SUFFIX) + AREA_QA_SUFFIX
            pairs.append((old, area, claimed[new], new))
            new = area
        result.append((old, new))
    return result, pairs


def plan_moves(
    root: Path,
) -> tuple[list[tuple[str, str]], list[tuple[str, str, str, str]]]:
    """List every (old, new) move for the files under ``root``.

    The second part names each pair that ``separate_shared_paths`` kept
    apart. Two moves can still share a new path; ``refuse_reason`` refuses
    them.
    """
    candidates: list[Path] = []
    for folder in (SPEC, SUPPLEMENTARY, ARC42):
        directory = root / folder
        if directory.is_dir():
            candidates += [p for p in directory.iterdir() if p.is_file()]
    themes = root / OLD_THEMES
    if themes.is_dir():
        candidates += [p for p in themes.rglob("*") if p.is_file()]
    moves = []
    for path in candidates:
        rel = path.relative_to(root).as_posix()
        target = new_path(rel)
        if target != rel and not in_removal_set(rel):
            moves.append((rel, target))
    moves, pairs = separate_shared_paths(moves)
    return sorted(moves, key=lambda move: (_move_rank(move[1]), move[0])), pairs


def _git(root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *args], capture_output=True, text=True, check=False
    )


def is_git_repo(root: Path) -> bool:
    out = _git(root, "rev-parse", "--is-inside-work-tree")
    return out.returncode == 0 and out.stdout.strip() == "true"


def busy_state(root: Path) -> str | None:
    """Name the state that keeps the repository busy, or return None."""

    def exists(name: str) -> bool:
        out = _git(root, "rev-parse", "--git-path", name)
        return (root / out.stdout.strip()).exists()

    if exists("MERGE_HEAD"):
        return "a merge is in progress"
    if exists("rebase-merge") or exists("rebase-apply"):
        return "a rebase is in progress"
    if exists("index.lock"):
        return "another git process holds the index lock (index.lock)"
    return None


def tracked_files(root: Path) -> set[str]:
    out = _git(root, "ls-files", "-z")
    return {p for p in out.stdout.split("\0") if p}


def in_removal_set(rel: str) -> bool:
    """Tell whether the path table removes ``rel``.

    The removal set holds actor-goal-list.md and every file in a folder named
    use_cases, anywhere under docs/, docs/~archive/ included (DEC-10).
    """
    parts = PurePosixPath(rel).parts
    if len(parts) < 2 or parts[0] != DOCS:
        return False
    return parts[-1] == GOAL_LIST or USE_CASES in parts[1:-1]


def _status_paths(porcelain_z: str) -> set[str]:
    """Collect every path that `git status --porcelain -z` names."""
    fields = porcelain_z.split("\0")
    paths: set[str] = set()
    index = 0
    while index < len(fields):
        entry = fields[index]
        index += 1
        if len(entry) < 4:
            continue
        paths.add(entry[3:])
        if entry[0] in "RC":
            paths.add(fields[index])
            index += 1
    return paths


def plan_removals(root: Path, git: bool) -> tuple[list[str], list[str]]:
    """Split the removal set under ``root`` into (git removes, delete by hand).

    ``git rm`` removes a file only when git tracks it and it has no staged or
    unstaged change, so git history keeps its whole content. Every other file
    of the set stays for the developer to delete.
    """
    docs = root / DOCS
    if not docs.is_dir():
        return [], []
    found = sorted(
        rel
        for rel in (p.relative_to(root).as_posix() for p in docs.rglob("*"))
        if in_removal_set(rel) and (root / rel).is_file()
    )
    if not found:
        return [], []
    if not git:
        return [], found
    tracked = tracked_files(root)
    out = _git(
        root, "status", "--porcelain", "-z", "--ignored", "--untracked-files=all"
    )
    changed = _status_paths(out.stdout)
    removable = [rel for rel in found if rel in tracked and rel not in changed]
    by_hand = [rel for rel in found if rel not in removable]
    return removable, by_hand


# ── Chapter 12 into the glossary ─────────────────────────────────────────


@dataclass
class GlossarySection:
    """One section of docs/spec/glossary.md: a heading, its prose, its rows."""

    heading: str
    prose: str = ""
    rows: list[tuple[str, ...]] = field(default_factory=list)


@dataclass
class Chapter12:
    """The conversion of chapter 12: the glossary sections and the new chapter.

    ``kept`` names each section that holds a table without two columns and
    therefore stays in chapter 12, with the column count of that table.
    """

    sections: list[GlossarySection]
    stub: str
    kept: list[tuple[str, int]] = field(default_factory=list)


def _cells(line: str) -> list[str]:
    body = line.strip().removeprefix("|")
    if body.endswith("|") and not body.endswith("\\|"):
        body = body[:-1]
    return [cell.strip() for cell in CELL_BORDER.split(body)]


def _split_tables(lines: list[str]) -> tuple[list[str], list[list[str]]]:
    """Split ``lines`` into the lines outside tables and the table blocks."""
    text: list[str] = []
    tables: list[list[str]] = []
    index = 0
    while index < len(lines):
        block = []
        while index < len(lines) and lines[index].lstrip().startswith("|"):
            block.append(lines[index])
            index += 1
        if len(block) >= 2 and TABLE_SEPARATOR.match(block[1].strip()):
            tables.append(block)
        elif block:
            text += block
        else:
            text.append(lines[index])
            index += 1
    return text, tables


def _join(parts: list[str]) -> str:
    """Join text parts with one blank line and collapse runs of blank lines."""
    text = "\n\n".join(part.strip("\n") for part in parts if part.strip())
    return re.sub(r"\n{3,}", "\n\n", text)


def convert_chapter12(text: str) -> Chapter12:
    """Convert chapter 12 into glossary sections and a new chapter 12.

    A ``##`` section whose tables all have two columns moves into the
    glossary under its heading, together with its prose. The tables directly
    under the title become the section "Terms"; the prose there stays in
    chapter 12. Every other section stays in chapter 12, below the link
    line. Cell text is copied as it is. A chapter without a two-column table
    gives no section and keeps its text.
    """
    lines = text.splitlines()
    starts = [i for i, line in enumerate(lines) if line.startswith("## ")]
    head = lines[: starts[0] if starts else len(lines)]
    chunks = [lines[a:b] for a, b in zip(starts, [*starts[1:], len(lines)])]
    title = next((i for i, line in enumerate(head) if line.startswith("# ")), -1)
    above, head = head[: title + 1], head[title + 1 :]

    sections: list[GlossarySection] = []
    kept: list[tuple[str, int]] = []

    def convert(heading: str, body: list[str]) -> list[str] | None:
        """Take the rows of ``body`` into a section; return the prose left."""
        rest, tables = _split_tables(body)
        if not tables:
            return None
        widths = [len(_cells(row)) for table in tables for row in table]
        other = [width for width in widths if width != 2]
        if other:
            kept.append((heading, other[0]))
            return None
        rows = [_cells(row) for table in tables for row in table[2:]]
        sections.append(GlossarySection(heading, rows=[(t, d) for t, d in rows]))
        return rest

    rest = convert(TITLE_SECTION, head)
    stays = ["\n".join(head if rest is None else rest)]
    for chunk in chunks:
        rest = convert(chunk[0][3:].strip(), chunk[1:])
        if rest is None:
            stays.append("\n".join(chunk))
        else:
            sections[-1].prose = _join(["\n".join(rest)])

    if not sections:
        return Chapter12([], text, kept)
    stub = _join(["\n".join(above), GLOSSARY_LINK, *stays]) + "\n"
    return Chapter12(sections, stub, kept)


def _table(rows: list[tuple[str, ...]]) -> str:
    widths = [max(3, *(len(row[i]) for row in rows)) for i in range(len(rows[0]))]
    lines = [
        "| " + " | ".join(cell.ljust(w) for cell, w in zip(row, widths)) + " |"
        for row in rows
    ]
    lines.insert(1, "| " + " | ".join("-" * w for w in widths) + " |")
    return "\n".join(lines)


def render_sections(sections: list[GlossarySection]) -> str:
    """Render ``sections``: per section one table with Term, Definition, Avoid.

    A row of two cells gets an empty Avoid cell.
    """
    parts = []
    for section in sections:
        rows = [GLOSSARY_COLUMNS, *((*row, "")[:3] for row in section.rows)]
        parts += [f"## {section.heading}", section.prose, _table(rows)]
    return _join(parts)


def render_glossary(sections: list[GlossarySection]) -> str:
    """Render the glossary: the title, then each section as a table."""
    return _join(["# Glossary", render_sections(sections)]) + "\n"


def plan_glossary(root: Path) -> Chapter12 | None:
    """Return the conversion of the project's chapter 12, or None for no work."""
    chapter = root / CHAPTER12
    if not chapter.is_file():
        return None
    result = convert_chapter12(chapter.read_text(encoding="utf-8"))
    return result if result.sections else None


# ── The terms of each CONTEXT.md into the glossary ───────────────────────

CONTEXT_FILES = ("docs/CONTEXT.md", "docs/arc42/CONTEXT.md")
CONTEXT_MAP = "docs/arc42/CONTEXT-MAP.md"
LANGUAGE_HEADING = re.compile(r"^## Language\s*$")
SECTION_END = re.compile(r"^#{1,2}\s")
TERM_LINE = re.compile(r"^(?:[-*]\s+)?\*\*(.+?)\*\*:\s*(.*)$")
AVOID_PART = re.compile(r"(?:^|\s)_Avoid_:\s*(.*)$")
SUBHEADING = re.compile(r"^###\s+(.+?)\s*#*$")
CONTEXT_TOKEN = re.compile(r"[\w./-]*CONTEXT\.md")
UNESCAPED_BAR = re.compile(r"(?<!\\)\|")
TERM_MARKUP = "*_` "
FOLD_STEP = (
    "next step: run capture-context --fold-context-map to fold the routing of "
    "CONTEXT-MAP.md and CONTEXT.md into docs/agent-context.md"
)
CLEANUP_STEP = (
    f"next step: remove the duplicate terms from {GLOSSARY} and clean it up, "
    "for example with domain-modeling"
)


@dataclass
class ContextTerms:
    """The terms of one CONTEXT.md and the file's text without ``## Language``."""

    path: str
    sections: list[GlossarySection]
    rest: str


def _cell(text: str) -> str:
    return UNESCAPED_BAR.sub(r"\\|", text)


def convert_context(
    text: str, fallback: str
) -> tuple[list[GlossarySection], str] | None:
    """Convert the ``## Language`` section of a CONTEXT.md into glossary sections.

    A term is ``**Term**:`` or the bullet ``- **Term**:`` or ``* **Term**:``,
    with a definition on the same line or the lines below and an optional
    ``_Avoid_:`` part. The terms go into a section named after the file's
    title, or ``fallback`` without a title. A ``###`` subheading starts a
    section of its own, named after the subheading. A line before the first
    term of a section is that section's prose, so no text is lost and no
    form stops the run (DEC-18). A section without text is left out. The
    result is the sections and the file's text without ``## Language``;
    None means the file has no such section.
    """
    lines = text.splitlines()
    start = next(
        (i for i, line in enumerate(lines) if LANGUAGE_HEADING.match(line)), -1
    )
    if start == -1:
        return None
    end = next(
        (i for i in range(start + 1, len(lines)) if SECTION_END.match(lines[i])),
        len(lines),
    )
    title = next(
        (line[2:].strip() for line in lines if line.startswith("# ")), fallback
    )
    groups: list[tuple[str, list[str], list[list]]] = [(title, [], [])]
    for number in range(start + 1, end):
        line = lines[number].strip()
        if not line:
            continue
        subheading = SUBHEADING.match(line)
        if subheading:
            groups.append((subheading.group(1), [], []))
            continue
        _, prose, rows = groups[-1]
        term = TERM_LINE.match(line)
        if term:
            rows.append([term.group(1).strip(), [], ""])
            line = term.group(2)
        elif not rows:
            prose.append(line)
            continue
        avoid = AVOID_PART.search(line)
        if avoid:
            rows[-1][2] = ", ".join(
                p for p in (rows[-1][2], avoid.group(1).strip()) if p
            )
            line = line[: avoid.start()].strip()
        if line:
            rows[-1][1].append(line)
    sections = [
        GlossarySection(
            heading,
            prose=" ".join(prose),
            rows=[(_cell(t), _cell(" ".join(d)), _cell(a)) for t, d, a in rows],
        )
        for heading, prose, rows in groups
        if prose or rows
    ]
    before = "\n".join(lines[:start]).rstrip()
    after = "\n".join(lines[end:]).strip("\n")
    rest = "\n\n".join(part for part in (before, after) if part) + "\n"
    return sections, rest


def context_files(root: Path) -> list[str]:
    """List each CONTEXT.md to read: the two in docs/, then those the map lists.

    A path in the context map resolves from the map's folder or, failing
    that, from the project root. A listed path that names no file is skipped.
    """
    found = [rel for rel in CONTEXT_FILES if (root / rel).is_file()]
    context_map = root / CONTEXT_MAP
    if context_map.is_file():
        text = context_map.read_text(encoding="utf-8")
        for token in CONTEXT_TOKEN.findall(text):
            for base in (posixpath.dirname(CONTEXT_MAP), ""):
                rel = posixpath.normpath(posixpath.join(base, token))
                if rel.startswith("../") or not (root / rel).is_file():
                    continue
                if rel not in found:
                    found.append(rel)
                break
    return found


def plan_contexts(root: Path) -> list[ContextTerms]:
    """Return the terms of every CONTEXT.md with ``## Language``, in read order."""
    planned = []
    for rel in context_files(root):
        converted = convert_context((root / rel).read_text(encoding="utf-8"), rel)
        if converted:
            planned.append(ContextTerms(rel, *converted))
    return planned


def _term_key(term: str) -> str:
    return term.strip(TERM_MARKUP).casefold()


def duplicate_terms(glossary: str) -> list[tuple[str, list[str]]]:
    """List each term of ``glossary`` that more than one ``##`` section holds.

    Terms compare without emphasis markup and without case. The result names
    each term once, in its first form, with its sections in document order.
    """
    seen: dict[str, tuple[str, list[str]]] = {}
    heading = ""
    lines = glossary.splitlines()
    starts = [i for i, line in enumerate(lines) if line.startswith("## ")]
    for a, b in zip(starts, [*starts[1:], len(lines)]):
        heading = lines[a][3:].strip()
        _, tables = _split_tables(lines[a + 1 : b])
        for table in tables:
            for row in table[2:]:
                term = _cells(row)[0]
                _, sections = seen.setdefault(
                    _term_key(term), (term.strip(TERM_MARKUP), [])
                )
                if heading not in sections:
                    sections.append(heading)
    return [(term, sections) for term, sections in seen.values() if len(sections) > 1]


def plan_glossary_text(
    root: Path,
    chapter: Chapter12 | None,
    contexts: list[ContextTerms],
    existing_edit: LinkEdit | None,
    moved: dict[str, str],
    removed: set[str],
) -> tuple[str, list[tuple[str, str]]]:
    """Return the glossary text after the run and its link rewrites.

    The glossary starts from the existing glossary, or from its title. The
    chapter 12 sections follow, then each CONTEXT.md section as a section of
    its own (DEC-18). Each part's links are rebased from its source file to
    docs/spec/.
    """
    if existing_edit:
        base, rewrites = existing_edit.text, list(existing_edit.rewrites)
    elif (root / GLOSSARY).is_file():
        base, rewrites = (root / GLOSSARY).read_text(encoding="utf-8"), []
    else:
        base, rewrites = "# Glossary\n", []
    blocks = []
    if chapter:
        block, rewrites_12 = rewrite_links(
            render_sections(chapter.sections), CHAPTER12, GLOSSARY, moved, removed
        )
        blocks.append(block)
        rewrites += rewrites_12
    for context in (context for context in contexts if context.sections):
        block, block_rewrites = rewrite_links(
            render_sections(context.sections), context.path, GLOSSARY, moved, removed
        )
        blocks.append(block)
        rewrites += block_rewrites
    if not blocks:
        return base, rewrites
    return base.rstrip("\n") + "\n\n" + "\n\n".join(blocks) + "\n", rewrites


# ── Markdown links ───────────────────────────────────────────────────────
#
# The link syntax follows packages/factory/scripts/link-check, the gate the
# rewritten files must pass: inline links and images, reference
# definitions, and no link inside front matter, a fenced block, or a code
# span.

LINK_START = re.compile(r"!?\[[^\]]*\]\(")
REFERENCE_DEFINITION = re.compile(
    r"^ {0,3}\[([^\]^][^\]]*)\]:[ \t]*(<[^>\n]*>|\S+)", re.MULTILINE
)
SCHEME = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
FENCE_OPEN = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
INLINE_CODE = re.compile(r"`+[^`\n]*`+")
LINK_PREFIX = "link"


def _blank(text: str) -> str:
    return re.sub(r"[^\r\n]", " ", text)


def mask_code(text: str) -> str:
    """Blank front matter, fenced blocks, and code spans; keep every offset."""
    lines = text.splitlines(keepends=True)
    out: list[str] = []
    index = 0
    if lines and lines[0].strip() == "---":
        for end in range(1, len(lines)):
            if lines[end].strip() in ("---", "..."):
                out += [_blank(line) for line in lines[: end + 1]]
                index = end + 1
                break
    closing: re.Pattern[str] | None = None
    for line in lines[index:]:
        body = line.rstrip("\r\n")
        if closing is None:
            match = FENCE_OPEN.match(body)
            if match and not (match.group(1)[0] == "`" and "`" in match.group(2)):
                run = match.group(1)
                closing = re.compile(
                    rf"^ {{0,3}}{re.escape(run[0])}{{{len(run)},}}[ \t]*$"
                )
                out.append(_blank(line))
                continue
            out.append(line)
        else:
            if closing.match(body):
                closing = None
            out.append(_blank(line))
    return INLINE_CODE.sub(lambda span: " " * len(span.group()), "".join(out))


def _destination_span(text: str, start: int) -> tuple[int, int, int] | None:
    """Locate the destination after a link's "(": (begin, end, after).

    ``text[begin:end]`` is the raw destination without angle brackets;
    ``after`` is the offset behind it.
    """
    position = start
    while position < len(text) and text[position] in " \t\n":
        position += 1
    if position < len(text) and text[position] == "<":
        end = text.find(">", position + 1)
        if end == -1 or "\n" in text[position:end]:
            return None
        return position + 1, end, end + 1
    begin, depth = position, 0
    while position < len(text):
        char = text[position]
        if char == "\\" and position + 1 < len(text):
            position += 2
            continue
        if char.isspace():
            break
        if char == "(":
            depth += 1
        elif char == ")":
            if depth == 0:
                break
            depth -= 1
        position += 1
    return begin, position, position


def _link_close(text: str, position: int) -> int | None:
    """Return the offset behind the ")" that closes a link, or None."""
    while position < len(text) and text[position] in " \t\n":
        position += 1
    if position < len(text) and text[position] in "\"'(":
        closer = ")" if text[position] == "(" else text[position]
        end = text.find(closer, position + 1)
        if end == -1:
            return None
        position = end + 1
        while position < len(text) and text[position] in " \t\n":
            position += 1
    if position < len(text) and text[position] == ")":
        return position + 1
    return None


def code_span(text: str) -> str:
    """Render ``text`` as a code span, with a longer fence around a backtick."""
    if "`" in text:
        return f"`` {text} ``"
    return f"`{text}`"


def _new_destination(
    dest: str, src: str, dst: str, moved: dict[str, str]
) -> str | None:
    """Return the destination of a link of ``src`` read from ``dst``, or None.

    None means the link stays as it is: an external link, a link to the
    same file, an absolute path, or a target that neither moves nor needs a
    rebase.
    """
    if not dest or SCHEME.match(dest) or dest.startswith(("/", "#")):
        return None
    cut = min((i for i in (dest.find("?"), dest.find("#")) if i != -1), default=-1)
    path, suffix = (dest, "") if cut == -1 else (dest[:cut], dest[cut:])
    decoded = unquote(path)
    target = posixpath.normpath(posixpath.join(posixpath.dirname(src), decoded))
    new_target = moved.get(target, target)
    new_dir = posixpath.dirname(dst) or "."
    if posixpath.normpath(posixpath.join(new_dir, decoded)) == new_target:
        return None
    new = posixpath.relpath(new_target, new_dir)
    if decoded.endswith("/"):
        new += "/"
    if decoded != path:
        new = quote(new)
    return new + suffix


def _removed_target(dest: str, src: str, removed: set[str]) -> bool:
    if not dest or SCHEME.match(dest) or dest.startswith(("/", "#")):
        return False
    path = re.split(r"[?#]", dest, maxsplit=1)[0]
    target = posixpath.normpath(posixpath.join(posixpath.dirname(src), unquote(path)))
    return target in removed


def rewrite_links(
    text: str, src: str, dst: str, moved: dict[str, str], removed: set[str]
) -> tuple[str, list[tuple[str, str]]]:
    """Rewrite the Markdown links of ``text`` for the move from ``src`` to ``dst``.

    ``src`` and ``dst`` are the file's paths before and after the run,
    relative to the project root. ``moved`` maps each moved path to its new
    path; ``removed`` holds the paths the run removes. A link to a moved
    file points at its new path; a relative link of a moved file resolves
    from its new folder; a link to a removed file becomes its link text in
    a code span. Anchors and queries stay. The result is the new text and
    each (old target, new target) in document order.
    """
    masked = mask_code(text)
    edits: list[tuple[int, int, str, str, str]] = []
    for match in LINK_START.finditer(masked):
        span = _destination_span(masked, match.end())
        if span is None:
            continue
        begin, end, after = span
        raw = text[begin:end]
        dest = re.sub(r"\\(.)", r"\1", raw)
        if _removed_target(dest, src, removed):
            close = _link_close(masked, after)
            if close is None:
                continue
            label = match.group()[match.group().index("[") + 1 : -2]
            shown = code_span(label or dest)
            edits.append((match.start(), close, shown, raw, shown))
            continue
        new = _new_destination(dest, src, dst, moved)
        if new is not None:
            edits.append((begin, end, new, raw, new))
    for match in REFERENCE_DEFINITION.finditer(masked):
        begin, end = match.span(2)
        if masked[begin] == "<":
            begin, end = begin + 1, end - 1
        raw = text[begin:end]
        if _removed_target(raw, src, removed):
            line_end = masked.find("\n", end)
            line_end = len(masked) if line_end == -1 else line_end
            shown = code_span(match.group(1))
            edits.append((match.start(), line_end, shown, raw, shown))
            continue
        new = _new_destination(raw, src, dst, moved)
        if new is not None:
            edits.append((begin, end, new, raw, new))
    edits.sort()
    rewritten = text
    for start, stop, replacement, _, _ in reversed(edits):
        rewritten = rewritten[:start] + replacement + rewritten[stop:]
    return rewritten, [(old, new) for _, _, _, old, new in edits]


@dataclass
class LinkEdit:
    """The link rewrites of one Markdown file: its paths and its new text."""

    old: str
    new: str
    text: str
    rewrites: list[tuple[str, str]]


def plan_links(
    root: Path,
    git: bool,
    moved: dict[str, str],
    removed: set[str],
    planned: dict[str, str],
) -> list[LinkEdit]:
    """List the link rewrites of every scanned Markdown file, by new path.

    The scan set is every ``*.md`` file that git tracks or that is untracked
    and not ignored, outside .git/ and .agent-factory/, except the removal
    set (CAL-G11). ``planned`` maps a path to the text the run writes there
    before the rewrite, such as chapter 12.
    """
    edits: list[LinkEdit] = []
    for rel in _scan_set(root, git):
        if not rel.endswith(".md"):
            continue
        text = planned[rel] if rel in planned else _read_text(root / rel)
        if text is None:
            continue
        new = moved.get(rel, rel)
        rewritten, rewrites = rewrite_links(text, rel, new, moved, removed)
        if rewrites:
            edits.append(LinkEdit(rel, new, rewritten, rewrites))
    return sorted(edits, key=lambda edit: edit.new)


# ── Old paths the script does not rewrite ────────────────────────────────


def is_old_path(token: str) -> bool:
    """Tell whether ``token``, a path or a folder, names an old layout path."""
    path = token.rstrip("/")
    parts = PurePosixPath(path).parts
    return (
        new_path(path) != path
        or in_removal_set(path)
        or path in (SUPPLEMENTARY, OLD_THEMES)
        or (parts[:1] == (DOCS,) and USE_CASES in parts[1:])
    )


def old_paths_in_line(line: str, markdown: bool) -> list[str]:
    """List the old paths in ``line``, in order; skip Markdown links.

    In Markdown, an inline link or image and a reference definition belong
    to the link rewrite, so their text and target are not searched.
    """
    if markdown:
        line = REFERENCE_LINK.sub("", INLINE_LINK.sub("", line))
    tokens = (match.group().rstrip(".") for match in PATH_TOKEN.finditer(line))
    return [token for token in tokens if is_old_path(token)]


def _factory_hook_lines(lines: list[str]) -> set[int]:
    """Number the lines of the hooks in the agent_factory_hook-* block."""
    inside, numbers = False, set()
    for number, line in enumerate(lines, start=1):
        hook = HOOK_ID.match(line)
        if hook:
            inside = hook.group(1).strip("'\"").startswith(FACTORY_HOOK)
        elif LIST_ITEM.match(line):
            inside = False
        if inside:
            numbers.add(number)
    return numbers


def _scan_set(root: Path, git: bool) -> list[str]:
    """List the files to scan: tracked, or untracked and not ignored."""
    if git:
        out = _git(root, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
        files = {p for p in out.stdout.split("\0") if p}
    else:
        files = {p.relative_to(root).as_posix() for p in root.rglob("*")}
    return sorted(
        rel
        for rel in files
        if not SKIPPED_DIRS & set(PurePosixPath(rel).parts)
        and not in_removal_set(rel)
        and (root / rel).is_file()
    )


def _read_text(path: Path) -> str | None:
    """Return the text of ``path``, or None for a binary file."""
    data = path.read_bytes()
    if b"\0" in data:
        return None
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return None


def plan_listing(
    root: Path, git: bool, planned: dict[str, str], moved: dict[str, str]
) -> list[tuple[str, int, str]]:
    """List each (file, line, old path) that the run leaves in place.

    The file is named by its path after the run. ``planned`` maps a path to
    the text the run writes there, such as chapter 12 and the glossary;
    ``moved`` maps each moved path to its new path.
    """
    sources = {moved.get(rel, new_path(rel)): rel for rel in _scan_set(root, git)}
    for rel in planned:
        sources.setdefault(rel, rel)
    found: list[tuple[str, int, str]] = []
    for name in sorted(sources):
        old = sources[name]
        text = planned[old] if old in planned else _read_text(root / old)
        if text is None:
            continue
        lines = text.splitlines()
        skip = _factory_hook_lines(lines) if name == PRE_COMMIT_CONFIG else set()
        markdown = name.endswith(".md")
        for number, line in enumerate(lines, start=1):
            if number not in skip:
                found += [(name, number, p) for p in old_paths_in_line(line, markdown)]
    return found


# ── The factory hook block follows the hook template ─────────────────────

# The hook template of the same factory tree as this script.
HOOK_TEMPLATE = Path(__file__).resolve().parent.parent / "config/pre-commit-config.yaml"
HOOK_KEY = re.compile(r"^( *)([A-Za-z_]+):(.*)$")
HOOK_PREFIX = "hook"


def _indent(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def hook_files_values(lines: list[str]) -> dict[str, tuple[int, int, str]]:
    """Map each hook id to its ``files:`` key: (first line, end line, value).

    The key's lines are ``lines[first:end]``: the key line and each more
    indented line below it. The value of a block scalar joins its lines, as
    a folded scalar reads. A hook without ``files:`` is left out.
    """
    found: dict[str, tuple[int, int, str]] = {}
    hook, key_indent = "", -1
    for number, line in enumerate(lines):
        match = HOOK_ID.match(line)
        if match:
            hook = match.group(1).strip("'\"")
            key_indent = _indent(line) + 2
            continue
        if line.strip() and _indent(line) < key_indent:
            hook, key_indent = "", -1
        key = HOOK_KEY.match(line)
        if not hook or not key or len(key.group(1)) != key_indent:
            continue
        if key.group(2) != "files":
            continue
        end = number + 1
        while (
            end < len(lines) and lines[end].strip() and _indent(lines[end]) > key_indent
        ):
            end += 1
        value = key.group(3).strip()
        if value[:1] in ">|":
            value = " ".join(part.strip() for part in lines[number + 1 : end])
        found[hook] = (number, end, value)
    return found


def rewrite_factory_hooks(
    text: str, template: str
) -> tuple[str, list[tuple[str, str, str]]]:
    """Give each factory hook of ``text`` the ``files:`` value of ``template``.

    Only a hook whose id starts with ``agent_factory_hook-`` and that has a
    ``files:`` key in both texts changes, and only that key: its lines are
    the template's lines at the project's indent. Comments, key order, and
    every other hook stay. The result is the new text and each (hook id,
    old value, new value) in file order.
    """
    lines = text.split("\n")
    template_lines = template.split("\n")
    wanted = hook_files_values(template_lines)
    edits = []
    for hook, (first, end, value) in hook_files_values(lines).items():
        if not hook.startswith(FACTORY_HOOK) or hook not in wanted:
            continue
        t_first, t_end, t_value = wanted[hook]
        if value == t_value:
            continue
        shift = _indent(lines[first]) - _indent(template_lines[t_first])
        new = [
            " " * shift + line if shift >= 0 else line[-shift:]
            for line in template_lines[t_first:t_end]
        ]
        edits.append((first, end, new, hook, value, t_value))
    for first, end, new, *_ in sorted(edits, reverse=True):
        lines[first:end] = new
    return "\n".join(lines), [edit[3:] for edit in sorted(edits)]


def plan_hooks(root: Path) -> tuple[str, list[tuple[str, str, str]]] | None:
    """Return the project's hook config after the run, or None for no edit."""
    config = root / PRE_COMMIT_CONFIG
    if not config.is_file() or not HOOK_TEMPLATE.is_file():
        return None
    text, rewrites = rewrite_factory_hooks(
        config.read_text(encoding="utf-8"), HOOK_TEMPLATE.read_text(encoding="utf-8")
    )
    return (text, rewrites) if rewrites else None


def _delete_created_file(path: Path) -> None:
    """Delete a file this run created. Only the undo of ``Run.create`` calls it."""
    path.unlink()


class Run:
    """Apply the steps of one run and undo them in reverse order on failure."""

    def __init__(self, root: Path) -> None:
        self.root = root
        self.undo_steps: list[Callable[[], None]] = []
        self.created_dirs: list[Path] = []

    def _check_git(self, *args: str) -> None:
        out = _git(self.root, *args)
        if out.returncode != 0:
            raise OSError(f"git {' '.join(args)}: {out.stderr.strip()}")

    def _make_parent(self, path: Path) -> None:
        missing = []
        parent = path.parent
        while not parent.exists():
            missing.append(parent)
            parent = parent.parent
        for directory in reversed(missing):
            directory.mkdir()
            self.created_dirs.append(directory)

    def move(self, old: str, new: str, tracked: bool) -> None:
        src, dst = self.root / old, self.root / new
        self._make_parent(dst)
        if dst.exists():
            raise OSError(f"{new} already exists; no file is replaced")
        if tracked:
            self._check_git("mv", "--", old, new)
        else:
            src.rename(dst)

        def undo() -> None:
            src.parent.mkdir(parents=True, exist_ok=True)
            if tracked:
                self._check_git("mv", "--", new, old)
            else:
                dst.rename(src)

        self.undo_steps.append(undo)

    def remove(self, rel: str) -> None:
        """Remove a clean tracked file with ``git rm``, which keeps its history."""
        self._check_git("rm", "-q", "--", rel)

        def undo() -> None:
            self._check_git("reset", "-q", "HEAD", "--", rel)
            self._check_git("checkout", "--", rel)

        self.undo_steps.append(undo)

    def write(self, rel: str, text: str) -> None:
        """Edit ``rel``; the undo journal holds its old bytes before the write."""
        path = self.root / rel
        before = path.read_bytes()

        def undo() -> None:
            if path.read_bytes() != before:
                path.write_bytes(before)

        self.undo_steps.append(undo)
        path.write_bytes(text.encode("utf-8"))

    def create(self, rel: str, text: str) -> None:
        """Write a new file; the undo deletes it."""
        path = self.root / rel
        self._make_parent(path)
        path.write_text(text, encoding="utf-8")
        self.undo_steps.append(lambda: _delete_created_file(path))

    def stage(self, rel: str) -> None:
        """Stage ``rel`` with ``git add``; the undo restores its index entry."""
        entry = _git(self.root, "ls-files", "-s", "--", rel).stdout.split()
        self._check_git("add", "--", rel)

        def undo() -> None:
            if entry:
                info = f"{entry[0]},{entry[1]},{rel}"
                self._check_git("update-index", "--cacheinfo", info)
            else:
                self._check_git("rm", "-q", "--cached", "--", rel)

        self.undo_steps.append(undo)

    def undo(self) -> list[str]:
        errors = []
        for step in reversed(self.undo_steps):
            try:
                step()
            except OSError as exc:
                errors.append(str(exc))
        for directory in reversed(self.created_dirs):
            _remove_if_empty(directory)
        return errors


def _remove_if_empty(directory: Path) -> None:
    try:
        directory.rmdir()
    except OSError:
        pass


def remove_empty_dirs(root: Path, folders: list[str]) -> None:
    """Remove the old folders that the moves left empty, deepest first."""
    for folder in folders:
        base = root / folder
        if not base.is_dir():
            continue
        for directory in sorted(base.rglob("*"), key=lambda p: -len(p.parts)):
            if directory.is_dir():
                _remove_if_empty(directory)
        _remove_if_empty(base)


def refuse_reason(root: Path, moves: list[tuple[str, str]], git: bool) -> str | None:
    """Name the reason to refuse the run before its first change, or None.

    An existing glossary is no reason: the run appends to it (DEC-18).
    """
    state = busy_state(root) if git else None
    if state:
        return state
    taken = [new for _, new in moves if (root / new).exists()]
    if taken:
        return "these destinations already exist: " + ", ".join(taken)
    news = [new for _, new in moves]
    shared = sorted({new for new in news if news.count(new) > 1})
    if shared:
        return "two old files share these destinations: " + ", ".join(shared)
    return None


def rewrite_theme(text: str) -> str:
    return THEME_LINE.sub(r"\1\2../assets/themes/", text)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Move a project's files into the core artifact layout."
    )
    parser.add_argument(
        "target",
        nargs="?",
        default=".",
        help="Project root (default: current directory)",
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="Print the planned moves; change no file"
    )
    args = parser.parse_args(argv)
    root = Path(args.target).resolve()
    if not root.is_dir():
        print(f"migrate-spec-layout: {root} is not a directory", file=sys.stderr)
        return 2

    moves, pairs = plan_moves(root)
    git = is_git_repo(root)
    removals, by_hand = plan_removals(root, git)
    glossary = plan_glossary(root)
    contexts = plan_contexts(root)
    hooks = plan_hooks(root)
    if not (moves or removals or by_hand or glossary or contexts or hooks):
        return 0

    if not args.dry_run:
        refusal = refuse_reason(root, moves, git)
        if refusal:
            print(
                f"migrate-spec-layout: refused, {refusal}; no file changed",
                file=sys.stderr,
            )
            return 2

    dsl_moves = any(new == DSL for _, new in moves)
    for old, new in moves:
        print(f"{old} -> {new}")
    for old, new, other_old, other_new in pairs:
        print(f"{SAME_NEW_PATH}: {old} -> {new}, because {other_old} -> {other_new}")
    if dsl_moves:
        old_dsl = (root / f"{ARC42}/architecture.dsl").read_text(encoding="utf-8")
        if THEME_LINE.search(old_dsl):
            print(f"{DSL}: theme themes/ -> theme ../assets/themes/")
    for rel in removals:
        print(f"remove: {rel}")
    for rel in by_hand:
        print(f"delete by hand: {rel}")
    if glossary:
        terms = sum(len(section.rows) for section in glossary.sections)
        print(f"{CHAPTER12} -> {GLOSSARY}: {terms} terms")
        for heading, columns in glossary.kept:
            print(f"keep in {CHAPTER12}: {heading} (table with {columns} columns)")
    for context in contexts:
        terms = sum(len(section.rows) for section in context.sections)
        headings = ", ".join(section.heading for section in context.sections)
        print(f"{context.path} -> {GLOSSARY}: {terms} terms ({headings})")
    moved = dict(moves)
    removed = set(removals)
    rewritten = {CHAPTER12: glossary.stub} if glossary else {}
    rewritten |= {context.path: context.rest for context in contexts}
    link_edits = plan_links(root, git, moved, removed, rewritten)
    planned: dict[str, str] = {}
    if glossary or contexts:
        by_old = {edit.old: edit for edit in link_edits}
        planned = {
            rel: by_old[rel].text if rel in by_old else text
            for rel, text in rewritten.items()
        }
        glossary_text, glossary_rewrites = plan_glossary_text(
            root, glossary, contexts, by_old.get(GLOSSARY), moved, removed
        )
        link_edits = [edit for edit in link_edits if edit.old != GLOSSARY]
        if glossary_rewrites:
            link_edits.append(
                LinkEdit(GLOSSARY, GLOSSARY, glossary_text, glossary_rewrites)
            )
            link_edits.sort(key=lambda edit: edit.new)
        planned[GLOSSARY] = glossary_text
    for edit in link_edits:
        for old_target, new_target in edit.rewrites:
            print(f"{LINK_PREFIX}: {edit.new}: {old_target} -> {new_target}")
    for hook, old_value, new_value in hooks[1] if hooks else []:
        print(f"{HOOK_PREFIX}: {PRE_COMMIT_CONFIG}: {hook}: {old_value} -> {new_value}")
    duplicates = duplicate_terms(planned[GLOSSARY]) if planned else []
    for term, sections in duplicates:
        print(f"duplicate term: {term} in {', '.join(sections)}")
    old_paths = plan_listing(root, git, planned, moved)
    if old_paths:
        print(LISTING_HEADING)
        for name, number, path in old_paths:
            print(f"old path: {name}:{number}: {path}")
    if (root / CONTEXT_MAP).is_file() or context_files(root):
        print(FOLD_STEP)
    if duplicates:
        print(CLEANUP_STEP)
    if args.dry_run:
        return 0

    tracked = tracked_files(root) if git else set()
    run = Run(root)
    try:
        for rel in removals:
            run.remove(rel)
        if GLOSSARY in planned:
            if (root / GLOSSARY).exists():
                run.write(GLOSSARY, planned[GLOSSARY])
            else:
                run.create(GLOSSARY, planned[GLOSSARY])
            if git:
                run.stage(GLOSSARY)
        if glossary:
            run.write(CHAPTER12, planned[CHAPTER12])
            if git and CHAPTER12 in tracked:
                run.stage(CHAPTER12)
        for context in contexts:
            run.write(context.path, planned[context.path])
        # Every content edit comes before the first move. A moved file gets
        # its edit at its old path, and the move takes the edit along.
        for edit in link_edits:
            if edit.old not in planned:
                run.write(edit.old, edit.text)
        if dsl_moves and THEME_LINE.search(old_dsl):
            run.write(f"{ARC42}/architecture.dsl", rewrite_theme(old_dsl))
        if hooks:
            run.write(PRE_COMMIT_CONFIG, hooks[0])
        for old, new in moves:
            run.move(old, new, old in tracked)
    except OSError as exc:
        print(f"migrate-spec-layout: failed: {exc}", file=sys.stderr)
        errors = run.undo()
        for error in errors:
            print(f"migrate-spec-layout: undo failed: {error}", file=sys.stderr)
        if not errors:
            print(
                "migrate-spec-layout: every change of the run is undone",
                file=sys.stderr,
            )
        return 1

    remove_empty_dirs(root, [SUPPLEMENTARY, OLD_THEMES])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
