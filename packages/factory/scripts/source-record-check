#!/usr/bin/env python3
# source-record-check — schema check of every source record in a folder tree.
#
# What: Finds every record file under the given folder — a `*.md` file whose
#       name starts with a record ID such as `SR-0001` or `A2-SR-05` — takes
#       its first fenced `json` block, and validates that block against
#       research-source-record.schema.json. A record without a json block
#       fails. Two files with the same record ID fail. Other markdown files,
#       such as an area index, are listed as skipped, so a misnamed record
#       stays visible.
# When: Step 3 of the research-survey playbook (the source-gathering gate),
#       run by each researcher on its own folder and by the orchestrator on
#       the whole `sources/` tree, and again in Step 5.
# By:   `.agent-factory/factory/scripts/source-record-check <folder>`
#
# A record file holds one source: a heading, one json block with the ten
# schema fields, then an Evidence section with quotes and exact locations.
#
# Python 3.8+ stdlib only.
#
# Exit code:
#   0  every record passes
#   1  at least one record fails (each failure printed as a `FAIL` line)
#   2  operational error — missing folder, no record files, unreadable schema

from __future__ import annotations

import json
import re
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
SCHEMA_PATH = SCRIPT_DIR.parent / "rulebooks" / "schemas" / "research-source-record.schema.json"
_JSON_BLOCK = re.compile(r"```json\n(.*?)```", re.S)
_RECORD_ID = re.compile(r"^((?:[A-Za-z0-9]+-)*SR-[0-9]+)")


def _load_schema_validate():
    loader = SourceFileLoader("schema_validate", str(SCRIPT_DIR / "schema-validate"))
    spec = spec_from_loader("schema_validate", loader)
    module = module_from_spec(spec)
    loader.exec_module(module)
    return module


def check_file(path: Path, schema: dict, validator) -> list[str]:
    text = path.read_text(encoding="utf-8")
    match = _JSON_BLOCK.search(text)
    if not match:
        return [f"{path}: no json block"]
    try:
        data = json.loads(match.group(1))
    except json.JSONDecodeError as exc:
        return [f"{path}: invalid json: {exc}"]
    return [f"{path}: {error}" for error in validator.validate(data, schema)]


def duplicate_ids(files: list[Path]) -> list[str]:
    seen: dict[str, Path] = {}
    failures = []
    for path in files:
        match = _RECORD_ID.match(path.stem)
        if not match:
            continue
        record_id = match.group(1)
        if record_id in seen:
            failures.append(f"{path}: record ID {record_id} already used by {seen[record_id]}")
        else:
            seen[record_id] = path
    return failures


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print("usage: source-record-check <folder>", file=sys.stderr)
        return 2
    folder = Path(argv[0])
    if not folder.is_dir():
        print(f"source-record-check: {folder} is not a folder", file=sys.stderr)
        return 2
    every = sorted(folder.rglob("*.md"))
    files = [f for f in every if _RECORD_ID.match(f.stem)]
    skipped = [f for f in every if not _RECORD_ID.match(f.stem)]
    if not files:
        print(f"source-record-check: no record files (<ID>-SR-<n>*.md) under {folder}", file=sys.stderr)
        return 2
    try:
        schema = json.loads(SCHEMA_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"source-record-check: cannot read schema: {exc}", file=sys.stderr)
        return 2
    validator = _load_schema_validate()
    failures = duplicate_ids(files)
    for path in files:
        failures.extend(check_file(path, schema, validator))
    for failure in failures:
        print(f"FAIL {failure}")
    for path in skipped:
        print(f"SKIP {path}: name does not start with a record ID")
    print(
        f"source-record-check: {len(files)} records checked, {len(failures)} failure(s), "
        f"{len(skipped)} other file(s) skipped"
    )
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
