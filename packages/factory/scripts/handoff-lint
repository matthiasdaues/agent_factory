#!/usr/bin/env python3
"""Validate the mechanically observable phase-handoff contract.

The validator is deliberately structural. It checks the canonical Markdown
shape, declared values, repository facts, and artifact paths, while leaving
omission and distortion detection to the independent semantic review required
by BR-049.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path

SHA_PATTERN = re.compile(r"^[0-9a-f]{40}$")
FIELD_PATTERN = re.compile(r"^([^:#]+):\s*(.*)$")
SECTION_PATTERN = re.compile(r"^##\s+(.+?)\s*$")
PLACEHOLDERS = {"", "...", "n/a", "tbd", "todo", "unknown", "<none>"}
VALID_BOUNDARIES = {
    "requirements -> review",
    "review -> architecture",
    "architecture -> review",
    "review -> remedies",
    "remedies -> planning",
    "planning -> implementation",
}
VALID_SEMANTIC_STATUSES = {"pending", "passed", "failed"}

REQUIRED_FIELDS = {
    "Boundary": ("Outgoing phase", "Incoming phase", "Boundary"),
    "Repository state": (
        "Checkout",
        "Branch",
        "HEAD",
        "Upstream",
        "Upstream SHA",
        "Ahead",
        "Behind",
        "Working tree",
        "Retained work",
    ),
    "Decisions and open items": ("Decisions", "Open items"),
    "Gate and verification evidence": ("Gates", "Verification"),
    "Semantic review": ("Reviewer", "Status", "Evidence"),
}
REQUIRED_SECTIONS = (
    "Boundary",
    "Repository state",
    "Decisions and open items",
    "Artifacts",
    "Gate and verification evidence",
    "Next action",
    "Semantic review",
)


@dataclass(frozen=True)
class Finding:
    """One deterministic structural defect reported to the handoff author."""

    code: str
    message: str

    def render(self) -> str:
        """Render the stable human-readable finding line."""
        return f"[ERROR] {self.code}: {self.message}"


@dataclass(frozen=True)
class Handoff:
    """Parsed headings and declared fields from one Markdown handoff."""

    has_title: bool
    sections: dict[str, list[str]]
    fields: dict[str, dict[str, str]]
    duplicates: tuple[str, ...]


def _parse(text: str) -> Handoff:
    """Parse only the small canonical Markdown subset used by handoffs."""
    sections: dict[str, list[str]] = {}
    duplicates: list[str] = []
    current: str | None = None
    for line in text.splitlines():
        match = SECTION_PATTERN.match(line)
        if match:
            current = match.group(1)
            if current in sections:
                duplicates.append(current)
            sections.setdefault(current, [])
            continue
        if current is not None:
            sections[current].append(line)

    fields: dict[str, dict[str, str]] = {}
    for section, lines in sections.items():
        declared: dict[str, str] = {}
        for line in lines:
            match = FIELD_PATTERN.match(line.strip())
            if match:
                declared[match.group(1).strip()] = match.group(2).strip()
        fields[section] = declared
    has_title = any(line.strip() == "# Phase Handoff" for line in text.splitlines())
    return Handoff(has_title, sections, fields, tuple(duplicates))


def _placeholder(value: str) -> bool:
    """Return whether a declared value carries no usable information."""
    stripped = value.strip().casefold()
    return stripped in PLACEHOLDERS or (
        stripped.startswith("<") and stripped.endswith(">")
    )


def _git(repo: Path, *args: str) -> str | None:
    """Return Git stdout, or None when the repository query is unavailable."""
    result = subprocess.run(
        ["git", *args], cwd=repo, text=True, capture_output=True, check=False
    )
    return result.stdout.strip() if result.returncode == 0 else None


def _required_shape(handoff: Handoff) -> list[Finding]:
    """Check canonical sections, fields, placeholders, and list content."""
    findings: list[Finding] = []
    if not handoff.has_title:
        findings.append(Finding("HO-TITLE", "missing required Phase Handoff title"))
    for duplicate in handoff.duplicates:
        findings.append(Finding("HO-DUPLICATE", f"duplicate section: {duplicate}"))
    for section in REQUIRED_SECTIONS:
        if section not in handoff.sections:
            findings.append(
                Finding("HO-SECTION", f"missing required section: {section}")
            )

    for section, required in REQUIRED_FIELDS.items():
        if section not in handoff.sections:
            continue
        declared = handoff.fields[section]
        for field in required:
            if field not in declared:
                findings.append(
                    Finding("HO-FIELD", f"missing declared field in {section}: {field}")
                )
            elif _placeholder(declared[field]):
                findings.append(
                    Finding("HO-PLACEHOLDER", f"placeholder declared field: {field}")
                )

    artifact_lines = [
        line.strip()[2:].strip()
        for line in handoff.sections.get("Artifacts", [])
        if line.strip().startswith("- ")
    ]
    if "Artifacts" in handoff.sections and not artifact_lines:
        findings.append(
            Finding("HO-ARTIFACTS", "Artifacts must declare at least one path")
        )

    next_action = " ".join(
        line.strip() for line in handoff.sections.get("Next action", []) if line.strip()
    )
    if "Next action" in handoff.sections and _placeholder(next_action):
        findings.append(Finding("HO-NEXT", "Next action is missing or a placeholder"))

    boundary = handoff.fields.get("Boundary", {}).get("Boundary")
    if boundary and not _placeholder(boundary):
        normalized_boundary = boundary.replace("→", "->").casefold()
        if normalized_boundary not in VALID_BOUNDARIES:
            findings.append(Finding("HO-BOUNDARY", f"malformed boundary: {boundary}"))

    semantic_status = handoff.fields.get("Semantic review", {}).get("Status")
    if (
        semantic_status
        and not _placeholder(semantic_status)
        and semantic_status.casefold() not in VALID_SEMANTIC_STATUSES
    ):
        findings.append(
            Finding(
                "HO-SEMANTIC",
                f"malformed semantic review status: {semantic_status}",
            )
        )
    return findings


def _integer_field(
    fields: dict[str, str], name: str
) -> tuple[int | None, list[Finding]]:
    """Parse one required non-negative repository-state count."""
    if name not in fields or _placeholder(fields[name]):
        return None, []
    value = fields[name]
    if not re.fullmatch(r"\d+", value):
        return None, [Finding("HO-STATE", f"malformed {name.lower()} count: {value}")]
    return int(value), []


def _repository_state(handoff: Handoff, repo: Path) -> list[Finding]:
    """Validate declared Git state against the observable checkout."""
    if "Repository state" not in handoff.fields:
        return []
    fields = handoff.fields["Repository state"]
    findings: list[Finding] = []

    head = fields.get("HEAD", "")
    if head and not SHA_PATTERN.fullmatch(head):
        findings.append(Finding("HO-SHA", f"malformed HEAD: {head}"))
    upstream = fields.get("Upstream", "")
    upstream_sha = fields.get("Upstream SHA", "")
    if upstream.casefold() == "none":
        if upstream_sha.casefold() != "none":
            findings.append(
                Finding(
                    "HO-SHA", f"malformed Upstream SHA for no upstream: {upstream_sha}"
                )
            )
    elif upstream_sha and not SHA_PATTERN.fullmatch(upstream_sha):
        findings.append(Finding("HO-SHA", f"malformed Upstream SHA: {upstream_sha}"))

    ahead, count_findings = _integer_field(fields, "Ahead")
    findings.extend(count_findings)
    behind, count_findings = _integer_field(fields, "Behind")
    findings.extend(count_findings)

    actual_head = _git(repo, "rev-parse", "HEAD")
    if actual_head is None:
        findings.append(Finding("HO-GIT", f"repository state unavailable: {repo}"))
        return findings

    checkout = fields.get("Checkout", "")
    if checkout and not _placeholder(checkout):
        declared_checkout = Path(checkout)
        if not declared_checkout.is_absolute():
            declared_checkout = repo / declared_checkout
        if declared_checkout.resolve() != repo.resolve():
            findings.append(
                Finding(
                    "HO-STATE", f"checkout does not match repository root: {checkout}"
                )
            )

    if SHA_PATTERN.fullmatch(head) and head != actual_head:
        findings.append(Finding("HO-STATE", f"HEAD does not match repository: {head}"))

    actual_branch = _git(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
    branch = fields.get("Branch", "")
    if actual_branch is not None and branch and branch != actual_branch:
        findings.append(
            Finding("HO-STATE", f"branch does not match repository: {branch}")
        )

    actual_upstream = _git(
        repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"
    )
    if actual_upstream is None:
        if upstream and upstream.casefold() != "none":
            findings.append(Finding("HO-STATE", "declared upstream is not configured"))
        if ahead is not None and ahead != 0:
            findings.append(
                Finding("HO-STATE", "ahead must be 0 when upstream is none")
            )
        if behind is not None and behind != 0:
            findings.append(
                Finding("HO-STATE", "behind must be 0 when upstream is none")
            )
        return findings

    if upstream and upstream != actual_upstream:
        findings.append(
            Finding("HO-STATE", f"upstream does not match repository: {upstream}")
        )
    actual_upstream_sha = _git(repo, "rev-parse", "@{upstream}")
    if SHA_PATTERN.fullmatch(upstream_sha) and upstream_sha != actual_upstream_sha:
        findings.append(Finding("HO-STATE", "Upstream SHA does not match repository"))
    counts = _git(repo, "rev-list", "--left-right", "--count", "HEAD...@{upstream}")
    if counts is not None:
        actual_ahead, actual_behind = (int(value) for value in counts.split())
        if ahead is not None and ahead != actual_ahead:
            findings.append(
                Finding("HO-STATE", "ahead count does not match repository")
            )
        if behind is not None and behind != actual_behind:
            findings.append(
                Finding("HO-STATE", "behind count does not match repository")
            )
    return findings


def _artifact_paths(handoff: Handoff, repo: Path) -> list[Finding]:
    """Validate every path declared in the authoritative artifact list."""
    findings: list[Finding] = []
    for line in handoff.sections.get("Artifacts", []):
        stripped = line.strip()
        if not stripped.startswith("- "):
            continue
        declared = stripped[2:].strip().strip("`")
        path = Path(declared)
        if path.is_absolute() or ".." in path.parts:
            findings.append(
                Finding(
                    "HO-PATH",
                    f"referenced path must be repository-relative: {declared}",
                )
            )
            continue
        resolved = (repo / path).resolve()
        try:
            resolved.relative_to(repo.resolve())
        except ValueError:
            findings.append(
                Finding("HO-PATH", f"referenced path escapes repository: {declared}")
            )
            continue
        if not resolved.exists():
            findings.append(Finding("HO-PATH", f"missing referenced path: {declared}"))
    return findings


def validate(text: str, repo: Path) -> list[Finding]:
    """Return every mechanically detectable handoff defect."""
    handoff = _parse(text)
    return (
        _required_shape(handoff)
        + _repository_state(handoff, repo)
        + _artifact_paths(handoff, repo)
    )


def _parser() -> argparse.ArgumentParser:
    """Build the public handoff-lint command-line parser."""
    parser = argparse.ArgumentParser(
        description="Validate a phase handoff's observable structure and references."
    )
    parser.add_argument("handoff_path", type=Path)
    parser.add_argument("--repo-root", type=Path, default=Path.cwd())
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    """Run validation and report all findings in one invocation."""
    args = _parser().parse_args(argv)
    if not args.handoff_path.is_file():
        print(
            f"[ERROR] HO-INPUT: handoff file does not exist: {args.handoff_path}",
            file=sys.stderr,
        )
        return 1
    if not args.repo_root.is_dir():
        print(
            f"[ERROR] HO-INPUT: repository root does not exist: {args.repo_root}",
            file=sys.stderr,
        )
        return 1

    findings = validate(args.handoff_path.read_text(encoding="utf-8"), args.repo_root)
    if findings:
        for finding in findings:
            print(finding.render(), file=sys.stderr)
        return min(len(findings), 255)

    print(
        "Handoff is structurally valid. This does not certify semantic completeness; "
        "independent semantic review remains required before phase closure."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
