#!/usr/bin/env python3
"""cycle — state-writing adapter for cycle-based orchestration.

Usage:
  cycle select --state STATE TARGET [--topic TOPIC] [--work REF] [--model PATH]

Exit codes: 0 (selected), 1 (conflict), 2 (invalid input).
"""

from __future__ import annotations

import argparse
import hashlib
import os
import sys
import tempfile
import uuid
from pathlib import Path

import yaml

PACKAGES_DIR = Path(__file__).resolve().parent.parent
ENGINE_DIR = PACKAGES_DIR / "engine"

if str(PACKAGES_DIR) not in sys.path:
    sys.path.insert(0, str(PACKAGES_DIR))

from engine.cycle_model import CycleModelError, load_delivery_model

VALID_CYCLES = {"IDEA", "CONCEPT", "ROADMAP", "REFINE", "REALIZE", "DONE"}
DEFAULT_MODEL = ENGINE_DIR / "models" / "delivery.yaml"


def cmd_select(args: argparse.Namespace) -> int:
    model_path = Path(args.model) if args.model else DEFAULT_MODEL

    try:
        model = load_delivery_model(model_path)
    except CycleModelError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    target = args.target
    if target not in VALID_CYCLES:
        print(f"error: invalid cycle: {target}", file=sys.stderr)
        return 2

    if target == "DONE":
        print("error: cannot select terminal cycle DONE directly", file=sys.stderr)
        return 2

    state_path = Path(args.state)

    if state_path.exists():
        return _transition(state_path, target, model, args)
    else:
        return _create(state_path, target, model, args)


def _create(state_path: Path, target: str, model, args: argparse.Namespace) -> int:
    if not args.topic:
        print("error: --topic required when creating a new workstream", file=sys.stderr)
        return 2

    workstream_id = state_path.stem

    state = {
        "schema_version": 1,
        "workstream_id": workstream_id,
        "topic": args.topic,
        "cycle": target,
        "revision": 1,
        "attempt": 1,
        "origin_ref": args.work if args.work else None,
        "work": [args.work] if args.work else None,
        "delegation": None,
    }

    state_path.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write(state_path, yaml.safe_dump(state, default_flow_style=False, sort_keys=False))

    _write_binding(state_path, state)

    print(f"created workstream '{workstream_id}' at cycle {target}")
    return 0


def _transition(state_path: Path, target: str, model, args: argparse.Namespace) -> int:
    try:
        state = yaml.safe_load(state_path.read_text())
    except yaml.YAMLError as exc:
        print(f"error: cannot read state file: {exc}", file=sys.stderr)
        return 2

    if not isinstance(state, dict):
        print("error: state file is not a valid YAML mapping", file=sys.stderr)
        return 2

    current_cycle = state.get("cycle", "")

    declared_routes = {(r.from_cycle, r.to_cycle) for r in model.routes}
    if (current_cycle, target) not in declared_routes:
        print(
            f"warning: no declared route from {current_cycle} to {target}",
            file=sys.stderr,
        )

    state["cycle"] = target
    state["attempt"] = 1
    state["revision"] = state.get("revision", 0) + 1

    _atomic_write(state_path, yaml.safe_dump(state, default_flow_style=False, sort_keys=False))

    _write_binding(state_path, state)

    print(f"selected cycle {target} (revision {state['revision']})")
    return 0


def _atomic_write(path: Path, content: str) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, suffix=".tmp")
    try:
        os.write(fd, content.encode())
        os.close(fd)
        os.replace(tmp, path)
    except BaseException:
        os.close(fd) if not os.get_inheritable(fd) else None
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _write_binding(state_path: Path, state: dict) -> None:
    bindings_dir_env = os.environ.get("CYCLE_BINDINGS_DIR")
    if bindings_dir_env:
        bindings_dir = Path(bindings_dir_env)
    else:
        bindings_dir = state_path.parent.parent / "session-bindings"

    bindings_dir.mkdir(parents=True, exist_ok=True)

    content = yaml.safe_dump(state, default_flow_style=False, sort_keys=False)
    digest = hashlib.sha256(content.encode()).hexdigest()

    session_id = os.environ.get("CLAUDE_SESSION_ID", str(uuid.uuid4())[:8])
    binding = {
        "session_id": session_id,
        "workstream_id": state.get("workstream_id", ""),
        "state_path": str(state_path),
        "revision": state.get("revision", 1),
        "digest": digest,
    }

    binding_path = bindings_dir / f"{session_id}.yaml"
    _atomic_write(binding_path, yaml.safe_dump(binding, default_flow_style=False, sort_keys=False))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="cycle", description="Cycle state adapter.")
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_select = sub.add_parser("select", help="Create or transition a workstream cycle.")
    p_select.add_argument("target", help="Target cycle (IDEA, CONCEPT, ROADMAP, REFINE, REALIZE)")
    p_select.add_argument("--state", required=True, help="Path to the workstream state file")
    p_select.add_argument("--topic", default=None, help="Workstream topic (required for new)")
    p_select.add_argument("--work", default=None, help="Proposal or work reference path")
    p_select.add_argument("--model", default=None, help="Path to delivery.yaml (default: built-in)")

    parsed = parser.parse_args(argv)
    if parsed.subcommand == "select":
        return cmd_select(parsed)
    return 2


if __name__ == "__main__":
    sys.exit(main())
