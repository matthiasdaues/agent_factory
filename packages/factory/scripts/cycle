#!/usr/bin/env python3
"""cycle — state-writing adapter for cycle-based orchestration.

Usage:
  cycle select --state STATE TARGET [--topic TOPIC] [--work REF] [--model PATH]
  cycle assess --state STATE [--model PATH]
  cycle list [--dir DIR]

Exit codes: 0 (success), 1 (conflict), 2 (invalid input).
"""

from __future__ import annotations

import argparse
import hashlib
import os
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path
from typing import Callable

import yaml

PACKAGES_DIR = Path(__file__).resolve().parent.parent
ENGINE_DIR = PACKAGES_DIR / "engine"

if str(PACKAGES_DIR) not in sys.path:
    sys.path.insert(0, str(PACKAGES_DIR))

from engine.cycles import REQUIRED_CYCLES
from engine.cycle_model import CycleModelError, load_delivery_model
from engine.readiness import evaluate_readiness
from engine.recommendations import (
    MultipleChoices,
    NoRecommendation,
    SingleRecommendation,
    recommend,
)
from engine.validators.proposal import ValidatorResult, validate_proposal

VALID_CYCLES = REQUIRED_CYCLES
DEFAULT_MODEL = ENGINE_DIR / "models" / "delivery.yaml"

CANONICAL_ARTIFACTS = frozenset({
    "docs/spec/scope-map.md",
    "docs/spec/entity-model.yaml",
    "docs/arc42/architecture.dsl",
})
SOURCE_PREFIXES = ("src/", "packages/", "tests/")


def _current_commit() -> str:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            capture_output=True, text=True, timeout=5,
        )
        return result.stdout.strip() if result.returncode == 0 else "unknown"
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return "unknown"


# Each entry: (is_semantic, validator_fn).
# is_semantic=True validators only run when code_changed=True.
VALIDATOR_REGISTRY: dict[str, tuple[bool, Callable[..., ValidatorResult]]] = {
    "proposal_lint": (False, lambda model, state, commit: validate_proposal(
        _resolve_proposal_path(state), assessed_commit=commit,
    )),
}


def _detect_code_changed(entry_commit: str | None, current_commit: str) -> bool:
    if not entry_commit or entry_commit == "unknown":
        return False
    if current_commit == "unknown":
        return False
    if entry_commit == current_commit:
        return False
    try:
        result = subprocess.run(
            ["git", "diff", "--name-only", entry_commit, current_commit],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode != 0:
            return False
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False

    for line in result.stdout.strip().splitlines():
        path = line.strip()
        if not path:
            continue
        if any(path.startswith(p) for p in SOURCE_PREFIXES):
            return True
        if path in CANONICAL_ARTIFACTS:
            return True
        if path.startswith("docs/spec/") and path.endswith(".feature"):
            return True
    return False


def _resolve_proposal_path(state: dict) -> Path:
    origin = state.get("origin_ref")
    if origin:
        return Path(origin)
    work = state.get("work")
    if work and isinstance(work, list):
        for ref in work:
            if "proposals/" in str(ref):
                return Path(ref)
    return Path("docs/proposals/unknown.md")


def cmd_select(args: argparse.Namespace) -> int:
    model_path = Path(args.model) if args.model else DEFAULT_MODEL

    try:
        model = load_delivery_model(model_path)
    except CycleModelError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    target = args.target
    if target not in VALID_CYCLES:
        print(f"error: invalid cycle: {target}", file=sys.stderr)
        return 2

    if target == "DONE":
        print("error: cannot select terminal cycle DONE directly", file=sys.stderr)
        return 2

    state_path = Path(args.state)

    if state_path.exists():
        return _transition(state_path, target, model, args)
    else:
        return _create(state_path, target, model, args)


def _create(state_path: Path, target: str, model, args: argparse.Namespace) -> int:
    if not args.topic:
        print("error: --topic required when creating a new workstream", file=sys.stderr)
        return 2

    workstream_id = state_path.stem

    state = {
        "schema_version": 1,
        "workstream_id": workstream_id,
        "topic": args.topic,
        "cycle": target,
        "revision": 1,
        "attempt": 1,
        "origin_ref": args.work if args.work else None,
        "work": [args.work] if args.work else None,
        "delegation": None,
        "cycle_entry_commit": _current_commit(),
    }

    state_path.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write(state_path, yaml.safe_dump(state, default_flow_style=False, sort_keys=False))

    _write_binding(state_path, state)

    print(f"created workstream '{workstream_id}' at cycle {target}")
    return 0


def _transition(state_path: Path, target: str, model, args: argparse.Namespace) -> int:
    try:
        state = yaml.safe_load(state_path.read_text())
    except yaml.YAMLError as exc:
        print(f"error: cannot read state file: {exc}", file=sys.stderr)
        return 2

    if not isinstance(state, dict):
        print("error: state file is not a valid YAML mapping", file=sys.stderr)
        return 2

    current_cycle = state.get("cycle", "")

    declared_routes = {(r.from_cycle, r.to_cycle) for r in model.routes}
    if (current_cycle, target) not in declared_routes:
        print(
            f"warning: no declared route from {current_cycle} to {target}",
            file=sys.stderr,
        )

    state["cycle"] = target
    state["attempt"] = 1
    state["revision"] = state.get("revision", 0) + 1
    state["cycle_entry_commit"] = _current_commit()

    _atomic_write(state_path, yaml.safe_dump(state, default_flow_style=False, sort_keys=False))

    _write_binding(state_path, state)

    print(f"selected cycle {target} (revision {state['revision']})")
    return 0


def _atomic_write(path: Path, content: str) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, suffix=".tmp")
    closed = False
    try:
        os.write(fd, content.encode())
        os.close(fd)
        closed = True
        os.replace(tmp, path)
    except BaseException:
        if not closed:
            os.close(fd)
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _write_binding(state_path: Path, state: dict) -> None:
    bindings_dir_env = os.environ.get("CYCLE_BINDINGS_DIR")
    if bindings_dir_env:
        bindings_dir = Path(bindings_dir_env)
    else:
        bindings_dir = state_path.parent.parent / "session-bindings"

    bindings_dir.mkdir(parents=True, exist_ok=True)

    content = yaml.safe_dump(state, default_flow_style=False, sort_keys=False)
    digest = hashlib.sha256(content.encode()).hexdigest()

    session_id = os.environ.get("CLAUDE_SESSION_ID", str(uuid.uuid4())[:8])
    binding = {
        "session_id": session_id,
        "workstream_id": state.get("workstream_id", ""),
        "state_path": str(state_path),
        "revision": state.get("revision", 1),
        "digest": digest,
    }

    binding_path = bindings_dir / f"{session_id}.yaml"
    _atomic_write(binding_path, yaml.safe_dump(binding, default_flow_style=False, sort_keys=False))


def cmd_list(args: argparse.Namespace) -> int:
    cycles_dir = Path(args.dir)
    if not cycles_dir.exists():
        print("no workstreams found")
        return 0

    state_files = sorted(cycles_dir.glob("*.yaml"))
    if not state_files:
        print("no workstreams found")
        return 0

    for sf in state_files:
        try:
            state = yaml.safe_load(sf.read_text())
        except yaml.YAMLError:
            continue
        if not isinstance(state, dict):
            continue

        wid = state.get("workstream_id", sf.stem)
        topic = state.get("topic", "")
        cycle = state.get("cycle", "")
        revision = state.get("revision", "")

        print(f"{wid}\t{cycle}\trev {revision}\t{topic}")

    return 0


def cmd_assess(args: argparse.Namespace) -> int:
    model_path = Path(args.model) if args.model else DEFAULT_MODEL

    try:
        model = load_delivery_model(model_path)
    except CycleModelError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    state_path = Path(args.state)
    if not state_path.exists():
        print(f"error: state file not found: {state_path}", file=sys.stderr)
        return 2

    try:
        state = yaml.safe_load(state_path.read_text())
    except yaml.YAMLError as exc:
        print(f"error: cannot read state file: {exc}", file=sys.stderr)
        return 2

    if not isinstance(state, dict):
        print("error: state file is not a valid YAML mapping", file=sys.stderr)
        return 2

    current_cycle = state.get("cycle", "")
    if current_cycle not in VALID_CYCLES:
        print(f"error: invalid current cycle: {current_cycle}", file=sys.stderr)
        return 2

    commit = _current_commit()
    mechanical_results = {}
    semantic_results = {}

    for vname, validator_data in model.validators.items():
        if vname in VALIDATOR_REGISTRY:
            is_semantic, validator_fn = VALIDATOR_REGISTRY[vname]
            result = validator_fn(model, state, commit)
            if is_semantic:
                semantic_results[vname] = result
            else:
                mechanical_results[vname] = result

    entry_commit = state.get("cycle_entry_commit")
    code_changed = _detect_code_changed(entry_commit, commit)

    readiness = evaluate_readiness(
        current_cycle, model.routes, mechanical_results,
        semantic_results=semantic_results, code_changed=code_changed,
    )
    recommendation = recommend(current_cycle, readiness)

    _write_binding(state_path, state)
    _print_assessment(current_cycle, readiness, recommendation, code_changed)
    return 0


def _print_assessment(current_cycle: str, readiness, recommendation, code_changed: bool = False) -> None:
    print(f"\n--- Assessment for cycle {current_cycle} ---\n")
    if code_changed:
        print("Reconciliation: code or artifact changes detected since cycle entry.\n")
    else:
        print("Reconciliation: no relevant changes since cycle entry.\n")

    if isinstance(recommendation, NoRecommendation):
        print("Result: no evidence-supported recommendation.\n")
        if recommendation.warnings:
            print("Warnings:")
            for w in recommendation.warnings:
                print(f"  - {w}")
            print()
        print("Available cycles:")
        for c in recommendation.available_cycles:
            print(f"  - {c}")

    elif isinstance(recommendation, SingleRecommendation):
        print(f"Recommendation: {recommendation.from_cycle} → {recommendation.recommended_cycle}\n")
        print("Evidence:")
        for ev in recommendation.evidence:
            if hasattr(ev, "checks"):
                for check in ev.checks:
                    status = "PASS" if check.passed else "FAIL"
                    print(f"  [{status}] {check.name}: {check.detail}")
            else:
                print(f"  {ev}")
        print()
        if recommendation.available_cycles:
            print("Other available cycles:")
            for c in recommendation.available_cycles:
                print(f"  - {c}")

    elif isinstance(recommendation, MultipleChoices):
        print("Multiple routes have supporting evidence (unranked):\n")
        for choice in recommendation.choices:
            print(f"  - {choice.from_cycle} → {choice.to_cycle}")
        print()
        if recommendation.available_cycles:
            print("Other available cycles:")
            for c in recommendation.available_cycles:
                print(f"  - {c}")

    print()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="cycle", description="Cycle state adapter.")
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_select = sub.add_parser("select", help="Create or transition a workstream cycle.")
    p_select.add_argument("target", help="Target cycle (IDEA, CONCEPT, ROADMAP, REFINE, REALIZE)")
    p_select.add_argument("--state", required=True, help="Path to the workstream state file")
    p_select.add_argument("--topic", default=None, help="Workstream topic (required for new)")
    p_select.add_argument("--work", default=None, help="Proposal or work reference path")
    p_select.add_argument("--model", default=None, help="Path to delivery.yaml (default: built-in)")

    p_assess = sub.add_parser("assess", help="Assess readiness and show route recommendations.")
    p_assess.add_argument("--state", required=True, help="Path to the workstream state file")
    p_assess.add_argument("--model", default=None, help="Path to delivery.yaml (default: built-in)")

    p_list = sub.add_parser("list", help="List existing workstreams.")
    p_list.add_argument("--dir", default=".current-work/cycles", help="Directory to scan for state files")

    parsed = parser.parse_args(argv)
    if parsed.subcommand == "select":
        return cmd_select(parsed)
    if parsed.subcommand == "assess":
        return cmd_assess(parsed)
    if parsed.subcommand == "list":
        return cmd_list(parsed)
    return 2


if __name__ == "__main__":
    sys.exit(main())
