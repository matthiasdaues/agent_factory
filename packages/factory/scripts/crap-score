#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml"]
# ///
"""crap-score — the CRAP gate: judge the changed functions from the project's measurements.

What: Runs the measuring commands of `gates.crap-score` in docs/testing.yaml,
      computes the CRAP score of each measured function, and judges the
      functions whose lines the story changed (BR-127 to BR-133).
When: In the gate-check step of a story, at the merge through premerge-check,
      and during the setup of the gate.
By:   implementation agent, premerge-check, gate-setup-proof, a person.

Call
  crap-score (--base <revision> | --all) [--story-id <id>] [--report-dir <folder>]
             [--settings-from-folder]

  The gate runs from the root of the folder it is called in and reads
  docs/testing.yaml of that folder. It holds no language-specific code: each
  measuring command writes its rows to the file in GATE_OUTPUT, one JSON
  array with one row per function. GATE_FILES holds the measure's trusted
  `files` pattern and GATE_EXCLUDE its trusted `exclude` patterns, one
  pattern per line, so the command can leave out the files the gate drops
  (DEC-65). The gate still applies both to the rows itself. Every command gets the caller's
  environment without the environments of `uv run --script`, those of
  dispatch and premerge-check included, so `python` in a command starts
  the project's interpreter. Such an environment is a folder with
  pyvenv.cfg under uv's cache folder.

Runs
  For each measure in list order, its `ready` command, when it has one, and
  then its measuring command. `timeout_minutes` limits every command and
  every wait for a lock together. A measure with a `ready` command runs under
  an exclusive flock on crap-score/<measure>.lock under the git common
  directory, so two runs of one shared service never overlap (DEC-43, DEC-47).
  The name of such a measure is the name of its lock file, so it holds no /
  and is not . or ..

Stops
  At the time limit, and when crap-score gets SIGTERM, SIGINT or SIGHUP,
  crap-score stops the process group of the running command: SIGTERM, then
  SIGKILL after 5 seconds. Only then does it release the lock. SIGKILL of
  crap-score cannot be caught; on Linux the shell that crap-score starts for
  a command gets SIGKILL when crap-score dies (PR_SET_PDEATHSIG). The
  processes that shell starts are not covered and may keep running.

Score
  complexity^2 * (1 - coverage_pct/100)^3 + complexity, rounded to two
  decimals, half up. A judged function passes when the rounded score is at
  or below the threshold.

Trusted gate source
  A story cannot decide what counts as accepted. So the threshold, the
  `files` pattern and `exclude` list of each measure, and the exceptions
  register come from the tip of the local branch refs/heads/<integration
  branch>, through one reader (DEC-67, DEC-72, ADR-0041). The integration
  branch is the key integration_branch of docs/factory-settings.yaml, and
  dev without the file or the key (DEC-68). With --base the file comes from
  the tree of that revision, with --all or --settings-from-folder from the
  folder (DEC-73, DEC-77). A value
  that git does not accept as a branch name exits 2 (DEC-77). enabled, timeout_minutes, and the
  name, command and ready of each measure stay at the story head (DEC-75).
  A measure that the branch does not name takes its patterns from the
  folder, and the output names it as not yet trusted (DEC-69). A measure
  that the branch names and the folder lacks exits 2 (DEC-70). Without the
  ref of the default dev, without docs/testing.yaml on the branch, or
  without gates.crap-score there, the values come from the folder, and the
  output names the cause (DEC-13, DEC-69). --settings-from-folder takes the
  threshold and the patterns from the folder and reads no docs/testing.yaml
  from the branch; only gate-setup-proof passes it (DEC-71, DEC-73).

Exceptions
  The table of the section `## CRAP score` of docs/findings/exceptions.md,
  read from the integration branch through git. A function above the
  threshold gets `accepted` when a row names its file and qualified name and
  its rounded score is at or below the row's accepted score. The output
  names the reason of each `accepted` row. Without a branch dev, the output
  says that no register was read (BR-132).

Exit codes
  0  every judged function passes or is accepted, also when none is judged
  1  a judged function fails; the output names its file, function and score
  2  the gate cannot measure; the message names the cause, and no report is
     written
  128 + n  crap-score was stopped by signal n (SIGTERM, SIGINT, SIGHUP); no
     report is written
"""

from __future__ import annotations

import argparse
import ctypes
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from abc import ABC, abstractmethod
from contextlib import contextmanager
from dataclasses import dataclass, field, replace
from decimal import ROUND_HALF_UP, Context, Decimal, localcontext
from pathlib import Path
from typing import Iterator

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dispatch_lib import glob_match

TESTING_YAML = Path("docs") / "testing.yaml"
GATE_KEY = "crap-score"
# The old key with underscores still counts (BR-055).
OLD_GATE_KEY = "crap_score"
REQUIRED_SETTINGS = ("threshold", "timeout_minutes", "measures")
REQUIRED_MEASURE_FIELDS = ("name", "files", "command")
FUNCTION_FIELDS = ("file", "function", "start_line", "end_line", "complexity", "coverage_pct")
DEFAULT_REPORT_DIR = Path(".current-work") / "crap-score"
TWO_DECIMALS = Decimal("0.01")
# The shape check lets through a complexity of up to about 1.8e308 and any
# float coverage, so the exact score has at most about 1,600 digits. With
# 4,000 digits the formula stays exact and rounding never fails.
SCORE_CONTEXT = Context(prec=4000)
LOCK_FOLDER = "crap-score"
LOCK_POLL_SECONDS = 0.05
KILL_GRACE_SECONDS = 5


STOP_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
PR_SET_PDEATHSIG = 1


class Stopped(BaseException):
    """crap-score got a stop signal; a BaseException, so no `except Exception` keeps the run going."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


class GateError(Exception):
    """The gate cannot measure; exit 2 with this message (BR-133)."""


@dataclass(frozen=True)
class Measure:
    name: str
    files: str
    command: str
    exclude: tuple[str, ...] = ()
    ready: str | None = None


@dataclass(frozen=True)
class Settings:
    threshold: Decimal
    timeout_minutes: float
    measures: tuple[Measure, ...]


@dataclass
class FileChanges:
    """The changed lines of one file in the new version, and its deletions.

    A deletion lies after the new line it names: 0 means above line 1.
    """

    lines: set[int] = field(default_factory=set)
    deletions: list[int] = field(default_factory=list)


# --- call ------------------------------------------------------------------


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="crap-score", description=__doc__.splitlines()[0])
    parser.add_argument("--base", default=None, help="judge the functions changed since the merge base of this revision and HEAD")
    parser.add_argument("--all", action="store_true", help="judge every measured function")
    parser.add_argument("--story-id", default=None, help="the name of the report file")
    parser.add_argument("--report-dir", default=None, help="the folder of the report file")
    parser.add_argument(
        "--settings-from-folder", action="store_true",
        help="take threshold, files and exclude from the folder; only gate-setup-proof passes it",
    )
    return parser.parse_args(argv)


def call_error(args: argparse.Namespace) -> str | None:
    """Name the wrong call: neither or both of --base and --all (BR-127, DEC-16)."""
    if args.base is None and not args.all:
        return "give exactly one of --base <revision> and --all; the call has neither"
    if args.base is not None and args.all:
        return "give exactly one of --base <revision> and --all; the call has both"
    return None


# --- settings --------------------------------------------------------------


def read_settings(root: Path) -> Settings:
    """Read `gates.crap-score` of docs/testing.yaml under *root* (BR-128).

    The values are read whatever `enabled` says. The old key `crap_score`
    counts too; with both keys, the key with hyphens wins with a warning.
    """
    path = root / TESTING_YAML
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise GateError(f"cannot read {TESTING_YAML}: {exc}") from exc
    except yaml.YAMLError as exc:
        raise GateError(f"{TESTING_YAML} is no valid YAML: {exc}") from exc
    gates = data.get("gates") if isinstance(data, dict) else None
    gates = gates if isinstance(gates, dict) else {}
    entry, old_entry = gates.get(GATE_KEY), gates.get(OLD_GATE_KEY)
    if entry is not None and old_entry is not None:
        print(
            f"crap-score: warning: {TESTING_YAML} has gates.{OLD_GATE_KEY} and gates.{GATE_KEY}; "
            f"using gates.{GATE_KEY}, so delete gates.{OLD_GATE_KEY}",
            file=sys.stderr,
        )
    chosen = entry if entry is not None else old_entry
    if not isinstance(chosen, dict):
        raise GateError(
            f"{TESTING_YAML} has no entry gates.{GATE_KEY}; the skill setup-crap-score sets it up"
        )
    for key in REQUIRED_SETTINGS:
        if chosen.get(key) is None:
            raise GateError(f"gates.{GATE_KEY} in {TESTING_YAML} has no {key}")
    threshold = _number(chosen["threshold"], "threshold")
    timeout = _number(chosen["timeout_minutes"], "timeout_minutes")
    return Settings(Decimal(str(threshold)), float(timeout), _measures(chosen["measures"]))


def _number(value: object, key: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise GateError(f"gates.{GATE_KEY}.{key} in {TESTING_YAML} is no number: {value!r}")
    return value


def _measures(value: object) -> tuple[Measure, ...]:
    if not isinstance(value, list):
        raise GateError(f"gates.{GATE_KEY}.measures in {TESTING_YAML} is no list")
    if not value:
        raise GateError(
            f"gates.{GATE_KEY}.measures in {TESTING_YAML} is an empty list, so no code is measured"
        )
    measures: list[Measure] = []
    first_position: dict[str, int] = {}
    for position, item in enumerate(value, start=1):
        if not isinstance(item, dict):
            raise GateError(f"measure {position} of gates.{GATE_KEY}.measures is no mapping")
        label = f"measure {item.get('name') or position}"
        for key in REQUIRED_MEASURE_FIELDS:
            if not isinstance(item.get(key), str) or not item[key]:
                raise GateError(f"{label} of gates.{GATE_KEY}.measures has no field {key}")
        exclude = item.get("exclude") or []
        if not isinstance(exclude, list) or not all(isinstance(p, str) for p in exclude):
            raise GateError(f"{label} of gates.{GATE_KEY}.measures has an exclude that is no list of patterns")
        # GATE_FILES and GATE_EXCLUDE hold one pattern per line (DEC-65).
        for key, patterns in (("files", [item["files"]]), ("exclude", exclude)):
            if any("\n" in p or "\r" in p for p in patterns):
                raise GateError(f"{label} of gates.{GATE_KEY}.measures has a pattern in {key} with a line break")
        ready = item.get("ready")
        if ready is not None and (not isinstance(ready, str) or not ready):
            raise GateError(f"{label} of gates.{GATE_KEY}.measures has a field ready that is no command")
        name = item["name"]
        if ready is not None and ("/" in name or "\0" in name or name in (".", "..")):
            raise GateError(
                f"measure {name} of gates.{GATE_KEY}.measures has a ready command, so its name "
                f"names its lock file, and {name!r} is no file name"
            )
        if name in first_position:
            raise GateError(
                f"measures {first_position[name]} and {position} of gates.{GATE_KEY}.measures "
                f"both have the name {name}"
            )
        first_position[name] = position
        measures.append(Measure(name, item["files"], item["command"], tuple(exclude), ready))
    return tuple(measures)


# --- measuring -------------------------------------------------------------


class Clock:
    """The one time limit of a gate run: every command and every lock wait (BR-129)."""

    def __init__(self, minutes: float) -> None:
        self.minutes = minutes
        self.deadline = time.monotonic() + minutes * 60

    def remaining(self) -> float:
        return self.deadline - time.monotonic()

    def limit(self) -> str:
        return f"the time limit of {self.minutes:g} minutes (timeout_minutes)"


def _signal_group(proc: subprocess.Popen, sig: int) -> None:
    try:
        os.killpg(proc.pid, sig)
    except ProcessLookupError:
        pass


def _group_alive(proc: subprocess.Popen) -> bool:
    try:
        os.killpg(proc.pid, 0)
    except ProcessLookupError:
        return False
    return True


def _stop_group(proc: subprocess.Popen) -> None:
    """Stop the command and every process of its group.

    SIGTERM first, then SIGKILL after the grace period. The grace period
    lasts until every process of the group has ended, not only the leader,
    so the children can end on SIGTERM too. SIGKILL goes to the group even
    when the leader has exited, because its children may not have.
    """
    _signal_group(proc, signal.SIGTERM)
    deadline = time.monotonic() + KILL_GRACE_SECONDS
    try:
        proc.wait(timeout=KILL_GRACE_SECONDS)
        while _group_alive(proc) and time.monotonic() < deadline:
            time.sleep(LOCK_POLL_SECONDS)
    except subprocess.TimeoutExpired:
        pass
    finally:
        # Also when a stop signal interrupts the grace period.
        _signal_group(proc, signal.SIGKILL)
        proc.wait()


def _command_preexec():
    """The preexec_fn of a command: unblock the stop signals, and on Linux set the parent-death signal.

    run_command blocks the stop signals while Popen runs, and a child process
    inherits that mask, so the child unblocks them before the command starts.
    On Linux the child also gets SIGKILL when crap-score dies.
    """
    prctl = None
    if sys.platform.startswith("linux"):
        try:
            prctl = ctypes.CDLL(None, use_errno=True).prctl
        except (OSError, AttributeError):
            prctl = None
    parent = os.getpid()

    def preexec() -> None:
        signal.pthread_sigmask(signal.SIG_UNBLOCK, STOP_SIGNALS)
        if prctl is not None:
            prctl(PR_SET_PDEATHSIG, int(signal.SIGKILL))
            if os.getppid() != parent:
                # crap-score died before prctl took effect.
                os.kill(os.getpid(), signal.SIGKILL)

    return preexec


def _raise_stopped(signum: int, frame: object) -> None:
    for sig in STOP_SIGNALS:
        signal.signal(sig, signal.SIG_IGN)
    raise Stopped(signum)


@contextmanager
def stop_signals() -> Iterator[None]:
    """Turn SIGTERM, SIGINT and SIGHUP into Stopped; restore the earlier handlers afterwards.

    After the first signal, the next ones are ignored, so the stop of the
    running command is not cut short.
    """
    earlier = {sig: signal.signal(sig, _raise_stopped) for sig in STOP_SIGNALS}
    try:
        yield
    finally:
        for sig, handler in earlier.items():
            signal.signal(sig, handler)


def run_command(measure: Measure, kind: str, command: str, root: Path, env: dict, clock: Clock) -> None:
    """Run *command* in its own process group from *root*.

    The group is stopped at the limit and on any other way out of the wait,
    such as Stopped, so no command outlives the lock. The stop signals stay
    blocked while Popen runs, so a signal that arrives before *proc* exists
    waits until the group exists and the try below can stop it.
    """
    remaining = clock.remaining()
    if remaining <= 0:
        raise GateError(f"measure {measure.name} ran out of {clock.limit()} before its {kind} {command}")
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        earlier = signal.pthread_sigmask(signal.SIG_BLOCK, STOP_SIGNALS)
        try:
            proc = subprocess.Popen(
                command, shell=True, cwd=root, env=env, stdout=out, stderr=err, start_new_session=True,
                preexec_fn=_command_preexec(),
            )
        except BaseException:
            signal.pthread_sigmask(signal.SIG_SETMASK, earlier)
            raise
        try:
            # A signal that arrived while Popen ran is delivered here.
            signal.pthread_sigmask(signal.SIG_SETMASK, earlier)
            code = proc.wait(timeout=remaining)
        except subprocess.TimeoutExpired:
            _stop_group(proc)
            raise GateError(
                f"measure {measure.name} ran out of {clock.limit()}; stopped its {kind} {command}"
            ) from None
        except BaseException:
            _stop_group(proc)
            raise
        if code != 0:
            err.seek(0)
            out.seek(0)
            message = (
                err.read().decode(errors="replace").strip()
                or out.read().decode(errors="replace").strip()
                or "no message"
            )
            raise GateError(f"the {kind} of measure {measure.name} exited {code}: {command}: {message}")


@contextmanager
def measure_lock(measure: Measure, root: Path, clock: Clock) -> Iterator[None]:
    """Hold the flock of a measure with a `ready` command (DEC-43, DEC-47).

    The lock file lies under the git common directory, so every worktree sees
    it. The descriptor is not inherited by the commands, so the lock ends with
    this process. A measure without a `ready` command takes no lock.
    """
    if measure.ready is None:
        yield
        return
    common = git(root, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    path = Path(common) / LOCK_FOLDER / f"{measure.name}.lock"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    except OSError as exc:
        raise GateError(f"measure {measure.name} cannot open the lock {path}: {exc}") from exc
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if clock.remaining() <= 0:
                    raise GateError(
                        f"measure {measure.name} waited for the lock {path} until {clock.limit()} ran out"
                    ) from None
                time.sleep(min(LOCK_POLL_SECONDS, max(clock.remaining(), 0)))
        yield
    finally:
        os.close(fd)


def uv_cache_folder() -> str:
    """uv's cache folder: UV_CACHE_DIR, else $XDG_CACHE_HOME/uv, else ~/.cache/uv."""
    folder = os.environ.get("UV_CACHE_DIR") or os.path.join(
        os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "uv"
    )
    return os.path.realpath(folder)


def is_uv_script_environment(folder: str, cache: str) -> bool:
    """True when *folder* is a Python environment that lies under uv's cache folder."""
    real = os.path.realpath(folder)
    return real.startswith(cache + os.sep) and os.path.isfile(os.path.join(real, "pyvenv.cfg"))


def caller_environment() -> dict[str, str]:
    """The environment of the caller, without the environments of `uv run --script`.

    Each script that starts through `uv run --script`, such as dispatch,
    premerge-check and this gate, names its environment in VIRTUAL_ENV and
    puts its bin folder on PATH. uv keeps these environments under its cache
    folder. Every such PATH entry goes, and VIRTUAL_ENV goes when it names
    such an environment, so `python` in a command starts the project's
    interpreter. A project's own .venv lies outside the cache and stays. The
    template crap-measure-python of setup-crap-score holds the same function.
    """
    cache = uv_cache_folder()
    env = dict(os.environ)
    if "VIRTUAL_ENV" in env and is_uv_script_environment(env["VIRTUAL_ENV"], cache):
        del env["VIRTUAL_ENV"]
    if "PATH" in env:
        env["PATH"] = os.pathsep.join(
            entry for entry in env["PATH"].split(os.pathsep)
            if not (os.path.basename(os.path.normpath(entry)) == "bin"
                    and is_uv_script_environment(os.path.dirname(os.path.normpath(entry)), cache))
        )
    return env


def run_measure(measure: Measure, root: Path, clock: Clock) -> object:
    """Run the `ready` command and the measuring command of *measure*; return the JSON it wrote (BR-129).

    Both commands get the caller's environment without the environments of
    `uv run --script`, plus GATE_OUTPUT, GATE_FILES and GATE_EXCLUDE.
    """
    with tempfile.TemporaryDirectory(prefix="crap-score-") as folder:
        output = Path(folder) / "rows.json"
        env = {
            **caller_environment(),
            "GATE_OUTPUT": str(output),
            "GATE_FILES": measure.files,
            "GATE_EXCLUDE": "\n".join(measure.exclude),
        }
        with measure_lock(measure, root, clock):
            if measure.ready is not None:
                run_command(measure, "ready command", measure.ready, root, env, clock)
            run_command(measure, "measuring command", measure.command, root, env, clock)
        try:
            rows = json.loads(output.read_text(encoding="utf-8"))
        except OSError as exc:
            raise GateError(f"measure {measure.name} wrote no rows to GATE_OUTPUT: {exc}") from exc
        except ValueError as exc:
            raise GateError(f"measure {measure.name} wrote no JSON to GATE_OUTPUT: {exc}") from exc
    return rows


def kept_rows(measure: Measure, rows: list[dict]) -> list[dict]:
    """The rows whose file matches `files` and no `exclude` pattern (BR-131, DEC-10).

    It reads `file` without a check, so check_report must run on *rows* first.
    """
    return [
        row for row in rows
        if glob_match(measure.files, row["file"])
        and not any(glob_match(p, row["file"]) for p in measure.exclude)
    ]


def check_report(measure: Measure, report: object) -> list[dict]:
    """Refuse a report in the wrong shape before any row is filtered or judged (BR-130, DEC-42).

    Every row must be a parse error row or a function row of
    schemas/measure-output-rows.json, and a function row must not start below
    its last line. The message names the measure and the field. A row is a
    parse error row only when `parse_error` holds a non-empty text. Any other
    `parse_error` is cut from the row, so the later steps judge it as a
    function row (IMPL-0078).
    """
    if not isinstance(report, list):
        raise GateError(f"measure {measure.name} wrote no JSON array of rows to GATE_OUTPUT")
    checked = []
    for position, row in enumerate(report, start=1):
        if not isinstance(row, dict):
            raise GateError(f"measure {measure.name} wrote row {position}, which is no JSON object")
        if _text(row.get("parse_error")):
            problem = _parse_error_problem(row)
        else:
            row = {key: value for key, value in row.items() if key != "parse_error"}
            problem = _function_problem(row)
        if problem:
            raise GateError(f"measure {measure.name} wrote row {position} {problem}")
        checked.append(row)
    return checked


def _parse_error_problem(row: dict) -> str | None:
    if not _text(row.get("file")):
        return "with a field parse_error and without a non-empty text in the field file"
    return None


def _function_problem(row: dict) -> str | None:
    """Name what breaks the function row of the schema, or None."""
    for key in FUNCTION_FIELDS:
        if key not in row:
            return f"{_where(row)}without the field {key}"
    for key in ("file", "function"):
        if not _text(row[key]):
            return f"{_where(row)}with {key} {row[key]!r}, which is no non-empty text"
    for key in ("start_line", "end_line", "complexity", "coverage_pct"):
        if _number_value(row[key]) and abs(row[key]) > sys.float_info.max:
            return f"{_where(row)}with {key} above {sys.float_info.max:g}, which is too large to compute with"
    for key in ("start_line", "end_line", "complexity"):
        if not _whole(row[key]) or row[key] < 1:
            return f"{_where(row)}with {key} {row[key]!r}, which is no whole number of 1 or more"
    coverage = row["coverage_pct"]
    if not _number_value(coverage) or not 0 <= coverage <= 100:
        return f"{_where(row)}with coverage_pct {coverage!r}, which is no number from 0 to 100"
    if row["start_line"] > row["end_line"]:
        return (
            f"{_where(row)}with start_line {row['start_line']} above end_line {row['end_line']}"
        )
    return None


def _where(row: dict) -> str:
    """The file and the function of a row, as far as the row names them as text."""
    parts = [str(row[key]) for key in ("file", "function") if _text(row.get(key))]
    return f"for {' '.join(parts)} " if parts else ""


def _text(value: object) -> bool:
    return isinstance(value, str) and bool(value)


def _number_value(value: object) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def _whole(value: object) -> bool:
    """A JSON integer of draft-07: also a number such as 12.0."""
    return _number_value(value) and float(value).is_integer()


def check_duplicates(measure: Measure, rows: list[dict], owners: dict[tuple[str, str], str]) -> None:
    """Refuse one function twice among the kept rows (BR-130, DEC-11, DEC-12, DEC-29).

    *owners* maps each (file, function) that an earlier measure kept to that
    measure; the pairs of *measure* are added to it.
    """
    seen: set[tuple[str, str]] = set()
    for row in rows:
        if "parse_error" in row:
            continue
        pair = (row["file"], row["function"])
        if pair in seen:
            raise GateError(f"measure {measure.name} reports {row['function']} of {row['file']} twice")
        if pair in owners:
            raise GateError(
                f"measures {owners[pair]} and {measure.name} both report {row['function']} of {row['file']}"
            )
        seen.add(pair)
    owners.update(dict.fromkeys(seen, measure.name))


# --- changed functions -----------------------------------------------------

HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")


def git_argv(*args: str) -> list[str]:
    """The argument vector of one git call (SEC-0009).

    --no-replace-objects makes git read the true objects, so a replace ref
    under refs/replace/ cannot stand in for a blob or tree of the branch.
    The command-line setting core.useReplaceRefs=false wins over a repository
    setting of the same key, which the option alone does not override on
    git 2.34.1. Every git call of this script goes through this function.
    """
    return ["git", "-c", "core.useReplaceRefs=false", "--no-replace-objects", *args]


def git(root: Path, *args: str, errors: str = "strict") -> str:
    """Run git and decode its output as UTF-8; *errors* is the decoder's error handler."""
    proc = subprocess.run(git_argv(*args), cwd=root, capture_output=True, check=False)
    if proc.returncode != 0:
        stderr = proc.stderr.decode("utf-8", errors="replace").strip()
        raise GateError(f"git {' '.join(args)} failed: {stderr}")
    try:
        return proc.stdout.decode("utf-8", errors=errors)
    except UnicodeDecodeError as error:
        raise GateError(f"git {' '.join(args)} printed text that is not UTF-8: {error}") from None


def changed_lines(root: Path, base: str) -> dict[str, FileChanges]:
    """The changes of the diff from the merge base of *base* and HEAD to HEAD (DEC-29, DEC-42)."""
    merge_base = git(root, "merge-base", base, "HEAD").strip()
    diff = git(root, "-c", "core.quotePath=false", "diff", "--unified=0", "--no-color",
               "--no-ext-diff", "--src-prefix=a/", "--dst-prefix=b/", merge_base, "HEAD",
               errors="surrogateescape")
    return parse_diff(diff)


def parse_diff(diff: str) -> dict[str, FileChanges]:
    """Read the changed lines and the deletions of each file from a diff with --unified=0.

    A ``+++ `` line is a file header only between ``diff --git`` and the first
    ``@@`` of that file, so an added line that starts with ``++ `` is no header.
    """
    changes: dict[str, FileChanges] = {}
    current: FileChanges | None = None
    in_header = False
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            in_header, current = True, None
            continue
        if in_header and line.startswith("+++ "):
            target = _diff_path(line[4:])
            current = None if target is None else changes.setdefault(target, FileChanges())
            continue
        match = HUNK.match(line)
        if match:
            in_header = False
            if current is not None:
                start, count = int(match.group(1)), int(match.group(2) or 1)
                if count == 0:
                    current.deletions.append(start)
                else:
                    current.lines.update(range(start, start + count))
    return changes


def _diff_path(field: str) -> str | None:
    """The path of a ``+++ `` field: no trailing tab, C quotes decoded, ``b/`` cut."""
    if field.endswith("\t"):
        field = field[:-1]
    if field == "/dev/null":
        return None
    if field.startswith('"') and field.endswith('"'):
        field = _unquote_c(field[1:-1])
    return field[2:] if field.startswith("b/") else field


C_ESCAPES = {"a": 7, "b": 8, "t": 9, "n": 10, "v": 11, "f": 12, "r": 13, '"': 34, "\\": 92}


def _unquote_c(text: str) -> str:
    """Decode the C quoting git gives a path, with octal escapes as UTF-8 bytes."""
    out = bytearray()
    index = 0
    while index < len(text):
        char = text[index]
        if char != "\\":
            out += char.encode()
            index += 1
        elif text[index + 1:index + 2] in C_ESCAPES:
            out.append(C_ESCAPES[text[index + 1]])
            index += 2
        else:
            out.append(int(text[index + 1:index + 4], 8))
            index += 4
    return out.decode(errors="surrogateescape")


def judged_rows(rows: list[dict], changes: dict[str, FileChanges] | None) -> list[dict]:
    """The rows to judge: every row without *changes*, else the changed functions (BR-131)."""
    if changes is None:
        return list(rows)
    judged = []
    for row in rows:
        file_changes = changes.get(row["file"])
        if file_changes is None or not (file_changes.lines or file_changes.deletions):
            continue
        if "parse_error" in row or _touched(row, rows, file_changes):
            judged.append(row)
    return judged


def _touched(row: dict, rows: list[dict], changes: FileChanges) -> bool:
    start, end = row["start_line"], row["end_line"]
    if any(start <= line <= end for line in changes.lines):
        return True
    siblings = [r for r in rows if r["file"] == row["file"] and "parse_error" not in r]
    return any(_deletion_touches(start, end, after, siblings) for after in changes.deletions)


def _deletion_touches(start: int, end: int, after: int, siblings: list[dict]) -> bool:
    """A deletion after new line *after* touches the function it lies in.

    A deletion that lies in no function and between two functions touches
    the nearest function above and the nearest function below (DEC-15, DEC-37).
    A deletion below the last function touches the last function, and a
    deletion above the first function touches none (DEC-51).
    """
    if start <= after < end:
        return True
    if any(r["start_line"] <= after < r["end_line"] for r in siblings):
        return False
    above = [r["end_line"] for r in siblings if r["end_line"] <= after]
    below = [r["start_line"] for r in siblings if r["start_line"] > after]
    if not above:
        return False
    return end == max(above) or (bool(below) and start == min(below))


# --- exceptions register ---------------------------------------------------

REGISTER_PATH = "docs/findings/exceptions.md"
DEFAULT_BRANCH = "dev"
REGISTER_SECTION = "## CRAP score"
REGISTER_COLUMNS = ("File", "Function", "Accepted score", "Reason", "Accepted by")
ACCEPTED_SCORE = re.compile(r"\d+(?:\.\d+)?")
SEPARATOR_CELL = re.compile(r":?-+:?")


@dataclass(frozen=True)
class ExceptionRow:
    """A row of the section `## CRAP score` of the exceptions register (BR-132)."""

    file: str
    function: str
    accepted_score: Decimal
    reason: str
    accepted_by: str
    line: int


Exceptions = dict[tuple[str, str], ExceptionRow]


def parse_register(text: str, branch: str = DEFAULT_BRANCH) -> Exceptions:
    """The rows of the first table under `## CRAP score`; a broken row raises GateError (BR-132, DEC-38).

    *branch* is the branch the text comes from, for the messages.
    """
    table = _section_table(text.splitlines())
    if not table:
        return {}
    (header_line, header), *rows = table
    if _cells(header) != list(REGISTER_COLUMNS):
        raise GateError(
            f"{_register_at(header_line, branch)}: the table of the section {REGISTER_SECTION} "
            f"needs the columns {', '.join(REGISTER_COLUMNS)}"
        )
    exceptions: Exceptions = {}
    for number, line in rows:
        cells = _cells(line)
        if all(SEPARATOR_CELL.fullmatch(cell) for cell in cells):
            continue
        row = _exception_row(number, cells, branch)
        key = (row.file, row.function)
        if key in exceptions:
            raise GateError(
                f"{REGISTER_PATH} on {branch}, lines {exceptions[key].line} and {number}: "
                f"two rows name {row.function} of {row.file}"
            )
        exceptions[key] = row
    return exceptions


def _register_at(number: int, branch: str) -> str:
    return f"{REGISTER_PATH} on {branch}, line {number}"


def _section_table(lines: list[str]) -> list[tuple[int, str]]:
    """The numbered lines of the first table in the section, up to the next heading of level 1 or 2."""
    try:
        start = [line.strip() for line in lines].index(REGISTER_SECTION)
    except ValueError:
        return []
    table: list[tuple[int, str]] = []
    for number, line in enumerate(lines[start + 1:], start=start + 2):
        if re.match(r"#{1,2}\s", line):
            break
        if line.lstrip().startswith("|"):
            table.append((number, line))
        elif table:
            break
    return table


def _cells(line: str) -> list[str]:
    """The cells of a table line; an escaped pipe stays in its cell."""
    inner = line.strip()
    inner = inner[1:] if inner.startswith("|") else inner
    inner = inner[:-1] if inner.endswith("|") and not inner.endswith("\\|") else inner
    return [cell.strip().replace("\\|", "|") for cell in re.split(r"(?<!\\)\|", inner)]


def _unquoted(cell: str) -> str:
    if len(cell) >= 2 and cell.startswith("`") and cell.endswith("`"):
        return cell[1:-1].strip()
    return cell


def _exception_row(number: int, cells: list[str], branch: str) -> ExceptionRow:
    where = _register_at(number, branch)
    if len(cells) != len(REGISTER_COLUMNS):
        raise GateError(f"{where}: the row has {len(cells)} cells, and the table has {len(REGISTER_COLUMNS)} columns")
    for column, cell in zip(REGISTER_COLUMNS, cells):
        if not _unquoted(cell):
            raise GateError(f"{where}: the row has an empty cell {column}")
    file, function, score = (_unquoted(cell) for cell in cells[:3])
    if not ACCEPTED_SCORE.fullmatch(score):
        raise GateError(f"{where}: the accepted score {score!r} of {function} is no number")
    return ExceptionRow(file, function, Decimal(score), cells[3], cells[4], number)


# --- trusted gate source ---------------------------------------------------

FACTORY_SETTINGS = Path("docs") / "factory-settings.yaml"
BRANCH_KEY = "integration_branch"
OPTION_CAUSE = "the call passes --settings-from-folder"


@dataclass(frozen=True)
class Patterns:
    """The `files` pattern and the `exclude` list of one measure."""

    files: str
    exclude: tuple[str, ...] = ()


@dataclass(frozen=True)
class TrustedValues:
    """The gate settings that the trusted gate source returns (DEC-72).

    *patterns* holds the patterns of each measure of the folder, by name.
    """

    threshold: Decimal
    patterns: dict[str, Patterns]
    notices: tuple[str, ...] = ()


class TrustedGateSource(ABC):
    """The one reader of the trusted values (DEC-72, ADR-0041).

    The gate logic reaches the threshold, the `files` and `exclude` patterns
    and the exceptions only through this interface. A second backend, such as
    a knowledge-graph store or an issue tracker, is a new subclass.
    """

    @abstractmethod
    def gate_values(self, folder: Settings) -> TrustedValues:
        """The threshold and the patterns of each measure of *folder*, and the notices."""

    @abstractmethod
    def exceptions(self) -> tuple[Exceptions, tuple[str, ...]]:
        """The rows of the exceptions register, and the notices."""


def _settings_text(root: Path, base: str | None) -> tuple[str | None, str]:
    """docs/factory-settings.yaml as text, or None without the file, and where it was read (DEC-77).

    With *base*, a commit that resolve_base gave, the file comes from its
    tree through git, so the story under judgement cannot change it. Without
    *base*, it comes from the folder *root*.
    """
    if base is None:
        try:
            return (root / FACTORY_SETTINGS).read_text(encoding="utf-8"), str(FACTORY_SETTINGS)
        except FileNotFoundError:
            return None, str(FACTORY_SETTINGS)
        except (OSError, UnicodeDecodeError) as exc:
            raise GateError(f"cannot read {FACTORY_SETTINGS}: {exc}") from exc
    where = f"{FACTORY_SETTINGS} at the revision {base}"
    path = FACTORY_SETTINGS.as_posix()
    if not git(root, "ls-tree", "--full-tree", "--name-only", base, "--", path).strip():
        return None, where
    return git(root, "show", f"{base}:{path}"), where


def _is_branch_name(root: Path, value: str) -> bool:
    """Whether git accepts *value* as a branch name, unexpanded (DEC-77).

    git check-ref-format --branch expands @{-n} to the branch checked out
    before, so a value counts only when git prints it back unchanged.
    """
    proc = subprocess.run(
        git_argv("check-ref-format", "--branch", value),
        cwd=root, capture_output=True, text=True, check=False,
    )
    return proc.returncode == 0 and proc.stdout.strip() == value


def integration_branch(root: Path, base: str | None = None) -> tuple[str, bool]:
    """The integration branch, and whether the key integration_branch names it (BR-128, DEC-68, DEC-74, DEC-77).

    With *base*, the key comes from docs/factory-settings.yaml in the tree of
    the revision *base*; without it, from the folder *root*. Without the file
    or the key, the branch is dev. A value that is not a non-empty string, or
    that git does not accept as a branch name, raises GateError and names the
    file, the key and the value.
    """
    text, where = _settings_text(root, base)
    if text is None:
        return DEFAULT_BRANCH, False
    try:
        data = yaml.safe_load(text)
    except yaml.YAMLError as exc:
        raise GateError(f"{where} is no valid YAML, so the key {BRANCH_KEY} cannot be read: {exc}") from exc
    data = {} if data is None else data
    if not isinstance(data, dict):
        raise GateError(f"{where} is no mapping, so the key {BRANCH_KEY} cannot be read")
    if BRANCH_KEY not in data:
        return DEFAULT_BRANCH, False
    value = data[BRANCH_KEY]
    if not isinstance(value, str) or not value.strip():
        raise GateError(f"the key {BRANCH_KEY} in {where} is {value!r}, which is no non-empty branch name")
    if not _is_branch_name(root, value):
        raise GateError(f"the key {BRANCH_KEY} in {where} is {value!r}, which git does not accept as a branch name")
    return value, True


def branch_values(entry: object, where: str) -> tuple[Decimal, dict[str, Patterns]]:
    """The threshold and the patterns of each measure of gates.crap-score on the branch (DEC-74).

    *where* names the file and the branch for the messages. The branch must
    hold a threshold, because the gate has no built-in value (BR-128).
    """
    if not isinstance(entry, dict):
        raise GateError(f"gates.{GATE_KEY} in {where} is no mapping")
    threshold = entry.get("threshold")
    if threshold is None:
        raise GateError(f"gates.{GATE_KEY} in {where} has no threshold, and the gate has no built-in value")
    if isinstance(threshold, bool) or not isinstance(threshold, (int, float)):
        raise GateError(f"gates.{GATE_KEY}.threshold in {where} is no number: {threshold!r}")
    measures = entry.get("measures")
    measures = [] if measures is None else measures
    if not isinstance(measures, list):
        raise GateError(f"gates.{GATE_KEY}.measures in {where} is no list")
    trusted: dict[str, Patterns] = {}
    for position, item in enumerate(measures, start=1):
        if not isinstance(item, dict) or not _text(item.get("name")):
            raise GateError(f"measure {position} of gates.{GATE_KEY}.measures in {where} has no name")
        name = item["name"]
        exclude = item.get("exclude") or []
        if not _text(item.get("files")):
            raise GateError(f"measure {name} of gates.{GATE_KEY}.measures in {where} has no field files")
        if not isinstance(exclude, list) or not all(isinstance(p, str) for p in exclude):
            raise GateError(f"measure {name} of gates.{GATE_KEY}.measures in {where} has an exclude that is no list of patterns")
        if any("\n" in p or "\r" in p for p in [item["files"], *exclude]):
            raise GateError(f"measure {name} of gates.{GATE_KEY}.measures in {where} has a pattern with a line break")
        if name in trusted:
            raise GateError(f"gates.{GATE_KEY}.measures in {where} names the measure {name} twice")
        trusted[name] = Patterns(item["files"], tuple(exclude))
    return Decimal(str(threshold)), trusted


def join_values(folder: Settings, entry: object, where: str, cause: str | None = None) -> TrustedValues:
    """Join gates.crap-score of the branch with the folder by measure name (BR-128, DEC-69, DEC-70, DEC-75).

    *entry* is the entry of the branch, or None when it is missing for
    *cause*; then every value comes from the folder, and the notice names the
    cause. Otherwise the threshold comes from the branch, a measure that the
    branch names takes its patterns from the branch, and a measure new in the
    folder takes its own and is named as not yet trusted. A measure that the
    branch names and the folder lacks raises GateError.
    """
    own = {measure.name: Patterns(measure.files, measure.exclude) for measure in folder.measures}
    if entry is None:
        notice = (
            f"crap-score: took the threshold and the files and exclude patterns of every measure "
            f"from {TESTING_YAML} of the folder, because {cause}"
        )
        return TrustedValues(folder.threshold, own, (notice,))
    threshold, trusted = branch_values(entry, where)
    dropped = [name for name in trusted if name not in own]
    if dropped:
        names = " and ".join(dropped)
        raise GateError(
            f"{'measures' if len(dropped) > 1 else 'measure'} {names} {'are' if len(dropped) > 1 else 'is'} "
            f"in {where} and not in {TESTING_YAML} of the folder; a story cannot drop a measure, "
            "so remove it on the integration branch first"
        )
    notices = tuple(
        f"crap-score: measure {name} is not in {where}, so its files and exclude patterns come from "
        "the folder and are not yet trusted"
        for name in own if name not in trusted
    )
    return TrustedValues(threshold, {name: trusted.get(name, own[name]) for name in own}, notices)


def apply_trusted(folder: Settings, values: TrustedValues) -> Settings:
    """The folder settings with the trusted threshold and patterns; command and ready stay (DEC-75, BR-129)."""
    measures = []
    for measure in folder.measures:
        patterns = values.patterns.get(measure.name)
        if patterns is None:
            raise GateError(f"the trusted gate source returned no files pattern for measure {measure.name}")
        measures.append(replace(measure, files=patterns.files, exclude=patterns.exclude))
    return replace(folder, threshold=values.threshold, measures=tuple(measures))


def _resolve(root: Path, revision: str) -> str | None:
    """The commit of *revision*, or None when git names none, also outside a git repository."""
    proc = subprocess.run(
        git_argv("rev-parse", "--verify", "--quiet", revision),
        cwd=root, capture_output=True, text=True, check=False,
    )
    return proc.stdout.strip() if proc.returncode == 0 else None


def _branch_tip(root: Path, branch: str) -> str | None:
    """The tip of the local branch *branch*, or None without it (DEC-77).

    git show-ref --verify reads exactly refs/heads/<branch>, so git guesses
    no tag, no remote ref and no revision expression.
    """
    proc = subprocess.run(
        git_argv("show-ref", "--verify", "--hash", f"refs/heads/{branch}"),
        cwd=root, capture_output=True, text=True, check=False,
    )
    return proc.stdout.strip() if proc.returncode == 0 else None


def resolve_base(root: Path, base: str) -> str:
    """The commit of --base, resolved once for every later git call (DEC-78).

    A local branch of the name wins, because git resolves a bare name as a
    tag first, and a story can write a tag. Any other revision, such as a
    SHA, resolves through git rev-parse.
    """
    commit = _branch_tip(root, base) or _resolve(root, f"{base}^{{commit}}")
    if commit is None:
        raise GateError(f"the revision {base} of --base names no commit")
    return commit


def _gate_entry(data: object, where: str) -> object:
    """gates.crap-score of parsed settings, the old key too; None without the entry."""
    if data is None:
        return None
    if not isinstance(data, dict):
        raise GateError(f"{where} cannot be parsed as settings, because it is no mapping")
    gates = data.get("gates")
    if not isinstance(gates, dict):
        return None
    entry = gates.get(GATE_KEY)
    return entry if entry is not None else gates.get(OLD_GATE_KEY)


class GitRefSource(TrustedGateSource):
    """The trusted gate source that reads refs/heads/<integration branch> through git (DEC-67).

    The reader resolves the tip of the local branch once and reads every
    value from that commit, so a tag, a remote ref or a revision expression
    never stands in for the branch (DEC-77). A branch that the key names must
    exist. With --base, the tip must also not be HEAD, the commit under
    judgement: a story would then be its own trusted source. With --all, the
    checked-out integration branch is HEAD by design (DEC-76, DEC-79). Only
    the default dev may be missing, and then the values come from the folder
    and no register is read (DEC-13, DEC-76).
    """

    def __init__(
        self, root: Path, branch: str, named: bool, settings_from_folder: bool = False,
        refuse_head_tip: bool = True,
    ) -> None:
        self.root = root
        self.branch = branch
        self.settings_from_folder = settings_from_folder
        tip = _branch_tip(root, branch)
        if named and tip is None:
            raise GateError(
                f"the key {BRANCH_KEY} in {FACTORY_SETTINGS} names the branch {branch}, "
                f"and git holds no branch {branch}"
            )
        if named and refuse_head_tip and tip == _resolve(root, "HEAD^{commit}"):
            raise GateError(
                f"the key {BRANCH_KEY} in {FACTORY_SETTINGS} names the branch {branch}, whose tip is HEAD, "
                "the commit under judgement; a story cannot be its own trusted source"
            )
        self.tip = tip
        self.present = tip is not None

    def _holds(self, path: str) -> bool:
        return bool(git(self.root, "ls-tree", "--full-tree", "--name-only", self.tip, "--", path).strip())

    def gate_values(self, folder: Settings) -> TrustedValues:
        where = f"{TESTING_YAML} on the branch {self.branch}"
        if self.settings_from_folder:
            return join_values(folder, None, where, OPTION_CAUSE)
        if not self.present:
            return join_values(folder, None, where, f"no branch {self.branch} exists")
        if not self._holds(TESTING_YAML.as_posix()):
            return join_values(folder, None, where, f"the branch {self.branch} holds no {TESTING_YAML}")
        text = git(self.root, "show", f"{self.tip}:{TESTING_YAML.as_posix()}")
        try:
            data = yaml.safe_load(text)
        except yaml.YAMLError as exc:
            raise GateError(f"{where} cannot be parsed: {exc}") from exc
        entry = _gate_entry(data, where)
        if entry is None:
            return join_values(folder, None, where, f"{where} has no entry gates.{GATE_KEY}")
        return join_values(folder, entry, where)

    def exceptions(self) -> tuple[Exceptions, tuple[str, ...]]:
        if not self.present:
            return {}, (f"crap-score: read no exceptions register, because no branch {self.branch} exists",)
        if not self._holds(REGISTER_PATH):
            return {}, ()
        return parse_register(git(self.root, "show", f"{self.tip}:{REGISTER_PATH}"), self.branch), ()


def open_source(root: Path, settings_from_folder: bool, base: str | None = None) -> TrustedGateSource:
    """The trusted gate source of the folder *root*: the git ref of its integration branch.

    With *base*, the key integration_branch comes from the revision *base*
    (DEC-77). The setup paths read it from the folder: --all, and
    --settings-from-folder, which only gate-setup-proof passes, because its
    first commit holds the uncommitted file of the working tree (DEC-73).
    The check that refuses a named branch whose tip is HEAD runs only with
    *base*, where a story is judged (DEC-79).
    """
    branch, named = integration_branch(root, None if settings_from_folder else base)
    return GitRefSource(root, branch, named, settings_from_folder, refuse_head_tip=base is not None)


# --- score -----------------------------------------------------------------


def crap_formula(complexity: int, coverage_pct: float) -> Decimal:
    """complexity^2 * (1 - coverage_pct/100)^3 + complexity, in exact decimals."""
    with localcontext(SCORE_CONTEXT):
        uncovered = 1 - Decimal(str(coverage_pct)) / 100
        return Decimal(complexity) ** 2 * uncovered**3 + Decimal(complexity)


def rounded(score: Decimal | float) -> Decimal:
    """The score rounded to two decimals, half up (DEC-36)."""
    value = score if isinstance(score, Decimal) else Decimal(str(score))
    with localcontext(SCORE_CONTEXT):
        return value.quantize(TWO_DECIMALS, rounding=ROUND_HALF_UP)


def verdict(score: Decimal, threshold: Decimal, exception: ExceptionRow | None = None) -> str:
    """Judge the rounded score (DEC-14, BR-132).

    `pass` at or below the threshold, also with a register row (DEC-24).
    Above it, `accepted` when the rounded score is at or below the accepted
    score of *exception*, else `fail`.
    """
    value = rounded(score)
    if value <= threshold:
        return "pass"
    if exception is not None and value <= exception.accepted_score:
        return "accepted"
    return "fail"


def report_row(row: dict, threshold: Decimal, exceptions: Exceptions | None = None) -> dict:
    if "parse_error" in row:
        return {"file": row["file"], "parse_error": row["parse_error"], "pass_fail": "fail"}
    score = rounded(crap_formula(row["complexity"], row["coverage_pct"]))
    result = {key: row[key] for key in FUNCTION_FIELDS}
    result["crap_score"] = float(score)
    exception = (exceptions or {}).get((row["file"], row["function"]))
    result["pass_fail"] = verdict(score, threshold, exception)
    return result


# --- report ----------------------------------------------------------------

ID_IN_BRANCH = re.compile(r"[A-Z][A-Z0-9]*-\d+")


def current_branch() -> str | None:
    """The name of the current branch, or None when git names none."""
    try:
        proc = subprocess.run(
            git_argv("symbolic-ref", "--quiet", "--short", "HEAD"),
            capture_output=True, text=True, check=False,
        )
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.strip() or None


def detect_story_id(explicit: str | None) -> str:
    """`--story-id`, then STORY_ID, then the ID in the branch name, then `adhoc` (DEC-27)."""
    story_id = explicit or os.environ.get("STORY_ID")
    if not story_id:
        branch = current_branch() or ""
        found = ID_IN_BRANCH.findall(branch.rsplit("/", 1)[-1])
        story_id = found[-1] if found else "adhoc"
    return story_id.replace("/", "-")


def write_report(report_dir: Path, story_id: str, rows: list[dict]) -> Path:
    """Write the report and replace an earlier report of the same name (BR-133)."""
    report_dir.mkdir(parents=True, exist_ok=True)
    path = report_dir / f"{story_id}.json"
    partial = path.with_name(path.name + ".partial")
    partial.write_text(json.dumps(rows, indent=2) + "\n", encoding="utf-8")
    os.replace(partial, path)
    return path


def _describe(row: dict, exceptions: Exceptions | None = None) -> str:
    """One output line; an `accepted` row also names the reason of its register row (BR-132)."""
    if "parse_error" in row:
        return f"FAIL {row['file']}: parse error: {row['parse_error']}"
    line = f"{row['pass_fail'].upper()} {row['file']} {row['function']} {row['crap_score']:.2f}"
    if row["pass_fail"] == "accepted":
        line += f": {(exceptions or {})[(row['file'], row['function'])].reason}"
    return line


# --- main ------------------------------------------------------------------


def measure_all(settings: Settings, root: Path) -> list[dict]:
    """Run every measure in list order within one time limit; return the kept rows."""
    clock = Clock(settings.timeout_minutes)
    kept: list[dict] = []
    owners: dict[tuple[str, str], str] = {}
    for measure in settings.measures:
        rows = kept_rows(measure, check_report(measure, run_measure(measure, root, clock)))
        check_duplicates(measure, rows, owners)
        kept.extend(rows)
    return kept


def main(argv: list[str] | None = None, source: TrustedGateSource | None = None) -> int:
    """Run the gate; *source* replaces the git ref backend of the trusted gate source (DEC-72)."""
    args = parse_args(argv)
    problem = call_error(args)
    if problem:
        print(f"crap-score: {problem}", file=sys.stderr)
        return 2
    root = Path.cwd()
    try:
        with stop_signals():
            folder = read_settings(root)
            base = resolve_base(root, args.base) if args.base is not None else None
            if source is None:
                source = open_source(root, args.settings_from_folder, base)
            trusted = source.gate_values(folder)
            settings = apply_trusted(folder, trusted)
            exceptions, register_notices = source.exceptions()
            changes = changed_lines(root, base) if base is not None else None
            rows = measure_all(settings, root)
    except GateError as exc:
        print(f"crap-score: cannot measure: {exc}", file=sys.stderr)
        return 2
    except Stopped as stop:
        name = signal.Signals(stop.signum).name
        print(f"crap-score: stopped by {name}; stopped the running command and wrote no report", file=sys.stderr)
        return 128 + stop.signum
    results = [report_row(row, settings.threshold, exceptions) for row in judged_rows(rows, changes)]
    report_dir = Path(args.report_dir) if args.report_dir else root / DEFAULT_REPORT_DIR
    path = write_report(report_dir, detect_story_id(args.story_id), results)
    for notice in (*trusted.notices, *register_notices):
        print(notice)
    for row in results:
        print(_describe(row, exceptions))
    failed = sum(row["pass_fail"] == "fail" for row in results)
    accepted = sum(row["pass_fail"] == "accepted" for row in results)
    print(
        f"crap-score: judged {len(results)} functions, {failed} failed and {accepted} accepted "
        f"above the threshold {settings.threshold}; wrote {path}",
        file=sys.stderr,
    )
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
