#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml"]
# ///
"""crap-score — the CRAP gate: judge the changed functions from the project's measurements.

What: Runs the measuring commands of `gates.crap-score` in docs/testing.yaml,
      computes the CRAP score of each measured function, and judges the
      functions whose lines the story changed (BR-127 to BR-133).
When: In the gate-check step of a story, at the merge through premerge-check,
      and during the setup of the gate.
By:   implementation agent, premerge-check, gate-setup-proof, a person.

Call
  crap-score (--base <revision> | --all) [--story-id <id>] [--report-dir <folder>]

  The gate runs from the root of the folder it is called in and reads
  docs/testing.yaml of that folder. It holds no language-specific code: each
  measuring command writes its rows to the file in GATE_OUTPUT, one JSON
  array with one row per function.

Runs
  For each measure in list order, its `ready` command, when it has one, and
  then its measuring command. `timeout_minutes` limits every command and
  every wait for a lock together. A measure with a `ready` command runs under
  an exclusive flock on crap-score/<measure>.lock under the git common
  directory, so two runs of one shared service never overlap (DEC-43, DEC-47).

Score
  complexity^2 * (1 - coverage_pct/100)^3 + complexity, rounded to two
  decimals, half up. A judged function passes when the rounded score is at
  or below the threshold.

Exit codes
  0  every judged function passes, also when none is judged
  1  a judged function fails; the output names its file, function and score
  2  the gate cannot measure; the message names the cause, and no report is
     written
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from dataclasses import dataclass, field
from decimal import ROUND_HALF_UP, Decimal
from pathlib import Path
from typing import Iterator

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dispatch_lib import glob_match

TESTING_YAML = Path("docs") / "testing.yaml"
GATE_KEY = "crap-score"
# The old key with underscores still counts (BR-055).
OLD_GATE_KEY = "crap_score"
REQUIRED_SETTINGS = ("threshold", "timeout_minutes", "measures")
REQUIRED_MEASURE_FIELDS = ("name", "files", "command")
FUNCTION_FIELDS = ("file", "function", "start_line", "end_line", "complexity", "coverage_pct")
DEFAULT_REPORT_DIR = Path(".current-work") / "crap-score"
TWO_DECIMALS = Decimal("0.01")
LOCK_FOLDER = "crap-score"
LOCK_POLL_SECONDS = 0.05
KILL_GRACE_SECONDS = 5


class GateError(Exception):
    """The gate cannot measure; exit 2 with this message (BR-133)."""


@dataclass(frozen=True)
class Measure:
    name: str
    files: str
    command: str
    exclude: tuple[str, ...] = ()
    ready: str | None = None


@dataclass(frozen=True)
class Settings:
    threshold: Decimal
    timeout_minutes: float
    measures: tuple[Measure, ...]


@dataclass
class FileChanges:
    """The changed lines of one file in the new version, and its deletions.

    A deletion lies after the new line it names: 0 means above line 1.
    """

    lines: set[int] = field(default_factory=set)
    deletions: list[int] = field(default_factory=list)


# --- call ------------------------------------------------------------------


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="crap-score", description=__doc__.splitlines()[0])
    parser.add_argument("--base", default=None, help="judge the functions changed since the merge base of this revision and HEAD")
    parser.add_argument("--all", action="store_true", help="judge every measured function")
    parser.add_argument("--story-id", default=None, help="the name of the report file")
    parser.add_argument("--report-dir", default=None, help="the folder of the report file")
    return parser.parse_args(argv)


def call_error(args: argparse.Namespace) -> str | None:
    """Name the wrong call: neither or both of --base and --all (BR-127, DEC-16)."""
    if args.base is None and not args.all:
        return "give exactly one of --base <revision> and --all; the call has neither"
    if args.base is not None and args.all:
        return "give exactly one of --base <revision> and --all; the call has both"
    return None


# --- settings --------------------------------------------------------------


def read_settings(root: Path) -> Settings:
    """Read `gates.crap-score` of docs/testing.yaml under *root* (BR-128).

    The values are read whatever `enabled` says. The old key `crap_score`
    counts too; with both keys, the key with hyphens wins with a warning.
    """
    path = root / TESTING_YAML
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise GateError(f"cannot read {TESTING_YAML}: {exc}") from exc
    except yaml.YAMLError as exc:
        raise GateError(f"{TESTING_YAML} is no valid YAML: {exc}") from exc
    gates = data.get("gates") if isinstance(data, dict) else None
    gates = gates if isinstance(gates, dict) else {}
    entry, old_entry = gates.get(GATE_KEY), gates.get(OLD_GATE_KEY)
    if entry is not None and old_entry is not None:
        print(
            f"crap-score: warning: {TESTING_YAML} has gates.{OLD_GATE_KEY} and gates.{GATE_KEY}; "
            f"using gates.{GATE_KEY}, so delete gates.{OLD_GATE_KEY}",
            file=sys.stderr,
        )
    chosen = entry if entry is not None else old_entry
    if not isinstance(chosen, dict):
        raise GateError(
            f"{TESTING_YAML} has no entry gates.{GATE_KEY}; the skill setup-crap-score sets it up"
        )
    for key in REQUIRED_SETTINGS:
        if chosen.get(key) is None:
            raise GateError(f"gates.{GATE_KEY} in {TESTING_YAML} has no {key}")
    threshold = _number(chosen["threshold"], "threshold")
    timeout = _number(chosen["timeout_minutes"], "timeout_minutes")
    return Settings(Decimal(str(threshold)), float(timeout), _measures(chosen["measures"]))


def _number(value: object, key: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise GateError(f"gates.{GATE_KEY}.{key} in {TESTING_YAML} is no number: {value!r}")
    return value


def _measures(value: object) -> tuple[Measure, ...]:
    if not isinstance(value, list):
        raise GateError(f"gates.{GATE_KEY}.measures in {TESTING_YAML} is no list")
    if not value:
        raise GateError(
            f"gates.{GATE_KEY}.measures in {TESTING_YAML} is an empty list, so no code is measured"
        )
    measures: list[Measure] = []
    first_position: dict[str, int] = {}
    for position, item in enumerate(value, start=1):
        if not isinstance(item, dict):
            raise GateError(f"measure {position} of gates.{GATE_KEY}.measures is no mapping")
        label = f"measure {item.get('name') or position}"
        for key in REQUIRED_MEASURE_FIELDS:
            if not isinstance(item.get(key), str) or not item[key]:
                raise GateError(f"{label} of gates.{GATE_KEY}.measures has no field {key}")
        exclude = item.get("exclude") or []
        if not isinstance(exclude, list) or not all(isinstance(p, str) for p in exclude):
            raise GateError(f"{label} of gates.{GATE_KEY}.measures has an exclude that is no list of patterns")
        ready = item.get("ready")
        if ready is not None and (not isinstance(ready, str) or not ready):
            raise GateError(f"{label} of gates.{GATE_KEY}.measures has a field ready that is no command")
        name = item["name"]
        if name in first_position:
            raise GateError(
                f"measures {first_position[name]} and {position} of gates.{GATE_KEY}.measures "
                f"both have the name {name}"
            )
        first_position[name] = position
        measures.append(Measure(name, item["files"], item["command"], tuple(exclude), ready))
    return tuple(measures)


# --- measuring -------------------------------------------------------------


class Clock:
    """The one time limit of a gate run: every command and every lock wait (BR-129)."""

    def __init__(self, minutes: float) -> None:
        self.minutes = minutes
        self.deadline = time.monotonic() + minutes * 60

    def remaining(self) -> float:
        return self.deadline - time.monotonic()

    def limit(self) -> str:
        return f"the time limit of {self.minutes:g} minutes (timeout_minutes)"


def _signal_group(proc: subprocess.Popen, sig: int) -> None:
    try:
        os.killpg(proc.pid, sig)
    except ProcessLookupError:
        pass


def _stop_group(proc: subprocess.Popen) -> None:
    """Stop the command and every process of its group.

    SIGTERM first, then SIGKILL after the grace period. SIGKILL goes to the
    group even when the leader has exited, because its children may not have.
    """
    _signal_group(proc, signal.SIGTERM)
    try:
        proc.wait(timeout=KILL_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        pass
    _signal_group(proc, signal.SIGKILL)
    proc.wait()


def run_command(measure: Measure, kind: str, command: str, root: Path, env: dict, clock: Clock) -> None:
    """Run *command* in its own process group from *root*; stop the group at the limit."""
    remaining = clock.remaining()
    if remaining <= 0:
        raise GateError(f"measure {measure.name} ran out of {clock.limit()} before its {kind} {command}")
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        proc = subprocess.Popen(
            command, shell=True, cwd=root, env=env, stdout=out, stderr=err, start_new_session=True
        )
        try:
            code = proc.wait(timeout=remaining)
        except subprocess.TimeoutExpired:
            _stop_group(proc)
            raise GateError(
                f"measure {measure.name} ran out of {clock.limit()}; stopped its {kind} {command}"
            ) from None
        if code != 0:
            err.seek(0)
            out.seek(0)
            message = (
                err.read().decode(errors="replace").strip()
                or out.read().decode(errors="replace").strip()
                or "no message"
            )
            raise GateError(f"the {kind} of measure {measure.name} exited {code}: {command}: {message}")


@contextmanager
def measure_lock(measure: Measure, root: Path, clock: Clock) -> Iterator[None]:
    """Hold the flock of a measure with a `ready` command (DEC-43, DEC-47).

    The lock file lies under the git common directory, so every worktree sees
    it. The descriptor is not inherited by the commands, so the lock ends with
    this process. A measure without a `ready` command takes no lock.
    """
    if measure.ready is None:
        yield
        return
    common = git(root, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    path = Path(common) / LOCK_FOLDER / f"{measure.name}.lock"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    except OSError as exc:
        raise GateError(f"measure {measure.name} cannot open the lock {path}: {exc}") from exc
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if clock.remaining() <= 0:
                    raise GateError(
                        f"measure {measure.name} waited for the lock {path} until {clock.limit()} ran out"
                    ) from None
                time.sleep(min(LOCK_POLL_SECONDS, max(clock.remaining(), 0)))
        yield
    finally:
        os.close(fd)


def run_measure(measure: Measure, root: Path, clock: Clock) -> list[dict]:
    """Run the `ready` command and the measuring command of *measure*; return its rows (BR-129)."""
    with tempfile.TemporaryDirectory(prefix="crap-score-") as folder:
        output = Path(folder) / "rows.json"
        env = {**os.environ, "GATE_OUTPUT": str(output)}
        with measure_lock(measure, root, clock):
            if measure.ready is not None:
                run_command(measure, "ready command", measure.ready, root, env, clock)
            run_command(measure, "measuring command", measure.command, root, env, clock)
        try:
            rows = json.loads(output.read_text(encoding="utf-8"))
        except OSError as exc:
            raise GateError(f"measure {measure.name} wrote no rows to GATE_OUTPUT: {exc}") from exc
        except ValueError as exc:
            raise GateError(f"measure {measure.name} wrote no JSON to GATE_OUTPUT: {exc}") from exc
    if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):
        raise GateError(f"measure {measure.name} wrote no JSON array of rows to GATE_OUTPUT")
    return rows


def kept_rows(measure: Measure, rows: list[dict]) -> list[dict]:
    """The rows whose file matches `files` and no `exclude` pattern (BR-131, DEC-10)."""
    kept = []
    for row in rows:
        path = row.get("file")
        if not isinstance(path, str) or not path:
            raise GateError(f"measure {measure.name} wrote a row without the field file")
        if glob_match(measure.files, path) and not any(glob_match(p, path) for p in measure.exclude):
            kept.append(row)
    return kept


def _check_row(measure: Measure, row: dict) -> None:
    """Refuse a row that the judging cannot read, so no traceback gives exit 1."""
    if "parse_error" in row:
        return
    for key in FUNCTION_FIELDS:
        if key not in row:
            raise GateError(f"measure {measure.name} wrote a row of {row['file']} without the field {key}")


# --- changed functions -----------------------------------------------------

HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")


def git(root: Path, *args: str) -> str:
    proc = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        raise GateError(f"git {' '.join(args)} failed: {proc.stderr.strip()}")
    return proc.stdout


def changed_lines(root: Path, base: str) -> dict[str, FileChanges]:
    """The changes of the diff from the merge base of *base* and HEAD to HEAD (DEC-29, DEC-42)."""
    merge_base = git(root, "merge-base", base, "HEAD").strip()
    diff = git(root, "-c", "core.quotePath=false", "diff", "--unified=0", "--no-color",
               "--no-ext-diff", "--src-prefix=a/", "--dst-prefix=b/", merge_base, "HEAD")
    return parse_diff(diff)


def parse_diff(diff: str) -> dict[str, FileChanges]:
    """Read the changed lines and the deletions of each file from a diff with --unified=0.

    A ``+++ `` line is a file header only between ``diff --git`` and the first
    ``@@`` of that file, so an added line that starts with ``++ `` is no header.
    """
    changes: dict[str, FileChanges] = {}
    current: FileChanges | None = None
    in_header = False
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            in_header, current = True, None
            continue
        if in_header and line.startswith("+++ "):
            target = _diff_path(line[4:])
            current = None if target is None else changes.setdefault(target, FileChanges())
            continue
        match = HUNK.match(line)
        if match:
            in_header = False
            if current is not None:
                start, count = int(match.group(1)), int(match.group(2) or 1)
                if count == 0:
                    current.deletions.append(start)
                else:
                    current.lines.update(range(start, start + count))
    return changes


def _diff_path(field: str) -> str | None:
    """The path of a ``+++ `` field: no trailing tab, C quotes decoded, ``b/`` cut."""
    if field.endswith("\t"):
        field = field[:-1]
    if field == "/dev/null":
        return None
    if field.startswith('"') and field.endswith('"'):
        field = _unquote_c(field[1:-1])
    return field[2:] if field.startswith("b/") else field


C_ESCAPES = {"a": 7, "b": 8, "t": 9, "n": 10, "v": 11, "f": 12, "r": 13, '"': 34, "\\": 92}


def _unquote_c(text: str) -> str:
    """Decode the C quoting git gives a path, with octal escapes as UTF-8 bytes."""
    out = bytearray()
    index = 0
    while index < len(text):
        char = text[index]
        if char != "\\":
            out += char.encode()
            index += 1
        elif text[index + 1:index + 2] in C_ESCAPES:
            out.append(C_ESCAPES[text[index + 1]])
            index += 2
        else:
            out.append(int(text[index + 1:index + 4], 8))
            index += 4
    return out.decode(errors="surrogateescape")


def judged_rows(rows: list[dict], changes: dict[str, FileChanges] | None) -> list[dict]:
    """The rows to judge: every row without *changes*, else the changed functions (BR-131)."""
    if changes is None:
        return list(rows)
    judged = []
    for row in rows:
        file_changes = changes.get(row["file"])
        if file_changes is None or not (file_changes.lines or file_changes.deletions):
            continue
        if "parse_error" in row or _touched(row, rows, file_changes):
            judged.append(row)
    return judged


def _touched(row: dict, rows: list[dict], changes: FileChanges) -> bool:
    start, end = row["start_line"], row["end_line"]
    if any(start <= line <= end for line in changes.lines):
        return True
    siblings = [r for r in rows if r["file"] == row["file"] and "parse_error" not in r]
    return any(_deletion_touches(start, end, after, siblings) for after in changes.deletions)


def _deletion_touches(start: int, end: int, after: int, siblings: list[dict]) -> bool:
    """A deletion after new line *after* touches the function it lies in.

    A deletion that lies in no function and between two functions touches
    the nearest function above and the nearest function below (DEC-15, DEC-37).
    """
    if start <= after < end:
        return True
    if any(r["start_line"] <= after < r["end_line"] for r in siblings):
        return False
    above = [r["end_line"] for r in siblings if r["end_line"] <= after]
    below = [r["start_line"] for r in siblings if r["start_line"] > after]
    if not above or not below:
        return False
    return end == max(above) or start == min(below)


# --- score -----------------------------------------------------------------


def crap_formula(complexity: int, coverage_pct: float) -> Decimal:
    """complexity^2 * (1 - coverage_pct/100)^3 + complexity, in exact decimals."""
    uncovered = 1 - Decimal(str(coverage_pct)) / 100
    return Decimal(complexity) ** 2 * uncovered**3 + Decimal(complexity)


def rounded(score: Decimal | float) -> Decimal:
    """The score rounded to two decimals, half up (DEC-36)."""
    value = score if isinstance(score, Decimal) else Decimal(str(score))
    return value.quantize(TWO_DECIMALS, rounding=ROUND_HALF_UP)


def verdict(score: Decimal, threshold: Decimal) -> str:
    """`pass` when the rounded score is at or below the threshold (DEC-14)."""
    return "pass" if rounded(score) <= threshold else "fail"


def report_row(row: dict, threshold: Decimal) -> dict:
    if "parse_error" in row:
        return {"file": row["file"], "parse_error": row["parse_error"], "pass_fail": "fail"}
    score = rounded(crap_formula(row["complexity"], row["coverage_pct"]))
    result = {key: row[key] for key in FUNCTION_FIELDS}
    result["crap_score"] = float(score)
    result["pass_fail"] = verdict(score, threshold)
    return result


# --- report ----------------------------------------------------------------

ID_IN_BRANCH = re.compile(r"[A-Z][A-Z0-9]*-\d+")


def current_branch() -> str | None:
    """The name of the current branch, or None when git names none."""
    try:
        proc = subprocess.run(
            ["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
            capture_output=True, text=True, check=False,
        )
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.strip() or None


def detect_story_id(explicit: str | None) -> str:
    """`--story-id`, then STORY_ID, then the ID in the branch name, then `adhoc` (DEC-27)."""
    story_id = explicit or os.environ.get("STORY_ID")
    if not story_id:
        branch = current_branch() or ""
        found = ID_IN_BRANCH.findall(branch.rsplit("/", 1)[-1])
        story_id = found[-1] if found else "adhoc"
    return story_id.replace("/", "-")


def write_report(report_dir: Path, story_id: str, rows: list[dict]) -> Path:
    """Write the report and replace an earlier report of the same name (BR-133)."""
    report_dir.mkdir(parents=True, exist_ok=True)
    path = report_dir / f"{story_id}.json"
    partial = path.with_name(path.name + ".partial")
    partial.write_text(json.dumps(rows, indent=2) + "\n", encoding="utf-8")
    os.replace(partial, path)
    return path


def _describe(row: dict) -> str:
    if "parse_error" in row:
        return f"FAIL {row['file']}: parse error: {row['parse_error']}"
    return f"{row['pass_fail'].upper()} {row['file']} {row['function']} {row['crap_score']:.2f}"


# --- main ------------------------------------------------------------------


def measure_all(settings: Settings, root: Path) -> list[dict]:
    """Run every measure in list order within one time limit; return the kept rows."""
    clock = Clock(settings.timeout_minutes)
    kept: list[dict] = []
    for measure in settings.measures:
        rows = kept_rows(measure, run_measure(measure, root, clock))
        for row in rows:
            _check_row(measure, row)
        kept.extend(rows)
    return kept


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    problem = call_error(args)
    if problem:
        print(f"crap-score: {problem}", file=sys.stderr)
        return 2
    root = Path.cwd()
    try:
        settings = read_settings(root)
        changes = changed_lines(root, args.base) if args.base is not None else None
        rows = measure_all(settings, root)
    except GateError as exc:
        print(f"crap-score: cannot measure: {exc}", file=sys.stderr)
        return 2
    results = [report_row(row, settings.threshold) for row in judged_rows(rows, changes)]
    report_dir = Path(args.report_dir) if args.report_dir else root / DEFAULT_REPORT_DIR
    path = write_report(report_dir, detect_story_id(args.story_id), results)
    for row in results:
        print(_describe(row))
    failed = sum(row["pass_fail"] == "fail" for row in results)
    print(
        f"crap-score: judged {len(results)} functions, {failed} above the threshold "
        f"{settings.threshold}; wrote {path}",
        file=sys.stderr,
    )
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
