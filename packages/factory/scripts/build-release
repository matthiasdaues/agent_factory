#!/usr/bin/env python3
"""build-release -- produce reproducible release assets from a versioned
Agent Factory source tree.

Reads the version from packages/factory/VERSION at HEAD.  Validates the version
format against the current Git branch:

  - main:  N.N.N  (no suffix)
  - dev:   N.N.N-rc

Produces three files in --output <dir> (default ./release/):

  install-agent-factory   -- copy of packages/factory/scripts/ at HEAD
  agent-factory.tar.gz    -- deterministic archive of packages/factory/ at HEAD
  SHA256SUMS              -- sha256 digest of agent-factory.tar.gz

The assets come from the committed tree at HEAD, read through git.
Untracked files and uncommitted changes stay out of the release.

Deterministic tar: sorted entries, fixed timestamps (1970-01-01 00:00:00),
fixed owner (root:root, uid/gid 0), modes 0755 for directories and
executables and 0644 for other files.

On failure: exits non-zero, prints the reason, and removes only the files
and directories this run created.  Files already in the output directory
stay.

Stdlib-only Python 3.8+.  No virtualenv or external dependencies.
"""

from __future__ import annotations

import argparse
import gzip
import hashlib
import io
import os
import re
import subprocess
import sys
import tarfile
from pathlib import Path


# ---------------------------------------------------------------------------
# Version validation
# ---------------------------------------------------------------------------

_VERSION_RE = re.compile(r"^\d+\.\d+\.\d+$")
_VERSION_RC_RE = re.compile(r"^\d+\.\d+\.\d+-rc$")


def read_version(files: dict[str, tuple[str, bytes]]) -> str:
    """Return the stripped VERSION content from the committed files.

    *files* is the mapping committed_factory_files returns, so the version
    comes from the same tree as the archive.
    """
    if _VERSION_PATH not in files:
        raise BuildError(f"{_VERSION_PATH} not found at HEAD")
    return files[_VERSION_PATH][1].decode().strip()


def current_branch(repo_root: Path) -> str:
    """Return the current Git branch name."""
    result = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=str(repo_root),
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise SystemExit("build-release: not a git repository")
    return result.stdout.strip()


def validate_version_branch(version: str, branch: str) -> bool:
    """Return True when version format matches branch policy."""
    if branch == "main":
        return bool(_VERSION_RE.match(version))
    if _VERSION_RC_RE.match(version):
        return True
    return False


# ---------------------------------------------------------------------------
# Archive building
# ---------------------------------------------------------------------------

_FACTORY_PREFIX = "packages/factory/"
_INSTALL_PATH = _FACTORY_PREFIX + "scripts/install-agent-factory"
_VERSION_PATH = _FACTORY_PREFIX + "VERSION"


class BuildError(Exception):
    """A build failure with a message for the user."""


def _git(repo_root: Path, *args: str) -> bytes:
    result = subprocess.run(
        ["git", *args], cwd=str(repo_root), capture_output=True,
    )
    if result.returncode != 0:
        raise BuildError(
            f"git {' '.join(args)} failed: "
            f"{result.stderr.decode(errors='replace').strip()}"
        )
    return result.stdout


def committed_factory_files(repo_root: Path) -> dict[str, tuple[str, bytes]]:
    """Return {path: (git mode, content)} for packages/factory/ at HEAD.

    Paths are relative to the repository root.  Submodule entries are
    skipped.
    """
    listing = _git(repo_root, "ls-tree", "-r", "-z", "HEAD", "--",
                   _FACTORY_PREFIX)
    entries: list[tuple[str, str, str]] = []
    for record in listing.split(b"\0"):
        if not record:
            continue
        meta, path = record.split(b"\t", 1)
        mode, kind, sha = meta.decode().split()
        if kind != "blob":
            continue
        entries.append((path.decode("utf-8", errors="surrogateescape"),
                        mode, sha))

    files: dict[str, tuple[str, bytes]] = {}
    for path, mode, sha in entries:
        files[path] = (mode, _git(repo_root, "cat-file", "blob", sha))
    return files


def _tarinfo(name: str) -> tarfile.TarInfo:
    info = tarfile.TarInfo(name)
    info.mtime = 0
    info.uid = 0
    info.gid = 0
    info.uname = "root"
    info.gname = "root"
    return info


def build_tarball(files: dict[str, tuple[str, bytes]]) -> bytes:
    """Build a deterministic tar.gz archive of packages/factory/ in memory.

    *files* maps repository paths to (git mode, content), as returned by
    committed_factory_files.  Returns the raw bytes of the gzipped tarball.
    """
    members: dict[str, tuple[str, bytes] | None] = {}
    for path, blob in files.items():
        rel = path[len(_FACTORY_PREFIX):]
        members[rel] = blob
        parent = Path(rel).parent
        while str(parent) != ".":
            members.setdefault(str(parent), None)
            parent = parent.parent

    # Build an uncompressed tar first, then gzip with mtime=0 to avoid
    # the gzip header embedding the current time.
    tar_buf = io.BytesIO()
    with tarfile.open(fileobj=tar_buf, mode="w",
                      format=tarfile.GNU_FORMAT) as tf:
        for name in sorted(members):
            blob = members[name]
            info = _tarinfo(name)
            if blob is None:
                info.type = tarfile.DIRTYPE
                info.mode = 0o755
                tf.addfile(info)
                continue
            mode, content = blob
            if mode == "120000":
                info.type = tarfile.SYMTYPE
                info.linkname = content.decode("utf-8")
                info.mode = 0o777
                tf.addfile(info)
                continue
            info.mode = 0o755 if mode == "100755" else 0o644
            info.size = len(content)
            tf.addfile(info, io.BytesIO(content))

    gz_buf = io.BytesIO()
    with gzip.GzipFile(fileobj=gz_buf, mode="wb", mtime=0) as gz:
        gz.write(tar_buf.getvalue())

    return gz_buf.getvalue()


def _create_dirs(path: Path) -> list[Path]:
    """Create *path* and missing parents; return the ones created, deepest
    first."""
    missing: list[Path] = []
    current = path
    while not current.exists():
        missing.append(current)
        current = current.parent
    for directory in reversed(missing):
        directory.mkdir()
    return missing


def write_assets(output_dir: Path, assets: dict[str, tuple[bytes, int]]) -> None:
    """Write *assets* ({name: (content, mode)}) into *output_dir*.

    Writes every asset to a temp file first and renames them into place
    only when all temp files exist and no target is a directory.  On
    failure removes the temp files and the directories this call created,
    then re-raises.  Files already in *output_dir* stay.
    """
    created_dirs: list[Path] = []
    temp_files: list[Path] = []
    try:
        created_dirs = _create_dirs(output_dir)
        staged: list[tuple[Path, Path]] = []
        for name, (content, mode) in assets.items():
            tmp = output_dir / f".{name}.build-release-tmp"
            temp_files.append(tmp)
            tmp.write_bytes(content)
            os.chmod(tmp, mode)
            staged.append((tmp, output_dir / name))
        for _, target in staged:
            if target.is_dir() and not target.is_symlink():
                raise IsADirectoryError(f"{target} is a directory")
        for tmp, target in staged:
            os.replace(tmp, target)
            temp_files.remove(tmp)
    except BaseException:
        for path in temp_files:
            try:
                path.unlink()
            except OSError:
                pass
        for directory in created_dirs:
            try:
                directory.rmdir()
            except OSError:
                pass
        raise


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Build reproducible release assets")
    parser.add_argument("--output", default="./release/",
                        help="Output directory (default: ./release/)")
    args = parser.parse_args(argv)

    repo_root = Path.cwd()
    output_dir = Path(args.output)

    branch = current_branch(repo_root)

    try:
        files = committed_factory_files(repo_root)
        version = read_version(files)
        if not validate_version_branch(version, branch):
            expected = "N.N.N" if branch == "main" else "N.N.N-rc"
            raise BuildError(f"version {version!r} does not fit branch "
                             f"{branch!r}; expected {expected}")
        if _INSTALL_PATH not in files:
            raise BuildError(f"{_INSTALL_PATH} not found at HEAD")
        install_mode, install_bytes = files[_INSTALL_PATH]
        if install_mode not in ("100644", "100755"):
            raise BuildError(f"{_INSTALL_PATH} is not a regular file at HEAD")
        tarball_bytes = build_tarball(files)
        digest = hashlib.sha256(tarball_bytes).hexdigest()
        write_assets(output_dir, {
            "install-agent-factory": (install_bytes, 0o755),
            "agent-factory.tar.gz": (tarball_bytes, 0o644),
            "SHA256SUMS": (f"{digest}  agent-factory.tar.gz\n".encode(), 0o644),
        })
    except (BuildError, OSError) as exc:
        print(f"build-release: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
