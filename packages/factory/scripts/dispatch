def _git(*args: str) -> tuple[int, str, str]:
    """Run a git command, returning (exit_code, stdout, stderr)."""
    r = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def _worktree_for_branch(branch: str) -> str | None:
    """Return the path of the worktree that has *branch* checked out, if any."""
    code, out, _ = _git("worktree", "list", "--porcelain")
    if code != 0:
        return None
    path = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line == f"branch refs/heads/{branch}":
            return path
    return None


def _project_root() -> Path:
    """Resolve the project root from git."""
    code, out, _ = _git("rev-parse", "--show-toplevel")
    if code != 0:
        return Path(".")
    return Path(out)


def _main_worktree_root() -> Path:
    """Resolve the main worktree root, even when called from a linked worktree.

    git-common-dir points to the shared .git directory.  For the main
    worktree that is ``.git``; for a linked worktree it is
    ``<main-root>/.git/worktrees/<name>``.  Either way, the main root is
    the parent of the resolved ``.git`` directory.
    """
    code, common_dir, _ = _git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if code != 0:
        return _project_root()
    common = Path(common_dir)
    # For the main worktree common_dir is "<root>/.git".
    # For a linked worktree it is "<root>/.git/worktrees/<name>".
    # Walk up to the parent of ".git" in either case.
    parts = common.parts
    try:
        git_idx = parts.index(".git")
    except ValueError:
        return _project_root()
    return Path(*parts[: git_idx])


class LedgerChoiceError(Exception):
    """Several ledgers exist and none fits the current branch."""


def _ledger_holds_story(path: Path, story_id: str) -> bool:
    """Return True when the ledger at *path* lists *story_id* under stories."""
    try:
        data = _load_yaml(path.read_text())
    except Exception:  # noqa: BLE001 - an unreadable ledger holds nothing
        return False
    stories = data.get("stories") if isinstance(data, dict) else None
    if isinstance(stories, dict):
        return story_id in stories
    if isinstance(stories, list):
        return any(isinstance(s, dict) and s.get("id") == story_id for s in stories)
    return False


def _default_ledger() -> str:
    """Derive the ledger path from the active dispatch under .current-work/.

    One ledger under the main worktree's .current-work/ is the default.
    With several, the ledger under ``.current-work/<current branch>/`` wins.
    On a ``story/<id>`` branch, the one ledger whose stories hold that story
    wins. When no ledger fits, raise LedgerChoiceError, which names the
    ledgers found. With none at all, return a path that produces a clear
    'ledger not found' error.
    """
    cw = _main_worktree_root() / ".current-work"
    ledgers = sorted(cw.glob("**/dispatch-ledger.yaml")) if cw.is_dir() else []
    if len(ledgers) == 1:
        return str(ledgers[0])
    if not ledgers:
        return ".current-work/dispatch-ledger.yaml"
    branch = _current_branch_name()
    if branch:
        own = cw / branch / "dispatch-ledger.yaml"
        if own in ledgers:
            return str(own)
        story = re.fullmatch(r"story/(.+)", branch)
        if story:
            holders = [p for p in ledgers if _ledger_holds_story(p, story.group(1))]
            if len(holders) == 1:
                return str(holders[0])
    found = "\n".join(f"  {p}" for p in ledgers)
    raise LedgerChoiceError(
        "several dispatch ledgers exist and none fits branch "
        f"{branch or '(detached HEAD)'}:\n{found}\npass --ledger <path>"
    )


_TEST_COMMAND_KEYS = ("test_command", "test_all")


def _testing_yaml_command(path: Path) -> str | None:
    """Return the top-level test_command, or else test_all, of testing.yaml.

    Only a non-empty string counts, so `test_command: null` falls through.
    When the loader cannot read the whole file, the two keys are read on
    their own, and a warning names the file and the parse error.
    """
    try:
        text = path.read_text()
    except OSError:
        return None
    try:
        data = _load_yaml(text)
    except Exception as e:  # noqa: BLE001 - fall back to the two top-level keys
        print(
            f"warning: cannot parse {path} ({e}); reading only its "
            f"top-level {' and '.join(_TEST_COMMAND_KEYS)} lines",
            file=sys.stderr,
        )
        data = _top_level_entries(text, _TEST_COMMAND_KEYS)
    for key in _TEST_COMMAND_KEYS:
        value = data.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def _top_level_entries(text: str, keys: tuple[str, ...]) -> dict:
    """Read each of *keys* from its top-level line and indented lines below.

    An entry that does not parse on its own is left out.
    """
    lines = text.splitlines()
    entries: dict = {}
    for index, line in enumerate(lines):
        key = line.partition(":")[0]
        if key not in keys or key in entries:
            continue
        end = index + 1
        while end < len(lines) and (
            not lines[end].strip() or lines[end].startswith((" ", "\t"))
        ):
            end += 1
        try:
            entries.update(_load_yaml("\n".join(lines[index:end])))
        except Exception:  # noqa: BLE001, S112 - an unreadable entry counts as absent
            continue
    return entries


def _read_test_command(project_root: Path) -> str | None:
    """Read the project's test command from docs/testing.yaml (BR-112).

    In a linked worktree, a file missing from the checkout is read from the
    main tree.
    """
    roots = [project_root]
    code, common_dir, _ = _git("rev-parse", "--git-common-dir")
    if code == 0 and common_dir:
        main_root = Path(common_dir).resolve().parent
        if main_root != project_root:
            roots.append(main_root)
    for root in roots:
        command = _testing_yaml_command(root / "docs" / "testing.yaml")
        if command:
            return command
    return None


def _checkout_roots(project_root: Path) -> list[Path]:
    """Return *project_root*, and the main tree when it is a linked worktree."""
    roots = [project_root]
    code, common_dir, _ = _git("rev-parse", "--git-common-dir")
    if code == 0 and common_dir:
        main_root = Path(common_dir).resolve().parent
        if main_root != project_root:
            roots.append(main_root)
    return roots


def _read_attempt_limits(project_root: Path) -> AttemptLimits:
    """Read `gates.attempts` and `gates.attempts_escalated` (BR-114).

    In a linked worktree, a file missing from the checkout is read from the
    main tree. Without the file or the keys, both counts are 3. A value
    that is no whole number raises ValueError.
    """
    for root in _checkout_roots(project_root):
        path = root / "docs" / "testing.yaml"
        if not path.is_file():
            continue
        try:
            data = _load_yaml(path.read_text())
        except Exception as e:  # name the file in the refusal
            raise ValueError(f"cannot parse {path}: {e}") from e
        return attempt_limits(data.get("gates") if isinstance(data, dict) else None)
    return AttemptLimits()


def _read_refuse_dirty_feature_worktree(project_root: Path) -> bool:
    """Read `dispatch.refuse_dirty_feature_worktree` from docs/testing.yaml (BR-124).

    In a linked worktree, a file missing from the checkout is read from the
    main tree. A missing file, section or key means True. A value that is
    no bool raises ValueError.
    """
    for root in _checkout_roots(project_root):
        path = root / "docs" / "testing.yaml"
        if not path.is_file():
            continue
        try:
            data = _load_yaml(path.read_text())
        except Exception as e:  # name the file in the refusal
            raise ValueError(f"cannot parse {path}: {e}") from e
        section = data.get("dispatch") if isinstance(data, dict) else None
        if not isinstance(section, dict) or "refuse_dirty_feature_worktree" not in section:
            return True
        value = section["refuse_dirty_feature_worktree"]
        if not isinstance(value, bool):
            raise ValueError(
                f"{path}: dispatch.refuse_dirty_feature_worktree must be true "
                f"or false, not {value!r}"
            )
        return value
    return True


def _testing_yaml_path(project_root: Path) -> Path:
    """The docs/testing.yaml that dispatch reads: the one of the checkout,
    else the one of the main tree, else the path in the checkout (IMPL-0039)."""
    for root in _checkout_roots(project_root):
        path = root / "docs" / "testing.yaml"
        if path.is_file():
            return path
    return project_root / "docs" / "testing.yaml"


def _refuse_dirty_feature_worktree(project_root: Path, entry: StoryEntry) -> bool:
    """Refuse a new merge when the feature worktree holds a tracked change (BR-124).

    Only an orchestrated run calls this, after premerge-check exited 0.
    Return True when merge-story must stop; the message names the files
    and the worktree.
    """
    try:
        refuse = _read_refuse_dirty_feature_worktree(project_root)
    except ValueError as e:
        print(f"error: {e}", file=sys.stderr)
        return True
    if not refuse:
        return False
    code, changed, err = _git(
        "-C", str(project_root), "status", "--porcelain", "--untracked-files=no"
    )
    if code != 0:
        print(
            f"error: git status failed in the worktree of the feature branch "
            f"{project_root}, so merge-story cannot tell whether it is clean; "
            f"{entry.id} stays dispatched: {err}",
            file=sys.stderr,
        )
        return True
    if not changed:
        return False
    print(
        f"error: the worktree of the feature branch {project_root} holds "
        f"uncommitted changes to tracked files; {entry.id} stays dispatched "
        f"and nothing was merged. Commit or revert them, or set "
        f"dispatch.refuse_dirty_feature_worktree: false in "
        f"{_testing_yaml_path(project_root)}:",
        file=sys.stderr,
    )
    # _git strips the output, so the status letters of the first line may
    # have lost their leading blank; split off the letters instead.
    for line in changed.splitlines():
        print(f"  {line.split(maxsplit=1)[1]}", file=sys.stderr)
    return True


def _attempt_limits_or_error(project_root: Path) -> AttemptLimits | None:
    """Return the attempt limits, or print the error and return None."""
    try:
        return _read_attempt_limits(project_root)
    except ValueError as e:
        print(f"error: {e}", file=sys.stderr)
        return None


def _story_frontmatter(project_root: Path, story_id: str) -> dict | None:
    """Return the parsed frontmatter for one backlog story, if available.

    A finding ID has no backlog file, so dispatch reads none (BR-117)."""
    if not is_story_id(story_id):
        return None
    story_path = project_root / "backlog" / f"{story_id}.md"
    if not story_path.exists():
        return None
    return parse_story_frontmatter(story_path.read_text())


def _story_deps(project_root: Path, story_id: str) -> list[str]:
    """Return the backlog-declared dependencies for *story_id* (BUG-0082)."""
    frontmatter = _story_frontmatter(project_root, story_id)
    deps = frontmatter.get("deps") if frontmatter else None
    if isinstance(deps, str):
        deps = [deps]
    if not isinstance(deps, list):
        return []
    return [str(dep).strip() for dep in deps if str(dep).strip()]


def _story_declared_tier(project_root: Path, story_id: str) -> str | None:
    """Return the backlog-declared tier for *story_id*, if any."""
    frontmatter = _story_frontmatter(project_root, story_id)
    if not frontmatter:
        return None
    tier = frontmatter.get("tier")
    return tier if isinstance(tier, str) else None


def _story_output_globs(project_root: Path, story_id: str) -> list[str]:
    """Return the backlog-declared output globs for *story_id*.

    Falls back to ``touches`` when ``outputs`` is absent, consistent
    with how wave planning resolves scope.
    """
    frontmatter = _story_frontmatter(project_root, story_id)
    if not frontmatter:
        return []
    outputs = frontmatter.get("outputs") or frontmatter.get("touches") or []
    if isinstance(outputs, str):
        return [outputs]
    return outputs if isinstance(outputs, list) else []


DEFAULT_MAX_FILES = 20


def _unit_file(project_root: Path, unit_id: str) -> tuple[Path, str]:
    """The file whose status merge-story sets, and the status it writes (BR-118).

    A story sets `status: done` in backlog/<id>.md, a finding sets
    `status: resolved` in docs/findings/<id>.md.
    """
    if is_story_id(unit_id):
        return project_root / "backlog" / f"{unit_id}.md", "done"
    return project_root / "docs" / "findings" / f"{unit_id}.md", "resolved"

# The index-lint pre-commit hook rewrites this file during a story commit.
HOOK_REWRITTEN_INDEX = "packages/factory/INDEX.yaml"

def _load_premerge_check():
    """Load premerge-check as a module, so merge-story shares its scope rule."""
    loader = SourceFileLoader("premerge_check", str(SCRIPT_DIR / "premerge-check"))
    spec = importlib.util.spec_from_loader("premerge_check", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _story_owned_scope(target_branch: str, branch: str, story_id: str) -> list[str] | None:
    """The changed review and finding files that belong to *story_id*.

    A file in docs/reviews/ or docs/findings/ belongs to the unit of work
    when its name holds the ID or its `story` field names it, read at the
    merge base for a file that exists there (IMPL-0027). Prints the git
    error and returns None when git cannot read a file.
    """
    # --no-renames keeps the old name of a renamed file in the list (IMPL-0057).
    code, out, err = _git(
        "diff", "--name-only", "--no-renames", f"{target_branch}...{branch}"
    )
    if code != 0:
        print(f"error: cannot list the changed files of {branch}: {err}", file=sys.stderr)
        return None
    premerge = _load_premerge_check()
    files = [line for line in out.splitlines() if line]
    try:
        return premerge.story_owned_files(target_branch, branch, story_id, files)
    except premerge.GitReadError as exc:
        print(f"error: cannot read the scope of {story_id} at {branch}: {exc}",
              file=sys.stderr)
        return None


@dataclass(frozen=True)
class _UnitScope:
    """The scope of a unit of work as merge-story passes it to premerge-check.

    *entries* are (flag, path) pairs, with the flag `--scope` or
    `--scope-glob`. A finding declares no file scope, so its list is empty
    and only *max_files* limits its diff (RL-G20). *owned* are the unit's
    own review and finding files, which do not count toward the limit.
    """

    entries: tuple[tuple[str, str], ...]
    max_files: int
    owned: tuple[str, ...]

    def arguments(self) -> list[str]:
        args: list[str] = []
        for flag, path in self.entries:
            args += [flag, path]
        return args + ["--max-files", str(self.max_files)]


def _unit_scope(
    project_root: Path, unit_id: str, target_branch: str, branch: str
) -> _UnitScope | None:
    """Build the scope of one unit of work (IMPL-0033).

    merge-story turns it into the arguments of premerge-check, and
    _story_scope_violation matches the diff against it, so both apply one
    rule. For a story the scope is its declared `outputs`, else its
    `touches`, plus its backlog file, its spec-feedback report, the
    INDEX.yaml that a hook rewrites, and its own review and finding files.
    An entry with `*` or `?` is a glob, any other entry a path prefix.
    Returns None when git cannot read the scope.
    """
    owned = _story_owned_scope(target_branch, branch, unit_id)
    if owned is None:
        return None
    if not is_story_id(unit_id):
        return _UnitScope((), DEFAULT_MAX_FILES, tuple(owned))
    outputs = _story_output_globs(project_root, unit_id)
    # glob_match has no bracket classes, so ``[`` stays literal.
    entries = [
        ("--scope-glob" if any(c in path for c in "*?") else "--scope", path)
        for path in outputs
    ]
    entries += [
        ("--scope-glob", f"backlog/{unit_id}.md"),
        # The story's own drift report is part of its work (ADR-0029).
        ("--scope-glob", spec_feedback_path(unit_id)),
        ("--scope-glob", HOOK_REWRITTEN_INDEX),
    ]
    entries += [("--scope", path) for path in owned]
    return _UnitScope(tuple(entries), _scaled_max_files(len(outputs)), tuple(owned))


def _scaled_max_files(output_count: int) -> int:
    """Recommend a per-story ``--max-files`` threshold from an output count.

    Scales with the story's declared output count so a multi-file story
    doesn't trip premerge-check's file-count-blowout gate, while never
    dropping below the gate's own default of 20 (preserved when a story
    declares no outputs, i.e. no scaling information is available).
    """
    return max(DEFAULT_MAX_FILES, output_count * 2)


def _attempt_session_for_story(
    frontmatter: dict | None,
    failure_class: str | None,
    active_session: str | None = None,
) -> str:
    """Infer the attempt session type from story metadata and failure class."""
    if active_session in {"seam", "impl"}:
        return active_session
    if failure_class == "seam_defect":
        return "seam"
    if frontmatter and frontmatter.get("strategy") == "seams-first":
        return "impl"
    return "impl"


def _story_scope_violation(project_root: Path, entry: StoryEntry) -> bool:
    """Return True when the diff of the branch fails the scope or the file
    limit that merge-story checks (BR-115).

    The diff runs from the feature branch to the branch of the unit, as in
    merge-story, so a fix that the User commits on the branch counts. The
    scope comes from _unit_scope, and the match uses the checks of
    premerge-check, so escalate and merge-story agree. A finding declares
    no file scope, so only the file limit applies to it.
    """
    target = entry.feature_branch or entry.base_sha
    if not entry.branch or not target:
        return True
    code, out, _ = _git(
        "diff", "--name-only", "--no-renames", f"{target}...{entry.branch}"
    )
    changed = [line for line in out.splitlines() if line]
    if code != 0 or not changed:
        return True
    scope = _unit_scope(project_root, entry.id, target, entry.branch)
    if scope is None:
        return True
    premerge = _load_premerge_check()
    scopes = [path for flag, path in scope.entries if flag == "--scope"]
    globs = [path for flag, path in scope.entries if flag == "--scope-glob"]
    in_scope, _ = premerge.check_out_of_scope(changed, scopes, globs)
    in_limit, _ = premerge.check_blowout(changed, scope.max_files, list(scope.owned))
    return not (in_scope and in_limit)


def cmd_status(args: argparse.Namespace) -> int:
    ledger_path = Path(args.ledger)
    try:
        ledger = Ledger.load(ledger_path)
    except FileNotFoundError:
        print(f"error: ledger not found: {ledger_path}", file=sys.stderr)
        return 1
    except Exception as e:  # noqa: BLE001 - normalize parser failures for CLI output
        print(f"error: malformed ledger: {e}", file=sys.stderr)
        return 1
    print(ledger.format_status_table())
    return 0


@dataclass
class TierMismatchReport:
    """Blocking and non-blocking tier-mismatch findings for a set of stories."""

    blocking: list[str] = field(default_factory=list)
    warnings: list[str] = field(default_factory=list)


def _check_tier_mismatches(
    project_root: Path, story_ids: list[str]
) -> TierMismatchReport:
    """Compare each story's declared tier against the rubric-suggested tier.

    Stories are looked up under ``<project_root>/backlog/<story_id>.md``. A
    story whose backlog file cannot be found or parsed is skipped silently —
    there is no frontmatter to evaluate the rubric against.
    """
    report = TierMismatchReport()
    project_config = load_project_config(project_root)
    backlog_dir = project_root / "backlog"

    for sid in story_ids:
        story_path = backlog_dir / f"{sid}.md"
        if not story_path.exists():
            continue
        fm = parse_story_frontmatter(story_path.read_text())
        if fm is None:
            continue

        declared_tier = fm.get("tier") or "economy"
        suggested = suggest_tier(fm, project_config)
        if suggested == declared_tier:
            continue

        if (
            suggested == "strong"
            and TIER_RANK.get(declared_tier, 0) < TIER_RANK["strong"]
        ):
            report.blocking.append(
                f"{sid}: rubric suggests 'strong' but declared tier is '{declared_tier}'"
            )
        else:
            report.warnings.append(
                f"{sid}: rubric suggests '{suggested}' but declared tier is '{declared_tier}'"
            )

    return report


def _story_meta_for_manifest(project_root: Path, story_id: str) -> dict:
    """Read backlog frontmatter for *story_id* to seed a step manifest.

    Returns a dict with ``deps``, ``traces``, ``outputs``, and optional
    ``max_input_tokens``. Missing or unparsable backlog files yield an empty
    dict — the manifest is still written, just with empty declarations.
    """
    fm = _story_frontmatter(project_root, story_id)
    if fm is None:
        return {}
    raw_traces = fm.get("traces")
    traces = (
        raw_traces
        if isinstance(raw_traces, list)
        else ([raw_traces] if raw_traces else [])
    )
    raw_max_tokens = fm.get("max_input_tokens")
    meta: dict = {
        "inputs": fm.get("inputs") or [],
        "deps": fm.get("deps") or [],
        "traces": traces,
        "outputs": fm.get("outputs") or [],
        "touches": fm.get("touches") or fm.get("outputs") or [],
        "strategy": fm.get("strategy") or "direct",
        "seam_outputs": fm.get("seam_outputs") or [],
        "impl_outputs": fm.get("impl_outputs") or [],
    }
    if raw_max_tokens:
        meta["max_input_tokens"] = int(raw_max_tokens)
    return meta


def _story_handoff_contract(
    project_root: Path,
    entry: StoryEntry,
    feature_branch: str,
    worktree_path: Path,
    *,
    session: str = "impl",
) -> tuple[object | None, str | None]:
    """Render and persist the story's seven-part handoff contract."""
    story_path, _ = _unit_file(project_root, entry.id)
    story_fm = _story_frontmatter(project_root, entry.id) or {}
    story_title = (story_fm or {}).get("title") or entry.id
    touches = list((story_fm or {}).get("touches") or [])
    strategy = (story_fm or {}).get("strategy")
    if strategy == "seams-first":
        if session == "seam":
            touches = list((story_fm or {}).get("seam_outputs") or [])
        else:
            touches = list((story_fm or {}).get("impl_outputs") or [])
    test_command = _read_test_command(project_root)
    if not test_command:
        return None, (
            "error: no test command found; add test_command to docs/testing.yaml"
        )

    try:
        contract = render_handoff_contract(
            story_id=entry.id,
            story_title=story_title,
            acceptance_criteria_path=story_path.relative_to(project_root)
            if story_path.is_relative_to(project_root)
            else story_path,
            worktree_path=worktree_path,
            story_branch=entry.branch or f"story/{entry.id}",
            touches=touches,
            test_command=test_command,
        )
    except ValueError as e:
        return None, str(e)

    return contract, None


def _write_story_manifest(
    project_root: Path,
    entry: StoryEntry,
    feature_branch: str,
    worktree_path: Path,
    *,
    session: str = "impl",
) -> tuple[int, str | None]:
    """Write the step manifest for *entry*, recording feature_branch on it.

    Returns (0, None) on success, (1, error_message) on no-supersede failure.
    """
    contract, contract_err = _story_handoff_contract(
        project_root, entry, feature_branch, worktree_path, session=session
    )
    if contract_err is not None:
        return 1, contract_err

    story_meta = _story_meta_for_manifest(project_root, entry.id)
    try:
        write_manifest(
            worktree_path,
            feature_branch,
            entry.branch,
            story_meta,
            session=session,
        )
    except ManifestExistsError as e:
        return 1, str(e)

    if contract is not None:
        write_handoff_contract(
            worktree_path,
            feature_branch,
            entry.branch or f"story/{entry.id}",
            contract.text,
        )
    entry.feature_branch = feature_branch
    return 0, None


def _story_declared_or_current_tier(project_root: Path, entry: StoryEntry) -> str:
    """Return the story's current declared/elevated tier."""
    return entry.tier or _story_declared_tier(project_root, entry.id) or "economy"


def _prepare_seams_first_session(
    project_root: Path,
    entry: StoryEntry,
    feature_branch: str,
    worktree_path: Path,
    *,
    session: str,
) -> tuple[int, str | None]:
    """Write the manifest and record the active seams-first session metadata."""
    manifest_code, manifest_err = _write_story_manifest(
        project_root,
        entry,
        feature_branch,
        worktree_path,
        session=session,
    )
    if manifest_code != 0:
        return manifest_code, manifest_err

    declared_tier = _story_declared_or_current_tier(project_root, entry)
    entry.active_session = session
    entry.active_tier = (
        declared_tier
        if session == "seam"
        else implementation_session_tier(declared_tier)
    )
    return 0, None


def cmd_init(args: argparse.Namespace) -> int:
    """Start a run: create the feature branch, and write the ledger.

    An orchestrated run gets a worktree for its feature branch. A run by hand
    gets the branch only, because it works in the primary checkout (BR-112).
    """
    feature_branch = getattr(args, "feature_branch", None)
    baseline_commit = getattr(args, "baseline_commit", False)
    mode = getattr(args, "mode", None) or "orchestrated"

    if feature_branch and baseline_commit:
        print(
            "error: --baseline-commit and --feature-branch are mutually exclusive",
            file=sys.stderr,
        )
        return 1

    project_root = _project_root()
    story_ids = [s.strip() for s in args.stories.split(",")]
    branch_name = feature_branch or _impl_branch_name(story_ids)
    ledger_dir = project_root / ".current-work" / branch_name
    ledger_path = ledger_dir / "dispatch-ledger.yaml"

    if ledger_path.exists():
        try:
            existing = Ledger.load(ledger_path)
            if set(existing.stories.keys()) == set(story_ids):
                print(
                    f"dispatch init: ledger already exists for '{branch_name}' (no-op)"
                )
                return 0
        except Exception:  # noqa: BLE001, S110 - malformed ledger handled below
            pass
        print(
            f"error: the ledger of '{branch_name}' lists other stories: {ledger_path}",
            file=sys.stderr,
        )
        return 1

    if mode == "by-hand":
        other = _active_run_by_hand()
        if other is not None:
            other_branch, other_path = other
            print(
                f"error: a run by hand is active on '{other_branch}' "
                f"({other_path}); both need the primary checkout",
                file=sys.stderr,
            )
            return 1

    test_cmd = _read_test_command(project_root)
    if not test_cmd:
        print(
            "error: no test command found; add test_command to docs/testing.yaml",
            file=sys.stderr,
        )
        return 1

    open_deps = _open_outside_deps(project_root, story_ids)
    if open_deps:
        for sid, dep in open_deps:
            print(
                f"error: {sid} depends on {dep}, which is outside the run "
                "and not done in the backlog",
                file=sys.stderr,
            )
        return 1

    tier_check = _check_tier_mismatches(project_root, story_ids)
    if tier_check.blocking:
        for msg in tier_check.blocking:
            print(f"error: {msg}", file=sys.stderr)
        return 1
    for msg in tier_check.warnings:
        print(f"warning: {msg}", file=sys.stderr)

    base = args.base

    # Verify base exists
    code, base_sha, _ = _git("rev-parse", f"refs/heads/{base}")
    if code != 0:
        code, base_sha, _ = _git("rev-parse", base)
        if code != 0:
            print(f"error: base branch '{base}' does not exist", file=sys.stderr)
            return 1

    if feature_branch:
        code, fb_sha, _ = _git("rev-parse", f"refs/heads/{feature_branch}")
        if code != 0:
            wt_path = (
                _main_worktree_root() / ".current-work" / feature_branch / "invocation"
            )
            code, err = _create_run_branch(mode, feature_branch, wt_path, base_sha)
            if code != 0:
                print(
                    f"error: failed to create feature branch "
                    f"'{feature_branch}' from '{base}': {err}",
                    file=sys.stderr,
                )
                return 1
            code, fb_sha, _ = _git("rev-parse", f"refs/heads/{feature_branch}")
            if code != 0:
                print(
                    f"error: branch '{feature_branch}' not found after creation",
                    file=sys.stderr,
                )
                return 1
        code, _, _ = _git("merge-base", "--is-ancestor", base_sha, fb_sha)
        if code != 0:
            print(
                f"error: branch '{feature_branch}' is not reachable from '{base}'",
                file=sys.stderr,
            )
            return 1
    else:
        code, untracked, _ = _git("ls-files", "--others", "--exclude-standard")
        if untracked and not baseline_commit:
            print(
                "error: untracked files in working tree; use --baseline-commit or "
                "clean them first",
                file=sys.stderr,
            )
            return 1
        if baseline_commit and untracked:
            _git("add", "-A")
            _git(
                "commit",
                "--no-verify",
                "-m",
                "chore: baseline commit before dispatch init",
            )
            code, base_sha, _ = _git("rev-parse", "HEAD")

        worktree_path = project_root / ".current-work" / branch_name
        code, err = _create_run_branch(mode, branch_name, worktree_path, base_sha)
        if code != 0:
            print(f"error: failed to create branch: {err}", file=sys.stderr)
            return 1

    # The branch root is the tip of the feature branch at init (BR-112).
    code, root_sha, _ = _git("rev-parse", f"refs/heads/{branch_name}")
    if code != 0:
        root_sha = base_sha

    ledger = Ledger()
    ledger.mode = mode
    ledger.feature_branch = branch_name
    ledger.branch_root = root_sha
    ledger.branch_head = root_sha
    for sid in story_ids:
        ledger.stories[sid] = StoryEntry(
            id=sid,
            tier=_story_declared_tier(project_root, sid),
            deps=_story_deps(project_root, sid),
        )
    ledger_dir.mkdir(parents=True, exist_ok=True)
    ledger.save(ledger_path)

    print(
        f"dispatch init: initialized '{branch_name}' ({mode}) "
        f"with {len(story_ids)} stories"
    )
    print(f"  ledger: {ledger_path}")
    return 0


def _impl_branch_name(story_ids: list[str]) -> str:
    """Name the branch of a run started without --feature-branch."""
    name = f"impl/{'-'.join(story_ids[:3]).lower()}"
    if len(story_ids) > 3:
        name += f"-and-{len(story_ids) - 3}-more"
    return name


def _create_run_branch(
    mode: str, branch: str, worktree_path: Path, base_sha: str
) -> tuple[int, str]:
    """Create *branch* at *base_sha*; only an orchestrated run gets a worktree."""
    if mode == "by-hand":
        code, _, err = _git("branch", branch, base_sha)
    else:
        code, _, err = _git("worktree", "add", "-b", branch, str(worktree_path), base_sha)
    return code, err


def _active_run_by_hand() -> tuple[str, Path] | None:
    """Return the feature branch and ledger path of an active run by hand."""
    # A ledger exists only while its run is active (BR-111).
    current_work = _main_worktree_root() / ".current-work"
    if not current_work.is_dir():
        return None
    for ledger_path in sorted(current_work.glob("**/dispatch-ledger.yaml")):
        try:
            ledger = Ledger.load(ledger_path)
        except Exception:  # noqa: BLE001, S112 - an unreadable ledger names no mode
            continue
        if ledger.mode == "by-hand":
            return ledger.feature_branch or "", ledger_path
    return None


def _open_outside_deps(
    project_root: Path, story_ids: list[str]
) -> list[tuple[str, str]]:
    """Return each (story, dependency) pair whose dependency is outside the run
    and not done in the backlog."""
    open_deps = []
    for sid in story_ids:
        for dep in _story_deps(project_root, sid):
            if dep in story_ids:
                continue
            frontmatter = _story_frontmatter(project_root, dep) or {}
            if frontmatter.get("status") != "done":
                open_deps.append((sid, dep))
    return open_deps


def cmd_plan(args: argparse.Namespace) -> int:
    backlog_dir = Path(args.backlog_dir)
    if not backlog_dir.is_dir():
        print(f"error: backlog directory not found: {backlog_dir}", file=sys.stderr)
        return 1

    stories = load_stories(backlog_dir)
    if not stories:
        print("error: no stories found in backlog directory", file=sys.stderr)
        return 1

    filter_ids = None
    if args.stories:
        filter_ids = [s.strip() for s in args.stories.split(",")]

    project_root = backlog_dir.resolve().parent
    plan = compute_wave_plan(stories, project_root, filter_ids)
    print(plan.to_yaml())

    if getattr(args, "dry_run", False):
        return 0

    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1
    # The backlog is the source of the dependencies; refresh them, so a
    # story edited after init is gated by what it declares now.
    for sid, entry in ledger.stories.items():
        entry.deps = _story_deps(project_root, sid)
    assigned = 0
    for wave_entry in plan.waves:
        wave_num = wave_entry["wave"]
        for story in wave_entry.get("stories", []):
            sid = story["id"]
            if sid in ledger.stories:
                ledger.stories[sid].wave = wave_num
                assigned += 1
    save_code = _save_ledger(ledger, ledger_path)
    if save_code != 0:
        return save_code
    print(f"dispatch plan: applied wave assignments to {assigned} stories in ledger")

    return 0


def cmd_not_implemented(args: argparse.Namespace) -> int:
    print(f"error: '{args.subcommand}' is not yet implemented", file=sys.stderr)
    return 1


def _load_ledger(ledger_path: Path) -> Ledger | None:
    """Load a ledger and report user-facing errors."""
    try:
        return Ledger.load(ledger_path)
    except FileNotFoundError:
        print(f"error: ledger not found: {ledger_path}", file=sys.stderr)
    except Exception as e:  # noqa: BLE001 - normalize parser failures for CLI output
        print(f"error: malformed ledger: {e}", file=sys.stderr)
    return None


def _load_orchestrated_ledger(ledger_path: Path) -> Ledger | None:
    """Load *ledger_path* and require the ledger of an orchestrated run."""
    ledger = _load_ledger(ledger_path)
    if ledger is not None and ledger.mode != "orchestrated":
        print(
            f"error: command requires the ledger of an orchestrated run: {ledger_path}",
            file=sys.stderr,
        )
        return None
    return ledger


def _save_ledger(ledger: Ledger, ledger_path: Path) -> int:
    """Persist a ledger, returning a shell-style status code."""
    try:
        ledger.save(ledger_path)
    except Exception as e:  # noqa: BLE001 - normalize persistence failures for CLI output
        print(f"error: failed to save ledger: {e}", file=sys.stderr)
        return 1
    return 0


def _current_branch_name() -> str | None:
    """Return the current branch name, or None outside a named branch."""
    code, out, _ = _git("rev-parse", "--abbrev-ref", "HEAD")
    if code != 0 or out == "HEAD":
        return None
    return out


def _verify_worktree_registration(worktree_path: Path) -> bool:
    """Return True when git reports *worktree_path* in worktree porcelain output."""
    code, out, _ = _git("worktree", "list", "--porcelain")
    if code != 0:
        return False
    needle = str(worktree_path.resolve())
    return f"worktree {needle}" in out.splitlines()


def _run_verify_base(
    worktree_path: Path, target_branch: str, base_sha: str
) -> tuple[int, str]:
    """Run verify-base inside one prepared story worktree."""
    result = subprocess.run(
        [
            str(SCRIPT_DIR / "verify-base"),
            target_branch,
            "--expect-base",
            base_sha,
        ],
        capture_output=True,
        text=True,
        cwd=worktree_path,
        check=False,
    )
    output = "\n".join(
        part for part in (result.stdout.strip(), result.stderr.strip()) if part
    )
    return result.returncode, output


@dataclass
class _StoryWorkspace:
    """What one _create_story_workspace call created, and its error."""

    created_branch: bool
    created_worktree: bool
    error: str


def _branch_tip(branch_name: str) -> str | None:
    code, tip, _ = _git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch_name}")
    return tip if code == 0 and tip else None


def _create_story_workspace(
    branch_name: str, worktree_path: Path, base_sha: str
) -> _StoryWorkspace:
    """Create a story branch together with its worktree (BUG-0084).

    A leftover branch from a failed run is reused when it holds no work,
    that is, when it still points at *base_sha*. A leftover branch with
    work is refused, so no commit is lost. git can create both and still
    exit 1, for example when a post-checkout hook fails. So the result
    reports what exists afterwards that did not exist before the call.
    """
    tip = _branch_tip(branch_name)
    if tip is not None and tip != base_sha:
        return _StoryWorkspace(False, False, (
            f"branch {branch_name!r} already exists with commits that are not "
            f"on the dispatch base; inspect it, then delete it or resume it"
        ))
    worktree_existed = (
        worktree_path.exists() or _verify_worktree_registration(worktree_path)
    )
    if tip is not None:
        code, _, err = _git("worktree", "add", str(worktree_path), branch_name)
    else:
        code, _, err = _git(
            "worktree", "add", "-b", branch_name, str(worktree_path), base_sha
        )
    created_branch = tip is None and _branch_tip(branch_name) is not None
    created_worktree = not worktree_existed and (
        worktree_path.exists() or _verify_worktree_registration(worktree_path)
    )
    if code != 0 and not err:
        err = "git worktree add failed"
    return _StoryWorkspace(created_branch, created_worktree, err if code != 0 else "")


def _remove_story_workspace(
    branch_name: str, worktree_path: Path, workspace: _StoryWorkspace
) -> None:
    """Undo what one _create_story_workspace call created, and nothing else."""
    if workspace.created_worktree:
        _git("worktree", "remove", "--force", str(worktree_path))
    if workspace.created_branch:
        _git("branch", "-D", branch_name)


def _reuse_story_workspace(
    ledger: Ledger, entry: StoryEntry, target_branch: str
) -> str:
    """Bring the existing branch of a reused entry onto the feature branch.

    `add` keeps the branch and the worktree of a finding that it takes back
    (BR-117). The next attempt runs there: the worktree stays, and the
    feature branch is merged into the branch, as `refresh-story` does, so
    the work of the earlier attempt stays (IMPL-0056). Returns "ok",
    "blocked" after a refresh conflict, or "error".
    """
    registered = _worktree_for_branch(entry.branch) if entry.branch else None
    if (
        not entry.worktree
        or registered is None
        or Path(registered).resolve() != Path(entry.worktree).resolve()
    ):
        print(
            f"error: {entry.id} holds the branch {entry.branch}, but git worktree "
            f"list reports no worktree of it at {entry.worktree}",
            file=sys.stderr,
        )
        return "error"
    if _refresh_story_branch(ledger, entry, target_branch) == 0:
        return "ok"
    return "blocked" if entry.status == StoryState.BLOCKED else "error"


def cmd_prepare_wave(args: argparse.Namespace) -> int:
    """Prepare every eligible story in one wave."""
    ledger_path = Path(args.ledger)
    ledger = _load_orchestrated_ledger(ledger_path)
    if ledger is None:
        return 1

    wave = args.wave
    if not any(entry.wave == wave for entry in ledger.stories.values()):
        print(f"error: no story in the ledger carries wave {wave}", file=sys.stderr)
        return 1
    missing = _missing_wave_record(ledger, wave, f"prepare-wave {wave}")
    if missing:
        print(missing, file=sys.stderr)
        return 1

    target_branch = ledger.feature_branch
    if not target_branch:
        target_branch = _current_branch_name()
    if not target_branch:
        print(
            "error: prepare-wave requires feature_branch in the ledger "
            "or a named current branch",
            file=sys.stderr,
        )
        return 1

    base_sha = ledger.branch_head or ledger.branch_root
    if not base_sha:
        code, base_sha, err = _git("rev-parse", "HEAD")
        if code != 0:
            print(f"error: failed to resolve base SHA: {err}", file=sys.stderr)
            return 1

    main_root = _main_worktree_root()
    project_root = _project_root()
    stories_in_wave = sorted(
        (entry for entry in ledger.stories.values() if entry.wave == wave),
        key=lambda entry: entry.id,
    )
    wave_story_ids = {entry.id for entry in stories_in_wave}
    refused_return = False

    for entry in stories_in_wave:
        # Only a pending story gets a new workspace. A story past that state
        # owns a worktree that may hold an agent's uncommitted work.
        if entry.status != StoryState.PENDING:
            continue

        returned = ledger.returned_refusal(entry.id)
        if returned:
            print(f"error: {returned}; prepare-wave skipped it", file=sys.stderr)
            refused_return = True
            continue

        same_wave_deps = [dep for dep in entry.deps if dep in wave_story_ids]
        if same_wave_deps:
            continue

        unmet = dependency_refusals(ledger, entry)
        if unmet:
            print(
                f"dispatch prepare-wave: skipped {entry.id}: {DEPENDENCY_NOT_DONE}: "
                + "; ".join(unmet)
            )
            continue

        if entry.branch:
            # A reused entry keeps its branch and worktree (IMPL-0056).
            reused = _reuse_story_workspace(ledger, entry, target_branch)
            if reused == "blocked":
                if _save_ledger(ledger, ledger_path) != 0:
                    return 1
                refused_return = True
                continue
            if reused == "error":
                return 1
            branch_name, worktree_path = entry.branch, Path(entry.worktree)
            workspace = _StoryWorkspace(False, False, "")
            remove_manifest(worktree_path, target_branch, branch_name)
        else:
            branch_name = f"story/{entry.id}"
            worktree_path = (
                main_root / ".current-work" / target_branch / branch_name
            )
            workspace = _create_story_workspace(branch_name, worktree_path, base_sha)
            if workspace.error:
                _remove_story_workspace(branch_name, worktree_path, workspace)
                print(
                    f"error: failed to create {branch_name!r} and its worktree "
                    f"for {entry.id}: {workspace.error}",
                    file=sys.stderr,
                )
                return 1

        if not _verify_worktree_registration(worktree_path):
            _remove_story_workspace(branch_name, worktree_path, workspace)
            print(
                f"error: git worktree list did not report {worktree_path} for {entry.id}",
                file=sys.stderr,
            )
            return 1

        verify_code, verify_output = _run_verify_base(
            worktree_path, target_branch, base_sha
        )
        if verify_code != 0:
            _remove_story_workspace(branch_name, worktree_path, workspace)
            if verify_output:
                print(verify_output, file=sys.stderr)
            print(f"error: verify-base failed for {entry.id}", file=sys.stderr)
            return 1

        entry.branch = branch_name
        entry.worktree = str(worktree_path)
        entry.base_sha = base_sha

        story_meta = _story_meta_for_manifest(project_root, entry.id)
        if story_meta.get("strategy") == "seams-first":
            manifest_code, manifest_err = _prepare_seams_first_session(
                project_root,
                entry,
                target_branch,
                worktree_path,
                session="seam",
            )
        else:
            manifest_code, manifest_err = _write_story_manifest(
                project_root, entry, target_branch, worktree_path
            )
            if manifest_code == 0:
                entry.active_session = "impl"
                entry.active_tier = _story_declared_or_current_tier(project_root, entry)
        if manifest_code != 0:
            _remove_story_workspace(branch_name, worktree_path, workspace)
            print(f"error: {manifest_err}", file=sys.stderr)
            return 1

        try:
            ledger.transition(entry.id, StoryState.PREPARED)
        except TransitionError as e:
            _remove_story_workspace(branch_name, worktree_path, workspace)
            print(f"error: {e}", file=sys.stderr)
            return 1
        save_code = _save_ledger(ledger, ledger_path)
        if save_code != 0:
            return save_code

    return 1 if refused_return else 0


def _pending_entry_error(entry: StoryEntry) -> str | None:
    """Name why prepare-story cannot prepare *entry*, or None for a pending
    entry that was not returned (BR-113)."""
    if entry.status == StoryState.PENDING and entry.returned:
        return (
            f"error: dispatch: {entry.id} was returned and waits for the end "
            f"of the run; prepare-story does not start it again"
        )
    if entry.status == StoryState.FAILED:
        return (
            f"error: story {entry.id} failed; prepare-story prepares only a "
            f"pending story. Retry it with `dispatch re-dispatch {entry.id}`"
        )
    if entry.status != StoryState.PENDING:
        return (
            f"error: story {entry.id} is {entry.status.value}; prepare-story "
            f"prepares only a pending story"
        )
    return None


def _print_dependency_refusals(ledger: Ledger, entry: StoryEntry) -> bool:
    """Print each dependency inside the run that is not done; True if any (BR-113)."""
    refusals = dependency_refusals(ledger, entry)
    for refusal in refusals:
        print(f"error: {DEPENDENCY_NOT_DONE}: {refusal}", file=sys.stderr)
    return bool(refusals)


def _wave_by_hand(ledger: Ledger, entry: StoryEntry) -> tuple[int | None, str | None]:
    """Return the wave of *entry* in a run by hand, or the refusal.

    Each story is a wave of its own, so an entry without a wave takes the
    next free number (BR-064). The previous wave needs its record (BR-113).
    """
    wave = entry.wave
    if wave is None:
        taken = [e.wave for e in ledger.stories.values() if e.wave is not None]
        wave = max(taken, default=0) + 1
    return wave, _missing_wave_record(ledger, wave, f"prepare-story {entry.id}")


def _missing_wave_record(ledger: Ledger, wave: int | None, command: str) -> str | None:
    """Name the missing record of the wave before *wave*, or None (BR-113).

    `dispatch close-wave` writes the record once the wave's units of work
    and drift rows let it close, so the record stands for the whole check."""
    if wave is None or wave <= 1:
        return None
    if any(record.number == wave - 1 for record in ledger.waves):
        return None
    return (
        f"error: wave {wave - 1} has no wave record; run "
        f"`dispatch close-wave {wave - 1}` before {command}"
    )


def _undo_checkout_by_hand(
    main_root: Path, previous: str | None, branch_name: str, created: bool
) -> None:
    """Check the earlier branch out again and delete a story branch we created."""
    if previous:
        _git("-C", str(main_root), "checkout", "-q", previous)
    if created:
        _git("-C", str(main_root), "branch", "-D", branch_name)


def _prepare_story_by_hand(
    ledger: Ledger, ledger_path: Path, entry: StoryEntry
) -> int:
    """Prepare one story of a run by hand in the primary checkout (RL-G03).

    The story branch starts at the tip of the feature branch and is checked
    out in the primary checkout. No worktree is added, so the entry's
    worktree stays empty.
    """
    if entry.status == StoryState.PREPARED:
        return 0
    refusal = _pending_entry_error(entry)
    if refusal:
        print(refusal, file=sys.stderr)
        return 1

    main_root = _main_worktree_root()
    if not ledger_path.resolve().is_relative_to((main_root / ".current-work").resolve()):
        print(
            f"error: the ledger {ledger_path} does not lie under "
            f"{main_root / '.current-work'}; run prepare-story in the primary "
            f"checkout of the run",
            file=sys.stderr,
        )
        return 1

    if _print_dependency_refusals(ledger, entry):
        return 1

    wave, refusal = _wave_by_hand(ledger, entry)
    if refusal:
        print(refusal, file=sys.stderr)
        return 1

    feature_branch = ledger.feature_branch
    base_sha = _branch_tip(feature_branch) if feature_branch else None
    if not base_sha:
        print(
            f"error: feature branch {feature_branch!r} of the ledger does not exist",
            file=sys.stderr,
        )
        return 1

    project_root = main_root
    code, changed, err = _git(
        "-C", str(main_root), "status", "--porcelain", "--untracked-files=no"
    )
    if code != 0:
        print(
            f"error: git status failed in the primary checkout {main_root}, "
            f"so prepare-story cannot tell whether it is clean: {err}",
            file=sys.stderr,
        )
        return 1
    if changed:
        print(
            f"error: the primary checkout {main_root} holds uncommitted changes "
            f"to tracked files; commit them or set them aside first:",
            file=sys.stderr,
        )
        # _git strips the output, so the status letters of the first line
        # may have lost their leading blank; split off the letters instead.
        for line in changed.splitlines():
            print(f"  {line.split(maxsplit=1)[1]}", file=sys.stderr)
        return 1
    branch_name = f"story/{entry.id}"
    tip = _branch_tip(branch_name)
    # A reused entry keeps its branch, and the next attempt runs on it (IMPL-0056).
    reused = entry.branch == branch_name and tip is not None
    if tip is not None and tip != base_sha and not reused:
        print(
            f"error: branch {branch_name!r} already exists with commits that are "
            f"not on the feature branch; inspect it, then delete it or resume it",
            file=sys.stderr,
        )
        return 1

    code, previous, _ = _git(
        "-C", str(main_root), "symbolic-ref", "--short", "-q", "HEAD"
    )
    if code != 0:
        _, previous, _ = _git("-C", str(main_root), "rev-parse", "HEAD")
    if tip is None:
        code, _, err = _git(
            "-C", str(main_root), "checkout", "-q", "-b", branch_name, base_sha
        )
    else:
        code, _, err = _git("-C", str(main_root), "checkout", "-q", branch_name)
    created = tip is None and _branch_tip(branch_name) is not None
    if code != 0:
        _undo_checkout_by_hand(main_root, previous, branch_name, created)
        print(
            f"error: failed to check out {branch_name!r} in {main_root}: {err}",
            file=sys.stderr,
        )
        return 1
    if reused and _refresh_story_branch(
        ledger, entry, feature_branch, str(main_root)
    ) != 0:
        _undo_checkout_by_hand(main_root, previous, branch_name, created)
        if entry.status == StoryState.BLOCKED:
            _save_ledger(ledger, ledger_path)
        return 1

    verify_code, verify_output = _run_verify_base(main_root, feature_branch, base_sha)
    if verify_code != 0:
        _undo_checkout_by_hand(main_root, previous, branch_name, created)
        if verify_output:
            print(verify_output, file=sys.stderr)
        print(f"error: verify-base failed for {entry.id}", file=sys.stderr)
        return 1

    entry.branch = branch_name
    entry.worktree = None
    entry.base_sha = base_sha
    if reused:
        remove_manifest(main_root, feature_branch, branch_name)
    manifest_code, manifest_err = _write_story_manifest(
        project_root, entry, feature_branch, main_root
    )
    if manifest_code != 0:
        _undo_checkout_by_hand(main_root, previous, branch_name, created)
        print(f"error: {manifest_err}", file=sys.stderr)
        return 1
    entry.wave = wave
    entry.active_session = "impl"
    entry.active_tier = _story_declared_or_current_tier(project_root, entry)
    ledger.transition(entry.id, StoryState.PREPARED)
    return _save_ledger(ledger, ledger_path)


def cmd_prepare_story(args: argparse.Namespace) -> int:
    """Prepare one story: a serial chain link in an orchestrated run, or the
    next story of a run by hand in the primary checkout."""
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1

    story_id = args.story_id
    entry = ledger.stories.get(story_id)
    if entry is None:
        print(f"error: story not found: {story_id}", file=sys.stderr)
        return 1
    if ledger.mode == "by-hand":
        return _prepare_story_by_hand(ledger, ledger_path, entry)

    # A returned entry waits for the end of the run, whatever its strategy,
    # so the return is named before the seams-first branch (IMPL-0037).
    if entry.status == StoryState.PENDING and entry.returned:
        print(_pending_entry_error(entry), file=sys.stderr)
        return 1

    project_root = _project_root()
    story_meta = _story_meta_for_manifest(project_root, story_id)
    if story_meta.get("strategy") == "seams-first":
        if entry.status == StoryState.PREPARED and entry.active_session == "impl":
            return 0
        if entry.status != StoryState.DISPATCHED or entry.active_session != "seam":
            print(
                f"error: seams-first story {story_id} requires a completed seam session",
                file=sys.stderr,
            )
            return 1
        if not entry.worktree or not entry.branch:
            print(
                f"error: seams-first story {story_id} is missing prepared worktree metadata",
                file=sys.stderr,
            )
            return 1

        worktree_path = Path(entry.worktree)
        feature_branch = (
            entry.feature_branch
            or ledger.feature_branch
            or _current_branch_name()
        )
        if not feature_branch:
            print(
                f"error: unable to determine feature branch for {entry.id}",
                file=sys.stderr,
            )
            return 1

        remove_manifest(worktree_path, feature_branch, entry.branch)
        manifest_code, manifest_err = _prepare_seams_first_session(
            project_root,
            entry,
            feature_branch,
            worktree_path,
            session="impl",
        )
        if manifest_code != 0:
            print(f"error: {manifest_err}", file=sys.stderr)
            return 1

        entry.status = StoryState.PREPARED
        return _save_ledger(ledger, ledger_path)

    if entry.status == StoryState.PREPARED:
        return 0
    refusal = _pending_entry_error(entry)
    if refusal:
        print(refusal, file=sys.stderr)
        return 1

    if not entry.deps:
        print(
            f"error: story {story_id} has no chain predecessor recorded",
            file=sys.stderr,
        )
        return 1
    if _print_dependency_refusals(ledger, entry):
        return 1
    missing = _missing_wave_record(ledger, entry.wave, f"prepare-story {entry.id}")
    if missing:
        print(missing, file=sys.stderr)
        return 1

    predecessor_id = entry.deps[0]
    predecessor = ledger.stories.get(predecessor_id)
    if predecessor is None:
        print(f"error: predecessor not found: {predecessor_id}", file=sys.stderr)
        return 1

    if predecessor.status != StoryState.DONE:
        print(
            f"error: predecessor {predecessor_id} is not done "
            f"(status: {predecessor.status.value})",
            file=sys.stderr,
        )
        return 1

    merge_sha = predecessor.commit_sha
    if not merge_sha:
        print(
            f"error: predecessor {predecessor_id} has no recorded merge commit",
            file=sys.stderr,
        )
        return 1

    main_root = _main_worktree_root()
    feature_branch_for_path = (
        predecessor.feature_branch
        or ledger.feature_branch
        or _current_branch_name()
    )
    branch_name = f"story/{entry.id}"
    worktree_path = main_root / ".current-work" / feature_branch_for_path / branch_name

    workspace = _create_story_workspace(branch_name, worktree_path, merge_sha)
    if workspace.error:
        _remove_story_workspace(branch_name, worktree_path, workspace)
        print(
            f"error: failed to create {branch_name!r} and its worktree "
            f"for {entry.id}: {workspace.error}",
            file=sys.stderr,
        )
        return 1

    if not _verify_worktree_registration(worktree_path):
        _remove_story_workspace(branch_name, worktree_path, workspace)
        print(
            f"error: git worktree list did not report {worktree_path} for {entry.id}",
            file=sys.stderr,
        )
        return 1

    verify_code, verify_output = _run_verify_base(worktree_path, merge_sha, merge_sha)
    if verify_code != 0:
        _remove_story_workspace(branch_name, worktree_path, workspace)
        if verify_output:
            print(verify_output, file=sys.stderr)
        print(f"error: verify-base failed for {entry.id}", file=sys.stderr)
        return 1

    entry.branch = branch_name
    entry.worktree = str(worktree_path)
    entry.base_sha = merge_sha

    feature_branch = (
        predecessor.feature_branch
        or ledger.feature_branch
        or _current_branch_name()
    )
    if not feature_branch:
        _remove_story_workspace(branch_name, worktree_path, workspace)
        print(
            f"error: unable to determine feature branch for {entry.id}",
            file=sys.stderr,
        )
        return 1

    manifest_code, manifest_err = _write_story_manifest(
        project_root, entry, feature_branch, worktree_path
    )
    if manifest_code != 0:
        _remove_story_workspace(branch_name, worktree_path, workspace)
        print(f"error: {manifest_err}", file=sys.stderr)
        return 1
    entry.active_session = "impl"
    entry.active_tier = _story_declared_or_current_tier(project_root, entry)

    try:
        ledger.transition(entry.id, StoryState.PREPARED)
    except TransitionError as e:
        _remove_story_workspace(branch_name, worktree_path, workspace)
        print(f"error: {e}", file=sys.stderr)
        return 1
    return _save_ledger(ledger, ledger_path)


def _transition(
    args: argparse.Namespace,
    target: StoryState,
    *,
    reason: str | None = None,
) -> int:
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1
    current_status = (
        ledger.stories.get(args.story_id).status
        if args.story_id in ledger.stories
        else None
    )
    try:
        ledger.transition(args.story_id, target)
    except KeyError:
        print(f"error: story not found: {args.story_id}", file=sys.stderr)
        return 1
    except TransitionError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    if reason is not None and current_status != target:
        ledger.stories[args.story_id].reason = reason
    return _save_ledger(ledger, ledger_path)


def cmd_mark_dispatching(args: argparse.Namespace) -> int:
    return _transition(args, StoryState.DISPATCHING)


def cmd_mark_dispatched(args: argparse.Namespace) -> int:
    return _transition(args, StoryState.DISPATCHED)


def cmd_clear_manifest(args: argparse.Namespace) -> int:
    """Force-remove a stale step manifest under a given worktree."""
    if not args.force:
        print("error: clear-manifest requires --force", file=sys.stderr)
        return 1

    worktree_path = Path(args.worktree)
    if not worktree_path.exists():
        print(f"error: worktree not found: {worktree_path}", file=sys.stderr)
        return 1

    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1

    current_work_dir = worktree_path / ".current-work"
    manifest_paths = (
        sorted(current_work_dir.glob(f"**/{MANIFEST_FILENAME}"))
        if current_work_dir.is_dir()
        else []
    )
    if not manifest_paths:
        print(f"error: no step manifest found under {worktree_path}", file=sys.stderr)
        return 1
    if len(manifest_paths) > 1:
        print(
            f"error: multiple step manifests found under {worktree_path}; "
            "expected exactly one",
            file=sys.stderr,
        )
        return 1

    manifest_path = manifest_paths[0]
    rel_parts = manifest_path.relative_to(current_work_dir).parts[:-1]
    feature_branch = rel_parts[0]
    story_branch = "/".join(rel_parts[1:])

    clear_manifest_force(worktree_path, feature_branch, story_branch, ledger)
    return _save_ledger(ledger, ledger_path)


def cmd_mark_blocked(args: argparse.Namespace) -> int:
    return _transition(args, StoryState.BLOCKED, reason=args.reason)


def cmd_mark_failed(args: argparse.Namespace) -> int:
    if args.evidence is not None:
        code, out, _ = _git("ls-files", "--", args.evidence)
        if code != 0 or not out.strip():
            print(
                f"error: evidence path is not tracked in git: {args.evidence}",
                file=sys.stderr,
            )
            return 1

    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1
    entry = ledger.stories.get(args.story_id)
    if entry is None:
        print(f"error: story not found: {args.story_id}", file=sys.stderr)
        return 1

    current_status = entry.status
    frontmatter = _story_frontmatter(_project_root(), args.story_id)
    session = _attempt_session_for_story(
        frontmatter, args.failure_class, entry.active_session
    )
    target_state = StoryState.FAILED
    if args.failure_class == "seam_defect" and session == "seam":
        prior_seam_defects = [
            attempt
            for attempt in entry.attempts
            if attempt.get("session") == "seam"
            and attempt.get("failure_class") == "seam_defect"
        ]
        if prior_seam_defects:
            target_state = StoryState.BLOCKED
    try:
        ledger.transition(args.story_id, target_state)
    except TransitionError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    if current_status != target_state:
        entry.failure_class = args.failure_class
        entry.evidence = args.evidence
        tier = counted_tier(
            entry, _story_declared_tier(_project_root(), args.story_id)
        )
        append_attempt(
            entry,
            session=session,
            tier=tier,
            failure_class=args.failure_class,
            evidence=args.evidence,
            commit_sha=entry.commit_sha,
            normalized_total=0,
        )
        if target_state == StoryState.BLOCKED:
            entry.reason = "seam_defect_human_decision"
    if _save_ledger(ledger, ledger_path) != 0:
        return 1
    _print_stop_state(_project_root(), entry)
    return 0


def _print_stop_state(project_root: Path, entry: StoryEntry) -> None:
    """Say whether the entry has stopped or still has a retry (BR-116)."""
    limits = _attempt_limits_or_error(project_root)
    if limits is None:
        return
    tier = counted_tier(entry, _story_declared_tier(project_root, entry.id))
    if has_stopped(entry, limits, tier):
        print(
            f"dispatch: {entry.id} has stopped as {entry.status.value} "
            "and waits for the User"
        )
        return
    counted = counted_attempts_on_tier(entry, tier)
    limit = tier_attempt_limit(entry, tier, limits)
    if entry.status == StoryState.FAILED and counted >= limit:
        print(
            f"dispatch: {entry.id} has used up its {counted} of {limit} counted "
            f"attempts on the tier {tier}; run `dispatch escalate {entry.id}`"
        )
        return
    print(
        f"dispatch: {entry.id} has a retry left ({counted} of {limit} counted "
        f"attempts on the tier {tier}); run `dispatch re-dispatch {entry.id}`"
    )


class _BranchCheckError(Exception):
    """The checks of the branch could not run."""


def _branch_escalation_refusal(
    project_root: Path, entry: StoryEntry
) -> tuple[str | None, str]:
    """Run the checks of the branch that `escalate` needs (BR-115).

    Returns the record for `reason` when a check refuses, else None, and
    the output that explains it. A run by hand has no worktree, so the
    checks run in the primary checkout. Raises _BranchCheckError when the
    entry has no branch or no declared base.
    """
    if not entry.branch or not entry.base_sha:
        raise _BranchCheckError(
            f"story {entry.id} is missing prepared branch metadata"
        )
    worktree = Path(entry.worktree) if entry.worktree else project_root
    code, output = _run_verify_base(worktree, entry.branch, entry.base_sha)
    if code != 0:
        return ESCALATE_REFUSED_VERIFY_BASE, output
    if _story_scope_violation(project_root, entry):
        return ESCALATE_REFUSED_SCOPE, (
            f"the diff of {entry.branch} leaves the scope or the file limit "
            f"of {entry.id}"
        )
    return None, ""


def cmd_re_dispatch(args: argparse.Namespace) -> int:
    """Set a failed or blocked entry prepared within the attempt cap (BR-116)."""
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1

    entry = ledger.stories.get(args.story_id)
    if entry is None:
        print(f"error: story not found: {args.story_id}", file=sys.stderr)
        return 1

    project_root = _project_root()
    limits = AttemptLimits()
    tier = counted_tier(entry, _story_declared_tier(project_root, args.story_id))
    if entry.status == StoryState.FAILED:
        read = _attempt_limits_or_error(project_root)
        if read is None:
            return 1
        limits = read

    def branch_allows_escalation() -> bool:
        record, _ = _branch_escalation_refusal(project_root, entry)
        return record is None

    try:
        disposition = re_dispatch_disposition(
            entry, tier, limits, branch_allows_escalation
        )
    except _BranchCheckError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    if disposition == "requires_escalation":
        counted = counted_attempts_on_tier(entry, tier)
        print(
            f"error: story {args.story_id} requires escalation before re-dispatch: "
            f"its {counted} counted attempts on the tier {tier} are used up. "
            f"Run `dispatch escalate {args.story_id}`.",
            file=sys.stderr,
        )
        return 1
    if disposition == "terminal":
        print(
            f"error: story {args.story_id} is terminal after two contract_violation failures",
            file=sys.stderr,
        )
        return 1

    try:
        ledger.transition(args.story_id, StoryState.PREPARED)
    except TransitionError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    if entry.reason in ESCALATE_REFUSED_RECORDS:
        entry.reason = None
    if disposition == "grant":
        grant_attempts(entry, tier)
    if _save_ledger(ledger, ledger_path) != 0:
        return 1
    if disposition == "grant":
        print(
            f"dispatch re-dispatch: {args.story_id} gets {limits.attempts} new "
            f"counted attempts on the tier {tier}"
        )
    return 0


def cmd_return_story(args: argparse.Namespace) -> int:
    """Set a failed or blocked story back to pending in the ledger and the
    backlog (BR-116). The backlog file changes in the working tree of the
    current checkout; return-story commits nothing. For a finding, only the
    ledger entry changes, and dispatch reads no backlog file."""
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1
    if args.story_id not in ledger.stories:
        print(f"error: story not found: {args.story_id}", file=sys.stderr)
        return 1
    try:
        ledger.return_story(args.story_id)
    except TransitionError as e:
        print(f"error: dispatch return-story refuses: {e}", file=sys.stderr)
        return 1
    if not is_story_id(args.story_id):
        # A finding keeps its file unchanged; only its entry changes (BR-116).
        if _save_ledger(ledger, ledger_path) != 0:
            return 1
        print(
            f"dispatch return-story: {args.story_id} is pending in the ledger; "
            f"docs/findings/{args.story_id}.md keeps its status"
        )
        return 0
    story_file = f"backlog/{args.story_id}.md"
    if not _update_story_status_in_file(_project_root(), args.story_id, "pending"):
        print(
            f"error: dispatch return-story found no status line in {story_file}; "
            f"the ledger keeps {args.story_id} unchanged",
            file=sys.stderr,
        )
        return 1
    if _save_ledger(ledger, ledger_path) != 0:
        return 1
    print(
        f"dispatch return-story: {args.story_id} is pending in the ledger and "
        f"in {story_file}"
    )
    return 0


def _finding_text(
    project_root: Path, feature_branch: str | None, finding_id: str
) -> str | None:
    """The finding file at the head of the feature branch, where the feature
    checks commit it; else the file in the current checkout; else None."""
    rel = f"docs/findings/{finding_id}.md"
    if feature_branch:
        code, text, _ = _git("show", f"refs/heads/{feature_branch}:{rel}")
        if code == 0:
            return text
    path = project_root / rel
    return path.read_text() if path.is_file() else None


def cmd_add(args: argparse.Namespace) -> int:
    """Put an open blocking finding into the next free wave (BR-117)."""
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1
    project_root = _project_root()
    finding_id = args.finding_id
    if is_story_id(finding_id) or (project_root / "backlog" / f"{finding_id}.md").exists():
        refusal = f"{finding_id} is a story, and add takes only a finding"
    else:
        text = _finding_text(project_root, ledger.feature_branch, finding_id)
        refusal = finding_add_refusal(finding_id, finding_fields(text))
    if refusal is None:
        try:
            entry = ledger.add_finding(finding_id)
        except TransitionError as e:
            refusal = str(e)
    if refusal is not None:
        print(f"error: dispatch add refuses {finding_id}: {refusal}", file=sys.stderr)
        return 1
    if _save_ledger(ledger, ledger_path) != 0:
        return 1
    print(
        f"dispatch add: {finding_id} is pending in wave {entry.wave} of "
        f"{ledger.feature_branch}, on the branch story/{finding_id}"
    )
    return 0


def cmd_escalate(args: argparse.Namespace) -> int:
    """Promote a story one tier when every condition of BR-115 holds."""
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1

    project_root = _project_root()
    entry = ledger.stories.get(args.story_id)
    if entry is None:
        print(f"error: story not found: {args.story_id}", file=sys.stderr)
        return 1
    limits = _attempt_limits_or_error(project_root)
    if limits is None:
        return 1

    story_tier = counted_tier(entry, _story_declared_tier(project_root, args.story_id))
    refusal = ledger_escalation_refusal(entry, story_tier, limits)
    if refusal is None:
        counted = counted_attempts_on_tier(entry, story_tier)
        limit = tier_attempt_limit(entry, story_tier, limits)
        if counted < limit:
            refusal = (
                f"it has {counted} of {limit} counted attempts on the tier "
                f"{story_tier}, and escalate grants only once they are used up"
            )
    if refusal is not None:
        print(
            f"error: dispatch escalate refuses {args.story_id}: {refusal}",
            file=sys.stderr,
        )
        return 1

    try:
        record, output = _branch_escalation_refusal(project_root, entry)
    except _BranchCheckError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    if record is not None:
        entry.reason = record
        if _save_ledger(ledger, ledger_path) != 0:
            return 1
        if output:
            print(output, file=sys.stderr)
        print(
            f"error: dispatch escalate refuses {args.story_id}: {record}. "
            f"{args.story_id} has stopped and waits for the User",
            file=sys.stderr,
        )
        return 1

    next_story_tier = next_tier(story_tier)
    entry.tier = next_story_tier
    entry.escalation_granted = True
    if entry.active_tier is not None:
        entry.active_tier = next_story_tier
    if entry.reason in ESCALATE_REFUSED_RECORDS:
        entry.reason = None
    if _save_ledger(ledger, ledger_path) != 0:
        return 1
    print(
        f"dispatch escalate: {args.story_id} escalated {story_tier} -> {next_story_tier}",
    )
    return 0


def _validate_sha_format(sha: str) -> None:
    """Raise ShaFormatError if *sha* is not 4 to 40 lowercase hex chars."""
    if not re.fullmatch(r"[0-9a-f]{4,40}", sha):
        raise ShaFormatError(
            f"SHA must be 4 to 40 lowercase hex characters, got: {sha!r}"
        )


def cmd_verify_story(args: argparse.Namespace) -> int:
    """Verify a story's reported commit SHA exists and is on its branch.

    Performs read-only git plumbing checks (`git cat-file -e`, `git branch
    --contains`) and records the outcome in the ledger. Never touches the
    working tree, index, or HEAD.
    """
    sha = args.sha
    try:
        _validate_sha_format(sha)
    except ShaFormatError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    # An abbreviated SHA expands to the full one, which the ledger records.
    code, full_sha, err = _git("rev-parse", "--verify", f"{sha}^{{commit}}")
    if code != 0:
        print(f"error: SHA does not exist: {sha}: {err}", file=sys.stderr)
        return 1
    sha = full_sha

    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1

    entry = ledger.stories.get(args.story_id)
    if entry is None:
        print(f"error: story not found: {args.story_id}", file=sys.stderr)
        return 1

    if not entry.branch:
        print(f"error: story {args.story_id} has no branch recorded", file=sys.stderr)
        return 1

    code, out, err = _git("branch", "--contains", sha)
    if code != 0:
        print(
            f"error: failed to list branches containing {sha}: {err}", file=sys.stderr
        )
        return 1

    branch_names = {line.strip().lstrip("*+ ").strip() for line in out.splitlines()}
    if entry.branch not in branch_names:
        print(
            f"error: SHA {sha} is not on branch '{entry.branch}' for {args.story_id}",
            file=sys.stderr,
        )
        return 1

    if entry.base_sha:
        ahead_code, _, _ = _git("merge-base", "--is-ancestor", entry.base_sha, sha)
        if ahead_code != 0 or _git("rev-parse", sha)[1] == entry.base_sha:
            print(
                f"error: SHA {sha} is not ahead of the story's base {entry.base_sha} "
                f"for {args.story_id}",
                file=sys.stderr,
            )
            return 1

    entry.verify_base = "pass"
    entry.commit_sha = sha
    if entry.attempts:
        latest = entry.attempts[-1]
        if latest.get("commit_sha") is None:
            latest["commit_sha"] = sha
    return _save_ledger(ledger, ledger_path)


def _update_story_status_in_file(
    project_root: Path, story_id: str, status: str
) -> bool:
    """Rewrite the ``status:`` frontmatter field in the story's backlog file."""
    return _update_status_in_file(project_root / "backlog" / f"{story_id}.md", status)


def _update_status_in_file(story_path: Path, status: str) -> bool:
    """Rewrite the ``status:`` frontmatter field of a story or finding file.

    Returns True if the file was found, parsed, and rewritten; False otherwise.
    Only the frontmatter ``status:`` line is touched — the rest of the file
    (including the frontmatter delimiters) is left byte-for-byte identical.
    """
    if not story_path.exists():
        return False
    text = story_path.read_text()
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return False
    end = None
    for i, ln in enumerate(lines[1:], start=1):
        if ln.strip() == "---":
            end = i
            break
    if end is None:
        return False
    for i in range(1, end):
        if re.match(r"^status\s*:\s*", lines[i]):
            lines[i] = f"status: {status}"
            story_path.write_text("\n".join(lines))
            return True
    return False


REFRESHABLE_STATES = {StoryState.PREPARED, StoryState.DISPATCHING, StoryState.DISPATCHED}


def _refresh_story_branch(
    ledger: Ledger, entry: StoryEntry, target_branch: str, worktree: str | None = None
) -> int:
    """Merge *target_branch* into the story branch inside its worktree.

    *worktree* names the checkout that has the branch checked out when it is
    not the entry's worktree, as in a run by hand.

    Returns 0 when the branch already contains the target tip or the merge
    succeeds, 1 otherwise. It refuses, unchanged, a dirty worktree, a
    worktree on another branch, and a target whose tip is the story's merge
    commit (an interrupted ``merge-story``; its rerun recovers). On a
    conflict the merge is aborted and the story is marked ``blocked`` with
    reason "refresh conflict"; the caller saves the ledger.
    """
    worktree = worktree or entry.worktree
    if not entry.branch or not worktree:
        print(f"error: story {entry.id} has no branch or worktree recorded", file=sys.stderr)
        return 1
    _, branch_tip, _ = _git("rev-parse", entry.branch)
    second_code, second_parent, _ = _git("rev-parse", "--verify", "-q", f"{target_branch}^2")
    if second_code == 0 and second_parent == branch_tip:
        print(
            f"error: {target_branch} already ends in the merge of {entry.branch}; "
            f"an interrupted merge-story left it there, so rerun merge-story {entry.id}",
            file=sys.stderr,
        )
        return 1
    contained, _, _ = _git("merge-base", "--is-ancestor", target_branch, entry.branch)
    if contained == 0:
        print(f"{entry.branch} already contains {target_branch}")
        return 0
    head_code, head_branch, _ = _git("-C", worktree, "symbolic-ref", "-q", "--short", "HEAD")
    if head_code != 0 or head_branch != entry.branch:
        checked_out = head_branch if head_code == 0 else "a detached HEAD"
        print(
            f"error: {worktree} is on {checked_out}, not {entry.branch}; "
            f"check out {entry.branch} before refreshing it",
            file=sys.stderr,
        )
        return 1
    code, dirty, err = _git("-C", worktree, "status", "--porcelain")
    if code != 0:
        print(f"error: cannot read the status of {worktree}: {err}", file=sys.stderr)
        return 1
    if dirty:
        print(
            f"error: {worktree} has uncommitted changes; commit or remove them "
            f"before refreshing {entry.branch}",
            file=sys.stderr,
        )
        return 1
    merge_code, _, merge_err = _git(
        "-C", worktree, "merge", "--no-ff", "--no-edit",
        "-m", f"merge: {target_branch} into story/{entry.id}", target_branch,
    )
    if merge_code == 0:
        print(f"merged {target_branch} into {entry.branch}")
        return 0
    _git("-C", worktree, "merge", "--abort")
    entry.reason = "refresh conflict"
    try:
        ledger.transition(entry.id, StoryState.BLOCKED)
    except TransitionError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    print(
        f"error: merge conflict merging {target_branch} into {entry.branch}; "
        f"aborted and blocked ({merge_err})",
        file=sys.stderr,
    )
    return 1


def cmd_refresh_story(args: argparse.Namespace) -> int:
    """Bring a story branch up to the invocation branch tip (BUG-0089)."""
    ledger_path = Path(args.ledger)
    ledger = _load_orchestrated_ledger(ledger_path)
    if ledger is None:
        return 1
    entry = ledger.stories.get(args.story_id)
    if entry is None:
        print(f"error: story not found: {args.story_id}", file=sys.stderr)
        return 1
    if entry.status not in REFRESHABLE_STATES:
        print(
            f"error: story {entry.id} cannot be refreshed in status {entry.status.value} "
            "(expected: prepared, dispatching, or dispatched)",
            file=sys.stderr,
        )
        return 1
    if not ledger.feature_branch:
        print("error: the ledger records no feature_branch", file=sys.stderr)
        return 1
    code = _refresh_story_branch(ledger, entry, ledger.feature_branch)
    if entry.status == StoryState.BLOCKED:
        _save_ledger(ledger, ledger_path)
    return code


def _checkout_feature_branch_by_hand(
    project_root: Path, entry: StoryEntry, target_branch: str
) -> int:
    """Check out *target_branch* in the primary checkout after premerge-check.

    Git's own refusal stays: its message names the files, and the story
    branch stays checked out (BR-124).
    """
    if _current_branch_name() == target_branch:
        return 0
    code, _, err = _git("checkout", "-q", target_branch)
    if code == 0:
        return 0
    # A failing post-checkout hook switches the branch and still fails.
    if _current_branch_name() != entry.branch:
        _git("checkout", "-q", entry.branch)
    if err:
        print(err, file=sys.stderr)
    print(
        f"error: git refused the checkout of {target_branch} in the primary "
        f"checkout {project_root}; {entry.id} stays dispatched and "
        f"{entry.branch} stays checked out. Commit or revert the changes, "
        f"then run merge-story {entry.id} again",
        file=sys.stderr,
    )
    return 1


# The hooks that run on ``git commit --amend`` and can refuse it.
AMEND_HOOKS = ("pre-commit", "prepare-commit-msg", "commit-msg")


def _merge_commit_story_status(story_path: Path, project_root: Path) -> str | None:
    """Return the ``status:`` of the story file in HEAD, or None without one."""
    rel = story_path.relative_to(project_root).as_posix()
    code, text, _ = _git("show", f"HEAD:{rel}")
    if code != 0:
        return None
    fm = parse_story_frontmatter(text)
    return (fm or {}).get("status")


def _amend_hook_names() -> list[str]:
    """Name the executable hooks that can refuse an amend, in the order git runs them."""
    code, hooks_dir, _ = _git("rev-parse", "--git-path", "hooks")
    if code != 0 or not hooks_dir:
        return []
    folder = Path(hooks_dir)
    if not folder.is_absolute():
        folder = Path.cwd() / folder
    return [
        name for name in AMEND_HOOKS
        if (folder / name).is_file() and os.access(folder / name, os.X_OK)
    ]


def _amend_status_into_merge_commit(project_root: Path, story_id: str) -> int:
    """Write the status into the merge commit by amending it (BR-118):
    ``status: done`` in backlog/<id>.md for a story, ``status: resolved`` in
    docs/findings/<id>.md for a finding.

    A refused amend exits 1 and names the hook that refused it. The caller
    then leaves the entry ``dispatched``; a rerun amends again.
    """
    unit_path, status = _unit_file(project_root, story_id)
    _update_status_in_file(unit_path, status)
    _git("add", "--", str(unit_path.relative_to(project_root)))
    amend_code, _, amend_err = _git("commit", "--amend", "--no-edit")
    if amend_code == 0:
        return 0
    hooks = _amend_hook_names()
    if len(hooks) == 1:
        who = f"the {hooks[0]} hook refused"
    elif hooks:
        who = f"one of the hooks {', '.join(hooks)} refused"
    else:
        who = "git refused"
    print(
        f"error: {who} the amend that writes status: {status} into the merge "
        f"commit; {story_id} is not done. Fix the cause, then run "
        f"merge-story {story_id} again ({amend_err})",
        file=sys.stderr,
    )
    return 1


def cmd_merge_story(args: argparse.Namespace) -> int:
    """Merge a story's feature branch into the current branch.

    Refreshes the story branch first (see ``cmd_refresh_story``) when it
    lacks the invocation tip; a refresh conflict blocks the story. Then runs
    ``premerge-check`` with the story's declared scope entries
    (``outputs``, else ``touches``) immediately before merging: plain entries as
    ``--scope`` path prefixes, entries with ``*`` or ``?`` as ``--scope-glob``.
    On a merge conflict, aborts the merge and marks the story ``blocked``
    with reason "merge conflict"; the current branch is left unchanged. On a
    red test suite after a clean merge, resets the current branch back to
    its pre-merge commit and marks the story ``blocked`` with reason
    "post-merge test failure". ``--dry-run`` runs premerge-check only and
    never refreshes, merges, touches the ledger, or cleans up the worktree/branch.
    Idempotent across interruption: if HEAD is a merge commit whose second
    parent is the story's tip (a prior run created the merge commit but was
    interrupted before the test suite finished), the merge is not repeated.
    The story file's status is set to done if the interrupted run did not get
    that far, and the test suite runs against the existing merge commit.

    By hand, the primary checkout has the story branch checked out. There is
    no refresh. ``premerge-check`` runs first, and only after its exit 0 is
    the feature branch checked out. A refused check, checkout or merge exits
    1, keeps the story branch checked out and the entry ``dispatched``, and
    leaves the feature branch where it was (BR-124).

    In an orchestrated run, a new merge also stops after premerge-check
    exited 0 when the worktree of the feature branch holds an uncommitted
    change to a tracked file, unless ``dispatch.refuse_dirty_feature_worktree``
    is false (BR-124). The rerun after a refused amend skips this check.
    """
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1
    by_hand = ledger.mode == "by-hand"

    entry = ledger.stories.get(args.story_id)
    if entry is None:
        print(f"error: story not found: {args.story_id}", file=sys.stderr)
        return 1

    if entry.status != StoryState.DISPATCHED:
        print(
            f"error: story {args.story_id} is not ready to merge "
            f"(status: {entry.status.value}, expected: dispatched)",
            file=sys.stderr,
        )
        return 1

    if not entry.branch:
        print(f"error: story {args.story_id} has no branch recorded", file=sys.stderr)
        return 1

    project_root = _project_root()
    target_branch = ledger.feature_branch or _current_branch_name()
    if not target_branch:
        print(
            "error: unable to determine target branch from ledger or current checkout",
            file=sys.stderr,
        )
        return 1

    current_branch = _current_branch_name()
    if by_hand and current_branch not in (entry.branch, target_branch):
        print(
            f"error: by hand, merge-story runs in the primary checkout with "
            f"'{entry.branch}' checked out, but the current checkout is on "
            f"'{current_branch}'",
            file=sys.stderr,
        )
        return 1
    if not by_hand and current_branch != target_branch:
        location = _worktree_for_branch(target_branch)
        where = f" Run it from {location}." if location else ""
        print(
            f"error: merge-story must run on the invocation branch '{target_branch}', "
            f"but the current checkout is on '{current_branch}'.{where}",
            file=sys.stderr,
        )
        return 1

    unit_path, unit_status = _unit_file(project_root, entry.id)

    # Interrupted-merge recovery: a prior run created the merge commit (and
    # may have amended the status update into it) but was interrupted before
    # the test suite completed. That is the case only when HEAD is a merge
    # commit whose second parent is the story's tip. A story branch that is
    # an ancestor of HEAD in any other way has no commits of its own, and
    # merging it would record unrelated history as the story's work.
    _, branch_tip, _ = _git("rev-parse", entry.branch)
    second_parent_code, second_parent, _ = _git(
        "rev-parse", "--verify", "-q", f"{target_branch}^2"
    )
    already_merged = second_parent_code == 0 and second_parent == branch_tip
    contained_code, _, _ = _git(
        "merge-base", "--is-ancestor", entry.branch, target_branch
    )
    if contained_code == 0 and not already_merged:
        if entry.base_sha and branch_tip == entry.base_sha:
            reason = "it has no commits of its own; nothing to merge"
        else:
            reason = (
                "it is already part of the branch, but HEAD is not its merge "
                "commit; check the history by hand before marking the story"
            )
        print(f"error: {entry.branch} cannot be merged into {target_branch}: {reason}",
              file=sys.stderr)
        return 1

    if by_hand and current_branch != entry.branch and not already_merged:
        print(
            f"error: by hand, merge-story checks out {target_branch} itself; "
            f"check out {entry.branch} in the primary checkout first",
            file=sys.stderr,
        )
        return 1

    # By hand only one story runs at a time, so the feature branch has not
    # moved under the story branch and needs no refresh.
    if not already_merged and not args.dry_run and not by_hand:
        if _refresh_story_branch(ledger, entry, target_branch) != 0:
            if entry.status == StoryState.BLOCKED:
                _save_ledger(ledger, ledger_path)
            return 1

    if not already_merged:
        scope = _unit_scope(project_root, entry.id, target_branch, entry.branch)
        if scope is None:
            return 1
        premerge_cmd = [
            str(SCRIPT_DIR / "premerge-check"), target_branch, entry.branch,
            *scope.arguments(),
        ]

        premerge_result = subprocess.run(
            premerge_cmd, capture_output=True, text=True, cwd=project_root, check=False
        )
        if premerge_result.stdout:
            print(premerge_result.stdout)
        if premerge_result.stderr:
            print(premerge_result.stderr, file=sys.stderr)

        if premerge_result.returncode != 0:
            print(f"error: premerge-check failed for {entry.branch}", file=sys.stderr)
            return 1

        # Only before a new merge: the rerun after a refused amend finds the
        # merge commit at HEAD and the changed backlog file (BR-124, BR-118).
        if (
            not by_hand
            and not args.dry_run
            and _refuse_dirty_feature_worktree(project_root, entry)
        ):
            return 1

    if args.dry_run:
        if already_merged:
            print(f"dry-run: {entry.branch} is already merged into {target_branch}")
        else:
            print(
                f"dry-run: premerge-check passed for {entry.branch} -> {target_branch}; "
                "no merge performed"
            )
        return 0

    if by_hand and _checkout_feature_branch_by_hand(
        project_root, entry, target_branch
    ) != 0:
        return 1

    if already_merged:
        pre_merge_sha = _git("rev-parse", "HEAD^1")[1]
        # Read the status from the merge commit, not from the working tree:
        # after a refused amend the file already says done (BR-118).
        if (
            _merge_commit_story_status(unit_path, project_root) != unit_status
            and _amend_status_into_merge_commit(project_root, entry.id) != 0
        ):
            return 1
        merge_sha = _git("rev-parse", "HEAD")[1]
    else:
        pre_merge_sha = _git("rev-parse", "HEAD")[1]
        merge_code, _, merge_err = _git(
            "merge",
            "--no-ff",
            entry.branch,
            "-m",
            f"merge: story/{entry.id} into {target_branch}",
        )
        if merge_code != 0:
            _git("merge", "--abort")
            if by_hand:
                _git("checkout", "-q", entry.branch)
                print(
                    f"error: git refused the merge of {entry.branch} into "
                    f"{target_branch} in the primary checkout {project_root}; "
                    f"{entry.id} stays dispatched ({merge_err})",
                    file=sys.stderr,
                )
                return 1
            entry.reason = "merge conflict"
            try:
                ledger.transition(entry.id, StoryState.BLOCKED)
            except TransitionError as e:
                print(f"error: {e}", file=sys.stderr)
                return 1
            _save_ledger(ledger, ledger_path)
            print(
                f"error: merge conflict merging {entry.branch} into {target_branch}; "
                f"aborted ({merge_err})",
                file=sys.stderr,
            )
            return 1

        if _amend_status_into_merge_commit(project_root, entry.id) != 0:
            return 1

        merge_sha = _git("rev-parse", "HEAD")[1]

    test_command = _read_test_command(project_root)
    if test_command:
        test_result = subprocess.run(
            test_command,
            shell=True,
            cwd=project_root,
            capture_output=True,
            text=True,
            check=False,
        )
        if test_result.stdout:
            print(test_result.stdout)
        if test_result.stderr:
            print(test_result.stderr, file=sys.stderr)

        if test_result.returncode != 0:
            # --keep moves the branch and the files the merge changed, and
            # keeps an uncommitted change to any other file (IMPL-0031).
            reset_code, _, reset_err = _git("reset", "--keep", pre_merge_sha)
            if reset_code != 0:
                print(
                    f"error: test suite failed after merging {entry.branch}, and "
                    f"git refused to move {target_branch} back to {pre_merge_sha} "
                    f"without losing a local change; {entry.id} stays dispatched "
                    f"({reset_err})",
                    file=sys.stderr,
                )
                return 1
            entry.reason = "post-merge test failure"
            try:
                ledger.transition(entry.id, StoryState.BLOCKED)
            except TransitionError as e:
                print(f"error: {e}", file=sys.stderr)
                return 1
            _save_ledger(ledger, ledger_path)
            print(
                f"error: test suite failed after merging {entry.branch}; "
                f"reverted to {pre_merge_sha}",
                file=sys.stderr,
            )
            return 1

    if entry.worktree:
        _git("worktree", "remove", entry.worktree)
    _git("branch", "-d", entry.branch)

    entry.commit_sha = merge_sha
    try:
        ledger.transition(entry.id, StoryState.DONE)
    except TransitionError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    ledger.branch_head = merge_sha
    return _save_ledger(ledger, ledger_path)


def cmd_suggest_merge_args(args: argparse.Namespace) -> int:
    """Print a recommended ``--max-files`` value for the final feature-to-dev merge.

    Sums the declared ``outputs`` count across every story in the ledger —
    the aggregate file footprint of the whole feature branch — and prints
    the result, floored at premerge-check's own default of 20. Used when
    merging a multi-story feature branch back into dev, where the combined
    diff routinely exceeds any single story's threshold.
    """
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1

    project_root = _project_root()
    total_outputs = sum(
        len(_story_output_globs(project_root, story_id)) for story_id in ledger.stories
    )
    recommended = max(DEFAULT_MAX_FILES, total_outputs)
    print(f"--max-files {recommended}")
    return 0


# The core list beside the running scripts: packages/factory/rulebooks/ in
# the factory repository, .agent-factory/factory/rulebooks/ when installed.
CORE_LIST_PATH = SCRIPT_DIR.parent / "rulebooks" / "core-artifacts.yaml"


def _drift_check(branch_head: str):
    """Return the close-wave check of the reports at *branch_head* (BR-062).

    Owner and reviewer sessions commit each row status on the invocation
    branch (ADR-0029), so the check reads the committed reports."""

    def check(story_ids: list[str]) -> list[str]:
        try:
            core_patterns = load_core_patterns(CORE_LIST_PATH)
        except ReportError as e:
            return [str(e)]
        reports: dict[str, str | None] = {}
        for story_id in story_ids:
            path = spec_feedback_path(story_id)
            exists, _, _ = _git("cat-file", "-e", f"{branch_head}:{path}")
            if exists != 0:
                reports[path] = None
                continue
            code, text, err = _git("show", f"{branch_head}:{path}")
            if code != 0:
                return [f"{path}: cannot read the report: {err}"]
            reports[path] = text
        return drift_row_problems(reports, core_patterns)

    return check


def cmd_close_wave(args: argparse.Namespace) -> int:
    """Record the close of one wave, on both ways of a run (BR-062, BR-064)."""
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1
    limits = _attempt_limits_or_error(_project_root())
    if limits is None:
        return 1

    # Read the invocation branch by name, so the result does not depend on
    # which checkout the caller runs from.
    head_ref = (
        f"refs/heads/{ledger.feature_branch}" if ledger.feature_branch else "HEAD"
    )
    branch_head_code, branch_head, branch_head_err = _git("rev-parse", head_ref)
    if branch_head_code != 0:
        print(
            f"error: unable to read current branch head: {branch_head_err}",
            file=sys.stderr,
        )
        return 1

    wave = args.wave
    try:
        _record, created = ledger.close_wave(
            wave, branch_head, drift_check=_drift_check(branch_head), limits=limits
        )
    except TransitionError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    if not created:
        return 0

    # The ledger is runtime state under the ignored .current-work/, so the
    # closeout is saved, not committed (BUG-0083).
    if _save_ledger(ledger, ledger_path) != 0:
        return 1
    print(f"dispatch close-wave: recorded wave {wave} in {ledger_path}")
    return 0


# -- dispatch close: the end of a run (BR-119) --------------------------------

# A finished run has merged its feature branch into this branch (RL-G05).
CLOSE_TARGET = "dev"
_UNIT_ID_RE = re.compile(r"^[A-Za-z0-9_.-]+$")


def _git_in(cwd: Path, *args: str) -> tuple[int, str, str]:
    """Run git on the checkout at *cwd*, whatever folder dispatch runs in."""
    return _git("-C", str(cwd), *args)


def _registered_worktrees(main_root: Path) -> dict[Path, str | None] | None:
    """Map each worktree that git lists to its branch, or None when detached."""
    code, out, _ = _git_in(main_root, "worktree", "list", "--porcelain")
    if code != 0:
        return None
    trees: dict[Path, str | None] = {}
    path: Path | None = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            path = Path(line[len("worktree "):]).resolve()
            trees[path] = None
        elif line.startswith("branch refs/heads/") and path is not None:
            trees[path] = line[len("branch refs/heads/"):]
    return trees


def _locked_worktrees(main_root: Path) -> set[Path] | None:
    """Each worktree that git lists as locked, or None when the list fails."""
    code, out, _ = _git_in(main_root, "worktree", "list", "--porcelain")
    if code != 0:
        return None
    locked: set[Path] = set()
    path: Path | None = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            path = Path(line[len("worktree "):]).resolve()
        elif (line == "locked" or line.startswith("locked ")) and path is not None:
            locked.add(path)
    return locked


def _close_run_dir(
    main_root: Path, current: Path, feature_branch: str
) -> tuple[Path | None, str | None]:
    """The folder of the run under .current-work/, or the reason to refuse it.

    The name must be a branch name that git accepts as it is, so that no
    `.` or `..` part leads to the folder of another run. The path is not
    resolved, and a symlink on the way to the folder is refused, so that a
    link cannot lead there either."""
    code, out, _ = _git_in(main_root, "check-ref-format", "--branch", feature_branch)
    if code != 0 or out != feature_branch:
        return None, f"the feature branch {feature_branch!r} is not a valid branch name"
    run_dir = current
    for part in feature_branch.split("/"):
        run_dir = run_dir / part
        if run_dir.is_symlink():
            return None, f"{run_dir} is a symlink, so it may lead to another run"
    return run_dir, None


def _branch_exists(main_root: Path, branch: str) -> bool:
    code, _, _ = _git_in(main_root, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")
    return code == 0


def _unmerged_feature_refusal(main_root: Path, feature_branch: str) -> str | None:
    """Name a feature branch that a close without --drop cannot end (BR-119)."""
    for branch in (feature_branch, CLOSE_TARGET):
        if not _branch_exists(main_root, branch):
            return (
                f"dispatch close: branch {branch} does not exist, so close cannot "
                f"check that {feature_branch} is merged into {CLOSE_TARGET}; "
                "to drop the run, run dispatch close --drop"
            )
    code, _, _ = _git_in(
        main_root, "merge-base", "--is-ancestor",
        f"refs/heads/{feature_branch}", f"refs/heads/{CLOSE_TARGET}",
    )
    if code == 0:
        return None
    return (
        f"dispatch close: {feature_branch} is not merged into {CLOSE_TARGET}; "
        "merge it first, or run dispatch close --drop to drop the run"
    )


def _run_worktrees(
    main_root: Path,
    current: Path,
    run_dir: Path,
    ledger: Ledger,
    trees: dict[Path, str | None],
) -> list[tuple[str, Path]]:
    """The worktrees of the run, each with the label of its stash.

    A worktree counts only when git lists it, it lies under .current-work/
    of the primary checkout, and it is not the primary checkout. The story
    worktrees come first and the worktree of the feature branch last,
    because an old run nests the others inside it."""
    picked: dict[Path, str] = {}

    def take(path: Path, label: str) -> None:
        if path in picked or path not in trees or not path.is_dir():
            return
        if path == main_root or not path.is_relative_to(current):
            return
        picked[path] = label

    for entry in ledger.stories.values():
        if entry.worktree:
            take(Path(entry.worktree).resolve(), entry.id)
        for path, branch in trees.items():
            if entry.branch and branch == entry.branch:
                take(path, entry.id)
    premerge = run_dir / "premerge"
    for path in trees:
        if path != premerge and path.is_relative_to(premerge):
            take(path, f"premerge/{path.relative_to(premerge)}")
    for path, branch in trees.items():
        if branch == ledger.feature_branch:
            take(path, "feature")
    return [(label, path) for path, label in picked.items()]


def _stash_and_remove(
    main_root: Path, path: Path, name: str
) -> tuple[str | None, str | None]:
    """Stash the changes of the worktree at *path*, then remove the worktree.

    Return the stash name, when a stash was made, and the error, if any.
    The stash is never applied (BR-119). A registered worktree below *path*
    stops the removal, because git would delete it with the folder. The
    check for changes lists every untracked file, whatever the git config
    of the User says, as git stash --include-untracked does."""
    trees = _registered_worktrees(main_root)
    if trees is None:
        return None, f"git worktree list failed in {main_root}"
    for other in trees:
        if other != path and other.is_relative_to(path):
            return None, (
                f"{path} holds the worktree {other}, which the ledger does not "
                "name; move or remove that worktree first"
            )
    code, changes, err = _git_in(path, "status", "--porcelain", "--untracked-files=all")
    if code != 0:
        return None, f"git status failed in {path}: {err}"
    stashed = None
    if changes:
        code, _, err = _git_in(path, "stash", "push", "--include-untracked", "-m", name)
        if code != 0:
            return None, f"git stash failed in {path}: {err}"
        stashed = name
    code, _, err = _git_in(main_root, "worktree", "remove", str(path))
    if code != 0:
        return stashed, f"git worktree remove failed for {path}: {err}"
    return stashed, None


def _marker_branch(text: str) -> str | None:
    for line in text.splitlines():
        if line.startswith("branch="):
            return line[len("branch="):]
    return None


def _remove_run_markers(current: Path, ledger: Ledger, run_branches: list[str]) -> None:
    """Remove the markers of the primary checkout that belong to the run.

    Each marker inside a removed worktree went with that worktree. Only a
    run by hand runs verify-base in the primary checkout (BR-112)."""
    marker = current / "premerge-check-ok"
    if marker.is_file() and _marker_branch(marker.read_text()) in run_branches:
        marker.unlink()
    if ledger.mode == "by-hand":
        (current / "verify-base-ok").unlink(missing_ok=True)


def _remove_gate_results(current: Path, ledger: Ledger) -> None:
    """Remove .current-work/<gate>/<id>.json of each unit of work of the run."""
    if not current.is_dir():
        return
    unit_ids = [uid for uid in ledger.stories if _UNIT_ID_RE.match(uid)]
    for folder in current.iterdir():
        if folder.is_symlink() or not folder.is_dir():
            continue
        for unit_id in unit_ids:
            result = folder / f"{unit_id}.json"
            if result.is_file() and not result.is_symlink():
                result.unlink()


def _remove_run_dir(
    current: Path, run_dir: Path, trees: dict[Path, str | None]
) -> list[Path]:
    """Remove the folder of the run, unless a worktree that git lists is left in it.

    *trees* are the worktrees that git lists after the removals. Return the
    worktrees left, which keep the folder."""
    left = [path for path in trees if path.is_relative_to(run_dir)]
    if left:
        return left
    if run_dir.is_dir():
        shutil.rmtree(run_dir)
    parent = run_dir.parent
    while parent != current and parent.is_relative_to(current):
        try:
            parent.rmdir()
        except OSError:
            break
        parent = parent.parent
    return []


def _delete_run_branches(main_root: Path, branches: list[str]) -> None:
    """Delete each merged branch with git branch -d, and list the others."""
    for branch in branches:
        if not _branch_exists(main_root, branch):
            continue
        code, _, err = _git_in(main_root, "branch", "-d", branch)
        if code == 0:
            print(f"deleted branch: {branch}")
            continue
        merged, _, _ = _git_in(main_root, "merge-base", "--is-ancestor", branch, "HEAD")
        if merged != 0:
            print(f"unmerged branch: {branch}")
        else:
            print(f"kept branch: {branch} ({err})")


def _run_branches(ledger: Ledger) -> list[str]:
    branches = [entry.branch for entry in ledger.stories.values() if entry.branch]
    if ledger.feature_branch:
        branches.append(ledger.feature_branch)
    return list(dict.fromkeys(branches))


def cmd_close(args: argparse.Namespace) -> int:
    """End a finished run, or with --drop a dropped run (BR-119).

    The close acts only on the worktrees, files and branches its own ledger
    names, and on the run's folder under .current-work/ of the primary
    checkout."""
    ledger_path = Path(args.ledger)
    ledger = _load_ledger(ledger_path)
    if ledger is None:
        return 1
    feature_branch = ledger.feature_branch
    main_root = _main_worktree_root().resolve()
    current = (main_root / ".current-work").resolve()
    if feature_branch is None:
        print(f"error: the ledger {ledger_path} names no feature branch", file=sys.stderr)
        return 1
    run_dir, refusal = _close_run_dir(main_root, current, feature_branch)
    if run_dir is None:
        print(f"error: dispatch close: {refusal}; the ledger stays", file=sys.stderr)
        return 1
    refusals = close_refusals(ledger)
    if not args.drop:
        refusal = _unmerged_feature_refusal(main_root, feature_branch)
        refusals += [refusal] if refusal else []
    if refusals:
        for refusal in refusals:
            print(f"error: {refusal}", file=sys.stderr)
        return 1
    trees = _registered_worktrees(main_root)
    if trees is None:
        print(f"error: git worktree list failed in {main_root}", file=sys.stderr)
        return 1

    day = datetime.now().astimezone().date().isoformat()
    for label, path in _run_worktrees(main_root, current, run_dir, ledger, trees):
        stashed, error = _stash_and_remove(
            main_root, path, stash_name(feature_branch, label, day)
        )
        if stashed:
            print(f"stash: {stashed}")
        if error:
            print(
                f"error: {error}; the ledger stays, so run dispatch close again "
                "after you fix the cause",
                file=sys.stderr,
            )
            return 1
    _git_in(main_root, "worktree", "prune")
    left_trees = _registered_worktrees(main_root)
    if left_trees is None:
        print(
            f"error: git worktree list failed in {main_root}; the ledger stays, "
            "so run dispatch close again after you fix the cause",
            file=sys.stderr,
        )
        return 1

    run_branches = _run_branches(ledger)
    ledger_path.unlink(missing_ok=True)
    _remove_run_markers(current, ledger, run_branches)
    _remove_gate_results(current, ledger)
    for path in _remove_run_dir(current, run_dir, left_trees):
        print(f"kept {run_dir}: it holds the worktree {path}, which the ledger does not name")
    _delete_run_branches(main_root, run_branches)
    print(f"dispatch close: closed the run on {feature_branch}")
    return 0


# -- dispatch close --orphans: what no active run owns (BR-120) ---------------

LEDGER_FILENAME = "dispatch-ledger.yaml"


@dataclass
class _FoundLedger:
    """A ledger file, with its folder relative to the .current-work/ it lies in.

    *link* is the symlinked folder that the walk passed to reach it, if any."""

    path: Path
    folder: Path
    link: Path | None = None


def _untracked_ledgers(tree: Path) -> list[Path]:
    """Each ledger file in the checkout of *tree* that git does not track.

    cmd_init writes a ledger to .current-work/<branch>/ of the checkout it
    runs in, and that folder can be a registered worktree or lie inside one,
    as after an init without --feature-branch (IMPL-0053). A tracked file of
    that name is a project file (IMPL-0046). The .current-work/ of *tree* is
    a root of the walk of its own. When git cannot list the files, the
    ledger path at the root stands for the checkout, so its claim keeps
    the worktree."""
    code, out, _ = _git_in(
        tree, "ls-files", "--others", "-z", "--",
        f":(glob)**/{LEDGER_FILENAME}", ":(exclude,glob).current-work/**",
    )
    if code != 0:
        return [Path(LEDGER_FILENAME)]
    return [Path(rel) for rel in out.split("\0") if rel]


def _find_ledgers(
    roots: list[Path], trees: dict[Path, str | None]
) -> tuple[list[_FoundLedger], list[Path]]:
    """Every ledger file below the .current-work/ folders in *roots*, and the
    symlinked folders that the walk met.

    The walk skips each registered worktree, whose own .current-work/ is a
    root of its own, so it never reads the files of a checkout (IMPL-0046).
    It reads the folder behind a symlink, because a ledger there may own
    worktrees (IMPL-0048); a ledger behind a link is never removed."""
    found: dict[Path, _FoundLedger] = {}
    links: list[Path] = []
    walked: set[Path] = set()
    pending = [(root, root, None) for root in roots]
    while pending:
        start, root, link = pending.pop(0)
        if start.is_symlink() and link is None:
            links.append(start)
            link = start
        if not start.is_dir() or start.resolve() in walked or start.resolve() in trees:
            continue
        walked.add(start.resolve())
        for folder, subfolders, files in os.walk(start):
            here = Path(folder)
            if here.resolve() in walked and here != start:
                subfolders[:] = []
                continue
            walked.add(here.resolve())
            kept = []
            for name in subfolders:
                sub = here / name
                if name == ".git":
                    continue
                if sub.is_symlink():
                    links.append(sub)
                    pending.append((sub, root, link or sub))
                elif sub.resolve() not in trees:
                    kept.append(name)
                else:
                    base = start.relative_to(root) / here.relative_to(start) / name
                    for rel in _untracked_ledgers(sub):
                        path = sub / rel
                        found.setdefault(path, _FoundLedger(path, base / rel.parent, link))
            subfolders[:] = kept
            if LEDGER_FILENAME in files:
                path = here / LEDGER_FILENAME
                logical = start.relative_to(root) / here.relative_to(start)
                found.setdefault(path, _FoundLedger(path, logical, link))
    return sorted(found.values(), key=lambda item: item.path), links


@dataclass
class _LedgerClaim:
    """What a ledger that stays owns, so that --orphans leaves it alone.

    *text* is set only for a ledger that dispatch cannot read. Then each
    worktree whose path or branch appears in that text counts as owned."""

    path: Path
    folders: list[Path]
    worktrees: set[Path] = field(default_factory=set)
    branches: set[str] = field(default_factory=set)
    text: str | None = None

    def owns(self, main_root: Path, path: Path, branch: str | None) -> bool:
        if any(path == folder or path.is_relative_to(folder) for folder in self.folders):
            return True
        if path in self.worktrees or (branch is not None and branch in self.branches):
            return True
        if self.text is None:
            return False
        names = [str(path), str(path.relative_to(main_root))]
        if branch is not None:
            names.append(branch)
        return any(name in self.text for name in names)


def _ledger_branch_state(main_root: Path, ledger: Ledger) -> str:
    """Whether the feature branch of *ledger* exists, for orphan_ledger_verdict."""
    branch = ledger.feature_branch
    if not branch:
        return "none"
    code, out, _ = _git_in(main_root, "check-ref-format", "--branch", branch)
    if code != 0 or out != branch:
        return "invalid"
    return "exists" if _branch_exists(main_root, branch) else "gone"


def _claim_of(main_root: Path, current: Path, path: Path, ledger: Ledger) -> _LedgerClaim:
    claim = _LedgerClaim(path=path, folders=[path.parent])
    if ledger.feature_branch:
        claim.branches.add(ledger.feature_branch)
        if _ledger_branch_state(main_root, ledger) in ("exists", "gone"):
            claim.folders.append(current / ledger.feature_branch)
    for entry in ledger.stories.values():
        claim.branches.add(f"story/{entry.id}")
        for branch in (entry.branch, entry.feature_branch):
            if branch:
                claim.branches.add(branch)
        if entry.worktree:
            claim.worktrees.add(Path(entry.worktree).resolve())
            claim.worktrees.add((main_root / entry.worktree).resolve())
    return claim


def _tracked_by(path: Path, trees: dict[Path, str | None]) -> tuple[Path | None, str | None]:
    """The worktree whose git tracks the file at *path*, and the error, if any.

    The file belongs to the deepest registered worktree that holds it."""
    holders = [tree for tree in trees if path.resolve().is_relative_to(tree)]
    if not holders:
        return None, None
    tree = max(holders, key=lambda item: len(item.parts))
    code, _, err = _git_in(tree, "ls-files", "--error-unmatch", "--", str(path.resolve()))
    if code == 0:
        return tree, None
    if code == 1:
        return None, None
    return None, f"git ls-files failed in {tree}: {err}"


def _removal_refusal(
    found: _FoundLedger, trees: dict[Path, str | None], behind_links: set[Path]
) -> str | None:
    """The reason to keep a ledger of no active run, or None to remove it."""
    if found.link is not None or found.path.resolve() in behind_links:
        link = found.link or "a symlinked folder"
        return f"it lies behind {link}, and dispatch removes nothing behind a symlink"
    tracker, error = _tracked_by(found.path, trees)
    if error is not None:
        return error
    if tracker is not None:
        return f"git tracks it in {tracker}"
    return None


def _sort_ledgers(
    main_root: Path,
    current: Path,
    ledgers: list[_FoundLedger],
    trees: dict[Path, str | None],
) -> tuple[list[Path], list[_LedgerClaim]]:
    """Split the ledgers into those to remove and the claims of those that stay.

    Each ledger that stays is listed, unless it belongs to an active run.
    Each one also claims the folder of the primary checkout's .current-work/
    that matches its own folder, because cmd_init writes a ledger to
    .current-work/<feature-branch>/ of the checkout it runs in, and every
    worktree of the run goes to that folder of the primary checkout. So the
    claim holds when the ledger yields no feature branch (IMPL-0045)."""
    behind_links = {found.path.resolve() for found in ledgers if found.link is not None}
    remove: list[Path] = []
    claims: list[_LedgerClaim] = []
    for found in ledgers:
        path = found.path
        mirror = current / found.folder
        ledger = None
        error = "it is a symlink" if path.is_symlink() else None
        if error is None:
            try:
                ledger = Ledger.load(path)
            except Exception as e:  # noqa: BLE001 - every failure keeps the ledger
                error = str(e).splitlines()[0] if str(e) else type(e).__name__
        if ledger is None:
            try:
                text = path.read_text(errors="replace")
            except OSError:
                text = ""
            claims.append(_LedgerClaim(path=path, folders=[path.parent, mirror], text=text))
            print(
                f"kept ledger: {path} (dispatch cannot read it: {error}; "
                "it keeps every worktree it may own)"
            )
            continue
        gone, reason = orphan_ledger_verdict(ledger, _ledger_branch_state(main_root, ledger))
        if gone:
            reason = _removal_refusal(found, trees, behind_links)
            if reason is None:
                remove.append(path)
                continue
        claim = _claim_of(main_root, current, path, ledger)
        claim.folders.append(mirror)
        claims.append(claim)
        if reason is not None:
            print(f"kept ledger: {path} ({reason})")
    return remove, claims


def _orphan_keep_reason(
    main_root: Path,
    path: Path,
    branch: str | None,
    claims: list[_LedgerClaim],
    trees: dict[Path, str | None],
    locked: set[Path],
) -> str | None:
    """The reason to keep a worktree of no ledger, or None to remove it.

    A locked worktree stays before any stash, because git worktree remove
    refuses it and the stash would empty its checkout (IMPL-0047)."""
    if Path.cwd().resolve().is_relative_to(path):
        return "dispatch runs inside it"
    if path in locked:
        return "it is locked"
    if branch is None:
        return "detached HEAD, so it has no branch to check"
    if not _branch_exists(main_root, CLOSE_TARGET):
        return f"{CLOSE_TARGET} does not exist, so dispatch cannot check the merge"
    code, _, err = _git_in(
        main_root, "merge-base", "--is-ancestor",
        f"refs/heads/{branch}", f"refs/heads/{CLOSE_TARGET}",
    )
    if code == 1:
        return f"{branch} is not merged into {CLOSE_TARGET}"
    if code != 0:
        return f"git merge-base failed: {err}"
    for claim in claims:
        if claim.path.is_relative_to(path):
            return f"it holds the ledger {claim.path}"
    for other in trees:
        if other != path and other.is_relative_to(path):
            return f"it holds the worktree {other}"
    return None


def cmd_close_orphans(args: argparse.Namespace) -> int:
    """Clean up what no active run owns (BR-120).

    A ledger stays when its feature branch exists, when a story in it is not
    done, or when dispatch cannot read it. Each ledger that stays owns its
    worktrees. A worktree under .current-work/ that no such ledger owns goes
    only when its branch is merged into dev; every other one is listed.
    Whatever dispatch cannot decide, it keeps."""
    main_root = _main_worktree_root().resolve()
    current = (main_root / ".current-work").resolve()
    trees = _registered_worktrees(main_root)
    if trees is None:
        print(f"error: git worktree list failed in {main_root}", file=sys.stderr)
        return 1
    roots = [current] + [path / ".current-work" for path in trees if path != main_root]
    ledgers, links = _find_ledgers(roots, trees)
    for link in links:
        print(f"kept link: {link} (a symlink; dispatch reads the ledgers behind it "
              "and removes none of them)")
    remove, claims = _sort_ledgers(main_root, current, ledgers, trees)
    for path in remove:
        try:
            path.unlink()
        except OSError as e:
            print(f"error: cannot remove the ledger {path}: {e}", file=sys.stderr)
            return 1
        print(f"removed ledger: {path}")

    orphans = [
        (path, branch) for path, branch in trees.items()
        if path != main_root and path != current and path.is_relative_to(current)
        and path.is_dir()
        and not any(claim.owns(main_root, path, branch) for claim in claims)
    ]
    orphans.sort(key=lambda item: len(item[0].parts), reverse=True)
    day = datetime.now().astimezone().date().isoformat()
    for path, branch in orphans:
        trees = _registered_worktrees(main_root)
        locked = _locked_worktrees(main_root)
        if trees is None or locked is None:
            print(f"error: git worktree list failed in {main_root}", file=sys.stderr)
            return 1
        reason = _orphan_keep_reason(main_root, path, branch, claims, trees, locked)
        if reason is not None:
            print(f"kept worktree: {path} ({branch + '; ' if branch else ''}{reason})")
            continue
        stashed, error = _stash_and_remove(main_root, path, orphan_stash_name(branch, day))
        if stashed:
            print(f"stash: {stashed}")
        if error:
            print(f"error: {error}; run dispatch close --orphans again after you "
                  "fix the cause", file=sys.stderr)
            return 1
        print(f"removed worktree: {path} ({branch})")
    print("dispatch close --orphans: done")
    return 0


def build_parser() -> argparse.ArgumentParser:
    """Build the dispatch parser; every subcommand is in one list of BR-091."""
    parser = argparse.ArgumentParser(
        prog="dispatch",
        description="Mechanized dispatch orchestration for Agent Factory.",
    )
    parser.add_argument(
        "--ledger",
        default=None,
        help="path to dispatch ledger (default: derived from current branch)",
    )
    sub = parser.add_subparsers(dest="subcommand", required=True)

    sub.add_parser("status", help="render the current ledger")

    p_init = sub.add_parser("init", help="initialize a dispatch run")
    p_init.add_argument("--base", required=True)
    p_init.add_argument("--stories", required=True)
    p_init.add_argument("--baseline-commit", action="store_true")
    p_init.add_argument("--feature-branch", default=None)
    p_init.add_argument("--mode", choices=LEDGER_MODES, default="orchestrated")
    p_init.add_argument("--yes", action="store_true", help="skip confirmation prompts")

    p_plan = sub.add_parser("plan", help="compute wave plan from stories")
    p_plan.add_argument("--backlog-dir", required=True)
    p_plan.add_argument(
        "--stories", default=None, help="comma-separated story IDs to include"
    )

    p_plan.add_argument(
        "--dry-run",
        action="store_true",
        help="print wave plan without persisting to the dispatch ledger",
    )

    sub.add_parser("prepare-wave", help="prepare all stories in a wave").add_argument(
        "wave", type=int
    )

    p_ps = sub.add_parser("prepare-story", help="prepare a serial chain link")
    p_ps.add_argument("story_id")

    p_md = sub.add_parser("mark-dispatching", help="mark story as dispatching")
    p_md.add_argument("story_id")

    p_mdd = sub.add_parser("mark-dispatched", help="mark story as dispatched")
    p_mdd.add_argument("story_id")

    p_cm = sub.add_parser("clear-manifest", help="force-remove a stale step manifest")
    p_cm.add_argument(
        "--force", action="store_true", help="required: confirms forced recovery"
    )
    p_cm.add_argument("--worktree", required=True, help="path to the story's worktree")

    p_mb = sub.add_parser("mark-blocked", help="mark story as blocked")
    p_mb.add_argument("story_id")
    p_mb.add_argument("--reason", required=True)

    p_mf = sub.add_parser("mark-failed", help="mark story as failed")
    p_mf.add_argument("story_id")
    p_mf.add_argument(
        "--class",
        dest="failure_class",
        required=False,
        default=None,
        choices=FAILURE_CLASSES,
    )
    p_mf.add_argument("--evidence", required=False, default=None)

    p_rd = sub.add_parser("re-dispatch", help="return story to prepared")
    p_rd.add_argument("story_id")

    p_ret = sub.add_parser(
        "return-story", help="set a failed or blocked story back to pending (User only)"
    )
    p_ret.add_argument("story_id")

    p_vs = sub.add_parser("verify-story", help="verify a story's commit SHA")
    p_vs.add_argument("story_id")
    p_vs.add_argument("--sha", required=True)

    p_add = sub.add_parser(
        "add", help="put an open blocking finding into a new wave of the run"
    )
    p_add.add_argument("finding_id")

    p_es = sub.add_parser("escalate", help="escalate a story to the next tier")
    p_es.add_argument("story_id")

    p_rs = sub.add_parser(
        "refresh-story", help="merge the invocation branch into a story branch"
    )
    p_rs.add_argument("story_id")

    p_ms = sub.add_parser("merge-story", help="merge a story's feature branch")
    p_ms.add_argument("story_id")
    p_ms.add_argument(
        "--dry-run",
        action="store_true",
        help="run premerge-check and report pass/fail without merging",
    )

    sub.add_parser("close-wave", help="close a completed wave").add_argument(
        "wave", type=int
    )

    p_close = sub.add_parser(
        "close", help="end a finished run, or with --drop a dropped run"
    ).add_mutually_exclusive_group()
    p_close.add_argument(
        "--drop",
        action="store_true",
        help="end a run whose feature branch is not merged into dev",
    )
    p_close.add_argument(
        "--orphans",
        action="store_true",
        help="clean up the worktrees and ledgers that no active run owns",
    )

    sub.add_parser(
        "suggest-merge-args",
        help="print recommended --max-files for the final feature-to-dev merge",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    # A critical finding without a confirmed stop refuses every subcommand
    # that starts or merges work, before any ledger is read (BR-091).
    if args.subcommand in STOP_SUBCOMMANDS:
        notice = stop_notice()
        if notice is not None:
            sys.stdout.write(notice)
            return 1
    # init creates its ledger and reads no existing one, so it needs no default.
    # close --orphans reads every ledger, so it needs none either.
    orphans = args.subcommand == "close" and args.orphans
    if args.ledger is None and args.subcommand != "init" and not orphans:
        try:
            args.ledger = _default_ledger()
        except LedgerChoiceError as e:
            print(f"error: {e}", file=sys.stderr)
            return 1

    if args.subcommand == "status":
        return cmd_status(args)
    if args.subcommand == "init":
        return cmd_init(args)
    if args.subcommand == "plan":
        return cmd_plan(args)
    if args.subcommand == "prepare-wave":
        return cmd_prepare_wave(args)
    if args.subcommand == "prepare-story":
        return cmd_prepare_story(args)
    if args.subcommand == "mark-dispatching":
        return cmd_mark_dispatching(args)
    if args.subcommand == "mark-dispatched":
        return cmd_mark_dispatched(args)
    if args.subcommand == "clear-manifest":
        return cmd_clear_manifest(args)
    if args.subcommand == "mark-blocked":
        return cmd_mark_blocked(args)
    if args.subcommand == "mark-failed":
        return cmd_mark_failed(args)
    if args.subcommand == "re-dispatch":
        return cmd_re_dispatch(args)
    if args.subcommand == "return-story":
        return cmd_return_story(args)
    if args.subcommand == "verify-story":
        return cmd_verify_story(args)
    if args.subcommand == "escalate":
        return cmd_escalate(args)
    if args.subcommand == "add":
        return cmd_add(args)
    if args.subcommand == "refresh-story":
        return cmd_refresh_story(args)
    if args.subcommand == "merge-story":
        return cmd_merge_story(args)
    if args.subcommand == "close-wave":
        return cmd_close_wave(args)
    if args.subcommand == "suggest-merge-args":
        return cmd_suggest_merge_args(args)
    if orphans:
        return cmd_close_orphans(args)
    if args.subcommand == "close":
        return cmd_close(args)
    return cmd_not_implemented(args)


if __name__ == "__main__":
    sys.exit(main())
