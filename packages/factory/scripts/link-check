#!/usr/bin/env python3
"""Check local links in Markdown files without network access.

The pre-commit hook passes changed Markdown files.  HTTP(S), mailto, and other
URI schemes are intentionally left to dedicated online crawlers; this fast
gate catches broken repository paths and broken heading anchors, in the same
document and across documents.

Fenced code blocks and inline code spans are skipped: a link inside them is an
example, not a reference.
"""

from __future__ import annotations

import argparse
import functools
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote, urlsplit

LINK = re.compile(r"!?\[[^\]]*\]\(([^)]+)\)")
SCHEME = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
FENCE = re.compile(r"^\s{0,3}(`{3,}|~{3,})")
INLINE_CODE = re.compile(r"`+[^`\n]*`+")
HEADING = re.compile(r"^\s{0,3}(#{1,6})\s+(.*?)\s*#*\s*$")


def without_fences(text: str) -> str:
    """Blank out fenced code blocks, preserving line count."""
    lines: list[str] = []
    fence: str | None = None
    for line in text.splitlines():
        match = FENCE.match(line)
        if match:
            if fence is None:
                fence = match.group(1)[0] * 3
            elif line.strip().startswith(fence):
                fence = None
            lines.append("")
            continue
        lines.append("" if fence else line)
    return "\n".join(lines)


def strip_code(text: str) -> str:
    """Blank out fenced blocks and inline code spans; a link in either is an example."""
    return INLINE_CODE.sub("", without_fences(text))


def slugify(title: str) -> str:
    """Slugify a heading the way GitHub does."""
    text = re.sub(r"`([^`]*)`", r"\1", title)
    text = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"[*~]", "", text)
    text = re.sub(r"[^\w\- ]", "", text.lower(), flags=re.UNICODE)
    return text.replace(" ", "-")


def anchors(path: Path) -> set[str]:
    """Every anchor a Markdown document offers, duplicates suffixed as GitHub does."""
    found: set[str] = set()
    counts: dict[str, int] = {}
    for line in without_fences(path.read_text(encoding="utf-8")).splitlines():
        heading = HEADING.match(line)
        if not heading:
            continue
        slug = slugify(heading.group(2).strip())
        seen = counts.get(slug, 0)
        counts[slug] = seen + 1
        found.add(slug if seen == 0 else f"{slug}-{seen}")
    return found


@functools.lru_cache(maxsize=None)
def _main_checkout(worktree_root: Path) -> Path | None:
    """Return the main checkout of a linked worktree, or None.

    The installed factory under .agent-factory/ is untracked, so only the
    main checkout has it. A linked worktree reaches it there.
    """
    result = subprocess.run(
        ["git", "-C", str(worktree_root), "rev-parse", "--git-common-dir"],
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None
    main_root = (worktree_root / result.stdout.strip()).resolve().parent
    return None if main_root == worktree_root.resolve() else main_root


def _installed_copy_in_main_checkout(target: Path) -> Path | None:
    """Map a missing path under .agent-factory/ to the main checkout's copy."""
    parts = target.parts
    if ".agent-factory" not in parts:
        return None
    index = parts.index(".agent-factory")
    main_root = _main_checkout(Path(*parts[:index]))
    return None if main_root is None else main_root.joinpath(*parts[index:])


def check(path: Path) -> list[str]:
    errors: list[str] = []
    text = strip_code(path.read_text(encoding="utf-8"))
    for raw in LINK.findall(text):
        destination = raw.strip().split(maxsplit=1)[0].strip("<>")
        if not destination or SCHEME.match(destination):
            continue
        parsed = urlsplit(destination)
        target = path if not parsed.path else path.parent / unquote(parsed.path)
        target = target.resolve()
        if not target.exists():
            fallback = _installed_copy_in_main_checkout(target)
            if fallback is None or not fallback.exists():
                errors.append(f"{path}: broken link {destination!r}")
                continue
            target = fallback
        if not parsed.fragment or target.is_dir() or target.suffix.lower() != ".md":
            continue
        if unquote(parsed.fragment) not in anchors(target):
            errors.append(f"{path}: broken anchor {destination!r}")
    return errors


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Check local Markdown links")
    parser.add_argument("files", nargs="*")
    args = parser.parse_args(argv)
    errors: list[str] = []
    for name in args.files:
        path = Path(name)
        if path.is_file() and path.suffix.lower() == ".md":
            errors.extend(check(path))
    if errors:
        print("\n".join(errors), file=sys.stderr)
        print(f"link-check: {len(errors)} broken local link(s)", file=sys.stderr)
        return 1
    print("link-check: all local links resolve")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
