#!/usr/bin/env python3
"""Check local links in Markdown files without network access.

The pre-commit hook passes changed Markdown files.  HTTP(S), mailto, and other
URI schemes are intentionally left to dedicated online crawlers; this fast
gate catches broken repository paths and broken heading anchors, in the same
document and across documents.

It checks inline links and reference definitions. Anchors come from ATX and
setext headings and from <a id> or <a name> tags. Fenced code blocks, inline
code spans, and front matter are skipped: a link inside them is an example,
not a reference.

The script uses only the standard library. It reads files as UTF-8 and
reports a missing or non-UTF-8 input file as a problem.
"""

from __future__ import annotations

import argparse
import functools
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote, urlsplit

LINK_START = re.compile(r"!?\[[^\]]*\]\(")
REFERENCE_DEFINITION = re.compile(r"^ {0,3}\[([^\]^][^\]]*)\]:[ \t]*(<[^>\n]*>|\S+)", re.MULTILINE)
SCHEME = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
FENCE_OPEN = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
INLINE_CODE = re.compile(r"`+[^`\n]*`+")
HEADING = re.compile(r"^\s{0,3}(#{1,6})\s+(.*?)\s*#*\s*$")
SETEXT_UNDERLINE = re.compile(r"^ {0,3}(=+|-+)[ \t]*$")
HTML_ANCHOR = re.compile(r"""<a\s[^>]*?\b(?:id|name)\s*=\s*["']([^"']+)["']""", re.IGNORECASE)
UNDERSCORE_EMPHASIS = re.compile(r"(?<![\w\\])(_{1,3})(?=\S)(.+?)(?<=\S)\1(?!\w)")


class Unreadable(Exception):
    """A Markdown file that does not exist or is not UTF-8."""


def read_markdown(path: Path) -> str:
    """Read a Markdown file as UTF-8, dropping a byte order mark."""
    try:
        return path.read_text(encoding="utf-8-sig")
    except FileNotFoundError as error:
        raise Unreadable(f"{path}: file not found") from error
    except UnicodeDecodeError as error:
        raise Unreadable(f"{path}: not valid UTF-8 ({error.reason} at byte {error.start})") from error
    except OSError as error:
        raise Unreadable(f"{path}: cannot read ({error.strerror})") from error


def without_fences(text: str) -> str:
    """Blank out front matter and fenced code blocks, preserving line count.

    A fence closes only on a line of the same character, at least as long as
    the opening run, with nothing after it, as CommonMark specifies.
    """
    lines = text.splitlines()
    out: list[str] = []
    index = 0
    if lines and lines[0].strip() == "---":
        for end in range(1, len(lines)):
            if lines[end].strip() in ("---", "..."):
                out.extend([""] * (end + 1))
                index = end + 1
                break
    closing: re.Pattern[str] | None = None
    for line in lines[index:]:
        if closing is None:
            match = FENCE_OPEN.match(line)
            if match and not (match.group(1)[0] == "`" and "`" in match.group(2)):
                run = match.group(1)
                closing = re.compile(rf"^ {{0,3}}{re.escape(run[0])}{{{len(run)},}}[ \t]*$")
                out.append("")
                continue
            out.append(line)
        else:
            if closing.match(line):
                closing = None
            out.append("")
    return "\n".join(out)


def strip_code(text: str) -> str:
    """Blank out fenced blocks and inline code spans; a link in either is an example."""
    return INLINE_CODE.sub("", without_fences(text))


def slugify(title: str) -> str:
    """Slugify a heading the way GitHub does."""
    text = re.sub(r"`([^`]*)`", r"\1", title)
    text = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"<[^>]+>", "", text)
    text = UNDERSCORE_EMPHASIS.sub(r"\2", text)
    text = re.sub(r"[*~]", "", text)
    text = re.sub(r"[^\w\- ]", "", text.lower(), flags=re.UNICODE)
    return text.replace(" ", "-")


def heading_titles(text: str) -> list[str]:
    """Every ATX and setext heading title, in document order."""
    titles: list[str] = []
    previous = ""
    for line in without_fences(text).splitlines():
        heading = HEADING.match(line)
        if heading:
            titles.append(heading.group(2).strip())
            previous = ""
            continue
        if previous.strip() and SETEXT_UNDERLINE.match(line):
            titles.append(previous.strip())
            previous = ""
            continue
        previous = line
    return titles


def anchors(path: Path) -> set[str]:
    """Every anchor a Markdown document offers, duplicates suffixed as GitHub does."""
    text = read_markdown(path)
    found: set[str] = set()
    counts: dict[str, int] = {}
    for title in heading_titles(text):
        slug = slugify(title)
        seen = counts.get(slug, 0)
        counts[slug] = seen + 1
        found.add(slug if seen == 0 else f"{slug}-{seen}")
    found.update(HTML_ANCHOR.findall(without_fences(text)))
    return found


def destination_at(text: str, start: int) -> str | None:
    """Parse the link destination that begins at text[start], after the "(".

    Handles <angle bracket> destinations, which may hold spaces, and bare
    destinations with balanced parentheses, such as file(1).md.
    """
    position = start
    while position < len(text) and text[position] in " \t\n":
        position += 1
    if position < len(text) and text[position] == "<":
        end = text.find(">", position + 1)
        if end == -1 or "\n" in text[position:end]:
            return None
        return text[position + 1 : end]
    depth = 0
    chars: list[str] = []
    while position < len(text):
        char = text[position]
        if char == "\\" and position + 1 < len(text):
            chars.append(text[position + 1])
            position += 2
            continue
        if char.isspace():
            break
        if char == "(":
            depth += 1
        elif char == ")":
            if depth == 0:
                break
            depth -= 1
        chars.append(char)
        position += 1
    return "".join(chars)


def destinations(text: str) -> list[str]:
    """Every inline link and reference definition destination in the text."""
    found: list[str] = []
    for match in LINK_START.finditer(text):
        destination = destination_at(text, match.end())
        if destination is not None:
            found.append(destination)
    for _label, raw in REFERENCE_DEFINITION.findall(text):
        found.append(raw[1:-1] if raw.startswith("<") else raw)
    return found


@functools.lru_cache(maxsize=None)
def _main_checkout(worktree_root: Path) -> Path | None:
    """Return the main checkout of a linked worktree, or None.

    The installed factory under .agent-factory/ is untracked, so only the
    main checkout has it. A linked worktree reaches it there.
    """
    result = subprocess.run(
        ["git", "-C", str(worktree_root), "rev-parse", "--show-toplevel", "--git-common-dir"],
        capture_output=True, text=True, check=False,
    )
    lines = result.stdout.splitlines()
    if result.returncode != 0 or len(lines) != 2:
        return None
    toplevel = Path(lines[0]).resolve()
    if toplevel != worktree_root.resolve():
        return None  # .agent-factory is a subfolder, not the installed copy
    main_root = (worktree_root / lines[1]).resolve().parent
    return None if main_root == toplevel else main_root


def _installed_copy_in_main_checkout(target: Path) -> Path | None:
    """Map a missing path under .agent-factory/ to the main checkout's copy."""
    parts = target.parts
    if ".agent-factory" not in parts:
        return None
    index = parts.index(".agent-factory")
    main_root = _main_checkout(Path(*parts[:index]))
    return None if main_root is None else main_root.joinpath(*parts[index:])


def check(path: Path) -> list[str]:
    errors: list[str] = []
    try:
        text = strip_code(read_markdown(path))
    except Unreadable as error:
        return [str(error)]
    for destination in destinations(text):
        destination = destination.strip()
        if not destination or SCHEME.match(destination):
            continue
        parsed = urlsplit(destination)
        target = path if not parsed.path else path.parent / unquote(parsed.path)
        target = target.resolve()
        if not target.exists():
            fallback = _installed_copy_in_main_checkout(target)
            if fallback is None or not fallback.exists():
                errors.append(f"{path}: broken link {destination!r}")
                continue
            target = fallback
        if not parsed.fragment or target.is_dir() or target.suffix.lower() != ".md":
            continue
        try:
            offered = anchors(target)
        except Unreadable as error:
            errors.append(f"{path}: cannot check anchor {destination!r}: {error}")
            continue
        if unquote(parsed.fragment) not in offered:
            errors.append(f"{path}: broken anchor {destination!r}")
    return errors


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Check local Markdown links")
    parser.add_argument("files", nargs="*")
    args = parser.parse_args(argv)
    errors: list[str] = []
    for name in args.files:
        path = Path(name)
        if not path.exists():
            errors.append(f"{path}: file not found")
        elif path.is_file() and path.suffix.lower() == ".md":
            errors.extend(check(path))
    if errors:
        print("\n".join(errors), file=sys.stderr)
        print(f"link-check: {len(errors)} problem(s) with local links", file=sys.stderr)
        return 1
    print("link-check: all local links resolve")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
