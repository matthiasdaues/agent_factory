#!/usr/bin/env python3
"""Generate Copilot-specific agent definitions from Factory agent Markdown.

What: Reads canonical factory/agents/*.md and writes .github/agents/*.md with
      Copilot-specific tools: frontmatter injected. Canonical definitions stay
      CLI-neutral; these copies get the correct tool names for Copilot CLI.
When: Called by init-factory during project setup and re-run on update.
By:   init-factory, or run standalone to refresh.

The tools: key tells Copilot CLI which tools a subagent may call. Without it,
the model guesses short names ("create", "edit", "grep") that don't match
Copilot's registered tool name registry, producing "Unknown tool name"
warnings and silently granting full tool access instead of the intended scope.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

OWNED_MARKER = "# Generated by Agent Factory; do not edit."

# Verified Copilot CLI tool names (from step-guard.json hook matchers).
COPILOT_ALL_TOOLS = [
    "bash",
    "create",
    "edit",
    "read_file",
    "view",
    "write_file",
]


class GenerationError(Exception):
    """Canonical agent input or a destination is unsafe to generate."""


def is_owned_file(path: Path) -> bool:
    """Check if a file was generated by this script."""
    if path.is_symlink() or not path.is_file():
        return False
    try:
        text = path.read_text(encoding="utf-8")
        if not text.startswith("---"):
            return False
        close = text.find("\n---", 3)
        if close == -1:
            return False
        return OWNED_MARKER in text[:close]
    except (OSError, UnicodeError):
        return False


def _is_safe_to_overwrite(dest: Path, canonical: Path) -> bool:
    """True if dest is owned by us, a symlink to canonical, or byte-identical."""
    if is_owned_file(dest):
        return True
    if dest.is_symlink():
        current = (dest.parent / dest.readlink()).resolve()
        return current == canonical.resolve()
    try:
        return dest.read_bytes() == canonical.read_bytes()
    except OSError:
        return False


def _inject_tools(text: str, tools: list[str]) -> str:
    """Inject tools: key and ownership marker into frontmatter."""
    if not text.startswith("---"):
        raise GenerationError("missing frontmatter")

    close = text.find("\n---", 3)
    if close == -1:
        raise GenerationError("unterminated frontmatter")

    fm_body = text[4:close]
    if not fm_body.endswith("\n"):
        fm_body += "\n"

    tools_yaml = "tools:\n" + "".join(f"  - {t}\n" for t in tools)
    body_after = text[close + 4 :]

    return "---\n" + OWNED_MARKER + "\n" + fm_body + tools_yaml + "---" + body_after


def generate(agents_dir: Path, output_dir: Path) -> int:
    """Refresh generated Copilot agent definitions."""
    if not agents_dir.is_dir():
        raise GenerationError(f"agents directory not found: {agents_dir}")

    sources = sorted(agents_dir.glob("*.md"))
    destinations = {path.name: output_dir / path.name for path in sources}

    if output_dir.exists() and not output_dir.is_dir():
        raise GenerationError(f"output path is not a directory: {output_dir}")

    for source in sources:
        dest = destinations[source.name]
        if (dest.exists() or dest.is_symlink()) and not _is_safe_to_overwrite(
            dest, source
        ):
            raise GenerationError(f"foreign destination collision: {dest}")

    output_dir.mkdir(parents=True, exist_ok=True)

    desired = set(destinations.values())
    stale = [
        path
        for path in output_dir.glob("*.md")
        if path not in desired and is_owned_file(path)
    ]

    for source in sources:
        text = source.read_text(encoding="utf-8")
        generated = _inject_tools(text, COPILOT_ALL_TOOLS)
        dest = destinations[source.name]
        if dest.is_symlink():
            dest.unlink()
        dest.write_text(generated, encoding="utf-8")

    for path in stale:
        path.unlink()

    return len(sources)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Generate .github/agents/*.md from factory/agents/*.md."
    )
    parser.add_argument("--agents-dir", type=Path, required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    args = parser.parse_args(argv)
    try:
        count = generate(args.agents_dir, args.output_dir)
    except (GenerationError, OSError, UnicodeError) as exc:
        print(f"generate-copilot-agents: {exc}", file=sys.stderr)
        return 2
    print(f"Generated {count} Copilot agent(s) in {args.output_dir}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
