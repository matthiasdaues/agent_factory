#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
"""next-id — claim the next ID of an ID prefix from the counter on the remote.

What: Prints the next ID of an ID prefix, such as ST-1013, and records it in
      the claim commit at refs/ids/counters on the remote. `--seed` creates
      that counter once for a project. `--plan-seed` prints the seed command
      that continues every ID sequence of the clone. `--move-to-origin` moves a
      local counter to `origin` once the project has one.
When: Before a producer names a new story, finding, todo entry, or ADR.
By:   the User, or an agent through the User's CLI (ADR-0031).

The counter is the ref refs/ids/counters. It points at a claim commit: a
commit with no parent on the empty tree. Its message holds `start=<NNNN>`,
one `<PREFIX>=<NNNN>` line per prefix that claimed an ID, and a random token.

A claim runs in a throwaway bare repository in a new temporary directory, so
the clone gains no ref and no object (BR-075). It pushes with a lease on the
SHA it read (BR-072). It runs every git call without a prompt and stops a
call after 30 seconds (BR-076); a seed keeps git's prompts and has no limit. When another claim pushed after this claim read the
counter, the lease is stale. The claim then waits a random 0.1 to 1 second
and reads again. After ten stale leases in a row, the claim fails. Every
other refusal ends the claim after one push. A seed pushes with the
create-only lease (BR-073).

Every line on standard output and standard error passes through one
redaction: the user info of a URL, such as a token, shows as `***`
(SEC-0007). The git calls get the URL as it is.

`--plan-seed` changes no ref and no file (BR-098). It reads the counter as a
claim does. When the remote holds no counter, it counts the IDs in use on
every local branch, every remote-tracking branch, and the working tree: the
file names in backlog/, docs/findings/, and docs/adr/, the `id` field of each
line in docs/findings/register/*.jsonl, and each heading `## T-NNNN` in
docs/spec/work/todo.md (BR-099). It prints `next-id --seed 0` with one pair
per prefix, in the order of PREFIXES (BR-101). An old file name, such as
ATAM-0014-some-title.md, counts by its number and gets a warning on standard
error (BR-100).

`--move-to-origin` carries the claim commit C of the local counter, which the
git setting agent-factory.counterRemote names, to `origin` in four steps
(BR-102). It reads C, sets a marker commit with parent C and the one line
`moved=<remote>` on the local counter with a lease on C, pushes C to `origin`
with the create-only lease, and removes the setting. A failed push never
puts C back: the marker and the setting stay, and a second move resumes
(DEC-16). A claim or `--plan-seed` that reads a marker
fails and names the remote of the marker (BR-097). A claim that raises the
local counter after the read makes the lease on C stale, so the move reads
again, at most ten times in a row (BR-103). A move that reads a marker at the
local counter was cut off: it takes C from the marker's parent and asks
`origin`. No counter there: it pushes C. C there: it only removes the
setting. Another counter there: a collision, and the marker stays (BR-102).

No third-party dependencies (Python stdlib only), matching backlog-lint.

Usage
  next-id <PREFIX> [--remote <url>]
  next-id --seed <number> [<PREFIX>=<n> …] [--remote <url>]
  next-id --plan-seed [--remote <url>]
  next-id --move-to-origin

Exit code: 0 on success, 1 on a failed claim, seed, plan, or move, 2 on a usage error. On
failure, nothing goes to standard output and the message goes to standard
error.
"""

from __future__ import annotations

import argparse
import json
import os
import posixpath
import random
import re
import secrets
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable, Iterable, Iterator
from contextlib import contextmanager
from typing import NamedTuple, Protocol

PREFIXES = (
    "ST", "BUG", "SPEC", "FAGAN", "SEC", "RECON", "ATAM", "IMPL", "T", "ADR", "ARCH", "QA"
)
COUNTER_REF = "refs/ids/counters"
COUNTER_REMOTE_SETTING = "agent-factory.counterRemote"
MAX_SEED = 9998
IDENTITY = "next-id"
IDENTITY_EMAIL = "next-id@agent-factory.invalid"
USAGE = (
    "next-id <PREFIX> [--remote <url>]\n"
    "       next-id --seed <number> [<PREFIX>=<n> …] [--remote <url>]\n"
    "       next-id --plan-seed [--remote <url>]\n"
    "       next-id --move-to-origin"
)
MARKER_KEY = "moved"
_NUMBER = re.compile(r"[0-9]+")
MAX_STALE_LEASES = 10
WAIT_SECONDS = (0.1, 1.0)
GIT_TIME_LIMIT = 30
# BR-076: a claim runs git without a terminal prompt and without an ssh prompt.
# The ssh prompt goes off by adding BatchMode to the ssh command git would run.
CLAIM_ENV = {"GIT_TERMINAL_PROMPT": "0"}
BATCH_MODE = " -o BatchMode=yes"
# git's two messages for a stale lease (BR-072, DEC-23): the client notices
# and reports `stale info`; the remote notices and reports `cannot lock ref`.
_STALE_LEASE = re.compile(
    r"stale info|cannot lock ref '[^']*': is at [0-9a-f]+ but expected [0-9a-f]+"
)


_MISSING_REF = re.compile(r"couldn't find remote ref")
# SEC-0007: the user info of a URL with a scheme, such as `user:token@` in
# `https://user:token@host/r.git`. The match runs to the last `@` before the
# path, so a password with an `@` goes too. An scp-style URL has no scheme
# and stays.
_USER_INFO = re.compile(r"\b([A-Za-z][A-Za-z0-9+.-]*://)[^/\s]*@")


def redact_user_info(text: str) -> str:
    """Replace the user info of every URL in the text with `***` (SEC-0007)."""
    return _USER_INFO.sub(r"\1***@", text)


class RedactingStream:
    """A text stream that redacts the user info of every URL it writes."""

    def __init__(self, stream):
        self._stream = stream

    def write(self, text: str) -> int:
        self._stream.write(redact_user_info(text))
        return len(text)

    def __getattr__(self, name: str):
        return getattr(self._stream, name)


def redact_output() -> None:
    """Send every write to standard output and standard error through the redaction.

    Messages, argparse errors, `sys.exit(<message>)`, and tracebacks all write
    to sys.stdout or sys.stderr, so none of them can print a token (SEC-0007).
    """
    sys.stdout = RedactingStream(sys.stdout)
    sys.stderr = RedactingStream(sys.stderr)


class NextIdError(Exception):
    """A claim or seed failed; the message goes to standard error."""


class MissingCounter(NextIdError):
    """The remote holds no refs/ids/counters."""


class MovedCounter(NextIdError):
    """The counter holds a marker commit: the counter moved to another remote."""

    def __init__(self, url: str, remote: str):
        super().__init__(
            f"{COUNTER_REF} on {url} moved to {remote}; "
            f"{remote} holds the counter now"
        )
        self.remote = remote


class GitTimedOut(Exception):
    """A git call of a claim ran over the time limit (BR-076)."""


class StaleLease(Exception):
    """The remote's counter moved after this claim read it (BR-072)."""


def is_stale_lease(error: str) -> bool:
    """Tell whether git's push error reports a stale lease."""
    return _STALE_LEASE.search(error) is not None


def _prefix_list() -> str:
    return ", ".join(PREFIXES)


def check_prefix(prefix: str) -> None:
    """Refuse a prefix outside the list of BR-068."""
    if prefix not in PREFIXES:
        raise NextIdError(
            f"the ID prefix '{prefix}' is not in the list: {_prefix_list()}"
        )


def _seed_number(text: str, argument: str) -> int:
    if not _NUMBER.fullmatch(text) or int(text) > MAX_SEED:
        raise NextIdError(
            f"the argument '{argument}' is not a whole number from 0 to {MAX_SEED}"
        )
    return int(text)


def parse_seed(arguments: list[str]) -> dict[str, int]:
    """Check the seed arguments of BR-069 and return the lines in order."""
    if not arguments:
        raise NextIdError("--seed needs a number")
    lines = {"start": _seed_number(arguments[0], arguments[0])}
    for argument in arguments[1:]:
        prefix, sep, number = argument.partition("=")
        if not sep:
            raise NextIdError(f"the argument '{argument}' is not a pair <PREFIX>=<n>")
        check_prefix(prefix)
        if prefix in lines:
            raise NextIdError(f"the ID prefix '{prefix}' has more than one pair")
        lines[prefix] = _seed_number(number, argument)
    return lines


def number_lines(lines: dict[str, int]) -> list[str]:
    """Write each line as `<key>=<NNNN>`, in four digits (BR-070)."""
    return [f"{key}={value:04d}" for key, value in lines.items()]


def format_message(lines: dict[str, int], token: str) -> str:
    """Write the claim commit message: the number lines, then the token."""
    return "\n".join([*number_lines(lines), f"token={token}"]) + "\n"


def format_marker(remote: str) -> str:
    """Write the marker commit message: the one line `moved=<remote>`, redacted (BR-097)."""
    return f"{MARKER_KEY}={redact_user_info(remote)}\n"


def marker_remote(message: str) -> str | None:
    """Return the remote of a marker commit message, or None for a claim commit."""
    lines = message.strip().splitlines()
    if len(lines) != 1:
        return None
    key, sep, remote = lines[0].partition("=")
    return remote if sep and key == MARKER_KEY else None


def parse_message(message: str) -> dict[str, int]:
    """Read the number lines of a claim commit message; drop the token."""
    lines: dict[str, int] = {}
    for line in message.splitlines():
        key, sep, value = line.strip().partition("=")
        if not sep or key == "token":
            continue
        if not _NUMBER.fullmatch(value):
            raise NextIdError(f"the claim commit holds the line '{line}', not a number")
        lines[key] = int(value)
    return lines


def raise_line(message: str, prefix: str, token: str) -> tuple[str, str]:
    """Raise the prefix's line by one and return the new message and the ID.

    A prefix without a line gets `start` plus one (BR-071). Every other line
    stays, and the token is replaced.
    """
    lines = parse_message(message)
    number = lines.get(prefix, lines.get("start", 0)) + 1
    lines[prefix] = number
    return format_message(lines, token), f"{prefix}-{number:04d}"


def ssh_command_with_batch_mode() -> str:
    """Return the ssh command git would run, plus BatchMode (BR-076, DEC-23).

    The order is the one git uses: GIT_SSH_COMMAND, then core.sshCommand, then
    plain ssh.
    """
    command = os.environ.get("GIT_SSH_COMMAND")
    if not command:
        try:
            command = git(["config", "--get", "core.sshCommand"])
        except subprocess.CalledProcessError:
            command = ""
    return (command or "ssh") + BATCH_MODE


def git(
    args: list[str],
    *,
    stdin: str = "",
    env: dict[str, str] | None = None,
    guarded: bool = False,
) -> str:
    """Run git with LC_ALL=C and return its standard output, stripped.

    A guarded call is a call of a claim (BR-076): it gets no prompt and a time
    limit, and raises GitTimedOut when git runs over.
    """
    full_env = {**os.environ, "LC_ALL": "C"}
    if guarded:
        full_env.update(CLAIM_ENV)
        full_env["GIT_SSH_COMMAND"] = ssh_command_with_batch_mode()
    full_env.update(env or {})
    try:
        result = subprocess.run(
            ["git", *args],
            input=stdin,
            capture_output=True,
            text=True,
            env=full_env,
            check=False,
            timeout=GIT_TIME_LIMIT if guarded else None,
        )
    except subprocess.TimeoutExpired:
        raise GitTimedOut from None
    if result.returncode != 0:
        raise subprocess.CalledProcessError(
            result.returncode, result.args, result.stdout, result.stderr
        )
    return result.stdout.strip()


def _git_error(exc: subprocess.CalledProcessError) -> str:
    return (exc.stderr or "").strip() or f"git exited {exc.returncode}"


def resolve_remote(remote: str | None, *, for_seed: bool) -> str:
    """Return the --remote URL, else the counterRemote setting, else origin (BR-096)."""
    if remote is not None:
        return remote
    try:
        return git(["config", "--get", COUNTER_REMOTE_SETTING])
    except subprocess.CalledProcessError:
        pass
    try:
        return git(["remote", "get-url", "origin"])
    except subprocess.CalledProcessError:
        hint = "" if for_seed else ", then run `next-id --seed <number>`"
        raise NextIdError(
            f"no remote: add the remote `origin` or pass `--remote <url>`{hint}"
        ) from None


@contextmanager
def throwaway(*, guarded: bool = False) -> Iterator[list[str]]:
    """Yield git arguments for a bare repository deleted at exit (BR-075)."""
    with tempfile.TemporaryDirectory(prefix="next-id-") as tmp:
        repo = os.path.join(tmp, "claim.git")
        git(["init", "--quiet", "--bare", "--template=", repo], guarded=guarded)
        yield [f"--git-dir={repo}"]


def _commit(
    repo: list[str], message: str, *, guarded: bool = False, parent: str | None = None
) -> str:
    """Create a commit on the empty tree: a claim commit, or a marker with a parent."""
    identity = {
        "GIT_AUTHOR_NAME": IDENTITY,
        "GIT_AUTHOR_EMAIL": IDENTITY_EMAIL,
        "GIT_COMMITTER_NAME": IDENTITY,
        "GIT_COMMITTER_EMAIL": IDENTITY_EMAIL,
    }
    tree = git([*repo, "mktree"], guarded=guarded)
    parents = ["-p", parent] if parent else []
    return git(
        [*repo, "commit-tree", tree, *parents],
        stdin=message,
        env=identity,
        guarded=guarded,
    )


def _push(
    repo: list[str], remote: str, sha: str, lease: str, *, guarded: bool = False
) -> None:
    git(
        [
            *repo,
            "push",
            "--quiet",
            f"--force-with-lease={COUNTER_REF}:{lease}",
            remote,
            f"{sha}:{COUNTER_REF}",
        ],
        guarded=guarded,
    )


class Counter(Protocol):
    """The port of a claim: read the counter, push a new claim commit."""

    def read(self) -> tuple[str, str]:
        """Return the SHA and the message of the claim commit."""
        ...

    def push(self, message: str, lease: str) -> None:
        """Push a claim commit; raise StaleLease, or NextIdError on another refusal."""
        ...


class RemoteCounter:
    """The counter at refs/ids/counters on a remote, through a throwaway repository."""

    def __init__(self, repo: list[str], url: str):
        self.repo = repo
        self.url = url

    def _timed_out(self) -> NextIdError:
        return NextIdError(
            f"a git call on {self.url} ran over the time limit of "
            f"{GIT_TIME_LIMIT} seconds"
        )

    def read(self) -> tuple[str, str]:
        try:
            git(
                [
                    *self.repo,
                    "fetch",
                    "--quiet",
                    self.url,
                    f"+{COUNTER_REF}:{COUNTER_REF}",
                ],
                guarded=True,
            )
        except GitTimedOut:
            raise self._timed_out() from None
        except subprocess.CalledProcessError as exc:
            error = _git_error(exc)
            if _MISSING_REF.search(error):
                raise MissingCounter(
                    f"{self.url} holds no {COUNTER_REF}; "
                    "run `next-id --seed <number>` once for the project"
                ) from None
            raise NextIdError(
                f"cannot read {COUNTER_REF} on {self.url}: {error}"
            ) from None
        try:
            old = git([*self.repo, "rev-parse", COUNTER_REF], guarded=True)
            message = git(
                [*self.repo, "show", "--no-patch", "--format=%B", old], guarded=True
            )
        except GitTimedOut:
            raise self._timed_out() from None
        moved_to = marker_remote(message)
        if moved_to is not None:
            raise MovedCounter(self.url, moved_to)
        return old, message

    def push(self, message: str, lease: str) -> None:
        try:
            sha = _commit(self.repo, message, guarded=True)
            _push(self.repo, self.url, sha, lease, guarded=True)
        except GitTimedOut:
            raise self._timed_out() from None
        except subprocess.CalledProcessError as exc:
            error = _git_error(exc)
            if is_stale_lease(error):
                raise StaleLease(error) from None
            raise NextIdError(f"on {self.url} failed: {error}") from None


def claim_loop(
    prefix: str, counter: Counter, *, sleep: Callable[[float], None] = time.sleep
) -> str:
    """Read, raise, and push until a push holds; return the claimed ID.

    A stale lease waits a random 0.1 to 1 second and reads again. The tenth
    stale lease in a row ends the claim. Any other refusal ends it at once.
    """
    for attempt in range(1, MAX_STALE_LEASES + 1):
        old, message = counter.read()
        new_message, new_id = raise_line(message, prefix, secrets.token_hex(8))
        try:
            counter.push(new_message, old)
        except StaleLease:
            if attempt < MAX_STALE_LEASES:
                sleep(random.uniform(*WAIT_SECONDS))
            continue
        except NextIdError as exc:
            raise NextIdError(f"the claim of {new_id} {exc}") from None
        return new_id
    raise NextIdError(
        f"the claim of {prefix} met ten stale leases in a row; "
        f"the last ID it tried was {new_id}"
    )


def claim(prefix: str, remote: str | None) -> str:
    """Claim the next ID of the prefix and return it, such as ST-1013."""
    check_prefix(prefix)
    url = resolve_remote(remote, for_seed=False)
    try:
        with throwaway(guarded=True) as repo:
            return claim_loop(prefix, RemoteCounter(repo, url))
    except GitTimedOut:
        raise NextIdError(
            f"a git call on {url} ran over the time limit of {GIT_TIME_LIMIT} seconds"
        ) from None


def seed(arguments: list[str], remote: str | None) -> str:
    """Create the counter on the remote and return the seed lines."""
    lines = parse_seed(arguments)
    url = resolve_remote(remote, for_seed=True)
    with throwaway() as repo:
        message = format_message(lines, secrets.token_hex(8))
        sha = _commit(repo, message)
        try:
            _push(repo, url, sha, "")
        except subprocess.CalledProcessError as exc:
            error = _git_error(exc)
            if "stale info" in error or "already exists" in error:
                raise NextIdError(
                    f"{COUNTER_REF} already exists on {url}; the seed changed nothing"
                ) from None
            raise NextIdError(f"the seed on {url} failed: {error}") from None
    return "\n".join(number_lines(lines))


# BR-099 and BR-100: where an ID counts as in use, and what a counted name is.
NAMED_DIRS = ("backlog", "docs/findings")
ADR_DIR = "docs/adr"
REGISTER_DIR = "docs/findings/register"
TODO_FILE = "docs/spec/work/todo.md"
_COUNTED = re.compile(r"([A-Z]+)-([0-9]+)")
_CLEAN_NAME = re.compile(r"[A-Z]+-[0-9]{4}[A-Za-z]?\.md")
_ADR_NAME = re.compile(r"([0-9]{4})-")
_TODO_HEADING = re.compile(r"## (T)-([0-9]+)")

# One ID in use: the prefix, the number, and the path to warn about, or None.
Found = tuple[str, int, str | None]


def _counted_id(text: str) -> tuple[str, int] | None:
    match = _COUNTED.match(text)
    if match is None or match.group(1) not in PREFIXES:
        return None
    return match.group(1), int(match.group(2))


def count_name(path: str) -> tuple[str, int, bool] | None:
    """Return the prefix, the number, and the warning flag of a file name (BR-100).

    A name in backlog/ or docs/findings/ counts when it starts with a prefix,
    a hyphen, and digits. It gets a warning when it is neither
    `<PREFIX>-NNNN.md` nor `<PREFIX>-NNNN<letter>.md`. An ADR file counts when
    its name starts with four digits and a hyphen.
    """
    folder, name = posixpath.split(path)
    if folder == ADR_DIR:
        match = _ADR_NAME.match(name)
        return ("ADR", int(match.group(1)), False) if match else None
    if folder not in NAMED_DIRS:
        return None
    counted = _counted_id(name)
    if counted is None:
        return None
    return (*counted, _CLEAN_NAME.fullmatch(name) is None)


def _register_ids(text: str) -> Iterator[tuple[str, int]]:
    for line in text.splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict) and isinstance(entry.get("id"), str):
            counted = _counted_id(entry["id"])
            if counted is not None:
                yield counted


def _register_file_id(path: str) -> tuple[str, int] | None:
    """Return the prefix and number of a register file name, never its body.

    `docs/findings/register/<class>/<PREFIX>-NNNN.json` counts, in any
    subfolder of the register folder. A JSON name without an ID does not.
    """
    folder, name = posixpath.split(path)
    if not folder.startswith(REGISTER_DIR + "/") or not name.endswith(".json"):
        return None
    return _counted_id(name)


def _todo_ids(text: str) -> Iterator[tuple[str, int]]:
    for line in text.splitlines():
        match = _TODO_HEADING.match(line)
        if match is not None:
            yield match.group(1), int(match.group(2))


def ids_in_tree(paths: Iterable[str], read: Callable[[str], str]) -> Iterator[Found]:
    """Yield every ID in use in one tree of files (BR-099).

    `read` returns the text of a path. It is called only for a register file
    and the todo file, because body text holds examples such as ST-9999.
    """
    for path in paths:
        counted = count_name(path)
        if counted is not None:
            prefix, number, warn = counted
            yield prefix, number, path if warn else None
        elif _register_file_id(path) is not None:
            prefix, number = _register_file_id(path)
            yield prefix, number, None
        elif posixpath.dirname(path) == REGISTER_DIR and path.endswith(".jsonl"):
            for prefix, number in _register_ids(read(path)):
                yield prefix, number, None
        elif path == TODO_FILE:
            for prefix, number in _todo_ids(read(path)):
                yield prefix, number, None


def plan(found: Iterable[Found]) -> tuple[str, list[str]]:
    """Return the seed command and the sorted paths to warn about (BR-101)."""
    highest: dict[str, int] = {}
    warnings: set[str] = set()
    for prefix, number, warn in found:
        highest[prefix] = max(number, highest.get(prefix, 0))
        if warn is not None:
            warnings.add(warn)
    pairs = [f"{prefix}={highest[prefix]}" for prefix in PREFIXES if prefix in highest]
    return " ".join(["next-id --seed 0", *pairs]), sorted(warnings)


def _branch_trees(top: str) -> Iterator[Found]:
    """Yield the IDs of every local and remote-tracking branch, without a checkout."""
    commits = git(
        ["-C", top, "for-each-ref", "--format=%(objectname)", "refs/heads", "refs/remotes"]
    ).split()
    blobs: dict[str, str] = {}

    def read_blob(sha: str) -> str:
        if sha not in blobs:
            blobs[sha] = git(["-C", top, "cat-file", "blob", sha])
        return blobs[sha]

    for commit in dict.fromkeys(commits):
        listing = git(
            ["-C", top, "ls-tree", "-r", commit, "--", *NAMED_DIRS, ADR_DIR, TODO_FILE]
        )
        shas = {}
        for line in listing.splitlines():
            meta, _, path = line.partition("\t")
            shas[path] = meta.split()[2]
        yield from ids_in_tree(shas, lambda path, shas=shas: read_blob(shas[path]))


def _working_tree(top: str) -> Iterator[Found]:
    """Yield the IDs in the working tree, also of files that no commit holds."""
    paths = []
    for folder in (*NAMED_DIRS, ADR_DIR):
        try:
            names = os.listdir(os.path.join(top, folder))
        except OSError:
            continue
        paths += [
            f"{folder}/{name}"
            for name in names
            if os.path.isfile(os.path.join(top, folder, name))
        ]
    for root, _, names in os.walk(os.path.join(top, REGISTER_DIR)):
        relative = os.path.relpath(root, top).replace(os.sep, "/")
        paths += [f"{relative}/{name}" for name in names]
    if os.path.isfile(os.path.join(top, TODO_FILE)):
        paths.append(TODO_FILE)

    def read(path: str) -> str:
        with open(os.path.join(top, path), encoding="utf-8", errors="replace") as file:
            return file.read()

    yield from ids_in_tree(paths, read)


def plan_seed(remote: str | None) -> str:
    """Check the remote, then return the seed command or the in-use line (BR-098)."""
    url = resolve_remote(remote, for_seed=True)
    try:
        with throwaway(guarded=True) as repo:
            RemoteCounter(repo, url).read()
    except MissingCounter:
        pass
    except GitTimedOut:
        raise NextIdError(
            f"a git call on {url} ran over the time limit of {GIT_TIME_LIMIT} seconds"
        ) from None
    else:
        return f"{COUNTER_REF} is in use on {url}; the project needs no seed"
    try:
        top = git(["rev-parse", "--show-toplevel"])
    except subprocess.CalledProcessError:
        raise NextIdError(
            "--plan-seed counts the IDs of a clone; run it inside the project's clone"
        ) from None
    command, warnings = plan([*_branch_trees(top), *_working_tree(top)])
    for path in warnings:
        print(
            f"next-id: warning: {path} breaks the name <PREFIX>-NNNN.md; "
            "it counts by its number",
            file=sys.stderr,
        )
    return command


# --- the move of a local counter to origin (BR-102) -----------------------------


def _guarded(args: list[str], what: str) -> str:
    """Run one git call of the move without prompts and with the limit (BR-076)."""
    try:
        return git(args, guarded=True)
    except GitTimedOut:
        raise NextIdError(
            f"a git call on {what} ran over the time limit of {GIT_TIME_LIMIT} seconds"
        ) from None


def _setting_value(key: str) -> str | None:
    try:
        return _guarded(["config", "--get", key], "this clone")
    except subprocess.CalledProcessError:
        return None


def read_local_counter(local: str) -> tuple[str, str]:
    """Return the SHA and the message of the commit at the local counter."""
    try:
        sha = _guarded(["-C", local, "rev-parse", "--verify", "--quiet", COUNTER_REF], local)
    except subprocess.CalledProcessError:
        raise NextIdError(
            f"the local counter {local} holds no {COUNTER_REF}; "
            "set up the local counter in fitting step 4 \"Seed the ID counter\" first"
        ) from None
    message = _guarded(["-C", local, "show", "--no-patch", "--format=%B", sha], local)
    return sha, message


def _set_local_counter(local: str, new: str, lease: str) -> None:
    """Point the local counter at `new`, with a lease on `lease`."""
    _guarded(["-C", local, "update-ref", COUNTER_REF, new, lease], local)


def push_to_origin(local: str, url: str, sha: str) -> None:
    """Push C to origin with the create-only lease, from a throwaway repository.

    A push from the project would run its pre-push hooks (IMPL-0008). The
    throwaway repository has no hooks, as for a claim (BR-075). It fetches the
    local counter, whose marker has C as its parent, so C arrives with it.
    """
    with throwaway(guarded=True) as repo:
        git(
            [*repo, "fetch", "--quiet", local, f"+{COUNTER_REF}:{COUNTER_REF}"],
            guarded=True,
        )
        _push(repo, url, sha, "", guarded=True)


class LocalCounter:
    """The port of a move on the local counter: read it, and set the marker on it."""

    def __init__(self, local: str, url: str):
        self.local = local
        self.url = url

    def read(self) -> tuple[str, str]:
        """Return the SHA and the message of the commit at the local counter."""
        return read_local_counter(self.local)

    def parent(self, marker: str) -> tuple[str, str]:
        """Return the SHA and the message of C, the parent of the marker (DEC-14)."""
        try:
            sha = _guarded(
                ["-C", self.local, "rev-parse", "--verify", "--quiet", f"{marker}^"],
                self.local,
            )
        except subprocess.CalledProcessError:
            raise NextIdError(
                f"the marker at the local counter {self.local} has no parent; "
                "the move changed nothing"
            ) from None
        message = _guarded(
            ["-C", self.local, "show", "--no-patch", "--format=%B", sha], self.local
        )
        return sha, message

    def mark(self, lease: str) -> str:
        """Set the marker with parent C, with a lease on C; return the marker."""
        marker = _marker_commit(self.local, self.url, lease)
        try:
            _set_local_counter(self.local, marker, lease)
        except subprocess.CalledProcessError as exc:
            error = _git_error(exc)
            if is_stale_lease(error):
                raise StaleLease(error) from None
            raise NextIdError(
                f"the local counter {self.local} refused the marker: {error}; "
                "the move changed nothing"
            ) from None
        return marker


# C, the message of C, the marker, and whether an earlier move set the marker.
Marked = tuple[str, str, str, bool]


def mark_loop(
    counter: LocalCounter, local: str, *, sleep: Callable[[float], None] = time.sleep
) -> Marked:
    """Read the local counter and set the marker until the lease on C holds (BR-103).

    A stale lease waits a random 0.1 to 1 second and reads again. The tenth
    stale lease in a row ends the move. A marker at the read is the marker of
    a cut-off move, so C is its parent (BR-102).
    """
    for attempt in range(1, MAX_STALE_LEASES + 1):
        sha, message = counter.read()
        if marker_remote(message) is not None:
            return (*counter.parent(sha), sha, True)
        try:
            return sha, message, counter.mark(sha), False
        except StaleLease:
            if attempt < MAX_STALE_LEASES:
                sleep(random.uniform(*WAIT_SECONDS))
    raise NextIdError(
        f"the move met ten stale leases in a row on the local counter {local}: "
        "an ID claim raised it after each read; the move changed nothing, "
        f"and {COUNTER_REMOTE_SETTING} stays"
    )


def _origin_counter(target: str, url: str) -> str | None:
    """Return the SHA at refs/ids/counters on origin, or None when origin holds none."""
    try:
        listing = _guarded(["ls-remote", target, COUNTER_REF], url)
    except subprocess.CalledProcessError as exc:
        raise NextIdError(
            f"cannot read {COUNTER_REF} on {url}: {_git_error(exc)}; "
            "the move changed nothing"
        ) from None
    return listing.split()[0] if listing else None


def _number_lines_of(message: str) -> str:
    lines = [line for line in message.splitlines() if not line.startswith("token=")]
    return ", ".join(lines)


def _collision(local: str, url: str, target: str, message: str) -> NextIdError:
    """Name both counters with their key=value lines (DEC-05, CIFP-C15)."""
    try:
        with throwaway(guarded=True) as repo:
            _, other = RemoteCounter(repo, target).read()
    except (NextIdError, GitTimedOut, subprocess.CalledProcessError) as exc:
        other = f"a counter next-id cannot read ({exc})"
    return NextIdError(
        f"two counters exist: the local counter {local} holds "
        f"{_number_lines_of(message)}, and {COUNTER_REF} on {url} holds "
        f"{_number_lines_of(other)}; the local counter keeps the marker of the "
        f"move, and {COUNTER_REMOTE_SETTING} stays"
    )


def move_to_origin() -> str:
    """Move the local counter to origin in the four steps of BR-102."""
    local = _setting_value(COUNTER_REMOTE_SETTING)
    if local is None:
        raise NextIdError(
            f"no local counter is set: the git setting {COUNTER_REMOTE_SETTING} "
            "does not exist; the move changed nothing"
        )
    # The URL as configured, not as git rewrites it, so the marker names it.
    url = _setting_value("remote.origin.url")
    if url is None:
        raise NextIdError(
            "no remote `origin`: add the remote `origin`, then run "
            "`next-id --move-to-origin` again; the move changed nothing"
        )
    # git rewrites the URL with the clone's url.<base>.insteadOf settings; the
    # throwaway repository of a read has none, so the move resolves it here.
    target = _guarded(["ls-remote", "--get-url", url], "this clone")
    sha, message, _, resumed = mark_loop(LocalCounter(local, url), local)
    done = f"moved {COUNTER_REF} from {local} to {url}"
    if resumed:
        on_origin = _origin_counter(target, url)
        if on_origin == sha:
            _guarded(["config", "--unset", COUNTER_REMOTE_SETTING], "this clone")
            return done
        if on_origin is not None:
            raise _collision(local, url, target, message)
    try:
        push_to_origin(local, target, sha)
    except GitTimedOut:
        raise NextIdError(
            f"the push to {url} ran over the time limit of {GIT_TIME_LIMIT} seconds; "
            f"the local counter {local} holds the marker of the move, and "
            f"{COUNTER_REMOTE_SETTING} stays"
        ) from None
    except subprocess.CalledProcessError as exc:
        return _after_refusal(
            Refusal(local, url, target, sha, message), _git_error(exc)
        )
    _guarded(["config", "--unset", COUNTER_REMOTE_SETTING], "this clone")
    return done


class Refusal(NamedTuple):
    """The state of a move whose push origin refused."""

    local: str
    url: str
    target: str
    sha: str
    message: str


def _after_refusal(move: Refusal, error: str) -> str:
    """Ask origin again after a refused push, then finish or refuse (DEC-16).

    origin may have gained C or another counter after the check. A counter on
    origin may have grown from C, so C never comes back: the local counter
    keeps the marker, the setting stays, and a second move resumes.
    """
    try:
        on_origin = _origin_counter(move.target, move.url)
    except NextIdError:
        on_origin = None
    if on_origin == move.sha:
        _guarded(["config", "--unset", COUNTER_REMOTE_SETTING], "this clone")
        return f"moved {COUNTER_REF} from {move.local} to {move.url}"
    if on_origin is not None:
        raise _collision(move.local, move.url, move.target, move.message)
    raise NextIdError(
        f"the move to {move.url} failed: {error}; the local counter {move.local} "
        f"keeps the marker of the move, and {COUNTER_REMOTE_SETTING} stays"
    )


def _marker_commit(local: str, url: str, parent: str) -> str:
    """Create the marker commit in the local repository, with C as its parent."""
    try:
        return _commit(["-C", local], format_marker(url), guarded=True, parent=parent)
    except GitTimedOut:
        raise NextIdError(
            f"a git call on {local} ran over the time limit of {GIT_TIME_LIMIT} seconds"
        ) from None


def _parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="next-id", usage=USAGE, description=__doc__.split("\n")[0]
    )
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--seed", action="store_true", help="create the counter once")
    mode.add_argument(
        "--plan-seed",
        action="store_true",
        help="print the seed command that continues every ID sequence",
    )
    mode.add_argument(
        "--move-to-origin",
        action="store_true",
        help="move the local counter of agent-factory.counterRemote to origin",
    )
    p.add_argument(
        "--remote",
        help="the remote URL; the default is the git setting "
        "agent-factory.counterRemote, then the URL of origin",
    )
    p.add_argument(
        "arguments", nargs="*", help="<PREFIX>, or <number> [<PREFIX>=<n> …]"
    )
    return p


def main(argv: list[str] | None = None) -> int:
    p = _parser()
    ns = p.parse_args(argv)
    if ns.plan_seed and ns.arguments:
        p.error("--plan-seed takes no argument")
    if ns.move_to_origin and (ns.arguments or ns.remote is not None):
        p.error("--move-to-origin takes no argument and no --remote")
    if not (ns.seed or ns.plan_seed or ns.move_to_origin) and len(ns.arguments) != 1:
        p.error("name one ID prefix")
    try:
        if ns.move_to_origin:
            output = move_to_origin()
        elif ns.plan_seed:
            output = plan_seed(ns.remote)
        elif ns.seed:
            output = seed(ns.arguments, ns.remote)
        else:
            output = claim(ns.arguments[0], ns.remote)
    except NextIdError as exc:
        print(f"next-id: {exc}", file=sys.stderr)
        return 1
    print(output)
    return 0


if __name__ == "__main__":
    redact_output()
    sys.exit(main())
