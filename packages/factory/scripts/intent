#!/usr/bin/env python3
"""intent — precondition-based agent selection and assessment.

Usage:
  intent select [--workstream ID] [--agents-dir DIR]
  intent assess [--workstream ID] [--format text|json]

Exit codes: 0 (success), 2 (invalid input).
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

PACKAGES_DIR = Path(__file__).resolve().parent.parent

if str(PACKAGES_DIR) not in sys.path:
    sys.path.insert(0, str(PACKAGES_DIR))

from engine.agent_loader import load_agent_definitions
from engine.eligibility import evaluate_all


def cmd_select(args: argparse.Namespace) -> int:
    agents_dir = Path(args.agents_dir) if args.agents_dir else None
    agents = load_agent_definitions(agents_dir)

    if not agents:
        print("no agent definitions found")
        return 0

    workstream_id = args.workstream if args.workstream else None
    results = evaluate_all(agents, workstream_id)

    descriptions = {a["name"]: a.get("description", "") for a in agents}
    _print_evidence(results, descriptions)
    return 0


def _print_evidence(
    results: list[dict], descriptions: dict[str, str],
) -> None:
    print("\n─── Agent Evidence ───\n")

    for r in results:
        name = r["agent_name"]
        reqs = r["requirements"]
        eligible = r["eligible"]
        warnings = r.get("warnings", [])
        desc = descriptions.get(name, "")

        if not reqs:
            header = f"○ {name}"
            if desc:
                header += f" — {desc}"
            print(header)
            print("  (no required inputs — always eligible)\n")
            continue

        marker = "✓" if eligible else "✗"
        header = f"{marker} {name}"
        if desc:
            header += f" — {desc}"
        print(header)

        print("  Required inputs:")
        for req in reqs:
            req_type = req.get("type", "unknown")
            satisfied = req["satisfied"]
            candidates = req.get("candidates", [])
            condition = req.get("condition")
            pattern = req.get("path_pattern", "")

            if satisfied:
                matched = candidates[0] if candidates else pattern
                detail = f"✓ {req_type}: {matched}"
                if condition and "field" in condition:
                    field = condition.get("field", "")
                    value = condition.get("value", condition.get("one_of", ""))
                    detail += f" ({field}={value})"
            else:
                detail = f"✗ {req_type}: no file matching {pattern}"
                if condition and "field" in condition:
                    field = condition.get("field", "")
                    value = condition.get("value", condition.get("one_of", ""))
                    detail += f" with {field}={value}"

            print(f"    {detail}")

        for w in warnings:
            print(f"  [warning] {w}")
        print()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="intent", description="Precondition-based agent selection."
    )
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_select = sub.add_parser("select", help="List agents with precondition evidence.")
    p_select.add_argument(
        "--workstream", default=None,
        help="Workstream ID for scope filtering",
    )
    p_select.add_argument(
        "--agents-dir", default=None,
        help="Path to agents directory (default: factory/agents)",
    )

    parsed = parser.parse_args(argv)
    if parsed.subcommand == "select":
        return cmd_select(parsed)
    return 2


if __name__ == "__main__":
    sys.exit(main())
