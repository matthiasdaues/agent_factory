#!/usr/bin/env python3
"""Generate project-scoped Codex custom agents from Factory agent Markdown."""

from __future__ import annotations

import argparse
import json
import sys
from dataclasses import dataclass
from pathlib import Path

OWNED_MARKER = "# Generated by Agent Factory; do not edit.\n"
_SCRIPTS_DIR = Path(__file__).resolve().parent
_REPO_ROOT = _SCRIPTS_DIR.parents[1]


class GenerationError(Exception):
    """Canonical agent input or a destination is unsafe to generate."""


@dataclass(frozen=True)
class Agent:
    """The Codex-facing subset of a canonical Factory agent."""

    name: str
    description: str
    body: str
    source: Path


def _parse_agent(path: Path) -> Agent:
    """Parse the canonical fields without depending on a YAML package."""
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise GenerationError(f"{path}: missing frontmatter")

    end = next(
        (
            index
            for index, line in enumerate(lines[1:], start=1)
            if line.strip() == "---"
        ),
        None,
    )
    if end is None:
        raise GenerationError(f"{path}: unterminated frontmatter")

    fields: dict[str, str] = {}
    index = 1
    while index < end:
        line = lines[index].rstrip("\r\n")
        if line[:1].isspace() or ":" not in line:
            index += 1
            continue
        key, _, raw_value = line.partition(":")
        value = raw_value.strip()
        if value in {">", ">-", ">|", "|", "|-"}:
            parts: list[str] = []
            index += 1
            while index < end and (
                not lines[index].strip() or lines[index][:1].isspace()
            ):
                part = lines[index].strip()
                if part:
                    parts.append(part)
                index += 1
            fields[key.strip()] = " ".join(parts)
            continue
        fields[key.strip()] = value
        index += 1

    name = fields.get("name", "").strip()
    description = fields.get("description", "").strip()
    if not name:
        raise GenerationError(f"{path}: missing name")
    if not description:
        raise GenerationError(f"{path}: missing description")
    if name != path.stem:
        raise GenerationError(
            f"{path}: agent name {name!r} must match filename {path.stem!r}"
        )

    body = "".join(lines[end + 1 :]).lstrip("\r\n")
    return Agent(name=name, description=description, body=body, source=path)


def _toml_string(value: str) -> str:
    """Encode a TOML basic string using its JSON-compatible escape subset."""
    return json.dumps(value, ensure_ascii=False)


def _render(agent: Agent) -> str:
    return (
        OWNED_MARKER
        + f"name = {_toml_string(agent.name)}\n"
        + f"description = {_toml_string(agent.description)}\n"
        + f"developer_instructions = {_toml_string(agent.body)}\n"
    )


def _is_owned_file(path: Path) -> bool:
    if path.is_symlink() or not path.is_file():
        return False
    try:
        with path.open(encoding="utf-8") as stream:
            return stream.readline() == OWNED_MARKER
    except (OSError, UnicodeError):
        return False


def generate(agents_dir: Path, output_dir: Path) -> int:
    """Refresh generated agents after validating every input and destination."""
    if not agents_dir.is_dir():
        raise GenerationError(f"agents directory not found: {agents_dir}")

    agents = [_parse_agent(path) for path in sorted(agents_dir.glob("*.md"))]
    destinations = {agent.name: output_dir / f"{agent.name}.toml" for agent in agents}

    if output_dir.exists() and not output_dir.is_dir():
        raise GenerationError(f"output path is not a directory: {output_dir}")

    # Complete preflight precedes every write and stale-file deletion.
    for destination in destinations.values():
        if (destination.exists() or destination.is_symlink()) and not _is_owned_file(
            destination
        ):
            raise GenerationError(f"foreign destination collision: {destination}")

    output_dir.mkdir(parents=True, exist_ok=True)
    desired = set(destinations.values())
    stale = [
        path
        for path in output_dir.glob("*.toml")
        if path not in desired and _is_owned_file(path)
    ]

    for agent in agents:
        destinations[agent.name].write_text(_render(agent), encoding="utf-8")
    for path in stale:
        path.unlink()
    return len(agents)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Generate .codex/agents/*.toml from factory/agents/*.md."
    )
    parser.add_argument(
        "--agents-dir", type=Path, default=_REPO_ROOT / "factory" / "agents"
    )
    parser.add_argument(
        "--output-dir", type=Path, default=_REPO_ROOT / ".codex" / "agents"
    )
    args = parser.parse_args(argv)
    try:
        count = generate(args.agents_dir, args.output_dir)
    except (GenerationError, OSError, UnicodeError) as exc:
        print(f"generate-codex-agents: {exc}", file=sys.stderr)
        return 2
    print(f"Generated {count} Codex agent(s) in {args.output_dir}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
