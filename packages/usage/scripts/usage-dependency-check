#!/usr/bin/env python3
"""Verify that DuckDB and PyArrow are directly declared and version-locked."""

import sys
from pathlib import Path

try:
    import tomllib
except ImportError:
    import tomli as tomllib  # type: ignore[no-redef]


def main() -> int:
    pyproject = Path(__file__).resolve().parent.parent / "pyproject.toml"
    if not pyproject.exists():
        print(f"not found: {pyproject}", file=sys.stderr)
        return 1

    with open(pyproject, "rb") as f:
        data = tomllib.load(f)

    deps = data.get("project", {}).get("dependencies", [])
    optional = data.get("project", {}).get("optional-dependencies", {})
    arrow_deps = optional.get("arrow", [])
    all_deps = deps + arrow_deps

    errors: list[str] = []

    duckdb_found = False
    pyarrow_found = False
    for dep in all_deps:
        name = dep.split(">")[0].split("<")[0].split("=")[0].split("[")[0].strip()
        if name == "duckdb":
            duckdb_found = True
        if name == "pyarrow":
            pyarrow_found = True
            if ">=" not in dep and "==" not in dep:
                errors.append(f"pyarrow not version-locked: {dep}")

    if not duckdb_found:
        errors.append("duckdb not directly declared in dependencies")
    if not pyarrow_found:
        errors.append("pyarrow not directly declared in dependencies or optional-dependencies")

    if errors:
        for e in errors:
            print(f"FAIL: {e}", file=sys.stderr)
        return 1

    print("OK: duckdb and pyarrow are directly declared and version-locked")
    return 0


if __name__ == "__main__":
    sys.exit(main())
