FROM docker.io/library/python:3.12-slim

# PoC worker image: python (orchestrator/scripts) + curl (egress checks).
# Node is deliberately omitted — the boundary proof does not depend on the
# AI CLIs; they are a later, orthogonal concern.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -u 1000 worker

WORKDIR /work
USER worker
CMD ["/bin/bash"]
