<mxfile host="app.diagrams.net"><diagram id="brownfield-lanes" name="Brownfield core lanes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Brownfield onboarding as core-artifact lanes" style="text;html=1;fontFamily=Noto Sans;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Each lane turns evidence in the code into one artifact: a step produces it, a deterministic gate checks it, a review confirms it. Dashed boxes mark a missing gate or review. Code and tests stay the truth above the core; reconciliation checks the core against them. Source: packages/factory/playbooks/brownfield-onboarding.md and docs/proposals/core-artifact-layout.md." style="text;html=1;fontFamily=Noto Sans;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="0" y="44" width="1300" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Evidence in code" style="text;html=1;fontFamily=Noto Sans;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="200" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Produced by" style="text;html=1;fontFamily=Noto Sans;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="220" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Gate" style="text;html=1;fontFamily=Noto Sans;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="190" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Review" style="text;html=1;fontFamily=Noto Sans;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="200" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Artifact" style="text;html=1;fontFamily=Noto Sans;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="220" height="30" as="geometry"/></mxCell><mxCell id="c8" value="Preparation" style="swimlane;horizontal=0;startSize=40;html=1;fontFamily=Noto Sans;fontSize=14;fontStyle=1;rounded=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="1300" height="160" as="geometry"/></mxCell><mxCell id="c9" value="Existing tests, public APIs, entry points, old docs" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans;fontSize=12;rounded=0;fillColor=#f7f7f7;strokeColor=#b0b0b0;fontColor=#595959;" vertex="1" parent="c8"><mxGeometry x="60" y="18" width="200" height="64" as="geometry"/></mxCell><mxCell id="c10" value="1.1 Test baseline&lt;br&gt;1.2 Identify seams&lt;br&gt;2.0 Archive old docs" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans;fontSize=12;rounded=1;arcSize=12;fillColor=#c6dcff;strokeColor=#305bab;" vertex="1" parent="c8"><mxGeometry x="300" y="18" width="220" height="64" as="geometry"/></mxCell><mxCell id="c11" value="Project test runner (1.1)" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans;fontSize=12;rhombus;fillColor=#fff6b6;strokeColor=#af7e04;" vertex="1" parent="c8"><mxGeometry x="560" y="12" width="190" height="76" as="geometry"/></mxCell><mxCell id="c12" value="none" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans;fontSize=12;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#9b4a08;dashed=1;fontColor=#595959;" vertex="1" parent="c8"><mxGeometry x="790" y="18" width="200" height="64" as="geometry"/></mxCell><mxCell id="c13" value="todos.md, ~archive/&lt;br&gt;(work output, not core)" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#f7